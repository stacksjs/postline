{
  "name": "postline",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "description": "Postline — compose once, publish to every social network: queue, campaigns, analytics, listening and a unified inbox.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "contributors": [
    "Chris Breuer <chris@stacksjs.org>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/postline#readme",
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/postline.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/postline/issues"
  },
  "scripts": {
    "build:reset": "rm -rf node_modules && bun install && ./buddy generate:types && ./buddy lint:fix",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "setup": "./bootstrap",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "dev": "./buddy dev",
    "development": "./buddy dev",
    "build": "./buddy build",
    "build:frontend": "./buddy build:frontend && bun scripts/bundle-client-scripts.ts",
    "prod": "./buddy build",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "format": "./buddy format",
    "format:check": "./buddy format:check",
    "serve": "./buddy serve",
    "make": "./buddy make",
    "make:component": "./buddy make:component",
    "make:function": "./buddy make:function",
    "make:database": "./buddy make:migration",
    "make:migration": "./buddy make:migration",
    "make:notification": "./buddy make:notification",
    "make:factory": "./buddy make:factory",
    "make:lang": "./buddy make:lang",
    "make:stack": "./buddy make:stack",
    "key:generate": "./buddy key:generate",
    "commit": "./buddy commit",
    "browser:check": "bun scripts/browser-check.ts",
    "budget:check": "bun scripts/budget-check.ts",
    "publication:check": "bun scripts/publication-check.ts",
    "release": "./buddy release",
    "release:patch": "./buddy release --bump patch",
    "release:minor": "./buddy release --bump minor",
    "release:major": "./buddy release --bump major",
    "changelog": "./buddy changelog",
    "generate": "./buddy generate",
    "typecheck:app": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "types:check": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "types:fix": "./buddy types:fix",
    "test": "./buddy test",
    "test:ui": "./buddy test:ui",
    "test:coverage": "./buddy test:coverage",
    "test:types": "./buddy test:types",
    "bud": "./buddy",
    "stx": "./buddy",
    "typecheck": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@stacksjs/ai": "^0.75.695",
    "@stacksjs/charts": "0.75.695",
    "@stacksjs/sanitizer": "0.2.955",
    "@stacksjs/socials": "^0.75.695",
    "@stacksjs/stx": "0.2.955",
    "@stacksjs/ts-cloud": "^0.16.157",
    "marked": "18.3.0",
    "stacks": "^0.75.695",
    "ts-backups": "https://github.com/stacksjs/ts-backups/releases/download/v0.1.6/ts-backups-0.1.6.tgz",
    "ts-images": "^0.2.35",
    "ts-medium-editor": "0.2.1"
  },
  "devDependencies": {
    "@iconify-json/hugeicons": "^1.2.36",
    "@iconify-json/simple-icons": "^1.2.92",
    "@stacksjs/components": "0.2.955",
    "better-dx": "^0.2.22",
    "bun-plugin-stx": "0.2.955",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "storage/framework",
    "storage/framework/libs/*",
    "storage/framework/views/*"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bun x --bun pickier lint --fix"
      }
    },
    "commit-msg": "bun x gitlint --edit .git/COMMIT_EDITMSG"
  }
}
