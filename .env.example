APP_NAME="Postline"
# development is for your own machine. On a server other people can reach, set
# APP_ENV=production and DEBUG=false: development mode answers an error with
# its stack trace and recent queries, and Postline refuses to start in
# development mode when APP_URL is not a local address.
APP_ENV=development
APP_KEY=
APP_URL=postline.localhost
# The origin the browser uses to reach Postline, when APP_URL does not say it
# (a reverse proxy, another port). Passkeys only work on that exact origin, and
# only over https or on localhost. Empty: APP_URL.
PASSKEY_ORIGIN=
# `marketing` only on the deployment that serves the public site: it serves the
# landing page, features, use cases and the waitlist. Anywhere else those pages
# redirect to the workspace and the waitlist endpoint is not mounted.
POSTLINE_SITE=
# Set to es for Spanish workspace navigation, headings, and command palette.
POSTLINE_WORKSPACE_LOCALE=en
APP_MAINTENANCE=false
APP_MAINTENANCE_SECRET=
APP_COMING_SOON=false
APP_COMING_SOON_SECRET=

# Where images attached to queued posts are kept until they are published.
# On a server, set this to a directory outside the app's folder that survives a
# deploy (for example /var/lib/postline/media). Unset, it is
# storage/app/postline-media under the app.
# POSTLINE_MEDIA_DIR=

# Optional nightly encrypted recovery sets on a production SQLite install.
# Use a private S3 bucket and a recovery key distinct from APP_KEY.
# POSTLINE_BACKUP_BUCKET=
# POSTLINE_BACKUP_REGION=us-east-1
# POSTLINE_BACKUP_ACCESS_KEY_ID=
# POSTLINE_BACKUP_SECRET_ACCESS_KEY=
# POSTLINE_BACKUP_RECOVERY_KEY=

# Private S3 storage for the Postline desktop update feed.
# POSTLINE_UPDATES_BUCKET=
# POSTLINE_UPDATES_REGION=us-east-1
# POSTLINE_UPDATES_ACCESS_KEY_ID=
# POSTLINE_UPDATES_SECRET_ACCESS_KEY=

# How many minutes late a scheduled post may be and still go out by itself.
# Anything later was missed while Postline was not running; it is held back
# for you to publish or reschedule. Default 30.
# POSTLINE_LATE_GRACE_MINUTES=30

PORT=3000
DEBUG=true
# Optional, and best left unset: lets rpx/tlsx set up local pretty domains and
# trusted certificates without prompting during `./buddy dev`. It is your
# machine's sudo password, in plain text.
# SUDO_PASSWORD=
# Optional: path to a compiled `rpx` binary (defaults to ~/Code/Tools/rpx/.../bin/rpx)
# RPX_BIN=

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postline
DB_DATABASE_PATH=database/postline.sqlite
DB_USERNAME=root
DB_PASSWORD=

# Only for `buddy deploy` to AWS (config/cloud.ts). Postline itself needs none.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_REGION=us-east-1
# AWS_HOSTED_ZONE_ID=
# Deploy TLS: who Let's Encrypt writes to, and extra names on the certificate.
# LETSENCRYPT_EMAIL=
# SSL_DOMAINS=

MAIL_MAILER=smtp
# `mailpit` is the docker-compose service name. Running mailpit directly on the
# host instead? Use 127.0.0.1.
MAIL_HOST=mailpit
MAIL_PORT=1025
# Leave these EMPTY, not "null". A dotenv value is always a string, so the
# literal `null` is truthy, and the SMTP driver gates auth on
# `if (smtpConfig.username && smtpConfig.password)` — so it issues AUTH LOGIN
# against a dev mail catcher that has no auth configured, and every send dies
# with `502 5.5.1 Command not implemented`.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_NAME="${APP_NAME}"
# Empty: no-reply@ the host in APP_URL (or MAIL_DOMAIN). Never a Stacks address.
MAIL_FROM_ADDRESS=
# Printed in the footer of waitlist emails; anti-spam laws in several countries ask for one.
MAIL_POSTAL_ADDRESS=
# Shown on /privacy as the address for privacy questions and deletion requests.
PRIVACY_CONTACT_EMAIL=

# Queue Configuration
# Drivers: sync (default, immediate execution), database, redis, sqs, memory
QUEUE_DRIVER=sync
QUEUE_PREFIX=postline:queue
QUEUE_CONCURRENCY=5
QUEUE_LOG_LEVEL=info
QUEUE_WORKER_CONCURRENCY=5
QUEUE_FAILED_DRIVER=database

# Queue Rate Limiting (optional)
# QUEUE_RATE_LIMIT_ENABLED=false
# QUEUE_RATE_LIMIT_MAX=100
# QUEUE_RATE_LIMIT_DURATION=1000

# Queue Dead Letter Queue (optional)
# QUEUE_DLQ_ENABLED=true
# QUEUE_DLQ_MAX_RETRIES=3

# Queue Horizontal Scaling (optional, for multi-instance deployments)
# QUEUE_HORIZONTAL_SCALING_ENABLED=false
# QUEUE_MAX_WORKERS=10
# QUEUE_JOBS_PER_WORKER=10

# Queue Metrics (optional)
# QUEUE_METRICS_ENABLED=false

# Redis Configuration (required when QUEUE_DRIVER=redis)
# REDIS_URL=
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# SQS Configuration (required when QUEUE_DRIVER=sqs)
# SQS_PREFIX=
# SQS_SUFFIX=

# Domains and time. Most installs leave these unset.
# APP_DOMAIN: the bare domain, when it differs from APP_URL's host.
# APP_DOMAIN=
# DOMAIN_MODE=subdomain|domain (config/domains.ts)
# DOMAIN_MODE=
# MAIL_DOMAIN: the domain mail is sent from; defaults to APP_URL's host.
# MAIL_DOMAIN=
# TZ: the server clock's zone. Schedules use the workspace zone in Settings.
# TZ=
# Where uploaded images are served from, when not from this app's own address.
# STORAGE_PUBLIC_URL=

# The public blog's name and description. Default: APP_NAME.
# BLOG_TITLE=
# BLOG_DESCRIPTION=

# Development ports, when the defaults are taken (config/ports.ts).
# PORT_API=3008
# PORT_DOCS=3006
# PORT_ADMIN=
# PORT_BACKEND=
# PORT_DESKTOP=
# PORT_EMAIL=
# PORT_INSPECT=
# PORT_LIBRARY=
# PORT_SYSTEM_TRAY=

# Sign-in tuning (config/auth.ts). The defaults are right for one owner.
# AUTH_TOKEN_EXPIRY=
# AUTH_USERNAME_FIELD=email
# AUTH_PASSWORD_FIELD=password
# AUTH_PASSWORD_RESET_EXPIRE=
# AUTH_PASSWORD_RESET_THROTTLE=

# Query logging for debugging slow pages (config/database.ts). Off by default.
# DB_QUERY_LOGGING_ENABLED=false
# DB_QUERY_LOGGING_SLOW_THRESHOLD=
# DB_QUERY_LOGGING_RETENTION_DAYS=
# DB_QUERY_LOGGING_PRUNE_FREQUENCY=
# DB_QUERY_LOGGING_EXPLAIN_PLAN=
# DB_QUERY_LOGGING_SUGGESTIONS=
# DB_QUERY_LOGGING_ANALYSIS_ENABLED=
# DB_QUERY_LOGGING_ANALYZE_ALL=

# The mail driver's older name, and the bundled mail server's mode (off).
# MAIL_DRIVER=
# MAIL_SERVER_MODE=

# Bluesky (optional — you can also connect via Accounts in the app)
# Create an app password at https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# X / Twitter (optional — connect via Accounts, or set a pre-obtained token below)
# 1. Create an app at https://developer.x.com/en/portal/dashboard
# 2. Enable OAuth 2.0 with the tweet.read, tweet.write, media.write, users.read
#    and offline.access scopes, and add the redirect URL below
# 3. Posting costs money, and it is billed per call rather than by tier. As
#    checked in October 2026: you buy credits up front, a post costs about
#    $0.015, and a post CONTAINING A LINK costs about $0.20. The free tier
#    closed to new developers in February 2026, and the old Basic ($200/mo)
#    and Pro ($5,000/mo) subscriptions are closed to new signups.
#    The link price is the one that matters here. Crossposting an article is a
#    link post every time, so budget against the $0.20 figure, not the $0.015
#    one — roughly $60/month at ten articles a day. X moves this line often, so
#    treat these numbers as a reason to open the portal, not as a quote.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Every other provider here points at the pretty domain, and 3000 was never a
# port this app runs on — see config/ports.ts.
TWITTER_REDIRECT_URL=https://postline.localhost/api/postline/twitter/callback
# Skip OAuth entirely by pasting a user-context bearer token here instead. An
# app-only bearer token from the portal will not work for publishing.
TWITTER_ACCESS_TOKEN=
# Daily Postline X API read estimate limit in USD, resetting at midnight UTC.
# Set 0 to block reads. X's Developer Console shows actual account charges.
TWITTER_DAILY_READ_BUDGET_USD=2
# Enable paid X engagement reads when you choose Refresh engagement in Analytics.
TWITTER_ENGAGEMENT_METRICS=false

# LinkedIn (optional — connect via Accounts, or set a pre-obtained token below)
# 1. Create an app at https://www.linkedin.com/developers/apps
# 2. Add the "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn" products
# 3. Add the redirect URL below to the app's "Authorized redirect URLs"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=https://postline.localhost/api/postline/linkedin/callback
# `true` also connects the company Pages you administer. Needs the Community
# Management API product on your LinkedIn app, or LinkedIn refuses the sign-in.
LINKEDIN_PAGES=
# Optional. When set, Postline POSTs a small JSON message here whenever
# something needs you: a post that failed for good, a scheduled post that
# was not sent, a network sign-in that was refused. Works with Slack and
# Discord incoming webhooks.
# POSTLINE_ALERT_WEBHOOK_URL=

# Signed outgoing post events. Configure both on the API and scheduler.
# POSTLINE_POST_WEBHOOK_URL=
# POSTLINE_POST_WEBHOOK_SECRET=

# Alerts are also emailed to the workspace owner when mail is set up (a
# MAIL_MAILER other than log). `off` stops the email; the app still shows them.
# POSTLINE_ALERT_EMAIL=

# Daily log files older than this many days are deleted. 0 keeps them all.
# LOG_RETENTION_DAYS=14

# Optional. Every error Postline logs is POSTed as JSON here: a service of
# your own. Nothing is sent anywhere without it.
# POSTLINE_ERROR_WEBHOOK_URL=

# Optional. Postline ships with a current LinkedIn API version (YYYYMM) and
# ignores one set here once LinkedIn has retired it. Leave unset.
# LINKEDIN_API_VERSION=
# Optional: true to read engagement with r_organization_social_feed or r_member_social_feed.
# LINKEDIN_ENGAGEMENT_METRICS=false

# Env-only shortcut: paste a member access token (w_member_social) to skip the
# OAuth flow. Optionally set the author URN to avoid an extra profile lookup.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Instagram (optional — posts REQUIRE an image URL; text-only is rejected)
# Uses the Facebook Graph API: create a Meta app, add Instagram + Facebook Login,
# link an Instagram Business/Creator account to a Facebook Page.
# The Page is not optional for this app. Meta also offers an Instagram Login
# path that needs no Page, but the scopes requested here (pages_show_list,
# pages_read_engagement) and the Page access token stored on connect are the
# Facebook Login path. Instagram messages are not read (Meta's app review).
# The API itself is free. App Review and Business Verification buy Advanced
# Access, which is only needed to publish for accounts you do NOT own — a
# single-workspace install posting to its own account can stay in development
# mode with that account added as an app tester, and skip the review.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URL=https://postline.localhost/api/postline/instagram/callback
# Optional Facebook Graph API version override. Leave blank for Postline's default.
INSTAGRAM_GRAPH_VERSION=
# Optional: true to read engagement with instagram_manage_insights.
# INSTAGRAM_ENGAGEMENT_METRICS=false

# Env-only shortcut: a Page access token + the IG Business account id skip OAuth.
INSTAGRAM_ACCESS_TOKEN=
# Separate Facebook User token for Insights when using a pre-obtained Page token.
# INSTAGRAM_INSIGHTS_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=

# Threads (optional — text-first; an image URL is optional, not required)
# Uses the Threads Graph API: create a Meta app, add the Threads use case,
# and connect a Threads account. OAuth scopes: threads_basic, threads_content_publish.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URL=https://postline.localhost/api/postline/threads/callback
# Bump if Meta deprecates this Threads Graph API version
THREADS_GRAPH_VERSION=v1.0
# Optional: true to read engagement with threads_manage_insights.
# THREADS_ENGAGEMENT_METRICS=false

# Env-only shortcut: a Threads user access token + user id skip OAuth.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_USERNAME=

# Mastodon (any instance; token from Preferences → Development)
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# AI for campaign planning (optional). Settings > AI overrides these; with
# neither, plans come from Postline's built-in planner. AI_PROVIDER is
# anthropic, openai or ollama; without it, an Anthropic key picks Anthropic.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# An OpenAI-compatible endpoint, if not OpenAI's own.
# OPENAI_BASE_URL=
OLLAMA_HOST=
OLLAMA_MODEL=

# Desktop (buddy build:desktop). The Mac app serves Postline from inside itself
# and reads none of this file: its settings live in config/desktop.ts and its
# data in ~/Library/Application Support/Postline. See docs/desktop.md.
# Point at the compiled Craft executable, not the repo's dev wrapper script.
CRAFT_BIN=
