{{--
  The Settings window: a window of its own in the desktop app, the whole
  viewport in a browser. No workspace shell, because System Settings has none.
--}}
@head
  <meta name="color-scheme" content="light dark">
  {{-- The workspace is private: keep every signed-in page and the sign-in page out of search engines, and out of the sitemap, which skips noindex pages. --}}
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <CsrfScripts />
  <SessionScripts />
  <FontFaces />
@endhead

@yield('content')

