<script server>
  // htmlAttrs puts the marketing class on the root element, which is what the
  // landing-page design tokens in config/crosswind.ts are scoped to. Supported
  // as of stx 0.2.153 (stacksjs/stx#1798) — before that the option was typed
  // and computed but never emitted, which is why this layout kept its own
  // document shell until now.
  useHead({
    htmlAttrs: { class: 'text-ink bg-bg marketing' },
    bodyAttrs: { class: 'min-w-0 antialiased' },
  })
</script>

@head
  <meta name="color-scheme" content="light">
  <title>@yield('title', 'Postline: publish, send and own your audience')</title>
  <meta name="description" content="@yield('description', 'Your publication, your newsletter and your paid subscribers, on software you own. Crossposts to every network. Open source, and nobody takes a cut.')">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/images/postline-icon-180.png">
  <link rel="canonical" href="@yield('canonical', 'https://postline.stacksjs.com/')">
  <meta name="theme-color" content="#f4f4f2">

  <!-- Open Graph / social. The card image is absolute: relative URLs are not
      resolved by crawlers, which is why summary_large_image previously
      rendered with no image at all. -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Postline">
  <meta property="og:url" content="@yield('canonical', 'https://postline.stacksjs.com/')">
  <meta property="og:title" content="@yield('title', 'Postline: publish, send and own your audience')">
  <meta property="og:description" content="@yield('description', 'Your publication, your newsletter and your paid subscribers, on software you own. Open source, and nobody takes a cut.')">
  <meta property="og:image" content="@yield('ogImage', 'https://postline.stacksjs.com/images/postline-og.png')">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Postline: one publish sends the post, emails your subscribers, and announces it on every network.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="@yield('title', 'Postline: publish, send and own your audience')">
  <meta name="twitter:description" content="@yield('description', 'Your publication, your newsletter and your paid subscribers, on software you own. Open source, and nobody takes a cut.')">
  <meta name="twitter:image" content="@yield('ogImage', 'https://postline.stacksjs.com/images/postline-og.png')">

  <!-- Geist (display) + Geist Mono (labels/code) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">

@endhead

    <!-- Shared chrome: every marketing page gets the same nav, so the mega menu
        is defined once here rather than repeated per page. -->
    <MegaMenu />
    @yield('content')
    <!-- Shared chrome: subscribe then footer, on every marketing page, so a new
        page picks both up without remembering to include them. -->
    <Subscribe />
    <SiteFooter />
    @stack('scripts')
