<script server>
  // htmlAttrs puts the marketing class on the root element, which is what the
  // marketing rules in config/css.ts are scoped to.
  useHead({
    htmlAttrs: { class: 'text-ink bg-bg marketing' },
    bodyAttrs: { class: 'min-w-0 antialiased' },
  })
</script>

@head
  <meta name="color-scheme" content="light">
  <CsrfScripts />
  <title>@yield('title', 'Postline — write once, publish everywhere')</title>
  <meta name="description" content="@yield('description', 'Postline publishes one draft to Bluesky, X, LinkedIn, Instagram, Threads and Mastodon. Queue, campaigns, inbox and analytics in one open-source app that runs with your keys.')">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/images/postline-icon-180.png">
  <meta name="theme-color" content="#fafafa">

  {{-- Open Graph / social. The card image is absolute: crawlers do not resolve
      relative URLs. --}}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Postline">
  <meta property="og:title" content="@yield('title', 'Postline — write once, publish everywhere')">
  <meta property="og:description" content="@yield('description', 'One draft, six networks. Queue, campaigns, inbox and analytics in one open-source app that runs with your keys.')">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="@yield('ogImageAlt', 'Postline: write once, publish to every network.')">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="@yield('title', 'Postline — write once, publish everywhere')">
  <meta name="twitter:description" content="@yield('description', 'One draft, six networks. Queue, campaigns, inbox and analytics in one open-source app that runs with your keys.')">

  <FontFaces />
  <link rel="stylesheet" href="/assets/styles/marketing.css">
  <script type="module" src="/assets/scripts/site-menus.ts"></script>
@endhead

    {{-- Shared chrome: defined once here, so a new page picks up the header
        and footer without remembering to include them. --}}
    {{-- First in the tab order: one key press past the header and its menus. --}}
    <a class="fixed left-4 top-3 z-50 px-4 py-2 font-medium text-[14px] text-on-accent bg-accent rounded-lg transition-transform focus:translate-y-0 -translate-y-20" href="#content">Skip to content</a>
    <SiteHeader />
    {{-- The router's swap container. `__stxRouterConfig.container` is `main`, so
        without this element the router finds nothing to swap into and every
        navigation across the marketing pages falls back to a full page load.
        Deliberately class-free: a class here is inherited by every page the
        router swaps in. --}}
    <main id="content" tabindex="-1">
      @yield('content')
    </main>
    <SiteFooter />
    @stack('scripts')
