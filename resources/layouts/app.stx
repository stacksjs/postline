@head
  <meta name="color-scheme" content="light dark">
  {{-- The workspace is private: keep every signed-in page and the sign-in page out of search engines, and out of the sitemap, which skips noindex pages. --}}
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <CsrfScripts />
  <SessionScripts />
  <script>
    // Apply the saved sidebar width before the STX shell hydrates.
    try {
      // stx-strict-ignore-next-line window.localStorage
      if (window.localStorage?.getItem('postline.sidebar.collapsed') === 'true')
        document.documentElement.classList.add('postline-sidebar-collapsed')
    } catch {}
  </script>
  <FontFaces />
  <link rel="stylesheet" href="/assets/styles/toast.css">
  {{-- A view's own stylesheet, declared in the head so the router loads it
      before it swaps the view in: no unstyled first entry, and no other view
      downloads it. --}}
  @yield('styles')
@endhead

    <a class="fixed left-4 top-3 z-[100] px-4 py-2 font-medium text-on-accent text-ui bg-accent rounded-lg focus:translate-y-0 -translate-y-20" href="#workspace-content">Skip to content</a>
    <WorkspaceShell>
      @yield('content')
    </WorkspaceShell>
    <div id="postline-toast-host" class="flex bottom-6 fixed right-6 z-[100] sm:right-6 flex-col-reverse gap-2.5 max-w-[22rem] w-[calc(100%-2rem)] pointer-events-none" aria-live="polite" aria-relevant="additions"></div>
    {{-- The editor and the analytics chart load with the view that uses them. --}}
    <script type="module" src="/assets/scripts/view-code.ts"></script>
    {{-- Alerts as Mac notifications and a dock badge; does nothing in a browser. --}}
    <script type="module" src="/assets/scripts/desktop-alerts.ts"></script>
    @stack('scripts')
