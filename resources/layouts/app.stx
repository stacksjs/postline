@head
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script>
    // Client-side auth guard: the server gate covers the listed pages,
    // and this covers `/` (which can't be a protected prefix without
    // also matching /login). The API rejects unauthenticated calls
    // regardless — this is UX, not the security boundary.
    //
    // The desktop shell skips it only against a loopback dev server, the one
    // place the API lets it in without a token (app/Support/Auth/native.ts).
    // The packaged app opens the deployed site, where the API wants a login
    // like any browser: skipping the guard there left a signed-out window on
    // "Loading accounts…" with every call answering 401.
    ;(() => {
      const isNativeApp = window.craft?.__craft_bridge_loaded === true
        || !!window.craft?.window
        || !!window.webkit?.messageHandlers?.craft
      // Pre-paint and pre-runtime: useRoute() and useCookie() do not exist
      // yet, and waiting for them would paint the protected page first, which
      // is the one thing this guard exists to prevent.
      // stx-strict-ignore-next-line window.location
      const host = window.location.hostname
      const isLoopback = host === 'localhost' || host === '127.0.0.1' || host === '[::1]' || host.endsWith('.localhost')

      // The marker login.stx leaves behind, NOT the session itself. The session
      // is an httpOnly cookie, so `document.cookie` cannot see it, and the test
      // this line used to make — `auth-token=` — was therefore true for
      // everyone, signed in or not. That bounced every browser sign-in straight
      // back to /login (#45). The marker carries no token and is not a
      // credential: the API decides what a request may do, and the wrapper
      // below drops the marker the moment the API says the session is over.
      // stx-strict-ignore-next-line document.cookie
      if (!(isNativeApp && isLoopback) && !/(?:^|;\s*)ot-signed-in=1\b/.test(document.cookie)) {
        // replace(), not assign(), so Back does not return to a page the
        // viewer was just bounced off.
        // stx-strict-ignore-next-line location.replace window.location
        window.location.replace('/login')
      }
    })()
  </script>
  <script>
    // Fetch wrapper for same-origin /api/ calls (app-owned so framework
    // upgrades can't clobber it).
    //
    // This used to be a cookie → bearer bridge, reading the session out of
    // `document.cookie` and attaching it as an Authorization header. It could
    // never have worked: the session cookie is httpOnly, so `readToken()`
    // returned undefined on every call and every /api/ request went out
    // unauthenticated (#45). The cookie is now honoured by the API directly
    // (app/Middleware/Auth.ts), and the browser attaches it to same-origin
    // requests by itself, so there is nothing left to bridge.
    //
    // Two jobs remain. Tell the API when the caller is the native shell, and
    // notice when the API says the session is over — the marker the guard above
    // reads is set by the login page and could otherwise outlive the session it
    // stands for.
    ;(() => {
      const nativeFetch = window.fetch.bind(window)
      const isNativeApp = () => window.craft?.__craft_bridge_loaded === true
        || !!window.craft?.window
        || !!window.webkit?.messageHandlers?.craft

      let leaving = false
      const sessionEnded = () => {
        if (leaving) return
        leaving = true
        // Clearable here, unlike the session cookie, precisely because the
        // marker is this app's own non-httpOnly flag. max-age=0 deletes it.
        // This wrapper installs before any runtime exists, so useCookie() is
        // not available yet.
        // stx-strict-ignore-next-line document.cookie
        document.cookie = 'ot-signed-in=; path=/; max-age=0; SameSite=Lax'
        // stx-strict-ignore-next-line location.replace window.location
        window.location.replace('/login')
      }

      // The API is the authority on the session, so its answer is what ends
      // one. Only /api/ responses are inspected: a 401 from some third-party
      // URL the page happens to fetch says nothing about this session.
      const watchForSignOut = (promise, isApi) => isApi
        ? promise.then((response) => {
            if (response.status === 401) sessionEnded()
            return response
          })
        : promise

      window.fetch = (input, init = {}) => {
        let sameOriginApi = false
        try {
          const url = typeof input === 'string' ? input : input?.url || ''
          // Reading the origin to classify a URL, not navigating — useRoute()
          // answers a different question.
          // stx-strict-ignore-next-line window.location
          sameOriginApi = url.startsWith('/api/') || url.startsWith(`${window.location.origin}/api/`)
          if (sameOriginApi && isNativeApp()) {
            const headers = new Headers(init.headers || (typeof input !== 'string' ? input.headers : undefined))
            headers.set('x-ot-native', 'craft')
            return watchForSignOut(nativeFetch(input, { ...init, headers }), true)
          }
        } catch {}
        return watchForSignOut(nativeFetch(input, init), sameOriginApi)
      }
    })()
  </script>
  <script>
    // Sidebar bootstrap — runs before paint so the shell does not jump from
    // expanded to collapsed on the first frame. The theme half of this block
    // moved to `app.colorMode` in config/ui.ts; what is left has no config
    // equivalent, because --ot-sidebar-width lands on document.documentElement,
    // outside every component's markup.
    ;(() => {
      const root = document.documentElement
      try {
        // Pre-paint and pre-runtime: useLocalStorage() does not exist yet, and
        // reading this after hydration would paint the shell expanded and then
        // snap it shut.
        // stx-strict-ignore-next-line window.localStorage
        const sidebarCollapsed = window.localStorage?.getItem('ot.sidebar.collapsed') === 'true'
        root.classList.toggle('ot-sidebar-collapsed', sidebarCollapsed)
        root.dataset.stxSidebarCollapsed = sidebarCollapsed ? 'true' : 'false'
        root.style.setProperty('--ot-sidebar-width', sidebarCollapsed ? '0px' : '286px')
      } catch {}
    })()
  </script>
  <script>window.STX_ROUTER_OPTIONS = { container: '[data-ot-workspace]', viewTransitions: false };</script>
  {{--
    The newsroom runs on two of the paper's four faces: the display serif for
    page headings and the condensed gothic for labels. The body face is
    deliberately NOT loaded here — a workspace is read in short bursts at small
    sizes, where the UI sans is more legible than Baskerville, and each family
    dropped is a request the app shell does not make on every cold load. The
    masthead face is marketing-only.
  --}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Oswald:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/styles/toast.css">
  <link rel="stylesheet" href="/assets/styles/timeline.css">
@endhead

    <div class="grid lg:overflow-hidden grid-cols-1 grid-rows-[auto_minmax(0,1fr)] lg:grid-cols-[var(--ot-sidebar-width,286px)_minmax(0,1fr)] lg:grid-rows-1 min-h-screen min-w-80 lg:h-screen antialiased font-sans text-ink bg-bg duration-200 ease-out transition-[grid-template-columns]" data-ot-app data-ot-shell>
      <AppSidebar />

      <div class="relative lg:overflow-hidden min-w-0 lg:h-screen bg-bg" data-ot-content-shell>
        <button
          class="inline-flex fixed left-3.5 top-3.5 z-[90] items-center justify-center h-9 w-9 text-body hover:text-zinc-900 bg-white/95 hover:bg-white border border-zinc-200/90 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400/60 shadow-[0_8px_28px_rgba(24,31,42,0.12)] backdrop-blur-sm"
          type="button"
          aria-label="Expand sidebar"
          title="Expand sidebar"
          data-sidebar-expand-fab
          data-no-window-drag
        >
          <span class="h-[18px] w-[18px] i-hugeicons-sidebar-right" aria-hidden="true"></span>
        </button>
        <section class="overflow-hidden lg:overflow-y-auto min-h-screen min-w-0 lg:h-screen bg-bg border-t border-zinc-200/80 lg:border-l lg:rounded-tl-[28px] lg:shadow-[-10px_0_36px_rgba(24,31,42,0.08)]" aria-label="The Open Times workspace" data-ot-workspace data-window-drag-region>
          <main class="p-3.5 sm:p-4 min-w-0" data-ot-router>
            @yield('content')
          </main>
        </section>
      </div>
    </div>
    <div id="ot-toast-host" class="flex bottom-6 fixed right-6 z-[100] sm:right-6 flex-col-reverse gap-2.5 max-w-[22rem] w-[calc(100%-2rem)] pointer-events-none" aria-live="polite" aria-relevant="additions"></div>
    <script type="module" src="/assets/scripts/toast.ts"></script>
    <script type="module" src="/assets/scripts/bluesky.ts"></script>
    <script type="module" src="/assets/scripts/linkedin.ts"></script>
    <script type="module" src="/assets/scripts/instagram.ts"></script>
    <script type="module" src="/assets/scripts/threads.ts"></script>
    <script type="module" src="/assets/scripts/social.ts"></script>
    <script type="module" src="/assets/scripts/richtext.ts"></script>
    <script type="module" src="/assets/scripts/analytics.ts"></script>
    <script>
      ;(() => {
        const syncSidebarCollapse = (collapsed) => {
          const shell = document.querySelector('[data-ot-shell]')
          const sidebar = document.querySelector('[data-ot-sidebar]')
          const button = document.querySelector('[data-sidebar-collapse]')
          const collapseIcon = document.querySelector('[data-sidebar-collapse-icon]')
          const expandFab = document.querySelector('[data-sidebar-expand-fab]')

          shell?.style.setProperty('--ot-sidebar-width', collapsed ? '0px' : '286px')
          document.documentElement.style.setProperty('--ot-sidebar-width', collapsed ? '0px' : '286px')
          document.documentElement.classList.toggle('ot-sidebar-collapsed', collapsed)
          document.documentElement.dataset.stxSidebarCollapsed = collapsed ? 'true' : 'false'
          if (shell?.dataset) shell.dataset.sidebarCollapsed = collapsed ? 'true' : 'false'
          sidebar?.classList.remove('opacity-0')
          sidebar?.classList.toggle('px-5', !collapsed)
          sidebar?.classList.toggle('pt-[68px]', !collapsed)
          sidebar?.classList.toggle('pb-5', !collapsed)
          sidebar?.setAttribute('aria-hidden', String(collapsed))
          if (sidebar) {
            sidebar.style.width = collapsed ? '0px' : ''
            sidebar.style.minWidth = collapsed ? '0px' : ''
            sidebar.style.overflow = collapsed ? 'visible' : ''
          }

          document.querySelectorAll('[data-sidebar-expanded]').forEach(element => {
            element.classList.toggle('hidden', collapsed)
          })
          document.querySelectorAll('[data-sidebar-collapsible-content]').forEach(element => {
            element.classList.toggle('hidden', collapsed)
          })

          button?.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar')
          button?.setAttribute('aria-expanded', String(!collapsed))
          if (collapseIcon instanceof SVGElement)
            collapseIcon.style.transform = collapsed ? 'rotate(180deg)' : ''
          else
            collapseIcon?.classList.toggle('rotate-180', collapsed)
          expandFab?.setAttribute('aria-hidden', String(!collapsed))
          window.localStorage?.setItem('ot.sidebar.collapsed', collapsed ? 'true' : 'false')
          window.craft?.window?.setWebSidebarCollapsed?.(collapsed).catch?.(() => {})
          syncNativeShell()
        }

        const bindSidebarCollapse = () => {
          const initial = window.localStorage?.getItem('ot.sidebar.collapsed') === 'true'
          syncSidebarCollapse(initial)

          document.querySelectorAll('[data-sidebar-collapse]').forEach(button => {
            if (button.dataset.bound === 'true') return
            button.dataset.bound = 'true'
            button.addEventListener('click', () => {
              const collapsed = button.getAttribute('aria-expanded') === 'true'
              syncSidebarCollapse(collapsed)
            })
          })

          document.querySelectorAll('[data-sidebar-expand-fab]').forEach(button => {
            if (button.dataset.bound === 'true') return
            button.dataset.bound = 'true'
            button.addEventListener('click', () => syncSidebarCollapse(false))
          })
        }

        const bindShellHistory = () => {
          document.querySelectorAll('[data-shell-back]').forEach(button => {
            if (button.dataset.bound === 'true') return
            button.dataset.bound = 'true'
            button.addEventListener('click', () => window.history.back())
          })
          document.querySelectorAll('[data-shell-forward]').forEach(button => {
            if (button.dataset.bound === 'true') return
            button.dataset.bound = 'true'
            button.addEventListener('click', () => window.history.forward())
          })
        }

        const isNativeShell = () =>
          document.documentElement.classList.contains('has-native-sidebar') ||
          window.craft?.__craft_bridge_loaded === true ||
          !!window.craft?.window ||
          !!window.webkit?.messageHandlers?.craft

        const syncNativeShell = () => {
          const row = document.querySelector('[data-shell-controls-row]')
          const sidebar = document.querySelector('[data-ot-sidebar]')
          if (!row || !sidebar) return
          const collapsed = window.localStorage?.getItem('ot.sidebar.collapsed') === 'true'

          if (isNativeShell()) {
            // Craft draws a sidebar toggle and history arrows beside the window
            // buttons itself, and the window server places them — which is why
            // they line up on the traffic lights' axis and our replicas never
            // did. Drawing our own over them would double every control.
            //
            // This used to be gated on `window.__craftWebChromeControls`, which
            // Craft removed: "Nothing ever read them, and what they claimed was
            // false." The check could never be true, so the hand-drawn branch
            // below ran in the native shell and spent its time guessing at
            // offsets the host already publishes.
            document.querySelectorAll('[data-native-shell-control]').forEach(element => {
              element.classList.add('hidden')
              element.style.display = 'none'
            })
            row.style.display = 'none'
            sidebar.style.paddingTop = '68px'
            return
          }

          if (collapsed) {
            row.style.display = 'none'
            sidebar.style.paddingTop = '0px'
            return
          }

          document.querySelectorAll('[data-native-shell-control]').forEach(element => {
            element.classList.add('hidden')
            element.style.display = 'none'
          })
          row.style.display = ''
          row.removeAttribute('style')
          row.style.removeProperty('position')
          row.style.removeProperty('top')
          row.style.removeProperty('left')
          row.style.removeProperty('z-index')
          sidebar.style.removeProperty('padding-top')
        }

        const bindWindowDragRegions = () => {
          document.querySelectorAll('[data-window-drag-region]').forEach(region => {
            if (region.dataset.dragBound === 'true') return
            region.dataset.dragBound = 'true'
            let dragging = false
            let lastX = 0
            let lastY = 0
            let pendingX = 0
            let pendingY = 0
            let dragFrame = 0

            const flushDrag = () => {
              dragFrame = 0
              const dx = pendingX
              const dy = pendingY
              pendingX = 0
              pendingY = 0
              if (dx || dy) window.craft?.window?.moveBy?.(dx, dy).catch?.(() => {})
            }

            const stopDrag = () => {
              dragging = false
              if (dragFrame) {
                cancelAnimationFrame(dragFrame)
                flushDrag()
              }
            }

            region.addEventListener('pointerdown', event => {
              if (event.button !== 0 || !isNativeShell()) return
              if (event.target.closest('a, button, input, textarea, select, [role="button"], [data-no-window-drag]')) return
              event.preventDefault()
              dragging = true
              lastX = event.screenX
              lastY = event.screenY
              region.setPointerCapture?.(event.pointerId)
            })

            region.addEventListener('pointermove', event => {
              if (!dragging) return
              event.preventDefault()
              const dx = event.screenX - lastX
              const dy = event.screenY - lastY
              lastX = event.screenX
              lastY = event.screenY
              pendingX += dx
              pendingY += dy
              if (!dragFrame) dragFrame = requestAnimationFrame(flushDrag)
            })

            region.addEventListener('pointerup', stopDrag)
            region.addEventListener('pointercancel', stopDrag)
            region.addEventListener('lostpointercapture', stopDrag)
          })
        }

        // Number keys 1-9 jump between pages (the sidebar shows the badges).
        // Bound through stx's useEventListener rather than a raw document
        // listener: it unsubscribes on destroy, so repeated SPA navigations
        // can't stack duplicate handlers. Routing goes through stx `navigate`
        // instead of synthesising a click on a link element.
        const bindKeyboardShortcuts = () => {
          if (window.__opentimesShortcutsBound) return
          window.__opentimesShortcutsBound = true
          const routes = { 1: '/composer', 2: '/queue', 3: '/timeline', 4: '/analytics', 5: '/campaigns', 6: '/listening', 7: '/inbox', 8: '/discover', 9: '/publication', 0: '/blog' }
          window.stx?.useEventListener('keydown', (event) => {
            if (event.metaKey || event.ctrlKey || event.altKey) return
            const target = event.target
            if (target instanceof HTMLElement && target.closest('input, textarea, select, [contenteditable]')) return
            const href = routes[event.key]
            if (!href || window.location.pathname === href) return
            event.preventDefault()
            window.stx.navigate(href)
          }, { target: document })
        }

        // Clicking the already-active destination is a no-op. Apart from
        // avoiding needless work, this prevents page-init success feedback
        // from being replayed when someone repeatedly clicks the same tab.
        const bindIdempotentNavigation = () => {
          if (window.__opentimesIdempotentNavigationBound) return
          window.__opentimesIdempotentNavigationBound = true
          window.stx?.useEventListener('click', (event) => {
            if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
            const link = event.target instanceof Element ? event.target.closest('a[data-stx-link]') : null
            if (!(link instanceof HTMLAnchorElement) || link.target === '_blank' || link.hasAttribute('download')) return
            const destination = new URL(link.href, window.location.href)
            const current = new URL(window.location.href)
            if (destination.origin !== current.origin || destination.pathname !== current.pathname || destination.search !== current.search || destination.hash !== current.hash) return
            event.preventDefault()
            event.stopImmediatePropagation()
          }, { target: document, capture: true })
        }

        bindSidebarCollapse()
        bindShellHistory()
        bindWindowDragRegions()
        bindKeyboardShortcuts()
        bindIdempotentNavigation()
        syncNativeShell()
        // useEventListener() binds for the lifetime of a scope and tears down
        // with it. These five are the opposite: they ARE the app shell's
        // re-binding mechanism across SPA navigations, so they have to outlive
        // every scope on the page. Each bind* is idempotent through a
        // dataset.bound guard, which is what makes re-firing on stx:load safe.
        // stx-strict-ignore-next-line window.addEventListener
        window.addEventListener('stx:load', bindShellHistory)
        // stx-strict-ignore-next-line window.addEventListener
        window.addEventListener('stx:load', bindSidebarCollapse)
        // stx-strict-ignore-next-line window.addEventListener
        window.addEventListener('stx:load', bindWindowDragRegions)
        // stx-strict-ignore-next-line window.addEventListener
        window.addEventListener('stx:load', syncNativeShell)
        // stx-strict-ignore-next-line window.addEventListener
        window.addEventListener('craft:ready', syncNativeShell)
      })()
    </script>
    @stack('scripts')
