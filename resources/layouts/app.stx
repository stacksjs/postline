<script server>
import { workspaceLocale } from '../../app/Support/Localization/workspace'

useHead({ htmlAttrs: { lang: workspaceLocale } })
</script>

@head
  <meta name="color-scheme" content="light dark">
  {{-- The workspace is private: keep every signed-in page and the sign-in page out of search engines, and out of the sitemap, which skips noindex pages. --}}
  <meta name="robots" content="noindex, nofollow">
  <meta name="stx-css-group" content="postline-workspace">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <CsrfScripts />
  <SessionScripts />
  <script>
    // Apply the saved sidebar width before the STX shell hydrates.
    try {
      // stx-strict-ignore-next-line window.localStorage
      if (window.localStorage?.getItem('postline.sidebar.collapsed') === 'true')
        document.documentElement.classList.add('postline-sidebar-collapsed')
    } catch {}
  </script>
  <FontFaces />
  {{-- A view's own stylesheet, declared in the head so the router loads it
      before it swaps the view in: no unstyled first entry, and no other view
      downloads it. --}}
  @yield('styles')
@endhead

    <WorkspaceSkipLink />
    <WorkspaceShell>
      @yield('content')
    </WorkspaceShell>
    <StxToast position="bottom-center" />
    {{-- The editor and the analytics chart load with the view that uses them. --}}
    <script type="module" src="/assets/scripts/view-code.ts"></script>
    @stack('scripts')
