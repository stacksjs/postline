<script server>
import { workspaceLocale, workspaceNavigation, workspaceRoutePath, workspaceShellText, workspaceText } from '../../app/Support/Localization/workspace'

export const shellText = workspaceShellText
export const language = workspaceLocale
export const routeLabels = Object.fromEntries(workspaceNavigation.map(({ href, label }) => [href, label]))
const currentPath = workspaceRoutePath(typeof requestContext === 'undefined' ? '/' : requestContext.url())
export const currentLabel = routeLabels[currentPath] ?? ''
export const sidebarLabels = { expand: shellText.expandSidebar, collapse: shellText.collapseSidebar }
export const channelsLabel = workspaceText('workspace.navigation.channels')
export const settingsLabel = workspaceText('workspace.navigation.settings')
</script>

<script client>
import type { CraftBridgeAPI } from 'craft-native'
import { bindDesktopAlerts } from '../functions/desktop-alerts'
import { showNotification } from '../functions/notification'

type WorkspaceBridge = CraftBridgeAPI & {
  window: CraftBridgeAPI['window'] & {
    setAppearance?: (mode: 'light' | 'dark' | 'system') => Promise<void>
  }
  settings?: { onOpen: (handler: () => void) => () => void }
}

const shell = useRef('shell')
const profile = useRef<HTMLDetailsElement>('profile')
const profileTrigger = useRef<HTMLElement>('profileTrigger')
const collapsed = useLocalStorage('postline.sidebar.collapsed', false)
const desktop = useNativeDesktop()
const native = state(Boolean(desktop()))
const bridge = () => desktop() as WorkspaceBridge | null
const colorMode = useColorMode()
const labels = {{ routeLabels }}
const sidebar = {{ sidebarLabels }}
const activeLabel = state({{ currentLabel }})
const account = workspaceBootstrapQuery()
const workspaceName = derived(() => account.data()?.workspace.workspaceName || 'Postline')
const ownerName = derived(() => account.data()?.workspace.name.trim() || '')
const ownerInitial = derived(() => Array.from(ownerName())[0]?.toLocaleUpperCase() ?? '')
const historyKey = 'postline.workspace.history'
const historyPosition = state({ index: 0, end: 0 })
let settingsChannel: BroadcastChannel | null = null
let unbindSettingsMenu: (() => void) | undefined
let unbindWorkspaceChanges: (() => void) | undefined
let unbindDesktopAlerts: (() => void) | undefined
const offlineToastId = 'postline-offline'

function showOfflineNotice() {
  showNotification({
    id: offlineToastId,
    tone: 'info',
    durationMs: 0,
    title: 'You are offline',
    message: 'Changes made now will not save until the connection is back. Scheduled posts still go out on time.',
  })
}

useEventListener('offline', showOfflineNotice)
useEventListener('online', () => {
  toast.dismiss(offlineToastId)
  showNotification({ tone: 'success', durationMs: 3000, title: 'Back online', message: 'Postline is connected again.' })
})

function toggleSidebar() {
  collapsed.update(value => !value)
}

// History entries keep their position through Back, Forward and reload.
// The STX router writes its own state first, so merge our position into it.
function syncHistory(event?: Event) {
  const view = shell.current?.ownerDocument.defaultView
  if (!view) return
  const history = view.history
  const entry = history.state?.[historyKey]
  const knownEntry = typeof entry === 'number'
  const direction = event instanceof CustomEvent ? event.detail?.direction : undefined
  const pushed = !knownEntry && direction === 'push'
  let index = knownEntry ? entry : 0
  if (!knownEntry && direction) index = historyPosition().index + Number(pushed)
  let end = historyPosition().end
  if (pushed || (!event && !knownEntry)) end = index
  try {
    if (!event && knownEntry) end = Number(view.sessionStorage.getItem(historyKey)) || 0
    if (!knownEntry) history.replaceState({ ...history.state, [historyKey]: index }, '')
    view.sessionStorage.setItem(historyKey, String(Math.max(index, end)))
  }
  catch { /* The toolbar can still track navigation for the open document. */ }
  historyPosition.set({ index, end: Math.max(index, end) })
}

function closeProfile(restoreFocus = false) {
  if (!profile.current?.open) return
  profile.current.open = false
  if (restoreFocus) profileTrigger.current?.focus()
}

function syncRoute(event?: Event) {
  const path = useRoute().path.replace(/\/$/, '')
  activeLabel.set(labels[path] ?? '')
  closeProfile()
  syncHistory(event)
}

useEventListener('stx:navigate', syncRoute)
useEventListener('popstate', syncHistory)
useEventListener('pointerdown', (event) => {
  if (event.target instanceof Node && !profile.current?.contains(event.target)) closeProfile()
})

function openSettings() {
  const origin = shell.current?.ownerDocument.location.origin
  const windowApi = bridge()?.window
  if (!origin || !windowApi?.open) {
    navigate('/settings', { reload: true })
    return
  }
  void windowApi.open({
    name: 'settings',
    url: `${origin}/settings`,
    title: 'Settings',
    width: 715,
    height: 640,
    minWidth: 715,
    minHeight: 420,
    titlebarHidden: true,
    chromeControls: false,
    persistentStorage: true,
  }).catch(() => navigate('/settings', { reload: true }))
}

function handleLink(event: MouseEvent) {
  if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
  const target = event.target instanceof Element ? event.target.closest('a[data-stx-link]') : null
  if (!(target instanceof HTMLAnchorElement) || target.target === '_blank' || target.hasAttribute('download')) return
  if (profile.current?.contains(target)) closeProfile()
  if (target.getAttribute('href') === '/settings') {
    event.preventDefault()
    event.stopPropagation()
    openSettings()
    return
  }
  // The router does not need to remount a view when its link is clicked again.
  if (target.href === target.ownerDocument.location.href) {
    event.preventDefault()
    event.stopPropagation()
  }
}

function receiveSettings(event: MessageEvent) {
  const message = event.data
  if (message?.type === 'navigate' && typeof message.path === 'string') {
    const location = shell.current?.ownerDocument.location
    if (!location || !message.path.startsWith('/')) return
    const next = new URL(message.path, location.href)
    if (next.origin !== location.origin) return
    navigate(next.pathname + next.search + next.hash)
    void bridge()?.window?.focus?.()
  }
  if (message?.type === 'theme' && ['light', 'dark', 'system'].includes(message.pref)) {
    colorMode.set(message.pref)
    void bridge()?.window?.setAppearance?.(message.pref)
  }
}

desktop.onReady((host) => {
  native.set(true)
  unbindSettingsMenu = (host as WorkspaceBridge).settings?.onOpen(openSettings)
  unbindDesktopAlerts = bindDesktopAlerts(host)
})

onMount(() => {
  syncRoute()
  if (shell.current?.ownerDocument.defaultView?.navigator.onLine === false) showOfflineNotice()
  unbindWorkspaceChanges = bindWorkspaceChanges()
  if (typeof BroadcastChannel !== 'function') return
  settingsChannel = new BroadcastChannel('postline:settings')
  settingsChannel.addEventListener('message', receiveSettings)
})

onDestroy(() => {
  unbindWorkspaceChanges?.()
  unbindSettingsMenu?.()
  unbindDesktopAlerts?.()
  settingsChannel?.close()
})
</script>

<template>
  <div
    class="grid lg:overflow-hidden grid-cols-1 lg:grid-cols-[var(--postline-sidebar-width)_minmax(0,1fr)] min-h-dvh min-w-80 antialiased font-sans text-ink"
    data-postline-app
    data-postline-shell
    :data-sidebar-collapsed="collapsed() ? 'true' : 'false'"
    :data-shell-native="native() ? 'true' : 'false'"
    ref="shell"
    @click.capture="handleLink($event)"
  >
    <AppSidebar :collapsed="collapsed()" />

    <section class="flex flex-col min-h-0 min-w-0 bg-bg" lang="{{ language }}" aria-label="{{ shellText.workspaceRegion }}" data-postline-workspace>
      <header class="grid sticky top-0 z-20 gap-2 grid-cols-[minmax(0,1fr)_auto] items-center shrink-0 lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] bg-bg" data-workspace-toolbar data-craft-drag>
        <div class="hidden lg:flex gap-1 items-center" data-command-ignore>
          <button
            class="grid place-items-center size-8 text-muted hover:text-ink hover:bg-panel-2 rounded-lg"
            type="button"
            aria-label="{{ shellText.collapseSidebar }}"
            :aria-label="collapsed() ? sidebar.expand : sidebar.collapse"
            :title="collapsed() ? sidebar.expand : sidebar.collapse"
            aria-controls="workspace-sidebar"
            :aria-expanded="!collapsed()"
            data-sidebar-collapse
            data-craft-no-drag
            @click="toggleSidebar"
          >
            <span class="size-[17px] i-hugeicons-sidebar-left" aria-hidden="true"></span>
          </button>
          <span class="mx-1 h-3.5 w-px bg-line" aria-hidden="true"></span>
          <button class="grid place-items-center size-7 text-muted enabled:hover:text-ink enabled:hover:bg-panel-2 rounded-lg disabled:opacity-45" type="button" aria-label="{{ shellText.back }}" title="{{ shellText.back }}" disabled :disabled="historyPosition().index === 0" data-workspace-back data-craft-no-drag @click="goBack()">
            <span class="size-4 i-hugeicons-arrow-left-01" aria-hidden="true"></span>
          </button>
          <button class="grid place-items-center size-7 text-muted enabled:hover:text-ink enabled:hover:bg-panel-2 rounded-lg disabled:opacity-45" type="button" aria-label="{{ shellText.forward }}" title="{{ shellText.forward }}" disabled :disabled="historyPosition().index >= historyPosition().end" data-workspace-forward data-craft-no-drag @click="goForward()">
            <span class="size-4 i-hugeicons-arrow-right-01" aria-hidden="true"></span>
          </button>
        </div>

        <div class="flex gap-1.5 items-center min-w-0 text-ui" data-workspace-location>
          <span class="hidden lg:inline text-muted">Postline</span>
          <span class="hidden lg:inline-block shrink-0 size-3 text-muted i-hugeicons-arrow-right-01" aria-hidden="true"></span>
          <span class="font-semibold text-ink truncate" :text="activeLabel()">{{ currentLabel }}</span>
        </div>

        <div class="flex gap-1 items-center justify-end min-w-0" data-craft-no-drag>
          <WorkspaceCommands compact="true" />
          <details class="relative min-w-0" ref="profile" data-workspace-profile data-command-ignore @keydown.escape="closeProfile(true)">
            <summary class="flex gap-1.5 items-center px-1.5 min-h-9 lg:min-h-8 hover:bg-panel-2 rounded-lg cursor-pointer" ref="profileTrigger">
              <span class="grid place-items-center shrink-0 size-6 font-semibold text-body text-xs bg-panel-3 rounded-full" aria-hidden="true">
                <span x-show="ownerInitial()" :text="ownerInitial()"></span>
                <span class="size-3.5 i-hugeicons-user-circle" x-show="!ownerInitial()"></span>
              </span>
              <span class="sr-only">{{ shellText.account }}</span>
              <span class="hidden lg:block w-28 text-body text-ui truncate" :text="ownerName()"></span>
              <span class="hidden sm:inline-block shrink-0 size-3 text-muted i-hugeicons-arrow-down-01" aria-hidden="true"></span>
            </summary>
            <div class="grid absolute right-0 top-full gap-0.5 mt-1 p-1 min-w-40 bg-panel border border-line rounded-xl shadow-lg">
              <p class="m-0 px-2 py-1 text-muted text-xs truncate" :text="workspaceName()">Postline</p>
              <a class="flex gap-2 items-center px-2 py-1.5 text-ui hover:bg-panel-2 rounded-lg" href="/accounts" data-stx-link>
                <span class="size-4 i-hugeicons-share-08" aria-hidden="true"></span>
                {{ channelsLabel }}
              </a>
              <a class="flex gap-2 items-center px-2 py-1.5 text-ui hover:bg-panel-2 rounded-lg" href="/settings" data-stx-link data-no-router>
                <span class="size-4 i-hugeicons-settings-02" aria-hidden="true"></span>
                {{ settingsLabel }}
              </a>
            </div>
          </details>
        </div>
      </header>
      <div class="flex flex-1 flex-col min-h-0 min-w-0" data-postline-router>
        <main id="workspace-content" lang="en" class="lg:overflow-y-auto flex-1 px-3.5 py-4 sm:p-6 min-h-0 min-w-0" tabindex="-1" data-stx-scroll="workspace">
          <slot />
        </main>
      </div>
    </section>
  </div>
</template>
