<script client>
import type { CraftBridgeAPI } from 'craft-native'
import { bindDesktopAlerts } from '../functions/desktop-alerts'
import { showNotification } from '../functions/notification'

type WorkspaceBridge = CraftBridgeAPI & {
  window: CraftBridgeAPI['window'] & {
    setWebSidebarCollapsed?: (collapsed: boolean) => Promise<void>
    setAppearance?: (mode: 'light' | 'dark' | 'system') => Promise<void>
  }
  settings?: { onOpen: (handler: () => void) => () => void }
}

const shell = useRef('shell')
const collapsed = useLocalStorage('postline.sidebar.collapsed', false)
const desktop = useNativeDesktop()
const bridge = state<WorkspaceBridge | null>(desktop() as WorkspaceBridge | null)
const colorMode = useColorMode()
let settingsChannel: BroadcastChannel | null = null
let unbindSettingsMenu: (() => void) | undefined
let unbindWorkspaceChanges: (() => void) | undefined
let unbindDesktopAlerts: (() => void) | undefined
const offlineToastId = 'postline-offline'

function showOfflineNotice() {
  showNotification({
    id: offlineToastId,
    tone: 'info',
    durationMs: 0,
    title: 'You are offline',
    message: 'Changes made now will not save until the connection is back. Scheduled posts still go out on time.',
  })
}

useEventListener('offline', showOfflineNotice)
useEventListener('online', () => {
  toast.dismiss(offlineToastId)
  showNotification({ tone: 'success', durationMs: 3000, title: 'Back online', message: 'Postline is connected again.' })
})

function toggleSidebar() {
  collapsed.set(!collapsed())
}

effect(() => {
  const value = collapsed()
  void bridge()?.window?.setWebSidebarCollapsed?.(value).catch(() => {})
})

function openSettings() {
  const origin = shell.current?.ownerDocument.location.origin
  const windowApi = bridge()?.window
  if (!origin || !windowApi?.open) {
    navigate('/settings')
    return
  }
  void windowApi.open({
    name: 'settings',
    url: `${origin}/settings`,
    title: 'Settings',
    width: 715,
    height: 640,
    minWidth: 715,
    minHeight: 420,
    titlebarHidden: true,
    chromeControls: false,
    persistentStorage: true,
  }).catch(() => navigate('/settings'))
}

function handleLink(event: MouseEvent) {
  if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
  const target = event.target instanceof Element ? event.target.closest('a[data-stx-link]') : null
  if (!(target instanceof HTMLAnchorElement) || target.target === '_blank' || target.hasAttribute('download')) return
  if (target.getAttribute('href') === '/settings' && bridge()?.window?.open) {
    event.preventDefault()
    event.stopPropagation()
    openSettings()
    return
  }
  // The router does not need to remount a view when its link is clicked again.
  if (target.href === target.ownerDocument.location.href) {
    event.preventDefault()
    event.stopPropagation()
  }
}

function startWindowDrag(event: PointerEvent) {
  const windowApi = bridge()?.window
  if (!windowApi?.startDrag || event.button !== 0 || !(event.target instanceof Element)) return
  if (!event.target.closest('[data-window-drag-region]')) return
  if (event.target.closest('a, button, input, textarea, select, label, summary, dialog, [contenteditable], [role="button"], [data-no-window-drag]')) return
  event.preventDefault()
  void windowApi.startDrag().catch(() => {})
}

function receiveSettings(event: MessageEvent) {
  const message = event.data
  if (message?.type === 'navigate' && typeof message.path === 'string') {
    const location = shell.current?.ownerDocument.location
    if (!location || !message.path.startsWith('/')) return
    const next = new URL(message.path, location.href)
    if (next.origin !== location.origin) return
    navigate(next.pathname + next.search + next.hash)
    void bridge()?.window?.focus?.()
  }
  if (message?.type === 'theme' && ['light', 'dark', 'system'].includes(message.pref)) {
    colorMode.set(message.pref)
    void bridge()?.window?.setAppearance?.(message.pref)
  }
}

desktop.onReady((host) => {
  bridge.set(host as WorkspaceBridge)
  unbindSettingsMenu = (host as WorkspaceBridge).settings?.onOpen(openSettings)
  unbindDesktopAlerts = bindDesktopAlerts(host)
})

onMount(() => {
  if (shell.current?.ownerDocument.defaultView?.navigator.onLine === false) showOfflineNotice()
  unbindWorkspaceChanges = bindWorkspaceChanges()
  if (typeof BroadcastChannel !== 'function') return
  settingsChannel = new BroadcastChannel('postline:settings')
  settingsChannel.addEventListener('message', receiveSettings)
})

onDestroy(() => {
  unbindWorkspaceChanges?.()
  unbindSettingsMenu?.()
  unbindDesktopAlerts?.()
  settingsChannel?.close()
})
</script>

<template>
  <div
    class="grid lg:overflow-hidden grid-cols-1 lg:grid-cols-[var(--postline-sidebar-width,286px)_minmax(0,1fr)] min-h-screen min-w-80 lg:h-screen antialiased font-sans text-ink bg-bg"
    data-postline-app
    data-postline-shell
    :data-sidebar-collapsed="collapsed() ? 'true' : 'false'"
    :data-shell-native="bridge() ? 'true' : 'false'"
    ref="shell"
    @click.capture="handleLink($event)"
    @pointerdown="startWindowDrag($event)"
  >
    <AppSidebar :collapsed="collapsed()" @toggle-sidebar="toggleSidebar" />

    <div class="relative lg:overflow-hidden min-w-0 lg:h-screen bg-bg" data-postline-content-shell>
      <button
        class="inline-flex fixed left-3.5 top-3.5 z-[90] items-center justify-center h-9 w-9 text-body hover:text-ink bg-glass-strong hover:bg-raised border border-line rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus shadow-lg backdrop-blur-sm"
        type="button"
        aria-label="Expand sidebar"
        title="Expand sidebar"
        data-sidebar-expand-fab
        data-no-window-drag
        @click="collapsed.set(false)"
      >
        <span class="h-[18px] w-[18px] i-hugeicons-sidebar-right" aria-hidden="true"></span>
      </button>
      <section class="overflow-hidden lg:overflow-y-auto min-h-screen min-w-0 lg:h-screen bg-bg border-line border-t lg:border-l lg:rounded-tl-[28px] lg:shadow-[-10px_0_36px_var(--workspace-shadow)]" aria-label="Postline workspace" data-postline-workspace data-postline-router data-window-drag-region>
        <div class="flex justify-end pt-3.5 px-3.5 sm:pt-4 sm:px-4">
          <WorkspaceCommands />
        </div>
        <main id="workspace-content" class="p-3.5 sm:p-4 min-w-0" tabindex="-1">
          <slot />
        </main>
      </section>
    </div>
  </div>
</template>
