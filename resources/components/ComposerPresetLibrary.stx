<script server>
import { workspaceLocale, workspaceSavedText } from '../../app/Support/Localization/workspace'

export const savedText = workspaceSavedText
export const savedTextMessages = savedText.client
export const savedTextLocale = workspaceLocale
</script>

<script client>
import type { ComposerPreset, ComposerPresetKind } from '../../app/Services/ComposerPresetService'

const disabled = useReactiveProp('disabled', false)
const dialog = useRef<HTMLDialogElement>('library')
const nameInput = useRef<HTMLInputElement>('nameInput')
const selection = useRef<HTMLSelectElement>('selection')
const newButton = useRef<HTMLButtonElement>('newButton')
const editButton = useRef<HTMLButtonElement>('editButton')
const deleteButton = useRef<HTMLButtonElement>('deleteButton')
const cancelDelete = useRef<HTMLButtonElement>('cancelDelete')
const title = useId('saved-text')
const emit = defineEmits(['insert'])
const items = state<ComposerPreset[]>([])
const selectedId = state('')
const selected = derived(() => items().find(item => item.uuid === selectedId()))
const busy = state(false)
const message = state('')
const mode = state<'browse' | 'edit' | 'delete'>('browse')
const id = state('')
const name = state('')
const body = state('')
const kind = state<ComposerPresetKind>('snippet')
const copy = {{ savedTextMessages }}
const locale = {{ savedTextLocale }}

type SavedText = typeof import('../assets/scripts/composer-saved-text')
async function run(work: (api: SavedText) => Promise<void>) {
  if (busy()) return false
  message.set('')
  busy.set(true)
  try {
    const path = '/assets/scripts/composer-saved-text.ts'
    await work(await import(path))
    return true
  }
  catch (error) {
    message.set(error instanceof Error ? error.message : String(error))
    return false
  }
  finally { busy.set(false) }
}

function focusControl(control: HTMLElement | null | undefined) {
  void nextTick(() => {
    if (dialog.current?.open) control?.focus()
  })
}

function browse(control: HTMLElement | null | undefined) {
  message.set('')
  mode.set('browse')
  focusControl(control)
}

function open() {
  if (disabled()) return
  mode.set('browse')
  dialog.current?.showModal()
  void run(async (api) => {
    const data = await api.loadSavedText(locale)
    items.set(data)
    if (!selected()) selectedId.set(data[0]?.uuid || '')
  })
}

function edit(item?: ComposerPreset) {
  id.set(item?.uuid || '')
  kind.set(item?.kind || 'snippet')
  name.set(item?.name || '')
  body.set(item?.body || '')
  message.set('')
  mode.set('edit')
  focusControl(nameInput.current)
}

async function save(submitter: HTMLElement | null) {
  const stored = await run(async (api) => {
    const saved = await api.storeSavedText({ uuid: id(), name: name(), kind: kind(), body: body() }, items(), locale)
    items.set(saved.items)
    selectedId.set(saved.uuid)
  })
  if (mode() !== 'edit') return
  if (stored) browse(selection.current)
  else focusControl(submitter)
}

function confirmDelete() {
  message.set('')
  mode.set('delete')
  focusControl(cancelDelete.current)
}

async function remove() {
  const item = selected()
  if (!item) return
  const removed = await run(async (api) => {
    items.set(await api.deleteSavedText(item.uuid, items(), locale))
    selectedId.set(items()[0]?.uuid || '')
  })
  if (mode() !== 'delete') return
  if (removed) browse(selected() ? selection.current : newButton.current)
  else focusControl(cancelDelete.current)
}

function insert() {
  const item = selected()
  if (!item || disabled()) return
  dialog.current?.close()
  emit('insert', item)
}
</script>

<template>
  <div>
    <button class="px-3 h-9 font-medium text-ink text-ui bg-panel hover:bg-hover border border-line rounded-lg" type="button" aria-haspopup="dialog" :disabled="disabled()" @click="open" data-composer-saved-text>{{ savedText.title }}</button>
    <dialog class="m-auto p-5 max-h-[85vh] max-w-md w-11/12 text-ink bg-panel backdrop:bg-black/40 border border-line rounded-2xl shadow-xl" role="dialog" :aria-labelledby="title" ref="library" data-saved-text-library>
      <header class="flex gap-3 items-center justify-between mb-3">
        <h2 class="m-0 font-semibold text-base text-ink" :id="title">{{ savedText.title }}</h2>
        <form method="dialog"><button class="text-info text-ui" type="submit">{{ savedText.close }}</button></form>
      </header>

      <p class="mb-2 text-danger text-ui" role="alert" x-show="message()" :text="message()"></p>
      <p class="text-muted text-ui" role="status" x-show="busy()">{{ savedText.working }}</p>

      <div class="grid gap-3" x-show="mode() === 'browse'">
        <label class="grid gap-1 text-ui" x-show="items().length">
          {{ savedText.savedItem }}
          <select class="px-2 h-9 min-w-0 text-ink bg-panel-2 border border-line rounded-lg" x-model="selectedId" :disabled="busy()" ref="selection" data-saved-text-select>
            <option x-for="item in items()" :key="item.uuid" :value="item.uuid" :text="item.name + ' · ' + copy.kinds[item.kind]"></option>
          </select>
        </label>
        <p class="m-0 text-muted text-ui" x-show="!busy() && !message() && !items().length">{{ savedText.empty }}</p>
        <p class="overflow-auto m-0 p-2 max-h-32 break-words text-ui whitespace-pre-wrap bg-panel-2 rounded-lg" x-show="selected()" :text="selected()?.body || ''"></p>
        <div class="flex flex-wrap gap-3 items-center text-ui">
          <button class="px-3 h-8 font-semibold text-on-accent bg-accent rounded-lg" type="button" :disabled="busy() || !selected()" x-show="selected()" @click="insert" data-saved-text-insert>{{ savedText.insert }}</button>
          <button class="text-info" type="button" :disabled="busy()" ref="newButton" @click="edit()" data-saved-text-new>{{ savedText.newItem }}</button>
          <button class="text-info" type="button" :disabled="busy() || !selected()" x-show="selected()" ref="editButton" @click="edit(selected())" data-saved-text-edit>{{ savedText.edit }}</button>
          <button class="text-danger" type="button" :disabled="busy() || !selected()" x-show="selected()" ref="deleteButton" @click="confirmDelete" data-saved-text-delete>{{ savedText.deleteLabel }}</button>
        </div>
      </div>

      <form class="grid gap-3 text-ui" x-show="mode() === 'edit'" @submit.prevent="save($event.submitter)" data-saved-text-form>
        <label class="grid gap-1">
          {{ savedText.type }}
          <select class="px-2 h-9 text-ink bg-panel-2 border border-line rounded-lg" x-model="kind" name="kind">
            <option value="snippet">{{ savedText.client.kinds.snippet }}</option>
            <option value="template">{{ savedText.client.kinds.template }}</option>
            <option value="hashtags">{{ savedText.client.kinds.hashtags }}</option>
          </select>
        </label>
        <label class="grid gap-1">{{ savedText.name }} <input class="px-2 h-9 text-ink bg-panel-2 border border-line rounded-lg" type="text" x-model="name" name="name" maxlength="80" ref="nameInput" required></label>
        <label class="grid gap-1">{{ savedText.text }} <textarea class="p-2 min-h-24 text-ink bg-panel-2 border border-line rounded-lg" x-model="body" name="body" maxlength="10000" required></textarea></label>
        <p class="m-0 text-muted text-xs" x-show="kind() === 'hashtags'">{{ savedText.hashtagHelp }}</p>
        <div class="flex gap-3 items-center">
          <button class="px-3 h-8 font-semibold text-on-accent bg-accent rounded-lg" type="submit" :disabled="busy()">{{ savedText.save }}</button>
          <button class="text-info" type="button" :disabled="busy()" @click="browse(id() ? editButton.current : newButton.current)">{{ savedText.cancel }}</button>
        </div>
      </form>

      <div class="grid gap-3 text-ui" x-show="mode() === 'delete'">
        <p class="m-0" :id="title + '-delete'" :text="copy.confirmDelete.replace('{name}', () => selected()?.name || '')"></p>
        <div class="flex gap-3 items-center">
          <button class="text-danger" type="button" :disabled="busy()" @click="remove" data-saved-text-confirm-delete>{{ savedText.deleteItem }}</button>
          <button class="text-info" type="button" :disabled="busy()" :aria-describedby="title + '-delete'" ref="cancelDelete" @click="browse(deleteButton.current)">{{ savedText.cancel }}</button>
        </div>
      </div>
    </dialog>
  </div>
</template>
