<script server cache>
import { workspaceInstagramPagePickerText, workspaceLocale } from '../../app/Support/Localization/workspace'

export const instagramPagePickerText = workspaceInstagramPagePickerText
export const instagramPagePickerClient = { locale: workspaceLocale, messages: workspaceInstagramPagePickerText }
</script>

<script client>
import { createI18n } from '@stacksjs/i18n/client'
import { requestJson } from '../functions/postline-client'

const { locale: language, messages: copy } = {{ instagramPagePickerClient }}
const words = createI18n({ locale: language, messages: { [language]: copy } })

type AuthorizedPage = { pageId: string, pageName?: string, username?: string, igUserId: string }

const route = useRoute()
const instagramState = route.query.instagram === 'choose' && typeof route.query.instagram_state === 'string'
  ? route.query.instagram_state
  : ''
const authorizedPages = state<AuthorizedPage[]>([])
const selectedPage = state('')
const pickerWaiting = state(Boolean(instagramState))
const pickerError = state('')
const pageInput = useRef('pageInput')
const endpoint = '/api/postline/instagram/pages'

onMount(async () => {
  if (!instagramState) return
  try {
    const { data } = await requestJson(`${endpoint}?state=${encodeURIComponent(instagramState)}`, { cache: 'no-store' }, copy.loadFailed)
    authorizedPages.set(data)
    if (data.length === 1) selectedPage.set(data[0].pageId)
    nextTick(() => pageInput.current?.focus())
  }
  catch (error) {
    pickerError.set(error instanceof Error ? error.message : copy.loadFailed)
  }
  finally {
    pickerWaiting.set(false)
  }
})

async function completePageSelection(cancel = false) {
  if (!instagramState || pickerWaiting() || (!cancel && !selectedPage())) return
  pickerWaiting.set(true)
  pickerError.set('')
  try {
    await requestJson(endpoint, {
      method: 'POST',
      body: JSON.stringify({ state: instagramState, ...(cancel ? { cancel: true } : { page_id: selectedPage() }) }),
    }, copy.connectFailed)
    navigate(cancel ? '/accounts' : '/accounts?instagram=connected', { reload: true, replace: true })
  }
  catch (error) {
    pickerError.set(error instanceof Error ? error.message : copy.connectFailed)
  }
  finally {
    pickerWaiting.set(false)
  }
}
</script>

<template>
  <section :if="instagramState" aria-labelledby="instagram-page-choice-title">
    <Card padding="sm" className="shadow-sm">
      <form class="grid gap-3" @submit.prevent="completePageSelection()" :aria-busy="pickerWaiting()">
        <h2 class="m-0 font-semibold text-ink text-sm" id="instagram-page-choice-title">{{ instagramPagePickerText.choose }}</h2>
        <p class="m-0 text-body text-ui">{{ instagramPagePickerText.description }}</p>
        <div class="grid gap-1 max-w-md w-full" :show="authorizedPages().length">
          <label class="font-medium text-ink text-ui" for="instagram-page-choice">{{ instagramPagePickerText.label }}</label>
          <select class="px-2.5 min-h-9 w-full text-ink text-ui bg-panel border border-line rounded-lg"
            id="instagram-page-choice" ref="pageInput" :disabled="pickerWaiting()" :value="selectedPage()" @change="selectedPage.set($event.target.value)">
            <option value="">{{ instagramPagePickerText.placeholder }}</option>
            <option x-for="page in authorizedPages()" :key="page.pageId" :value="page.pageId"
              :text="(page.pageName || words.t('pageId', { id: page.pageId })) + ' · ' + (page.username ? '@' + page.username : page.igUserId)"></option>
          </select>
        </div>
        <p :show="pickerError()" :text="pickerError()" role="alert" class="m-0 text-danger text-ui"></p>
        <p :show="pickerWaiting() && !authorizedPages().length" role="status" class="m-0 text-body text-ui">{{ instagramPagePickerText.loading }}</p>
        <div class="flex flex-wrap gap-2">
          <Button type="submit" variant="primary" size="sm" :disabled="pickerWaiting() || !selectedPage()">{{ instagramPagePickerText.connect }}</Button>
          <Button type="button" variant="secondary" size="sm" :disabled="pickerWaiting()" @click="completePageSelection(true)">{{ instagramPagePickerText.cancel }}</Button>
        </div>
      </form>
    </Card>
  </section>
</template>
