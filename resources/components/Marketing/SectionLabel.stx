<script server>
import { defineProps, withDefaults } from 'stx'

interface SectionLabelProps {
  /** Two-digit index, e.g. "02". */
  index: string
  /** Short label following the index, e.g. "Queue". */
  label: string
  /** Set on the one dark section, where muted grey has too little contrast. */
  onDark?: boolean
}

const { index, label, onDark } = withDefaults(
  defineProps<SectionLabelProps>(),
  { onDark: false },
)
</script>

<template>
  <!--
    A section head, set the way a newspaper sets one: a rule, then the section
    number and name in condensed caps. The `kicker` class carries the face and
    the letterspacing; `onDark` only has to override the colour.
  -->
  <p class="flex gap-3 items-center m-0 kicker {{ onDark ? 'text-on-accent/60' : '' }}">
    <span class="tabular-nums">{{ index }}</span>
    <span class="h-px w-6 {{ onDark ? 'bg-on-accent/40' : 'bg-accent' }}" aria-hidden="true"></span>
    <span>{{ label }}</span>
  </p>
</template>
