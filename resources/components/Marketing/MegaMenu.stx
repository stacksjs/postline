<style>
  /* The panel is positioned against the header, so the trigger only needs to
    own the hover/focus state. */
  .menu-item { position: static; }

  .menu-panel {
    position: absolute;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    /* Motivated motion: the panel drops from the bar it belongs to, so it reads
      as attached to the item that opened it. */
    transition:
      opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0.18s;
  }

  .menu-item:hover .menu-panel,
  .menu-item:focus-within .menu-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .menu-chevron {
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-item:hover .menu-chevron,
  .menu-item:focus-within .menu-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-chevron {
      transition: none;
      transform: none;
    }
  }
</style>
