<template>
  <!--
    Email capture, posting to the framework's SubscriberEmailAction. That action
    already owns the hard parts: per-IP rate limiting, dedupe against the
    subscribers unique index, and the confirmation mail. This is the form.

    Behaviour is bound from an inline script by data attribute rather than stx
    client directives: directives are stripped from components rendered through
    a layout, which would leave the form inert with no visible sign of it.
  -->
  <!--
    The subscription box a paper prints at the foot of the sheet: ruled off,
    headed like a coupon, and asking for one thing.
  -->
  <section class="bg-panel-2 border-ink border-y-2" aria-labelledby="subscribe-heading" data-subscribe>
    <div class="grid gap-8 lg:gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] mx-auto px-6 py-14 max-w-[1400px]">
      <div class="max-w-[46ch]">
        <p class="m-0 kicker">Subscription coupon</p>
        <h2 id="subscribe-heading" class="m-0 mt-3 leading-[1.05] text-3xl text-ink sm:text-4xl">
          Hear when the next edition ships
        </h2>
        <p class="m-0 mt-3 leading-relaxed text-body">
          Occasional notes on releases and what changed — set and sent with The Open Times itself. No drip sequence, and one click to leave.
        </p>
      </div>

      <div class="lg:pt-2">
        <form class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto]" data-subscribe-form novalidate>
          <div class="grid gap-1.5">
            <label class="folio" for="subscribe-email">Email address</label>
            <input
              id="subscribe-email"
              class="px-3.5 h-12 text-ink text-sm bg-panel border border-ink outline-none focus:ring-2 focus:ring-accent/30"
              type="email"
              name="email"
              autocomplete="email"
              placeholder="you@example.com"
              aria-describedby="subscribe-status"
              data-subscribe-email
              required
            >
          </div>

          <div class="flex sm:items-end">
            <button
              class="inline-flex items-center justify-center px-6 h-12 w-full sm:w-auto text-sm disabled:opacity-60 ink-button"
              type="submit"
              data-subscribe-submit
            >
              Subscribe
            </button>
          </div>

          <!-- Reserved line: the message lands in space already occupied, so
              submitting never shifts the section under the reader. -->
          <p
            id="subscribe-status"
            class="sm:col-span-2 m-0 min-h-5 byline"
            role="status"
            aria-live="polite"
            data-subscribe-status
          ></p>
        </form>
      </div>
    </div>
  </section>

  <script>
    ;(() => {
      const root = document.querySelector('[data-subscribe]')
      if (!root) return

      const form = root.querySelector('[data-subscribe-form]')
      const input = root.querySelector('[data-subscribe-email]')
      const submit = root.querySelector('[data-subscribe-submit]')
      const status = root.querySelector('[data-subscribe-status]')

      // Rebuilt rather than toggled so the class list always matches the one on
      // the server-rendered element — `byline` carries the face, and dropping it
      // here would make the status line change typeface on first submit.
      const say = (text, tone) => {
        status.textContent = text
        status.className = `sm:col-span-2 m-0 min-h-5 byline ${
          tone === 'error' ? 'text-accent' : tone === 'ok' ? 'text-ink' : 'text-muted'
        }`
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        const email = (input.value || '').trim()

        // Validate before the request so an obvious typo does not spend one of
        // the ten attempts the endpoint allows per minute.
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          say('Enter a valid email address.', 'error')
          input.focus()
          return
        }

        submit.disabled = true
        submit.textContent = 'Adding...'
        say('', 'muted')

        try {
          const body = new FormData()
          body.set('email', email)
          body.set('source', 'opentimes-marketing')

          const response = await fetch('/api/subscribe', { method: 'POST', body })
          const payload = await response.json().catch(() => ({}))

          if (!response.ok || payload.success === false)
            throw new Error(payload.message || 'That did not go through. Try again in a moment.')

          say(payload.message === 'Already subscribed' ? 'You are already on the list.' : 'Check your inbox to confirm.', 'ok')
          input.value = ''
        }
        catch (error) {
          say(error instanceof Error ? error.message : String(error), 'error')
        }
        finally {
          submit.disabled = false
          submit.textContent = 'Subscribe'
        }
      })
    })()
  </script>
</template>
