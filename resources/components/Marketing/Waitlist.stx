<template>
  {{--
    The hosted-plan waitlist. Posts to the framework's own email capture
    (`POST /api/email/subscribe`), which is double opt-in (config/email.ts,
    newsletter.doubleOptIn): an address typed here is mailed a confirmation
    link and nothing else until it is clicked.

    The answer is the same whether or not the address was already on the
    list, so the form cannot tell anyone who has signed up. `website` is a
    honeypot: hidden from people, filled in only by bots.
  --}}
  <form class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto]" action="/api/email/subscribe" method="post" data-waitlist-form>
    <input type="hidden" name="source" value="postline-waitlist">
    <input type="hidden" name="return" value="/#pricing">
    <label class="sr-only" for="waitlist-email">Email address</label>
    <input class="sr-only" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
    <input id="waitlist-email" class="px-4 h-11 text-[15px] text-ink placeholder:text-muted bg-panel border border-field-line outline-none rounded-xl focus:ring-2 focus:ring-focus-ring" type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@company.com" required>
    <button class="inline-flex items-center justify-center px-5 h-11 font-medium text-[15px] text-on-accent bg-accent rounded-xl disabled:opacity-50 hover:opacity-90 transition-opacity" type="submit">Notify me</button>
    <p class="sm:col-span-2 m-0 min-h-5 data-[error]:text-danger text-[13px] text-muted" role="status"></p>
    <p class="sm:col-span-2 m-0 text-[12px] text-muted">One email when it opens, nothing else. <a class="underline underline-offset-4 hover:text-ink" href="/privacy" data-stx-link>Privacy</a></p>
  </form>
</template>
