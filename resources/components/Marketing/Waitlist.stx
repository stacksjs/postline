<template>
  {{--
    The hosted-plan waitlist. Posts to the framework's own email capture
    (`POST /api/subscribe`), which is double opt-in (config/email.ts,
    newsletter.doubleOptIn): an address typed here is mailed a confirmation
    link and nothing else until it is clicked.

    The answer is the same whether or not the address was already on the
    list, so the form cannot tell anyone who has signed up. `website` is a
    honeypot: hidden from people, filled in only by bots.
  --}}
  <form class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto]" novalidate @submit="join($event)">
    <label class="sr-only" for="waitlist-email">Email address</label>
    <input class="sr-only" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" x-model="website">
    <input id="waitlist-email" class="px-4 h-11 text-[15px] text-ink placeholder:text-muted bg-panel border border-field-line outline-none rounded-xl focus:ring-2 focus:ring-focus-ring" type="email" autocomplete="email" inputmode="email" placeholder="you@company.com" required x-model="email">
    <button class="inline-flex items-center justify-center px-5 h-11 font-medium text-[15px] text-on-accent bg-accent rounded-xl disabled:opacity-50 hover:opacity-90 transition-opacity" type="submit" :disabled="sending()" :text="sending() ? 'Adding…' : 'Notify me'">Notify me</button>
    <p class="sm:col-span-2 m-0 min-h-5 text-[13px]" role="status" :class="tone() === 'error' ? 'text-danger' : 'text-muted'" :text="message()"></p>
    <p class="sm:col-span-2 m-0 text-[12px] text-muted">One email when it opens, nothing else. <a class="underline underline-offset-4 hover:text-ink" href="/privacy" data-stx-link>Privacy</a></p>
  </form>

  <script client>
    const email = state('')
    const website = state('')
    const sending = state(false)
    const message = state('')
    const tone = state('muted')

    const join = async (event: SubmitEvent) => {
      event.preventDefault()
      const address = email().trim()

      // Checked before the request so an obvious typo does not spend one of
      // the attempts the endpoint allows per minute.
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(address)) {
        tone.set('error')
        message.set('Enter a valid email address.')
        return
      }

      sending.set(true)
      message.set('')
      try {
        const body = new FormData()
        body.set('email', address)
        body.set('source', 'postline-waitlist')
        body.set('website', website())

        const response = await fetch('/api/subscribe', { method: 'POST', body })
        const payload = await response.json().catch(() => ({}))
        if (!response.ok || payload.success === false)
          throw new Error(payload.message || 'That did not go through. Try again in a moment.')

        tone.set('muted')
        message.set(payload.pending ? 'Check your inbox and confirm your email.' : 'You are on the list.')
        email.set('')
      }
      catch (error) {
        tone.set('error')
        message.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        sending.set(false)
      }
    }
  </script>
</template>
