<script client>
const provider = useReactiveProp('provider', '')
const guide = useReactiveProp('guide', null, { parse: value => value })
const bootstrap = workspaceBootstrapQuery()
const sending = state(false)
const busyAccount = state(0)
const disconnectId = state(0)
const disconnectDialog = useRef<HTMLDialogElement>('disconnectDialog')
const message = state('')
const failed = state(false)

const name = derived(() => providerLabel(provider()))
const status = derived(() => bootstrap.data()?.providers.find(item => item.provider === provider()))
const accounts = derived(() => bootstrap.data()?.accounts.filter(account => account.provider === provider()) ?? [])
const disconnectTitle = derived(() => {
  const account = accounts().find(item => item.id === disconnectId())
  return account ? `Disconnect ${channelHandle(account.handle)}?` : 'Disconnect account?'
})
const blog = derived(() => provider() === 'blog')
const manual = derived(() => provider() === 'bluesky' || provider() === 'mastodon')
const connected = derived(() => Boolean(status()?.canPublish))
const pill = derived(() => {
  if (connected()) return blog() ? 'Ready' : 'Connected'
  if (blog()) return 'Disabled'
  return status()?.handle ? 'Reconnect' : 'Setup'
})
const summary = derived(() => {
  if (blog()) return 'Built into Postline'
  const total = accounts().length
  if (total > 1) return `${total} accounts connected`
  return status()?.handle ? channelHandle(status()!.handle!) : 'Not connected'
})
const detail = derived(() => {
  if (blog()) return 'Publish long-form posts to your site without another account.'
  if (provider() === 'bluesky')
    return connected() ? 'Ready to publish and sync your timeline.' : 'Add an app password to publish and sync your timeline.'
  if (provider() === 'mastodon')
    return connected() ? 'Ready to publish from Postline.' : 'Connect any Mastodon instance with an access token.'
  if (provider() === 'instagram')
    return connected() ? 'Ready to publish images.' : 'Connect an Instagram professional account. Posts require an image.'
  if (provider() === 'twitter')
    return connected() ? 'Ready to publish on X.' : 'Connect X to publish with the API. X charges per post.'
  return connected() ? 'Ready to publish from Postline.' : `Connect ${name()} to publish from Postline.`
})
const connectLabel = derived(() => {
  if (connected()) return manual() ? 'Add or reconnect account' : 'Connect another account'
  return status()?.handle ? `Reconnect ${name()}` : `Connect ${name()}`
})

function channelHandle(handle: string): string {
  if (provider() === 'linkedin' || handle.startsWith('@')) return handle
  return `@${handle}`
}

function expiryLabel(expiresAt: string | null): string {
  const hours = Math.round((Date.parse(expiresAt || '') - Date.now()) / 3_600_000)
  if (!Number.isFinite(hours)) return 'Expires soon'
  if (hours <= 0) return 'Expired'
  if (hours < 48) return `Expires in ${hours} hour${hours === 1 ? '' : 's'}`
  return `Expires in ${Math.round(hours / 24)} days`
}

function showMessage(text: string, error = false) {
  message.set(text)
  failed.set(error)
}

async function connect(event?: SubmitEvent) {
  if (sending()) return
  const form = event?.currentTarget
  sending.set(true)
  showMessage('')
  try {
    const body = form instanceof HTMLFormElement ? new FormData(form) : undefined
    await requestJson(`/api/postline/${provider()}/connect`, { method: 'POST', body }, `Could not connect ${name()}.`)
    await bootstrap.load()
    if (form instanceof HTMLFormElement) {
      const token = form.elements.namedItem('access_token')
      if (token instanceof HTMLInputElement) token.value = ''
      else form.reset()
    }
    showMessage(`${name()} connected.`)
  }
  catch (error) {
    showMessage(error instanceof Error ? error.message : String(error), true)
  }
  finally {
    sending.set(false)
  }
}

async function updateAccount(id: number, action: 'default' | 'disconnect') {
  if (busyAccount()) return
  const account = accounts().find(item => item.id === id)
  if (!account) return
  busyAccount.set(id)
  showMessage('')
  try {
    if (action === 'disconnect') {
      await disconnectSocialAccount(id)
      disconnectDialog.current?.close()
      await bootstrap.load()
      showMessage(`${channelHandle(account.handle)} disconnected.`)
    }
    else {
      const body = new FormData()
      body.set('id', String(id))
      await requestJson('/api/postline/accounts/default', { method: 'POST', body }, 'Could not change the default account.')
      await bootstrap.load()
      showMessage(`${channelHandle(account.handle)} is the default account.`)
    }
  }
  catch (error) {
    disconnectDialog.current?.close()
    showMessage(error instanceof Error ? error.message : String(error), true)
  }
  finally {
    busyAccount.set(0)
  }
}

function confirmDisconnect(id: number) {
  disconnectId.set(id)
  disconnectDialog.current?.showModal()
}
</script>

<template>
  <article class="flex flex-col gap-4 justify-between p-4 h-full min-h-52 bg-panel border border-line rounded-2xl" :data-channel="provider()">
    <div>
      <div class="flex gap-3 items-start justify-between">
        <span class="grid place-items-center h-10 w-10 text-ink bg-panel-2 rounded-xl" aria-hidden="true"><span class="h-5 w-5" :class="providerIcon(provider())"></span></span>
        <span data-channel-status>
          <Badge size="sm" className="whitespace-nowrap" :variant="connected() ? 'success' : status()?.handle ? 'warning' : 'default'">{{ pill() }}</Badge>
        </span>
      </div>
      <h2 class="mb-0 mt-4 font-semibold text-sm" :text="name()"></h2>
      <p class="my-1.5 text-body text-ui" :text="summary()"></p>
      <p class="m-0 text-muted text-xs" :text="detail()"></p>
      <ul class="grid gap-1.5 m-0 mt-3 p-0 list-none" x-show="accounts().length" data-channel-accounts>
        <li class="grid gap-1.5 p-2 bg-panel-2 border border-line rounded-xl" x-for="account in accounts()" :key="account.id">
          <div class="flex flex-wrap gap-1.5 items-center justify-between">
            <span class="max-w-full min-w-0 text-ink text-xs truncate" :title="account.displayName || channelHandle(account.handle)" :text="channelHandle(account.handle)"></span>
            <Badge size="sm" :variant="account.connected && !account.expiresSoon ? 'success' : 'warning'">{{ !account.connected ? 'Reconnect' : account.expiresSoon ? expiryLabel(account.expiresAt) : 'Connected' }}</Badge>
          </div>
          <div class="flex flex-wrap gap-2 justify-end">
            <span class="mr-auto text-muted text-xs" x-show="account.isDefault && accounts().length > 1">Default</span>
            <button class="text-muted text-xs underline hover:text-ink disabled:opacity-50" type="button" :disabled="Boolean(busyAccount())" x-show="account.connected && !account.isDefault && accounts().length > 1" :aria-label="`Publish to ${channelHandle(account.handle)} by default`" @click="updateAccount(account.id, 'default')">Make default</button>
            <button class="text-muted text-xs underline hover:text-danger disabled:opacity-50" type="button" :disabled="Boolean(busyAccount())" :aria-label="`Disconnect ${channelHandle(account.handle)}`" @click="confirmDisconnect(account.id)">Disconnect</button>
          </div>
        </li>
      </ul>
    </div>
    <div class="grid gap-2">
      <a class="inline-flex items-center justify-center h-9 font-semibold text-ink text-xs bg-panel-2 hover:bg-raised border border-line rounded-xl" href="/writing" data-stx-link x-show="blog()">Open Blog</a>
      <div class="grid gap-2" x-show="!manual() && !blog()">
        <button class="inline-flex items-center justify-center px-3 h-9 w-full font-semibold text-on-accent text-xs bg-accent hover:bg-accent-hover rounded-xl disabled:opacity-50" type="button" :disabled="!status()?.oauthConfigured || sending()" :text="connectLabel()" @click="navigate('/api/postline/' + provider() + '/auth', { reload: true })"></button>
        <p class="m-0 text-muted text-xs" x-show="!status()?.oauthConfigured">Set up this app under Your network apps to sign in.</p>
        <button class="text-muted text-xs underline hover:text-ink disabled:opacity-50" type="button" :disabled="sending()" x-show="status()?.configuredFromEnv" @click="connect()">Use configured token</button>
      </div>
      <details x-show="manual()">
        <summary class="inline-flex items-center justify-center h-9 w-full font-semibold list-none text-ink text-xs bg-panel-2 hover:bg-raised border border-line rounded-xl cursor-pointer" :text="'Manage ' + name()"></summary>
        <ol class="grid gap-1 mb-0 mt-3 pl-5 text-body text-xs">
          <li x-for="step in guide()?.steps ?? []" :text="step"></li>
        </ol>
        <a class="inline-block mt-2 text-info text-xs underline" :href="guide()?.url" :aria-label="'Full ' + name() + ' setup guide'" target="_blank" rel="noopener noreferrer" x-show="guide()">Full setup guide</a>
        <form class="grid gap-2 pt-3" @submit.prevent="connect($event)">
          <input class="px-3 h-9 text-ink text-xs bg-raised border border-field-line rounded-xl" :name="provider() === 'bluesky' ? 'identifier' : 'instance'" :placeholder="provider() === 'bluesky' ? 'name.bsky.social' : 'mastodon.social'" :autocomplete="provider() === 'bluesky' ? 'username' : 'url'" :aria-label="provider() === 'bluesky' ? 'Bluesky handle' : 'Mastodon instance'" :value="provider() === 'mastodon' ? status()?.instance : null" required>
          <input class="px-3 h-9 text-ink text-xs bg-raised border border-field-line rounded-xl" type="password" :name="provider() === 'bluesky' ? 'password' : 'access_token'" :placeholder="provider() === 'bluesky' ? 'App password' : 'Access token'" :autocomplete="provider() === 'bluesky' ? 'current-password' : 'off'" :aria-label="provider() === 'bluesky' ? 'Bluesky app password' : 'Mastodon access token'" required>
          <button class="inline-flex items-center justify-center px-3 h-9 w-full font-semibold text-on-accent text-xs bg-accent hover:bg-accent-hover rounded-xl disabled:opacity-50" type="submit" :disabled="sending()" :text="sending() ? 'Connecting…' : connectLabel()"></button>
        </form>
      </details>
      <p class="m-0 text-xs" role="status" x-show="message()" :class="failed() ? 'text-danger' : 'text-success'" :text="message()"></p>
    </div>
    <dialog ref="disconnectDialog" class="p-4 max-w-[22rem] text-ink bg-panel border border-line rounded-xl shadow-xl" :aria-labelledby="'disconnect-' + provider()" data-channel-confirmation>
      <h3 class="m-0 font-semibold" :id="'disconnect-' + provider()" :text="disconnectTitle()"></h3>
      <p class="mt-2 text-body text-sm">Scheduled posts for this account will fail until it is connected again. Published posts are kept.</p>
      <form method="dialog" class="flex gap-2 justify-end">
        <button class="px-3 h-9 font-semibold text-ink text-xs bg-panel-2 rounded-lg" type="submit" autofocus>Cancel</button>
        <button class="px-3 h-9 font-semibold text-on-accent text-xs bg-danger-solid rounded-lg disabled:opacity-50" type="button" :disabled="Boolean(busyAccount())" @click="updateAccount(disconnectId(), 'disconnect')">Disconnect</button>
      </form>
    </dialog>
  </article>
</template>
