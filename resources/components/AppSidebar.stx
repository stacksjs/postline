<script server>
const requestUrl = (typeof requestContext !== 'undefined' && requestContext.url)
  ? requestContext.url()
  : 'http://localhost/'

let currentPath = '/'
try {
  currentPath = new URL(requestUrl).pathname
}
catch {
  currentPath = '/'
}

const navLinks = [
  { href: '/composer', label: 'Composer', shortcut: '1', icon: 'i-hugeicons-edit-02' },
  { href: '/queue', label: 'Queue', shortcut: '2', icon: 'i-hugeicons-calendar-03' },
  { href: '/timeline', label: 'Timeline', shortcut: '3', icon: 'i-hugeicons-news' },
  { href: '/analytics', label: 'Analytics', shortcut: '4', icon: 'i-hugeicons-chart-line-data-01' },
  { href: '/campaigns', label: 'Campaigns', shortcut: '5', icon: 'i-hugeicons-flowchart-01' },
  { href: '/listening', label: 'Listening', shortcut: '6', icon: 'i-hugeicons-radar-02' },
  { href: '/inbox', label: 'Inbox', shortcut: '7', icon: 'i-hugeicons-message-01' },
  { href: '/writing', label: 'Blog', shortcut: '8', icon: 'i-hugeicons-quill-write-02' },
  { href: '/activity', label: 'Activity', shortcut: '9', icon: 'i-hugeicons-activity-01' },
].map((link) => ({
  ...link,
  active: currentPath === link.href || currentPath.startsWith(`${link.href}/`),
}))

const settingsActive = currentPath === '/accounts' || currentPath === '/settings' || currentPath.startsWith('/settings/')
const mobilePrimary = new Set(['/composer', '/queue', '/inbox'])
const mobileLinks = navLinks.filter(link => mobilePrimary.has(link.href))
const moreLinks = [
  ...navLinks.filter(link => !mobilePrimary.has(link.href)),
  { href: '/accounts', label: 'Channels', icon: 'i-hugeicons-share-08', active: currentPath === '/accounts' },
  { href: '/settings', label: 'Settings', icon: 'i-hugeicons-settings-02', active: settingsActive && currentPath !== '/accounts' },
]
</script>

<script client>
const moreDialog = useRef('moreDialog')
const moreOpen = state(false)
const desktopWidth = useMediaQuery('(min-width: 1024px)')

function showMore() {
  moreDialog.current?.showModal()
  moreOpen.set(Boolean(moreDialog.current?.open))
}

function closeMore() {
  moreDialog.current?.close()
}

function dismissOutside(event: MouseEvent) {
  if (event.target === moreDialog.current) closeMore()
}

effect(() => {
  if (desktopWidth() && moreOpen()) closeMore()
})
</script>

<template>
  <div class="contents">
  <nav class="grid lg:hidden bottom-0 fixed inset-x-0 z-50 grid-cols-4 items-center px-2 bg-panel border-line border-t" aria-label="Primary" data-postline-mobile-nav>
    @foreach (mobileLinks as link)
      <a
        href="{{ link.href }}"
        data-stx-link
        data-stx-active-class="text-ink bg-nav-active"
        data-stx-exact-active-class="text-ink bg-nav-active"
        class="grid justify-items-center content-center gap-0.5 mx-0.5 px-1 h-12 font-semibold text-xs rounded-xl {{ link.active ? 'bg-nav-active text-ink' : 'text-muted' }}"
        aria-current="{{ link.active ? 'page' : 'false' }}"
      >
        <span class="h-5 w-5 {{ link.icon }}" aria-hidden="true"></span>
        <span>{{ link.href === '/composer' ? 'Compose' : link.label }}</span>
      </a>
    @endforeach
    <button class="grid content-center gap-0.5 justify-items-center mx-0.5 px-1 h-12 font-semibold text-muted text-xs rounded-xl" type="button" aria-controls="workspace-more" aria-haspopup="dialog" :aria-expanded="moreOpen()" @click="showMore">
      <span class="h-5 w-5 i-hugeicons-more-horizontal" aria-hidden="true"></span>
      <span>More</span>
    </button>
  </nav>

  <dialog id="workspace-more" ref="moreDialog" class="p-0 text-ink bg-panel border border-line rounded-t-2xl shadow-xl" aria-labelledby="workspace-more-title" data-postline-mobile-menu @close="moreOpen.set(false)" @click="dismissOutside($event)">
    <div class="p-4">
      <header class="flex gap-3 items-center justify-between mb-2">
        <h2 id="workspace-more-title" class="m-0 font-semibold text-base">More views</h2>
        <button class="grid place-items-center h-11 w-11 text-muted bg-panel-2 hover:bg-raised rounded-xl" type="button" aria-label="Close menu" autofocus @click="closeMore">
          <span class="h-5 w-5 i-hugeicons-cancel-01" aria-hidden="true"></span>
        </button>
      </header>
      <nav class="grid gap-1.5 grid-cols-2" aria-label="More views">
        @foreach (moreLinks as link)
          <a
            href="{{ link.href }}"
            class="flex min-w-0 gap-2 items-center px-3 min-h-11 font-medium text-ui rounded-xl hover:bg-panel-2 {{ link.active ? 'bg-nav-active text-ink' : 'text-body' }}"
            data-stx-link
            data-stx-exact-active-class="text-ink bg-nav-active"
            aria-current="{{ link.active ? 'page' : 'false' }}"
            @click="closeMore"
          >
            <span class="shrink-0 h-5 w-5 {{ link.icon }}" aria-hidden="true"></span>
            <span class="truncate">{{ link.label }}</span>
          </a>
        @endforeach
      </nav>
    </div>
  </dialog>

  <aside class="hidden lg:flex overflow-hidden relative sticky top-0 flex-col pb-5 pt-[68px] px-5 h-screen min-w-0 bg-[#f3f3f1]/48 backdrop-blur-3xl backdrop-saturate-150 duration-150 ease-out transition-[width,padding]" aria-label="Postline" data-postline-sidebar data-window-drag-region>
    <div class="absolute inset-0 bg-[linear-gradient(112deg,rgba(255,255,255,0.20)_0%,rgba(255,255,255,0.04)_45%,rgba(226,226,222,0.16)_100%)] pointer-events-none"></div>
    <div class="flex absolute right-5 top-3.5 z-20 items-center min-h-7" data-shell-controls-row>
      <div class="flex gap-1.5 items-center">
        <button class="inline-flex items-center justify-center h-8 w-8 text-muted hover:text-ink bg-glass hover:bg-raised border border-line rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus shadow-sm duration-150 transition-all" type="button" aria-label="Collapse sidebar" aria-expanded="true" data-sidebar-collapse data-no-window-drag>
          <span class="h-[18px] w-[18px] duration-150 transition-transform i-hugeicons-sidebar-left" data-sidebar-collapse-icon aria-hidden="true"></span>
        </button>
        <button class="flex hidden items-center justify-center h-7 w-7 text-muted hover:text-ink hover:bg-glass-hover rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus transition-colors" type="button" aria-label="Go back" data-shell-back data-native-shell-control>
          <span class="h-5 w-5 i-hugeicons-arrow-left-02" aria-hidden="true"></span>
        </button>
        <button class="flex hidden items-center justify-center h-7 w-7 text-muted hover:text-ink hover:bg-glass-hover rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus transition-colors" type="button" aria-label="Go forward" data-shell-forward data-native-shell-control>
          <span class="h-5 w-5 i-hugeicons-arrow-right-02" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <a
      class="flex relative z-10 gap-3 items-center mb-5 px-2 py-2 text-body rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus"
      href="/composer"
      data-stx-link
      data-stx-exact-active-class="text-ink"
      data-sidebar-collapsible-content="true"
      data-no-window-drag
      aria-label="Postline composer"
    >
      {{-- The same mark as the favicon and the sign-in page (`.brand-mark`
          in config/css.ts), so the three agree. --}}
      <span class="h-7 w-7 brand-mark" aria-hidden="true"></span>
      <span class="font-semibold text-sm" data-sidebar-expanded>Postline</span>
    </a>

    <nav class="grid relative z-10 gap-1" aria-label="Primary" data-stx-nav data-testid="postline-nav" data-sidebar-collapsible-content="true">
      @foreach (navLinks as link)
        <a
          href="{{ link.href }}"
          data-stx-link
          data-stx-active-class="text-ink bg-nav-active"
          data-stx-exact-active-class="text-ink bg-nav-active"
          data-no-window-drag
          title="Open {{ link.label }} ({{ link.shortcut }})"
          class="flex w-full items-center gap-3 rounded-[14px] px-3 py-1.5 text-left text-ui transition-colors hover:bg-glass-hover focus-visible:bg-glass-hover focus-visible:outline-none {{ link.active ? 'bg-nav-active text-ink' : 'text-body' }}"
          aria-current="{{ link.active ? 'page' : 'false' }}"
        >
          <span class="h-[18px] w-[18px] {{ link.icon }} {{ link.active ? 'text-ink' : 'text-muted' }}" aria-hidden="true"></span>
          <span class="flex-1 font-medium truncate" data-sidebar-expanded>{{ link.label }}</span>
          <kbd class="grid place-items-center px-1.5 h-5 min-w-5 font-sans text-muted text-xs bg-glass rounded-full shadow-sm" data-sidebar-expanded aria-label="Shortcut {{ link.shortcut }}">{{ link.shortcut }}</kbd>
        </a>
      @endforeach
    </nav>

    <a
      href="/settings"
      data-stx-link
      data-stx-active-class="text-ink bg-nav-active"
      data-stx-exact-active-class="text-ink bg-nav-active"
      data-sidebar-collapsible-content="true"
      data-no-window-drag
      title="Open Settings (,)"
      class="relative z-10 mt-auto flex w-full items-center gap-3 rounded-[14px] px-3 py-1.5 text-left text-ui transition-colors hover:bg-glass-hover focus-visible:bg-glass-hover focus-visible:outline-none {{ settingsActive ? 'bg-nav-active text-ink' : 'text-body' }}"
      aria-current="{{ settingsActive ? 'page' : 'false' }}"
    >
      <span class="h-[18px] w-[18px] i-hugeicons-settings-02 {{ settingsActive ? 'text-ink' : 'text-muted' }}" aria-hidden="true"></span>
      <span class="flex-1 font-medium" data-sidebar-expanded>Settings</span>
      <kbd class="grid place-items-center px-1.5 h-5 min-w-5 font-sans text-muted text-xs bg-glass rounded-full shadow-sm" data-sidebar-expanded aria-label="Shortcut comma">,</kbd>
    </a>
  </aside>
  </div>
</template>
