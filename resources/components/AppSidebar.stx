<script server>
import { unreadText, workspaceLocale, workspaceShellText, workspaceText } from '../../app/Support/Localization/workspace'

const shellText = workspaceShellText
export const language = workspaceLocale
export const sidebarText = { unread: unreadText, expand: shellText.expandSidebar, collapse: shellText.collapseSidebar }
const settingsLabel = workspaceText('workspace.navigation.settings')
const channelsLabel = workspaceText('workspace.navigation.channels')

const requestUrl = (typeof requestContext !== 'undefined' && requestContext.url)
  ? requestContext.url()
  : 'http://localhost/'

let currentPath = '/'
try {
  currentPath = new URL(requestUrl).pathname
}
catch {
  currentPath = '/'
}

const navLinks = [
  { href: '/composer', labelKey: 'workspace.navigation.composer', shortcut: '1', icon: 'i-hugeicons-edit-02' },
  { href: '/queue', labelKey: 'workspace.navigation.queue', shortcut: '2', icon: 'i-hugeicons-calendar-03' },
  { href: '/timeline', labelKey: 'workspace.navigation.timeline', shortcut: '3', icon: 'i-hugeicons-news' },
  { href: '/analytics', labelKey: 'workspace.navigation.analytics', shortcut: '4', icon: 'i-hugeicons-chart-line-data-01' },
  { href: '/campaigns', labelKey: 'workspace.navigation.campaigns', shortcut: '5', icon: 'i-hugeicons-flowchart-01' },
  { href: '/listening', labelKey: 'workspace.navigation.listening', shortcut: '6', icon: 'i-hugeicons-radar-02' },
  { href: '/inbox', labelKey: 'workspace.navigation.inbox', shortcut: '7', icon: 'i-hugeicons-message-01' },
  { href: '/writing', labelKey: 'workspace.navigation.writing', shortcut: '8', icon: 'i-hugeicons-quill-write-02' },
  { href: '/activity', labelKey: 'workspace.navigation.activity', shortcut: '9', icon: 'i-hugeicons-activity-01' },
].map(({ labelKey, ...link }) => {
  const label = workspaceText(labelKey)
  return {
    ...link,
    label,
    tooltip: workspaceText('workspace.shell.openView', { view: label, shortcut: link.shortcut }),
    shortcutLabel: workspaceText('workspace.shell.shortcut', { shortcut: link.shortcut }),
    active: currentPath === link.href || currentPath.startsWith(`${link.href}/`),
  }
})

const settingsActive = currentPath === '/accounts' || currentPath === '/settings' || currentPath.startsWith('/settings/')
const mobilePrimary = new Set(['/composer', '/queue', '/inbox'])
const mobileLinks = navLinks.filter(link => mobilePrimary.has(link.href)).map(link => ({
  ...link,
  label: link.href === '/composer' ? workspaceText('workspace.navigation.compose') : link.label,
}))
const moreLinks = [
  ...navLinks.filter(link => !mobilePrimary.has(link.href)),
  { href: '/accounts', label: channelsLabel, icon: 'i-hugeicons-share-08', active: currentPath === '/accounts' },
  { href: '/settings', label: settingsLabel, icon: 'i-hugeicons-settings-02', active: settingsActive && currentPath !== '/accounts' },
]
</script>

<script client>
const copy = {{ sidebarText }}
const collapsed = useReactiveProp('collapsed', false)
const emit = defineEmits()
const moreDialog = useRef('moreDialog')
const moreOpen = state(false)
const desktopWidth = useMediaQuery('(min-width: 1024px)')

const bootstrap = workspaceBootstrapQuery()
const unread = derived(() => bootstrap.data()?.unread ?? { inbox: 0, listening: 0 })

function refreshUnread() {
  void bootstrap.load()
}

function unreadFor(href: string): number {
  return href === '/inbox' ? unread().inbox : unread().listening
}

function unreadLabel(href: string): string {
  const count = unreadFor(href)
  const kind = href === '/inbox' ? 'inbox' : 'listening'
  const form = count === 1 ? 'One' : 'Other'
  return copy.unread[kind + form].replace('{count}', String(count))
}

function unreadBadge(href: string): string {
  const count = unreadFor(href)
  return count > 99 ? '99+' : String(count)
}

onMount(refreshUnread)
useEventListener('stx:load', refreshUnread)
useInterval(refreshUnread, 60_000, { whileVisible: true })

function showMore() {
  moreDialog.current?.showModal()
  moreOpen.set(Boolean(moreDialog.current?.open))
}

function closeMore() {
  moreDialog.current?.close()
}

function dismissOutside(event: MouseEvent) {
  if (event.target === moreDialog.current) closeMore()
}

effect(() => {
  if (desktopWidth() && moreOpen()) closeMore()
})
</script>

<template>
  <div class="contents" lang="{{ language }}">
  <nav class="grid lg:hidden bottom-0 fixed inset-x-0 z-50 grid-cols-4 items-center px-2 bg-panel border-line border-t" aria-label="{{ shellText.primaryNavigation }}" data-postline-mobile-nav>
    @foreach (mobileLinks as link)
      <a
        href="{{ link.href }}"
        data-stx-link
        data-stx-active-class="text-ink bg-nav-active"
        data-stx-exact-active-class="text-ink bg-nav-active"
        class="grid relative justify-items-center content-center gap-0.5 mx-0.5 px-1 h-12 font-semibold text-xs rounded-xl {{ link.active ? 'bg-nav-active text-ink' : 'text-muted' }}"
        aria-current="{{ link.active ? 'page' : 'false' }}"
      >
        <span class="h-5 w-5 {{ link.icon }}" aria-hidden="true"></span>
        <span>{{ link.label }}</span>
        @if(link.href === '/inbox')
          <span class="absolute right-1 top-0.5 px-1 min-w-4 font-semibold text-center text-on-accent text-xs bg-accent rounded-full" x-cloak x-show="unreadFor('/inbox') > 0" :text="unreadBadge('/inbox')" aria-hidden="true"></span>
          <span class="sr-only" x-show="unreadFor('/inbox') > 0" :text="unreadLabel('/inbox')"></span>
        @endif
      </a>
    @endforeach
    <button class="grid content-center gap-0.5 justify-items-center mx-0.5 px-1 h-12 font-semibold text-muted text-xs rounded-xl" type="button" aria-controls="workspace-more" aria-haspopup="dialog" :aria-expanded="moreOpen()" @click="showMore">
      <span class="h-5 w-5 i-hugeicons-more-horizontal" aria-hidden="true"></span>
      <span>{{ shellText.more }}</span>
    </button>
  </nav>

  <dialog id="workspace-more" ref="moreDialog" class="p-0 text-ink bg-panel border border-line rounded-t-2xl shadow-xl" aria-labelledby="workspace-more-title" data-postline-mobile-menu @close="moreOpen.set(false)" @click="dismissOutside($event)">
    <div class="p-4">
      <header class="flex gap-3 items-center justify-between mb-2">
        <h2 id="workspace-more-title" class="m-0 font-semibold text-base">{{ shellText.moreViews }}</h2>
        <button class="grid place-items-center h-11 w-11 text-muted bg-panel-2 hover:bg-raised rounded-xl" type="button" aria-label="{{ shellText.closeMenu }}" autofocus @click="closeMore">
          <span class="h-5 w-5 i-hugeicons-cancel-01" aria-hidden="true"></span>
        </button>
      </header>
      <nav class="grid gap-1.5 grid-cols-2" aria-label="{{ shellText.moreViews }}">
        @foreach (moreLinks as link)
          <a
            href="{{ link.href }}"
            class="flex min-w-0 gap-2 items-center px-3 min-h-11 font-medium text-ui rounded-xl hover:bg-panel-2 {{ link.active ? 'bg-nav-active text-ink' : 'text-body' }}"
            data-stx-link
            data-stx-exact-active-class="text-ink bg-nav-active"
            aria-current="{{ link.active ? 'page' : 'false' }}"
            @click="closeMore"
            @if(link.href === '/settings')
              data-no-router
            @endif
            @if(link.href === '/accounts')
              data-command-destination="{{ channelsLabel }}"
            @endif
          >
            <span class="shrink-0 h-5 w-5 {{ link.icon }}" aria-hidden="true"></span>
            <span class="flex-1 truncate">{{ link.label }}</span>
            @if(link.href === '/listening')
              <span class="px-1.5 min-w-5 font-semibold text-center text-on-accent text-xs bg-accent rounded-full" x-cloak x-show="unreadFor('/listening') > 0" :text="unreadBadge('/listening')" aria-hidden="true"></span>
              <span class="sr-only" x-show="unreadFor('/listening') > 0" :text="unreadLabel('/listening')"></span>
            @endif
          </a>
        @endforeach
      </nav>
    </div>
  </dialog>

  <aside id="workspace-sidebar" class="hidden lg:flex overflow-hidden relative sticky top-0 flex-col pb-5 pt-[68px] px-5 h-screen min-w-0 backdrop-blur-3xl backdrop-saturate-150" aria-label="Postline" :aria-hidden="collapsed()" data-postline-sidebar data-craft-drag>
    <div class="flex absolute right-5 top-3.5 z-20 items-center min-h-7" data-shell-controls-row>
      {{-- Craft's native titlebar uses this same button to toggle the sidebar. --}}
      <button class="inline-flex items-center justify-center h-8 w-8 text-muted hover:text-ink bg-glass hover:bg-raised border border-line rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus shadow-sm duration-150 transition-colors" type="button" :aria-label="collapsed() ? copy.expand : copy.collapse" aria-controls="workspace-sidebar" :aria-expanded="!collapsed()" data-sidebar-collapse data-craft-no-drag @click="emit('toggle-sidebar')">
        <span class="h-[18px] w-[18px] i-hugeicons-sidebar-left" aria-hidden="true"></span>
      </button>
    </div>

    <a
      class="flex relative z-10 gap-3 items-center mb-5 px-2 py-2 text-body rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus"
      href="/composer"
      data-stx-link
      data-stx-exact-active-class="text-ink"
      data-craft-no-drag
      aria-label="{{ shellText.brandLink }}"
    >
      {{-- The same mark as the favicon and the sign-in page (`.brand-mark`
          in config/css.ts), so the three agree. --}}
      <span class="h-7 w-7 brand-mark" aria-hidden="true"></span>
      <span class="font-semibold text-sm">Postline</span>
    </a>

    <nav class="grid relative z-10 gap-1" aria-label="{{ shellText.primaryNavigation }}" data-stx-nav data-testid="postline-nav">
      @foreach (navLinks as link)
        <a
          href="{{ link.href }}"
          data-stx-link
          data-stx-active-class="text-ink bg-nav-active"
          data-stx-exact-active-class="text-ink bg-nav-active"
          data-craft-no-drag
          title="{{ link.tooltip }}"
          data-command-destination="{{ link.label }}"
          data-command-shortcut="{{ link.shortcut }}"
          aria-keyshortcuts="{{ link.shortcut }}"
          class="flex w-full items-center gap-3 rounded-[14px] px-3 py-1.5 text-left text-ui transition-colors hover:bg-glass-hover focus-visible:bg-glass-hover focus-visible:outline-none {{ link.active ? 'bg-nav-active text-ink' : 'text-body' }}"
          aria-current="{{ link.active ? 'page' : 'false' }}"
        >
          <span class="h-[18px] w-[18px] {{ link.icon }} {{ link.active ? 'text-ink' : 'text-muted' }}" aria-hidden="true"></span>
          <span class="flex-1 font-medium truncate">{{ link.label }}</span>
          @if(link.href === '/inbox' || link.href === '/listening')
            <span class="px-1.5 min-w-5 font-semibold text-center text-on-accent text-xs bg-accent rounded-full" x-cloak x-show="unreadFor('{{ link.href }}') > 0" :text="unreadBadge('{{ link.href }}')" aria-hidden="true"></span>
            <span class="sr-only" x-show="unreadFor('{{ link.href }}') > 0" :text="unreadLabel('{{ link.href }}')"></span>
          @endif
          <kbd class="grid place-items-center px-1.5 h-5 min-w-5 font-mono text-muted text-xs bg-panel border border-b-2 border-line rounded-md" aria-label="{{ link.shortcutLabel }}">{{ link.shortcut }}</kbd>
        </a>
      @endforeach
    </nav>

    <a
      href="/settings"
      data-stx-link
      data-no-router
      data-stx-active-class="text-ink bg-nav-active"
      data-stx-exact-active-class="text-ink bg-nav-active"
      data-craft-no-drag
      title="{{ shellText.openSettings }}"
      data-command-destination="{{ settingsLabel }}"
      data-command-shortcut=","
      aria-keyshortcuts=","
      class="relative z-10 mt-auto flex w-full items-center gap-3 rounded-[14px] px-3 py-1.5 text-left text-ui transition-colors hover:bg-glass-hover focus-visible:bg-glass-hover focus-visible:outline-none {{ settingsActive ? 'bg-nav-active text-ink' : 'text-body' }}"
      aria-current="{{ settingsActive ? 'page' : 'false' }}"
    >
      <span class="h-[18px] w-[18px] i-hugeicons-settings-02 {{ settingsActive ? 'text-ink' : 'text-muted' }}" aria-hidden="true"></span>
      <span class="flex-1 font-medium">{{ settingsLabel }}</span>
      <kbd class="grid place-items-center px-1.5 h-5 min-w-5 font-mono text-muted text-xs bg-panel border border-b-2 border-line rounded-md" aria-label="{{ shellText.settingsShortcut }}">,</kbd>
    </a>
  </aside>
  </div>
</template>
