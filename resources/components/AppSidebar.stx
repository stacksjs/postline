<script server>
import { unreadText, workspaceLocale, workspaceNavigation, workspaceRoutePath, workspaceShellText, workspaceText } from '../../app/Support/Localization/workspace'

const shellText = workspaceShellText
export const language = workspaceLocale
export const sidebarUnread = unreadText

const currentPath = workspaceRoutePath(typeof requestContext === 'undefined' ? '/' : requestContext.url())
const links = workspaceNavigation.map(link => ({
  ...link,
  tooltip: link.href === '/settings' ? shellText.openSettings : link.shortcut
    ? workspaceText('workspace.shell.openView', { view: link.label, shortcut: link.shortcut })
    : link.label,
  shortcutLabel: link.href === '/settings' ? shellText.settingsShortcut
    : workspaceText('workspace.shell.shortcut', { shortcut: link.shortcut ?? '' }),
  active: currentPath === link.href,
}))
const primaryLinks = links.filter(link => link.primary)
const utilityLinks = links.filter(link => !link.primary)
const mobileLinks = links.filter(link => link.mobile)
const moreLinks = links.filter(link => !link.mobile)
</script>

<script client>
import type { CraftBridgeAPI } from 'craft-native'

type SidebarWindow = CraftBridgeAPI['window'] & {
  setWebSidebarCollapsed?: (collapsed: boolean) => Promise<void>
}

const copy = {{ sidebarUnread }}
const collapsed = useReactiveProp('collapsed', false)
const desktop = useNativeDesktop()
const nativeWindow = state<SidebarWindow | undefined>(undefined)
const moreDialog = useRef('moreDialog')
const moreOpen = state(false)
const desktopWidth = useMediaQuery('(min-width: 1024px)')

const bootstrap = workspaceBootstrapQuery()
const unread = derived(() => bootstrap.data()?.unread ?? { inbox: 0, listening: 0 })

desktop.onReady(host => nativeWindow.set(host.window as SidebarWindow))
effect(() => {
  const value = collapsed()
  void nativeWindow()?.setWebSidebarCollapsed?.(value).catch(() => {})
})

function refreshUnread() {
  void bootstrap.load()
}

function unreadFor(href: string): number {
  return href === '/inbox' ? unread().inbox : unread().listening
}

function unreadLabel(href: string): string {
  const count = unreadFor(href)
  const kind = href === '/inbox' ? 'inbox' : 'listening'
  const form = count === 1 ? 'One' : 'Other'
  return copy[kind + form].replace('{count}', String(count))
}

function unreadBadge(href: string): string {
  const count = unreadFor(href)
  return count > 99 ? '99+' : String(count)
}

onMount(refreshUnread)
useEventListener('stx:load', refreshUnread)
useInterval(refreshUnread, 60_000, { whileVisible: true })

function showMore() {
  moreDialog.current?.showModal()
  moreOpen.set(Boolean(moreDialog.current?.open))
}

function closeMore() {
  moreDialog.current?.close()
}

function dismissOutside(event: MouseEvent) {
  if (event.target === moreDialog.current) closeMore()
}

effect(() => {
  if (desktopWidth() && moreOpen()) closeMore()
})
</script>

<template>
  <div class="contents" lang="{{ language }}">
  <nav class="grid lg:hidden bottom-0 fixed inset-x-0 z-50 grid-cols-4 items-center px-2 bg-panel border-line border-t" aria-label="{{ shellText.primaryNavigation }}" data-postline-mobile-nav>
    @foreach (mobileLinks as link)
      <a
        href="{{ link.href }}"
        data-stx-link
        data-stx-active-class="text-ink bg-nav-active"
        data-stx-exact-active-class="text-ink bg-nav-active"
        class="grid relative justify-items-center content-center gap-0.5 mx-0.5 px-1 h-12 font-semibold text-xs rounded-xl {{ link.active ? 'bg-nav-active text-ink' : 'text-muted' }}"
        aria-current="{{ link.active ? 'page' : 'false' }}"
      >
        <span class="h-5 w-5 {{ link.icon }}" aria-hidden="true"></span>
        <span>{{ link.mobileLabel }}</span>
        @if(link.href === '/inbox')
          <span class="absolute right-1 top-0.5 px-1 min-w-4 font-semibold text-center text-on-accent text-xs bg-accent rounded-full" x-cloak x-show="unreadFor('/inbox') > 0" :text="unreadBadge('/inbox')" aria-hidden="true"></span>
          <span class="sr-only" x-show="unreadFor('/inbox') > 0" :text="unreadLabel('/inbox')"></span>
        @endif
      </a>
    @endforeach
    <button class="grid content-center gap-0.5 justify-items-center mx-0.5 px-1 h-12 font-semibold text-muted text-xs rounded-xl" type="button" aria-controls="workspace-more" aria-haspopup="dialog" :aria-expanded="moreOpen()" @click="showMore">
      <span class="h-5 w-5 i-hugeicons-more-horizontal" aria-hidden="true"></span>
      <span>{{ shellText.more }}</span>
    </button>
  </nav>

  <dialog id="workspace-more" ref="moreDialog" class="p-0 text-ink bg-panel border border-line rounded-t-2xl shadow-xl" aria-labelledby="workspace-more-title" data-postline-mobile-menu @close="moreOpen.set(false)" @click="dismissOutside($event)">
    <div class="p-4">
      <header class="flex gap-3 items-center justify-between mb-2">
        <h2 id="workspace-more-title" class="m-0 font-semibold text-base">{{ shellText.moreViews }}</h2>
        <button class="grid place-items-center h-11 w-11 text-muted bg-panel-2 hover:bg-raised rounded-xl" type="button" aria-label="{{ shellText.closeMenu }}" autofocus @click="closeMore">
          <span class="h-5 w-5 i-hugeicons-cancel-01" aria-hidden="true"></span>
        </button>
      </header>
      <nav class="grid gap-1.5 grid-cols-2" aria-label="{{ shellText.moreViews }}">
        @foreach (moreLinks as link)
          <a
            href="{{ link.href }}"
            class="flex min-w-0 gap-2 items-center px-3 min-h-11 font-medium text-ui rounded-xl hover:bg-panel-2 {{ link.active ? 'bg-nav-active text-ink' : 'text-body' }}"
            data-stx-link
            data-stx-exact-active-class="text-ink bg-nav-active"
            aria-current="{{ link.active ? 'page' : 'false' }}"
            @click="closeMore"
            @if(link.href === '/settings')
              data-no-router
            @endif
          >
            <span class="shrink-0 h-5 w-5 {{ link.icon }}" aria-hidden="true"></span>
            <span class="flex-1 truncate">{{ link.label }}</span>
            @if(link.href === '/listening')
              <span class="px-1.5 min-w-5 font-semibold text-center text-on-accent text-xs bg-accent rounded-full" x-cloak x-show="unreadFor('/listening') > 0" :text="unreadBadge('/listening')" aria-hidden="true"></span>
              <span class="sr-only" x-show="unreadFor('/listening') > 0" :text="unreadLabel('/listening')"></span>
            @endif
          </a>
        @endforeach
      </nav>
    </div>
  </dialog>

  <aside id="workspace-sidebar" class="hidden lg:flex overflow-hidden flex-col min-h-0 min-w-0 select-none" aria-label="Postline" :aria-hidden="collapsed()" data-postline-sidebar data-craft-drag>
    <div class="shrink-0" data-sidebar-window-inset></div>
    <nav class="flex overflow-y-auto flex-1 flex-col gap-3 pb-2.5 px-2.5 min-h-0" aria-label="{{ shellText.primaryNavigation }}" data-stx-nav data-testid="postline-nav">
      <a
        class="flex gap-2.5 items-center shrink-0 px-2 py-1.5 rounded-xl"
        href="/composer"
        data-stx-link
        data-sidebar-brand
        data-craft-no-drag
        aria-label="{{ shellText.brandLink }}"
      >
        <span class="size-7 brand-mark" aria-hidden="true"></span>
        <span class="font-semibold text-sm">Postline</span>
      </a>

      <div class="grid gap-0.5 shrink-0 pt-3" data-sidebar-group>
        @foreach (primaryLinks as link)
          <a
            href="{{ link.href }}"
            class="flex gap-2.5 items-center px-2 min-h-10 font-medium text-ui rounded-xl transition-colors"
            data-stx-link
            data-sidebar-row
            data-craft-no-drag
            title="{{ link.tooltip }}"
            data-command-destination="{{ link.label }}"
            data-command-shortcut="{{ link.shortcut }}"
            aria-keyshortcuts="{{ link.shortcut }}"
            aria-current="{{ link.active ? 'page' : 'false' }}"
          >
            <span class="grid place-items-center shrink-0 size-7 rounded-lg" data-sidebar-tile aria-hidden="true">
              <span class="size-4 {{ link.icon }}"></span>
            </span>
            <span class="flex-1 truncate">{{ link.label }}</span>
            @if(link.href === '/inbox' || link.href === '/listening')
              <span class="px-1.5 min-w-5 font-semibold text-center text-xs rounded-full" data-sidebar-badge x-cloak x-show="unreadFor('{{ link.href }}') > 0" :text="unreadBadge('{{ link.href }}')" aria-hidden="true"></span>
              <span class="sr-only" x-show="unreadFor('{{ link.href }}') > 0" :text="unreadLabel('{{ link.href }}')"></span>
            @endif
            <kbd class="px-1.5 min-w-5 font-mono text-center text-xs rounded-md" data-sidebar-shortcut aria-label="{{ link.shortcutLabel }}">{{ link.shortcut }}</kbd>
          </a>
        @endforeach
      </div>

      <div class="grid gap-0.5 shrink-0 mt-auto pt-2" data-sidebar-group>
        @foreach (utilityLinks as link)
          <a
            href="{{ link.href }}"
            class="flex gap-2.5 items-center px-2 min-h-9 font-medium text-ui rounded-xl transition-colors"
            data-stx-link
            data-sidebar-row
            data-sidebar-utility
            data-craft-no-drag
            data-command-destination="{{ link.label }}"
            title="{{ link.tooltip }}"
            aria-current="{{ link.active ? 'page' : 'false' }}"
            @if(link.href === '/settings')
              data-no-router
            @endif
            @if(link.shortcut)
              data-command-shortcut="{{ link.shortcut }}"
              aria-keyshortcuts="{{ link.shortcut }}"
            @endif
          >
            <span class="grid place-items-center shrink-0 w-7" aria-hidden="true"><span class="size-4 {{ link.icon }}"></span></span>
            <span class="flex-1 truncate">{{ link.label }}</span>
            @if(link.shortcut)
              <kbd class="px-1.5 min-w-5 font-mono text-center text-xs rounded-md" data-sidebar-shortcut aria-label="{{ link.shortcutLabel }}">{{ link.shortcut }}</kbd>
            @endif
          </a>
        @endforeach
      </div>
    </nav>
  </aside>
  </div>
</template>
