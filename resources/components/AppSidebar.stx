<script server>
const requestUrl = (typeof requestContext !== 'undefined' && requestContext.url)
  ? requestContext.url()
  : 'http://localhost/'

let currentPath = '/'
try {
  currentPath = new URL(requestUrl).pathname
}
catch {
  currentPath = '/'
}

const navLinks = [
  { href: '/composer', label: 'Composer', shortcut: '1', icon: 'i-hugeicons-edit-02' },
  { href: '/queue', label: 'Queue', shortcut: '2', icon: 'i-hugeicons-calendar-03' },
  { href: '/timeline', label: 'Timeline', shortcut: '3', icon: 'i-hugeicons-news' },
  { href: '/analytics', label: 'Analytics', shortcut: '4', icon: 'i-hugeicons-chart-line-data-01' },
  { href: '/campaigns', label: 'Campaigns', shortcut: '5', icon: 'i-hugeicons-flowchart-01' },
  { href: '/listening', label: 'Listening', shortcut: '6', icon: 'i-hugeicons-radar-02' },
  { href: '/inbox', label: 'Inbox', shortcut: '7', icon: 'i-hugeicons-message-01' },
  { href: '/discover', label: 'Discover', shortcut: '8', icon: 'i-hugeicons-compass' },
  { href: '/publication', label: 'Publication', shortcut: '9', icon: 'i-hugeicons-user-multiple' },
  { href: '/blog', label: 'Blog', shortcut: '0', icon: 'i-hugeicons-quill-write-02' },
].map((link) => ({
  ...link,
  active: currentPath === link.href || currentPath.startsWith(`${link.href}/`),
}))

const settingsActive = currentPath === '/accounts' || currentPath === '/settings' || currentPath.startsWith('/settings/')
</script>

