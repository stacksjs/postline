<script server cache>
import { workspaceInboxPublicText, workspaceLocale } from '../../app/Support/Localization/workspace'

export const publicInboxText = workspaceInboxPublicText
export const publicInboxClient = { locale: workspaceLocale, messages: publicInboxText }
</script>

<script client>
import { createI18n } from '@stacksjs/i18n/client'
import { providerLabel } from '../functions/networks'
import { relativeTime, requestJson } from '../functions/postline-client'

const { locale: language, messages: copy } = {{ publicInboxClient }}
const words = createI18n({ locale: language, messages: { [language]: copy } })
const elapsed = language === 'en' ? undefined : new Intl.RelativeTimeFormat(language, { numeric: 'auto' })

interface PublicEntry {
  id: number
  kind: 'reply' | 'mention'
  author: string
  body: string
  url: string
  postedAt: string
  read: boolean
  provider: string
  account: string
}

const entries = state<PublicEntry[]>([])
const nextOffset = state<number | null>(null)
const loading = state(true)
const syncing = state(false)
const loadError = state('')
const syncFeedback = state('')
const syncErrors = state<Array<{ provider: string, handle: string, message: string }>>([])
const marking = state(0)
const replyDialog = useRef<HTMLDialogElement>('replyDialog')
const replyEntry = state<PublicEntry | null>(null)
const replyText = state('')
const replyError = state('')
const sendingReply = state(false)
const replyFeedback = state('')
const replyInQueue = state(false)
const endpoint = '/api/postline/inbox/mentions'

async function load(offset = 0) {
  loading.set(true)
  loadError.set('')
  try {
    const { data } = await requestJson(`${endpoint}?offset=${offset}`)
    entries.set(offset ? [...entries(), ...data.entries] : data.entries)
    nextOffset.set(data.nextOffset)
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : copy.readPublicFailed)
  }
  finally {
    loading.set(false)
  }
}

async function sync() {
  syncing.set(true)
  syncFeedback.set('')
  syncErrors.set([])
  try {
    const { data } = await requestJson(`${endpoint}/sync`, { method: 'POST' })
    syncErrors.set(data.errors)
    if (data.added) syncFeedback.set(words.tc('newPublicItems', data.added))
    else if (!data.errors.length) syncFeedback.set(copy.upToDate)
    await load()
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : copy.syncPublicFailed)
  }
  finally {
    syncing.set(false)
  }
}

async function markRead(id: number) {
  if (marking()) return
  marking.set(id)
  loadError.set('')
  try {
    await requestJson(`${endpoint}/read`, { method: 'POST', body: JSON.stringify({ id }) })
    entries.set(entries().map(item => item.id === id ? { ...item, read: true } : item))
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : copy.markReadFailed)
  }
  finally {
    marking.set(0)
  }
}

function openReply(item: PublicEntry) {
  replyEntry.set(item)
  replyText.set(item.provider === 'mastodon' ? `@${item.author.replace(/^@/, '')} ` : '')
  replyError.set('')
  replyDialog.current?.showModal()
}

function closeReply() {
  if (!sendingReply()) replyDialog.current?.close()
}

async function sendReply() {
  const item = replyEntry()
  const text = replyText().trim()
  if (!item || !text || sendingReply()) return
  sendingReply.set(true)
  replyError.set('')
  replyFeedback.set('')
  try {
    const { data } = await requestJson(`${endpoint}/reply`, { method: 'POST', body: JSON.stringify({ id: item.id, text }) })
    entries.set(entries().map(entry => entry.id === item.id ? { ...entry, read: true } : entry))
    replyInQueue.set(data.status !== 'sent')
    replyFeedback.set(data.status === 'sent' ? copy.publicReplySent : data.status === 'sending' ? copy.publicReplySending : copy.publicReplyQueued)
    replyDialog.current?.close()
  }
  catch (error) {
    replyError.set(error instanceof Error ? error.message : copy.publicReplyFailed)
  }
  finally {
    sendingReply.set(false)
  }
}

onMount(() => { void load() })
</script>

<template>
  <section aria-labelledby="public-inbox-title" data-testid="public-inbox">
    <Card padding="none" className="shadow-sm">
      <header class="flex flex-wrap gap-3 items-center justify-between px-4 py-3 border-b border-line">
        <h2 class="m-0 font-semibold text-ink text-sm" id="public-inbox-title">{{ publicInboxText.publicActivity }}</h2>
        <Button size="sm" variant="secondary" :disabled="loading()" :loading="syncing()" :label="syncing() ? copy.syncing : copy.syncPublic" @click="sync">{{ publicInboxText.syncPublic }}</Button>
      </header>
      <div class="px-4 py-3" :show="loadError() || syncFeedback() || syncErrors().length">
        <p class="m-0 text-danger text-ui" role="alert" :show="loadError()" :text="loadError()"></p>
        <p class="m-0 text-body text-ui" role="status" :show="syncFeedback()" :text="syncFeedback()"></p>
        <ul class="m-0 pl-4 space-y-1 text-danger text-ui" :show="syncErrors().length" role="alert">
          <li x-for="error in syncErrors()" :text="`${providerLabel(error.provider)} · ${error.handle}: ${error.message}`"></li>
        </ul>
      </div>
      <div class="px-4 py-3 text-body text-ui" :show="replyFeedback()">
        <span role="status" :text="replyFeedback()"></span>
        <a class="ml-2 text-info underline" href="/queue" data-stx-link :show="replyInQueue()">{{ publicInboxText.openQueue }}</a>
      </div>
      <WorkspaceListSkeleton :show="loading() && !entries().length" label="{{ publicInboxText.loadingPublic }}" />
      <EmptyState :show="!loading() && !loadError() && !entries().length" variant="bare" title="{{ publicInboxText.emptyPublic }}"
        description="{{ publicInboxText.emptyPublicDescription }}">
        <StxLink class="text-info text-ui underline" to="/accounts">{{ publicInboxText.openChannels }}</StxLink>
      </EmptyState>
      <div class="divide-line divide-y" :show="entries().length">
        <article x-for="item in entries()" :key="item.id" class="grid gap-2 px-4 py-3" :class="item.read ? '' : 'bg-info-soft'">
          <div class="flex flex-wrap gap-2 items-center">
            <NetworkChip :provider="item.provider" size="small" />
            <strong class="text-ink text-ui" :text="item.author"></strong>
            <span class="text-muted text-xs" :text="`${item.kind === 'reply' ? copy.replyType : copy.mentionType} · ${item.account}`"></span>
            <time class="text-muted text-xs" :datetime="item.postedAt" :text="relativeTime(item.postedAt, { formatter: elapsed })"></time>
          </div>
          <p class="m-0 break-words text-body text-ui whitespace-pre-line" :show="item.body" :text="item.body"></p>
          <div class="flex flex-wrap gap-3 items-center">
            <Button variant="ghost" size="xs" :ariaLabel="words.t('replyToAuthor', { author: item.author })" @click="openReply(item)">{{ publicInboxText.reply }}</Button>
            <a class="text-info text-ui underline" :href="item.url" target="_blank" rel="noopener noreferrer">{{ publicInboxText.openOriginal }}</a>
            <Button variant="ghost" size="xs" :show="!item.read" :disabled="marking() !== 0" :loading="marking() === item.id" :ariaLabel="words.t('markAuthorRead', { author: item.author })" @click="markRead(item.id)">{{ publicInboxText.markRead }}</Button>
          </div>
        </article>
      </div>
      <Button variant="ghost" size="sm" fullWidth="true" :show="nextOffset() !== null" :loading="loading()" :disabled="syncing()" @click="load(nextOffset() ?? 0)">{{ publicInboxText.morePublic }}</Button>
    </Card>
    <dialog ref="replyDialog" class="p-0 max-w-lg w-[calc(100%_-_2rem)] text-ink bg-panel border border-line rounded-2xl shadow-xl" aria-labelledby="public-reply-title" aria-describedby="public-reply-account" @cancel.prevent="closeReply">
      <form class="grid gap-3 p-4" @submit.prevent="sendReply">
        <h2 id="public-reply-title" class="m-0 font-semibold text-base">{{ publicInboxText.publicReply }}</h2>
        <p id="public-reply-account" class="m-0 text-muted text-ui" :text="replyEntry() ? words.t('replyFrom', { account: replyEntry().account, network: providerLabel(replyEntry().provider) }) : ''"></p>
        <label class="grid gap-1 text-body text-ui">
          {{ publicInboxText.replyText }}
          <textarea class="p-2 w-full text-ink bg-panel border border-field-line rounded-xl" rows="4" maxlength="4000" autofocus required x-model="replyText" :disabled="sendingReply()"></textarea>
        </label>
        <p class="m-0 text-danger text-ui" role="alert" :show="replyError()" :text="replyError()"></p>
        <div class="flex gap-2 justify-end">
          <Button size="sm" variant="ghost" type="button" :disabled="sendingReply()" @click="closeReply">{{ publicInboxText.cancel }}</Button>
          <Button size="sm" type="submit" :disabled="!replyText().trim()" :loading="sendingReply()" :label="sendingReply() ? copy.sending : copy.sendPublicReply">{{ publicInboxText.sendPublicReply }}</Button>
        </div>
      </form>
    </dialog>
  </section>
</template>
