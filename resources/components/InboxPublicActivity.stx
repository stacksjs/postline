<script client>
import { providerLabel } from '../functions/networks'
import { relativeTime, requestJson } from '../functions/postline-client'

interface PublicEntry {
  id: number
  kind: 'reply' | 'mention'
  author: string
  body: string
  url: string
  postedAt: string
  read: boolean
  provider: string
  account: string
}

const entries = state<PublicEntry[]>([])
const nextOffset = state<number | null>(null)
const loading = state(true)
const syncing = state(false)
const loadError = state('')
const syncFeedback = state('')
const syncErrors = state<Array<{ provider: string, handle: string, message: string }>>([])
const marking = state(0)
const endpoint = '/api/postline/inbox/mentions'

async function load(offset = 0) {
  loading.set(true)
  loadError.set('')
  try {
    const { data } = await requestJson(`${endpoint}?offset=${offset}`)
    entries.set(offset ? [...entries(), ...data.entries] : data.entries)
    nextOffset.set(data.nextOffset)
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : 'Could not read public activity.')
  }
  finally {
    loading.set(false)
  }
}

async function sync() {
  syncing.set(true)
  syncFeedback.set('')
  syncErrors.set([])
  try {
    const { data } = await requestJson(`${endpoint}/sync`, { method: 'POST' })
    syncErrors.set(data.errors)
    if (data.added) syncFeedback.set(`${data.added} new ${data.added === 1 ? 'item' : 'items'}.`)
    else if (!data.errors.length) syncFeedback.set('You’re up to date.')
    await load()
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : 'Could not sync public activity.')
  }
  finally {
    syncing.set(false)
  }
}

async function markRead(id: number) {
  marking.set(id)
  loadError.set('')
  try {
    await requestJson(`${endpoint}/read`, { method: 'POST', body: JSON.stringify({ id }) })
    entries.set(entries().map(item => item.id === id ? { ...item, read: true } : item))
  }
  catch (error) {
    loadError.set(error instanceof Error ? error.message : 'Could not mark the item as read.')
  }
  finally {
    marking.set(0)
  }
}

onMount(() => { void load() })
</script>

<template>
  <section aria-labelledby="public-inbox-title" data-testid="public-inbox">
    <Card padding="none" className="shadow-sm">
      <header class="flex flex-wrap gap-3 items-center justify-between px-4 py-3 border-b border-line">
        <h2 class="m-0 font-semibold text-ink text-sm" id="public-inbox-title">Replies and mentions</h2>
        <Button size="sm" variant="secondary" :disabled="syncing() || loading()" @click="sync"><span :text="syncing() ? 'Syncing…' : 'Sync public activity'"></span></Button>
      </header>
      <div class="px-4 py-3" :show="loadError() || syncFeedback() || syncErrors().length">
        <p class="m-0 text-danger text-ui" role="alert" :show="loadError()" :text="loadError()"></p>
        <p class="m-0 text-body text-ui" role="status" :show="syncFeedback()" :text="syncFeedback()"></p>
        <ul class="m-0 pl-4 space-y-1 text-danger text-ui" :show="syncErrors().length" role="alert">
          <li x-for="error in syncErrors()" :text="`${providerLabel(error.provider)} · ${error.handle}: ${error.message}`"></li>
        </ul>
      </div>
      <WorkspaceListSkeleton :show="loading() && !entries().length" label="Loading public activity" />
      <EmptyState :show="!loading() && !loadError() && !entries().length" variant="bare" title="No replies or mentions yet"
        description="Sync to collect recent public activity for connected Bluesky and Mastodon accounts.">
        <StxLink class="text-info text-ui underline" to="/accounts">Open Channels</StxLink>
      </EmptyState>
      <div class="divide-line divide-y" :show="entries().length">
        <article x-for="item in entries()" :key="item.id" class="grid gap-2 px-4 py-3" :class="item.read ? '' : 'bg-info-soft'">
          <div class="flex flex-wrap gap-2 items-center">
            <NetworkChip :provider="item.provider" size="small" />
            <strong class="text-ink text-ui" :text="item.author"></strong>
            <span class="text-muted text-xs" :text="`${item.kind === 'reply' ? 'Reply' : 'Mention'} · ${item.account}`"></span>
            <time class="text-muted text-xs" :datetime="item.postedAt" :text="relativeTime(item.postedAt)"></time>
          </div>
          <p class="m-0 break-words text-body text-ui whitespace-pre-line" :show="item.body" :text="item.body"></p>
          <div class="flex flex-wrap gap-3 items-center">
            <a class="text-info text-ui underline" :href="item.url" target="_blank" rel="noopener noreferrer">Open original post</a>
            <button class="text-muted text-ui underline" type="button" :show="!item.read" :disabled="marking() !== 0" @click="markRead(item.id)">Mark as read</button>
          </div>
        </article>
      </div>
      <button class="p-3 w-full text-center text-muted text-ui hover:text-ink hover:bg-panel-2" type="button" :show="nextOffset() !== null" :disabled="loading()" @click="load(nextOffset() ?? 0)">Load more activity</button>
    </Card>
  </section>
</template>
