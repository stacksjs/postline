<script server cache>
import { workspaceXBrowserSessionText, workspaceLocale } from '../../app/Support/Localization/workspace'

export const xBrowserSessionText = workspaceXBrowserSessionText
export const xBrowserSessionClient = { locale: workspaceLocale, messages: workspaceXBrowserSessionText }
</script>

<script client>
import { createI18n } from '@stacksjs/i18n/client'
import type { TwitterBrowserSessionSnapshot } from '../../app/Services/Social/TwitterBrowserSession'
import type { XBrowserWindow } from '../functions/x-browser-session'
import { requestJson } from '../functions/postline-client'
import { openXBrowser, readXBrowserSession, xBrowserWindow } from '../functions/x-browser-session'

const { locale: language, messages: copy } = {{ xBrowserSessionClient }}
const words = createI18n({ locale: language, messages: { [language]: copy } })
const numbers = new Intl.NumberFormat(language)
const plural = new Intl.PluralRules(language)

const xSessionDesktop = useNativeDesktop()
const xBrowser = state<XBrowserWindow | null>(null)
const xSession = state<TwitterBrowserSessionSnapshot | null>(null)
const xSessionBusy = state(false)
const xSessionNeedsCheck = state(false)
const xSessionFeedback = state('')

const xSessionEndpoint = '/api/postline/twitter/browser-session'

async function loadSession() {
  try {
    const { data } = await requestJson(xSessionEndpoint, { cache: 'no-store' }, copy.loadFailed)
    xSession.set(data)
    xSessionNeedsCheck.set(data.needsCheck)
    if (data.needsCheck) xSessionFeedback.set(data.needsLayoutCheck ? copy.layout : copy.attentionBody)
  }
  catch (error) {
    xSessionFeedback.set(error instanceof Error ? error.message : copy.loadFailed)
  }
}

xSessionDesktop.onReady((host) => {
  const windowApi = xBrowserWindow(host)
  if (!windowApi) return
  xBrowser.set(windowApi)
  void loadSession()
})

async function openSession() {
  const windowApi = xBrowser()
  const current = xSession()
  if (!windowApi || !current || xSessionBusy()) return
  xSessionBusy.set(true)
  try {
    await openXBrowser(windowApi, current.profile)
    xSessionFeedback.set(current.needsLayoutCheck ? copy.layout : copy.openHelp)
  }
  catch {
    xSessionFeedback.set(copy.openFailed)
  }
  finally {
    xSessionBusy.set(false)
  }
}

async function pauseReads(message: string, layout = false) {
  xSessionNeedsCheck.set(true)
  xSessionFeedback.set(message)
  const current = xSession()
  if (layout && current) xSession.set({ ...current, needsCheck: true, needsLayoutCheck: true })
  try {
    const { data } = await requestJson(xSessionEndpoint, { method: 'POST', body: JSON.stringify({ needs_check: true, needs_layout_check: layout }) }, copy.saveFailed)
    xSession.set(data)
  }
  catch {
    xSessionFeedback.set(`${message} ${copy.saveFailed}`)
  }
}

async function returnToX(browser: XBrowserWindow, profile: string, reason: 'needs-attention' | 'signed-out') {
  const paused = pauseReads(reason === 'needs-attention'
    ? copy.attention
    : copy.signInFirst)
  await openXBrowser(browser, profile).catch(() => {})
  await paused
}

async function checkSignIn() {
  const windowApi = xBrowser()
  const current = xSession()
  if (!windowApi || !current || xSessionBusy()) return
  xSessionBusy.set(true)
  try {
    const status = await readXBrowserSession(windowApi, current.profile, current.needsLayoutCheck ? 'listening' : 'sign-in')
    if (status.state === 'needs-attention') {
      await returnToX(windowApi, current.profile, status.state)
      return
    }
    if (status.state === 'unavailable') {
      xSessionFeedback.set(copy.checkReady)
      return
    }
    if (status.state === 'connected' && current.needsLayoutCheck && (!status.posts || status.readIssue)) {
      xSessionFeedback.set(copy.layout)
      return
    }

    const body = status.state === 'connected'
      ? { handle: status.handle, checked_layout: current.needsLayoutCheck }
      : { signed_out: true }
    const { data } = await requestJson(xSessionEndpoint, { method: 'POST', body: JSON.stringify(body) }, copy.saveFailed)
    xSession.set(data)
    xSessionNeedsCheck.set(data.needsCheck)
    xSessionFeedback.set(data.handle ? words.t('signedIn', { handle: data.handle }) : copy.signedOut)
  }
  catch (error) {
    xSessionFeedback.set(error instanceof Error ? error.message : copy.checkFailed)
  }
  finally {
    xSessionBusy.set(false)
  }
}

async function readConfirmedSession(browser: XBrowserWindow, profile: string, handle: string, kind: 'sign-in' | 'metrics' | 'listening') {
  const result = await readXBrowserSession(browser, profile, kind)
  if (result.state === 'needs-attention' || result.state === 'signed-out') {
    await returnToX(browser, profile, result.state)
    return
  }
  if (result.state === 'connected') {
    if (result.handle.toLowerCase() === handle.toLowerCase()) return result
    await pauseReads(copy.differentAccount)
    return
  }
  xSessionFeedback.set(copy.importReady)
}

async function openReadPage(page: 'profile' | 'mentions') {
  const windowApi = xBrowser()
  const current = xSession()
  if (!windowApi || !current?.handle || xSessionBusy() || xSessionNeedsCheck()) return
  const url = page === 'profile'
    ? 'https://x.com/' + encodeURIComponent(current.handle)
    : 'https://x.com/notifications/mentions'
  xSessionBusy.set(true)
  try {
    // Craft reuses a named window without replacing its page. On a cold
    // launch it opens the destination directly in the same WebKit store.
    await openXBrowser(windowApi, current.profile, url)
    const confirmed = await readConfirmedSession(windowApi, current.profile, current.handle, 'sign-in')
    if (!confirmed) return
    await windowApi._call('loadURL', { url }, current.profile)
    xSessionFeedback.set(page === 'profile' ? copy.profileOpened : copy.mentionsOpened)
  }
  catch {
    xSessionFeedback.set(copy.pageOpenFailed)
  }
  finally {
    xSessionBusy.set(false)
  }
}

async function captureMetrics() {
  const windowApi = xBrowser()
  const current = xSession()
  if (!windowApi || !current?.handle || xSessionBusy() || xSessionNeedsCheck()) return
  xSessionBusy.set(true)
  try {
    const result = await readConfirmedSession(windowApi, current.profile, current.handle, 'metrics')
    if (!result) return
    const { data } = await requestJson(`${xSessionEndpoint}/metrics`, {
      method: 'POST',
      body: JSON.stringify({ handle: result.handle, measurements: result.measurements }),
    }, copy.saveEngagementFailed)
    xSessionFeedback.set(data.synced
      ? words.t(plural.select(data.synced) === 'one' ? 'metricsOne' : 'metricsMany', { count: numbers.format(data.synced) })
      : copy.noMatches)
  }
  catch (error) {
    xSessionFeedback.set(error instanceof Error ? error.message : copy.readEngagementFailed)
  }
  finally {
    xSessionBusy.set(false)
  }
}

async function captureListening() {
  const windowApi = xBrowser()
  const current = xSession()
  if (!windowApi || !current?.handle || xSessionBusy() || xSessionNeedsCheck()) return
  xSessionBusy.set(true)
  try {
    const result = await readConfirmedSession(windowApi, current.profile, current.handle, 'listening')
    if (!result) return
    if (result.readIssue === 'layout') {
      await pauseReads(copy.layout, true)
      return
    }
    if (result.readIssue === 'loading') {
      xSessionFeedback.set(copy.importReady)
      return
    }
    if (!result.posts) {
      xSessionFeedback.set(copy.openMentions)
      return
    }
    const { data } = await requestJson(`${xSessionEndpoint}/listening`, {
      method: 'POST',
      body: JSON.stringify({ handle: result.handle, posts: result.posts }),
    }, copy.importFailed)
    xSessionFeedback.set(data.watches
      ? words.t(plural.select(data.created) === 'one' ? 'mentionsOne' : 'mentionsMany', { count: numbers.format(data.created) })
      : copy.createWatch)
  }
  catch (error) {
    xSessionFeedback.set(error instanceof Error ? error.message : copy.importFailed)
  }
  finally {
    xSessionBusy.set(false)
  }
}
</script>

<template>
  <section aria-labelledby="x-browser-session-title" :if="xBrowser()">
    <Card padding="sm" className="shadow-sm">
      <div class="grid gap-2">
        <h2 class="m-0 font-semibold text-ink text-sm" id="x-browser-session-title">{{ xBrowserSessionText.title }}</h2>
        <p class="m-0 text-body text-xs">{{ xBrowserSessionText.description }}</p>
        <p class="m-0 text-muted text-xs" :show="xSession()?.handle" :text="xSession()?.handle ? words.t('lastConfirmed', { handle: xSession().handle }) : ''"></p>
        <div class="flex flex-wrap gap-2 items-center">
          <Button variant="secondary" size="xs" label="{{ xBrowserSessionText.open }}" :disabled="!xSession() || xSessionBusy()" @click="openSession" />
          <Button variant="secondary" size="xs" label="{{ xBrowserSessionText.check }}" :disabled="!xSession() || xSessionBusy()" @click="checkSignIn" />
          <Button variant="secondary" size="xs" label="{{ xBrowserSessionText.metrics }}" :show="xSession()?.handle" :disabled="xSessionBusy() || xSessionNeedsCheck()" @click="captureMetrics" />
          <Button variant="secondary" size="xs" label="{{ xBrowserSessionText.mentions }}" :show="xSession()?.handle" :disabled="xSessionBusy() || xSessionNeedsCheck()" @click="captureListening" />
          <Button variant="secondary" size="xs" label="{{ xBrowserSessionText.profile }}" :show="xSession()?.handle" :disabled="xSessionBusy() || xSessionNeedsCheck()" @click="openReadPage('profile')" />
          <Button variant="secondary" size="xs" label="{{ xBrowserSessionText.openMentionsPage }}" :show="xSession()?.handle" :disabled="xSessionBusy() || xSessionNeedsCheck()" @click="openReadPage('mentions')" />
          <a class="text-info text-xs underline" href="https://help.x.com/en/rules-and-policies/x-automation" target="_blank" rel="noopener noreferrer">{{ xBrowserSessionText.rules }}</a>
        </div>
        <p class="m-0 text-body text-xs" role="status" :show="xSessionFeedback()" :text="xSessionFeedback()"></p>
      </div>
    </Card>
  </section>
</template>
