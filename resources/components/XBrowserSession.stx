<script client>
import type { XBrowserWindow } from '../functions/x-browser-session'
import { requestJson } from '../functions/postline-client'
import { openXBrowser, readXBrowserSession, xBrowserWindow } from '../functions/x-browser-session'

const xSessionDesktop = useNativeDesktop()
const xBrowser = state<XBrowserWindow | null>(null)
const xSession = state<{ profile: string, handle: string | null } | null>(null)
const xSessionBusy = state(false)
const xSessionFeedback = state('')

const xSessionEndpoint = '/api/postline/twitter/browser-session'

async function loadSession() {
  try {
    const { data } = await requestJson(xSessionEndpoint, { cache: 'no-store' }, 'Could not load the X browser session.')
    xSession.set(data)
  }
  catch (error) {
    xSessionFeedback.set(error instanceof Error ? error.message : 'Could not load the X browser session.')
  }
}

xSessionDesktop.onReady((host) => {
  const windowApi = xBrowserWindow(host)
  if (!windowApi) return
  xBrowser.set(windowApi)
  void loadSession()
})

async function openSession() {
  const windowApi = xBrowser()
  const current = xSession()
  if (!windowApi || !current || xSessionBusy()) return
  xSessionBusy.set(true)
  try {
    await openXBrowser(windowApi, current.profile)
    xSessionFeedback.set('Return here and select Check sign-in after signing in or out on X.')
  }
  catch {
    xSessionFeedback.set('Could not open X. Browser sessions require macOS 14 or later.')
  }
  finally {
    xSessionBusy.set(false)
  }
}

async function checkSignIn() {
  const windowApi = xBrowser()
  const current = xSession()
  if (!windowApi || !current || xSessionBusy()) return
  xSessionBusy.set(true)
  try {
    const status = await readXBrowserSession(windowApi, current.profile)
    if (status.state === 'needs-attention') {
      xSessionFeedback.set('X needs your attention. Open X to continue there.')
      return
    }
    if (status.state === 'unavailable') {
      xSessionFeedback.set('Open X and wait for the page to finish loading before checking again.')
      return
    }

    const body = status.state === 'connected' ? { handle: status.handle } : { signed_out: true }
    const { data } = await requestJson(xSessionEndpoint, { method: 'POST', body: JSON.stringify(body) }, 'Could not save the X sign-in.')
    xSession.set({ ...current, handle: data.handle })
    xSessionFeedback.set(data.handle ? `Signed in to X as @${data.handle}.` : 'Signed out of X. Open X to sign in.')
  }
  catch (error) {
    xSessionFeedback.set(error instanceof Error ? error.message : 'Could not check the X sign-in.')
  }
  finally {
    xSessionBusy.set(false)
  }
}

async function captureMetrics() {
  const windowApi = xBrowser()
  const current = xSession()
  if (!windowApi || !current?.handle || xSessionBusy()) return
  xSessionBusy.set(true)
  try {
    const result = await readXBrowserSession(windowApi, current.profile, 'metrics')
    if (result.state !== 'connected' || result.handle.toLowerCase() !== current.handle.toLowerCase()) {
      xSessionFeedback.set('Open X and check the sign-in before reading engagement.')
      return
    }
    const { data } = await requestJson(`${xSessionEndpoint}/metrics`, {
      method: 'POST',
      body: JSON.stringify({ handle: result.handle, measurements: result.measurements }),
    }, 'Could not save X engagement.')
    xSessionFeedback.set(data.synced
      ? `Updated ${data.synced} published ${data.synced === 1 ? 'post' : 'posts'} in Analytics.`
      : 'No visible counts matched your published X posts. Open your profile in the X window and try again.')
  }
  catch (error) {
    xSessionFeedback.set(error instanceof Error ? error.message : 'Could not read X engagement.')
  }
  finally {
    xSessionBusy.set(false)
  }
}

async function captureListening() {
  const windowApi = xBrowser()
  const current = xSession()
  if (!windowApi || !current?.handle || xSessionBusy()) return
  xSessionBusy.set(true)
  try {
    const result = await readXBrowserSession(windowApi, current.profile, 'listening')
    if (result.state !== 'connected' || result.handle.toLowerCase() !== current.handle.toLowerCase()) {
      xSessionFeedback.set('Open X and check the sign-in before importing posts.')
      return
    }
    if (!result.posts) {
      xSessionFeedback.set('Open Search or Mentions in the X window first.')
      return
    }
    const { data } = await requestJson(`${xSessionEndpoint}/listening`, {
      method: 'POST',
      body: JSON.stringify({ handle: result.handle, posts: result.posts }),
    }, 'Could not import X posts.')
    xSessionFeedback.set(data.watches
      ? `Saved ${data.created} new X ${data.created === 1 ? 'mention' : 'mentions'} in Listening.`
      : 'Create an active Listening watch with X browser session as its source.')
  }
  catch (error) {
    xSessionFeedback.set(error instanceof Error ? error.message : 'Could not import X posts.')
  }
  finally {
    xSessionBusy.set(false)
  }
}
</script>

<template>
  <section aria-labelledby="x-browser-session-title" :if="xBrowser()">
    <Card padding="sm" className="shadow-sm">
      <div class="grid gap-2">
        <h2 class="m-0 font-semibold text-ink text-sm" id="x-browser-session-title">X browser session</h2>
        <p class="m-0 text-body text-xs">Sign in to X in a separate window. WebKit keeps the sign-in on this Mac. X may restrict accounts that use scripted access.</p>
        <p class="m-0 text-muted text-xs" :show="xSession()?.handle" :text="xSession()?.handle ? 'Last confirmed as @' + xSession().handle : ''"></p>
        <div class="flex flex-wrap gap-2 items-center">
          <Button variant="secondary" size="xs" label="Open X" :disabled="!xSession() || xSessionBusy()" @click="openSession" />
          <Button variant="secondary" size="xs" label="Check sign-in" :disabled="!xSession() || xSessionBusy()" @click="checkSignIn" />
          <Button variant="secondary" size="xs" label="Read visible engagement" :show="xSession()?.handle" :disabled="xSessionBusy()" @click="captureMetrics" />
          <Button variant="secondary" size="xs" label="Import visible mentions" :show="xSession()?.handle" :disabled="xSessionBusy()" @click="captureListening" />
          <a class="text-info text-xs underline" href="https://help.x.com/en/rules-and-policies/x-automation" target="_blank" rel="noopener noreferrer">X automation rules</a>
        </div>
        <p class="m-0 text-body text-xs" role="status" :show="xSessionFeedback()" :text="xSessionFeedback()"></p>
      </div>
    </Card>
  </section>
</template>
