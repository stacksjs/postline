<script server>
// The welcome email, sent once a waitlist address is confirmed. It says what
// the list is for and how to leave it, and nothing about the framework
// Postline is built on.
//
// MAIL_POSTAL_ADDRESS, when set, is printed in the footer (see subscription-confirm.stx).
const email = props.email || ''
const unsubscribeUrl = props.unsubscribeUrl || '#'
const appName = props.appName || 'Postline'
const appUrl = props.appUrl || ''
const year = props.year || new Date().getFullYear()
const postalAddress = String(process.env.MAIL_POSTAL_ADDRESS || '').trim()
const subject = `You are on the ${appName} waitlist`
</script>

<EmailLayout title="{{ subject }}" preheader="We will tell you when hosted {{ appName }} opens." brand="{{ appName }}" brandUrl="{{ appUrl }}" accent="#0a0a0b">
  <EmailText size="heading">You are on the list.</EmailText>
  <EmailText>When hosted {{ appName }} opens we will send one email with the price and how to start. That is the only reason this list exists.</EmailText>
  <EmailText>You do not have to wait: {{ appName }} runs on your own computer today, free, with your own network apps.</EmailText>

  @if (appUrl)
    <EmailButton href="{{ appUrl }}" bg="#0a0a0b">Get {{ appName }}</EmailButton>
  @endif

  <EmailDivider />
  <EmailText size="sm" spacing="0">You are getting this because {{ email }} joined the waitlist. Changed your mind? <a href="{{ unsubscribeUrl }}" style="color:#71717a;text-decoration:underline;">Unsubscribe</a> in one click.</EmailText>

  <template #footer>
    <tr>
      <td class="email-muted" style="padding:16px 40px 20px;border-top:1px solid #e4e4e7;color:#a1a1aa;font-size:11px;text-align:center;">
        &copy; {{ year }} {{ appName }}
        @if (postalAddress)
          <br>{{ postalAddress }}
        @endif
      </td>
    </tr>
  </template>
</EmailLayout>
