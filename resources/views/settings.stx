@extends('layouts/postline')

@section('title', 'Postline - Settings')
@section('description', 'Configure Postline publishing defaults.')

@section('content')
  <section class="grid gap-5" data-postline-page="settings" data-testid="settings-page">
    <header class="flex gap-4 items-center justify-between min-h-11">
      <div>
        <p class="mb-1.5 font-bold text-[11px] text-muted tracking-wider uppercase">Settings</p>
        <h1 class="m-0 font-bold text-[22px] text-ink tracking-normal">Publishing</h1>
        <p class="mb-0 mt-1.5 text-[13px] text-muted">Defaults for Postline. Bluesky credentials live on Accounts.</p>
      </div>
      <button class="inline-flex items-center justify-center px-4 h-9 font-bold text-ink text-sm bg-panel hover:bg-zinc-50 border border-line rounded-xl shadow-sm transition-colors" type="button" @click="signOut">Sign out</button>
    </header>

    <section class="grid gap-3.5 lg:grid-cols-2">
      <article class="grid gap-3 lg:col-span-2 p-4 bg-panel border border-line rounded-2xl shadow-sm">
        <header class="flex gap-3 items-center justify-between pb-3 border-b border-line">
          <div>
            <strong class="text-[13px]">Appearance</strong>
            <p class="mb-0 mt-1 text-muted text-xs">Light, dark, or match your system.</p>
          </div>
          <!-- Active state binds to a data attribute rather than :class: the
              binding removes the attribute on false, the styling lives in CSS
              below, and no dynamically-applied class means nothing to safelist. -->
          <div class="grid grid-cols-3 p-0.5 bg-panel-3 border border-line rounded-xl" role="group" aria-label="Theme">
            <button class="px-3 py-1.5 min-w-16 font-bold text-xs rounded-lg transition-colors" type="button" data-theme-option :data-active="themePref() === 'light'" @click="setTheme('light')">Light</button>
            <button class="px-3 py-1.5 min-w-16 font-bold text-xs rounded-lg transition-colors" type="button" data-theme-option :data-active="themePref() === 'dark'" @click="setTheme('dark')">Dark</button>
            <button class="px-3 py-1.5 min-w-16 font-bold text-xs rounded-lg transition-colors" type="button" data-theme-option :data-active="themePref() === 'system'" @click="setTheme('system')">System</button>
          </div>
        </header>
      </article>

      <article class="grid gap-3 p-4 bg-panel border border-line rounded-2xl shadow-sm">
        <header class="flex gap-3 items-center justify-between pb-3 border-b border-line">
          <div>
            <strong class="text-[13px]">Bluesky connection</strong>
            <p class="mb-0 mt-1 text-muted text-xs" :text="blueskySummary()">Checking…</p>
          </div>
          <span class="px-2.5 py-1 font-bold text-[11px] border rounded-full" data-bluesky-pill :data-state="blueskyState()" :text="blueskyPill()">Checking</span>
        </header>
        <p class="m-0 leading-relaxed text-[13px] text-body">Postline uses a Bluesky app password (not your main login). You can also set <code class="px-1 py-0.5 text-xs bg-panel-3 rounded">BLUESKY_IDENTIFIER</code> and <code class="px-1 py-0.5 text-xs bg-panel-3 rounded">BLUESKY_APP_PASSWORD</code> in <code class="px-1 py-0.5 text-xs bg-panel-3 rounded">.env</code> for local dev.</p>
        <a class="inline-flex items-center justify-center px-4 h-9 w-fit font-bold text-on-accent text-sm bg-accent hover:bg-neutral-800 rounded-xl transition-colors" href="/accounts" data-stx-link>Manage on Accounts</a>
      </article>

      <article class="grid gap-3 p-4 bg-panel border border-line rounded-2xl shadow-sm">
        <header class="flex gap-3 items-center justify-between pb-3 border-b border-line">
          <strong class="text-[13px]">Composer</strong>
          <span class="text-muted text-xs">Bluesky</span>
        </header>
        <label class="flex gap-4 items-center justify-between text-[13px] text-body">
          <span>Character limit</span>
          <span class="font-bold text-ink" :text="charLimit()">300</span>
        </label>
        <label class="flex gap-4 items-center justify-between text-[13px] text-body">
          <span>Default mode</span>
          <span class="text-muted">Single post</span>
        </label>
        <label class="flex gap-4 items-center justify-between text-[13px] text-body">
          <span>Auto-save drafts</span>
          <span class="font-bold text-emerald-700">On</span>
        </label>
      </article>
    </section>
  </section>


  <script client>
    const readStoredTheme = () => {
      try {
        return localStorage.getItem('theme') || 'system'
      }
      catch {
        return 'system'
      }
    }

    const themePref = state(readStoredTheme())
    const blueskySummary = state('Checking…')
    const blueskyPill = state('Checking')
    const blueskyState = state('')
    const charLimit = state(300)

    /**
     * Applies the preference to the root html element.
     *
     * stx ships `useColorMode`, which is what this should be, but it cannot
     * express what Postline needs on two counts (see stacksjs/stx issue):
     *   1. `applyDOM` sets EITHER `darkClass` OR `attribute`, never both, and
     *      the app needs `html.dark` (every dark: utility and the CSS-var
     *      overrides key off it) together with `data-theme`.
     *   2. It persists only 'light' | 'dark' | 'auto'. Postline stores
     *      'system', which `readPersisted` rejects — adopting it would rewrite
     *      the key to 'auto' and silently break the layout's pre-paint block,
     *      which matches on 'system'.
     * Revisit once either is addressed.
     */
    const applyTheme = (pref) => {
      const dark = pref === 'dark'
        || (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
      document.documentElement.classList.toggle('dark', dark)
      document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light')
    }

    const setTheme = (pref) => {
      themePref.set(pref)
      try {
        localStorage.setItem('theme', pref)
      }
      catch {}
      applyTheme(pref)
    }

    // Signal-backed cookie: setting it to '' emits max-age=0, and it adds
    // Secure automatically over https, which the hand-rolled string did not.
    const authToken = useCookie('auth-token')

    /**
     * Navigation side effect: renders nothing. Deliberately a hard navigation
     * rather than stx `navigate()` — signing out should drop all in-memory
     * state, which an SPA transition would preserve.
     */
    const signOut = () => {
      authToken.set('')
      location.assign('/login')
    }

    onMount(() => {
      // Keep 'system' live if the OS theme flips while the page is open.
      // useEventListener unsubscribes on destroy; a raw addEventListener here
      // would outlive the SPA swap.
      useEventListener('change', () => {
        if (themePref() === 'system') applyTheme('system')
      }, { target: matchMedia('(prefers-color-scheme: dark)') })

      void postlineBluesky?.fetchStatus().then((data) => {
        if (data?.characterLimit) charLimit.set(data.characterLimit)
        blueskySummary.set(data.canPublish
          ? `@${data.handle} is connected and ready to publish.`
          : data.handle
            ? `@${data.handle} needs an app password before publishing.`
            : 'No Bluesky account connected yet.')
        blueskyPill.set(data.canPublish ? 'Ready' : 'Setup')
        blueskyState.set(data.canPublish ? 'ready' : 'setup')
      }).catch(() => {
        blueskySummary.set('Could not load Bluesky status.')
        blueskyPill.set('Unknown')
        blueskyState.set('setup')
      })
    })
  </script>
@endsection
