@extends('layouts/settings')

<script server cache>
import manifest from '../../package.json'
import { workspaceLocale, workspaceSettingsText } from '../../app/Support/Localization/workspace'

export const buildVersion = manifest.version
export const settingsLocale = workspaceLocale
export const settingsText = workspaceSettingsText.labels
export const settingsCopy = { locale: workspaceLocale, messages: workspaceSettingsText.client }
export const settingsAppearanceOptions = [
  { value: 'light', label: settingsText.light },
  { value: 'dark', label: settingsText.dark },
  { value: 'auto', label: settingsText.automatic },
]
</script>

@section('title'){{ settingsText.documentTitle }}@endsection

@section('content')
  @meta('description', settingsText.description)
  {{--
    The Settings window stx ships: the two columns System Settings has, with
    its sidebar, search, panes and Mac controls. In the desktop app the
    workspace opens this page in a window of its own (craft.window.open, from
    layouts/app.stx); in a browser it is the whole page, with a way back.
  --}}
  <main id="workspace-content" tabindex="-1" data-postline-page="settings" data-testid="settings-page" lang="{{ settingsLocale }}">
    <SettingsWindow id="postline-settings" title="{{ settingsText.title }}" searchPlaceholder="{{ settingsText.search }}" storageKey="postline" v-model:pane="pane">
      <template #account>
        <a class="inline-flex gap-1.5 items-center px-2 py-1 text-muted text-ui hover:text-ink" href="/composer" data-no-router x-show="!ownWindow()" data-settings-back>
          <span class="h-3.5 w-3.5 i-hugeicons-arrow-left-01" aria-hidden="true"></span>
          {{ settingsText.back }}
        </a>
      </template>
      <template #sidebar>
        <SettingsSidebarGroup>
          <SettingsSidebarItem id="general" label="{{ settingsText.general }}" icon="i-hugeicons-settings-01" tone="grey" />
          <SettingsSidebarItem id="appearance" label="{{ settingsText.appearance }}" icon="i-hugeicons-sun-moon" tone="ink" />
        </SettingsSidebarGroup>
        <SettingsSidebarGroup>
          <SettingsSidebarItem id="channels" label="{{ settingsText.channels }}" icon="i-hugeicons-share-08" tone="blue" keywords="{{ settingsText.channelKeywords }}" />
          <SettingsSidebarItem id="notifications" label="{{ settingsText.notifications }}" icon="i-hugeicons-notification-01" tone="red" keywords="{{ settingsText.notificationKeywords }}" />
          <SettingsSidebarItem id="composer" label="{{ settingsText.composer }}" icon="i-hugeicons-pencil-edit-02" tone="orange" />
          <SettingsSidebarItem id="ai" label="{{ settingsText.ai }}" icon="i-hugeicons-sparkles" tone="purple" keywords="anthropic openai ollama claude api key campaign planner" />
          <SettingsSidebarItem id="deletion" label="{{ settingsText.cleanup }}" icon="i-hugeicons-delete-02" tone="red" keywords="retention delete cleanup" />
          <SettingsSidebarItem id="data" label="{{ settingsText.data }}" icon="i-hugeicons-hard-drive" tone="grey" keywords="{{ settingsText.dataKeywords }}" />
        </SettingsSidebarGroup>
        <div x-show="!ownWindow()">
          <SettingsSidebarGroup>
            <SettingsSidebarItem id="account" label="{{ settingsText.account }}" icon="i-hugeicons-user" tone="indigo" keywords="{{ settingsText.accountKeywords }}" />
          </SettingsSidebarGroup>
        </div>
        <SettingsSidebarGroup>
          <SettingsSidebarItem id="about" label="{{ settingsText.about }}" icon="i-hugeicons-information-circle" tone="grey" keywords="version software update log troubleshooting" />
        </SettingsSidebarGroup>
      </template>

      <SettingsPane id="general" title="{{ settingsText.general }}" active>
        <SettingsGroup>
          <SettingsRow label="{{ settingsText.channels }}" setting="channels-summary" to="channels" :value="channelPill()" />
          <SettingsRow label="{{ settingsText.automaticDeletion }}" setting="deletion-summary" to="deletion" :value="statusPill()" />
          <SettingsRow label="{{ settingsText.appearance }}" setting="appearance-summary" to="appearance" />
          <SettingsRow label="{{ settingsText.notifications }}" setting="notifications-summary" to="notifications" />
        </SettingsGroup>

        {{--
          The workspace. Its time zone is the one every schedule, campaign
          and chart uses, so changing it here moves them together.
        --}}
        <SettingsGroup title="{{ settingsText.workspace }}" footer="{{ settingsText.workspaceHelp }}">
          <SettingsRow label="{{ settingsText.workspace }}" setting="workspace-name" keywords="{{ settingsText.workspaceKeywords }}">
            <TextInput variant="mac" v-model:value="workspaceName" maxlength="120" data-workspace-name />
          </SettingsRow>
          <SettingsRow label="{{ settingsText.owner }}" setting="owner-name" keywords="{{ settingsText.ownerKeywords }}">
            <TextInput variant="mac" v-model:value="ownerName" maxlength="120" data-workspace-owner />
          </SettingsRow>
          <SettingsRow label="{{ settingsText.timezone }}" setting="timezone" keywords="{{ settingsText.timezoneKeywords }}">
            <Select variant="mac" v-model:value="workspaceZone" placeholder="" :options="zoneOptions()" data-workspace-timezone />
          </SettingsRow>
        </SettingsGroup>
        {{--
          Instagram and Threads fetch each image from an address on the
          internet. Without a public address of its own (the Mac app, a server
          at home), Postline can lend the image one for as long as the network
          takes to fetch it.
        --}}
        <SettingsGroup title="{{ settingsText.images }}" footer="{{ settingsText.imagesHelp }}">
          <SettingsRow label="{{ settingsText.shareImages }}" setting="share-media" keywords="{{ settingsText.imageKeywords }}">
            <Switch variant="mac" v-model:checked="shareMediaByTunnel" data-share-media />
          </SettingsRow>
        </SettingsGroup>
        <SettingsGroup title="{{ settingsText.publishing }}" footer="{{ settingsText.publishingHelp }}">
          <SettingsRow label="{{ settingsText.pause }}" setting="publishing-paused" keywords="{{ settingsText.publishingKeywords }}">
            <Switch variant="mac" v-model:checked="publishingPaused" data-publishing-paused />
          </SettingsRow>
        </SettingsGroup>
        <div class="flex gap-2 items-center justify-end mt-3">
          <p class="m-0 mr-auto text-xs" :data-tone="workspaceTone()" x-show="workspaceMessage()" :text="workspaceMessage()" role="status" aria-live="polite" data-workspace-message></p>
          <Button appearance="mac" variant="primary" :disabled="!canSaveWorkspace()" @click="saveWorkspace">{{ settingsText.save }}</Button>
        </div>
      </SettingsPane>

      <SettingsPane id="appearance" title="{{ settingsText.appearance }}">
        <SettingsGroup footer="{{ settingsText.appearanceHelp }}">
          <SettingsRow label="{{ settingsText.appearance }}" layout="stacked" setting="appearance" keywords="{{ settingsText.appearanceKeywords }}">
            <AppearancePicker v-model:value="appearance" label="{{ settingsText.appearance }}" :options="appearanceOptions" @change="setAppearance" />
          </SettingsRow>
        </SettingsGroup>
      </SettingsPane>

      <SettingsPane id="channels" title="{{ settingsText.channels }}">
        <SettingsGroup footer="{{ settingsText.credentials }}">
          <SettingsRow label="{{ settingsText.publishingChannels }}" :description="channelSummary()" setting="channels" keywords="{{ settingsText.manageKeywords }}">
            <Button appearance="mac" @click="openWorkspacePage('/accounts')">{{ settingsText.manageChannels }}</Button>
          </SettingsRow>
        </SettingsGroup>
      </SettingsPane>

      <SettingsPane id="notifications" title="{{ settingsText.notifications }}">
        <SettingsGroup footer="{{ settingsText.alertsHelp }}">
          <SettingsRow label="{{ settingsText.alerts }}" setting="activity-alerts">
            <Button appearance="mac" @click="openWorkspacePage('/activity')">{{ settingsText.openActivity }}</Button>
          </SettingsRow>
          <SettingsRow label="{{ settingsText.macNotifications }}" :description="nativeNotificationDescription()" setting="macos-notifications" x-show="notificationControls()">
            <Button appearance="mac" :disabled="requestingNotifications()" :show="nativeNotificationPermission() === 'notDetermined'" @click="allowNativeNotifications">{{ settingsText.allowNotifications }}</Button>
          </SettingsRow>
        </SettingsGroup>
        <SettingsGroup title="{{ settingsText.delivery }}">
          <SettingsRow label="{{ settingsText.emailDelivery }}" :description="mailDescription()" setting="mail-status" keywords="{{ settingsText.emailKeywords }}" />
          <SettingsRow label="{{ settingsText.emailAlerts }}" setting="email-alerts" :description="delivery() ? (delivery().email ? copy.on : copy.off) : ''" />
          <SettingsRow label="{{ settingsText.webhook }}" setting="alert-webhook" :description="delivery() ? (delivery().webhook ? copy.configured : copy.unconfigured) : ''" />
        </SettingsGroup>
      </SettingsPane>

      {{--
        The AI provider campaign planning uses (#138). Saved here, it wins over
        the environment, which is the only way the Mac app can have one. The
        key is sealed on the server and never sent back to this page.
      --}}
      <SettingsPane id="ai" title="{{ settingsText.ai }}">
        <SettingsGroup footer="{{ settingsText.aiHelp }}">
          <SettingsRow label="{{ settingsText.provider }}" setting="ai-provider" keywords="anthropic openai ollama">
            <Select variant="mac" v-model:value="aiProvider" placeholder="" :options="aiProviderOptions" data-ai-provider />
          </SettingsRow>
          <div x-show="aiProvider() === 'anthropic' || aiProvider() === 'openai'">
            <SettingsRow label="{{ settingsText.apiKey }}" :description="aiKeyDescription()" setting="ai-key" keywords="{{ settingsText.keyKeywords }}">
              <TextInput variant="mac" type="password" autocomplete="off" v-model:value="aiKey" :placeholder="aiHasKey() ? copy.savedKey : copy.pasteKey" data-ai-key />
            </SettingsRow>
          </div>
          <div x-show="aiProvider()">
            <SettingsRow label="{{ settingsText.model }}" description="{{ settingsText.defaultModel }}" setting="ai-model" keywords="{{ settingsText.modelKeywords }}">
              <TextInput variant="mac" v-model:value="aiModel" maxlength="120" :placeholder="aiModelPlaceholder()" data-ai-model />
            </SettingsRow>
          </div>
          <SettingsRow label="{{ settingsText.planningUses }}" setting="ai-active"><span :text="aiActiveText()" data-ai-active>—</span></SettingsRow>
        </SettingsGroup>
        <div class="flex gap-2 items-center justify-end mt-3">
          <p class="m-0 mr-auto text-xs" :data-tone="aiTone()" x-show="aiMessage()" :text="aiMessage()" role="status" aria-live="polite" data-ai-message></p>
          <div x-show="aiHasKey()"><Button appearance="mac" :disabled="aiSaving()" @click="removeAiKey">{{ settingsText.removeKey }}</Button></div>
          <Button appearance="mac" variant="primary" :disabled="aiSaving()" @click="saveAi">{{ settingsText.save }}</Button>
        </div>
      </SettingsPane>

      <SettingsPane id="composer" title="{{ settingsText.composer }}">
        <SettingsGroup footer="{{ settingsText.characterHelp }}">
          <SettingsRow label="{{ settingsText.characterLimit }}" :description="charLimitSource()" setting="character-limit">
            <span :text="charLimitText()">—</span>
          </SettingsRow>
          <SettingsRow label="{{ settingsText.defaultFormat }}" description="{{ settingsText.defaultFormatHelp }}" setting="default-mode" keywords="{{ settingsText.formatKeywords }}">
            <Select variant="mac" v-model:value="composerFormat" placeholder="" :options="composerFormatOptions" />
          </SettingsRow>
          <SettingsRow label="{{ settingsText.autosave }}" description="{{ settingsText.autosaveHelp }}" setting="auto-save" keywords="{{ settingsText.draftKeywords }}">
            <Switch variant="mac" v-model:checked="composerAutosave" />
          </SettingsRow>
        </SettingsGroup>
      </SettingsPane>

      {{--
        Retention. Saved on the workspace (accounts row) and applied once a day
        by the AutoDeletePosts job through the same purge engine as the manual
        tool under Channels, so it has the same caps and audit trail.
      --}}
      <SettingsPane id="deletion" title="{{ settingsText.cleanup }}">
        <SettingsGroup footer="{{ settingsText.retentionCheck }}">
          <SettingsRow label="{{ settingsText.enableRetention }}" :description="statusPill()" setting="auto-delete" keywords="{{ settingsText.retentionKeywords }}">
            <Switch variant="mac" v-model:checked="autoEnabled" data-retention-enabled />
          </SettingsRow>
          <SettingsRow label="{{ settingsText.olderThan }}" description="{{ settingsText.daysRange }}" setting="auto-delete-days">
            <NumberInput variant="mac" v-model:value="autoDaysText" min="1" max="3650" step="1" data-retention-days />
          </SettingsRow>
        </SettingsGroup>

        <SettingsGroup footer="{{ settingsText.scopeHelp }}">
          <SettingsRow label="{{ settingsText.scope }}" setting="auto-delete-scope" keywords="{{ settingsText.retentionScopeKeywords }}">
            <Select variant="mac" v-model:value="autoScope" placeholder="" :options="retentionScopeOptions" />
          </SettingsRow>
        </SettingsGroup>

        <SettingsGroup header="{{ settingsText.networks }}" footer="{{ settingsText.retentionNetworksHelp }}">
          <SettingsRow label="Bluesky" setting="auto-delete-bluesky"><Switch variant="mac" size="mini" v-model:checked="onBluesky" /></SettingsRow>
          <SettingsRow label="X" setting="auto-delete-twitter"><Switch variant="mac" size="mini" v-model:checked="onTwitter" /></SettingsRow>
          <SettingsRow label="Mastodon" setting="auto-delete-mastodon"><Switch variant="mac" size="mini" v-model:checked="onMastodon" /></SettingsRow>
          <SettingsRow label="LinkedIn" setting="auto-delete-linkedin"><Switch variant="mac" size="mini" v-model:checked="onLinkedin" /></SettingsRow>
        </SettingsGroup>

        <div x-show="needsAcknowledgement()">
          <SettingsGroup>
            <SettingsRow label="{{ settingsText.acknowledge }}" description="{{ settingsText.acknowledgeHelp }}" multiline destructive setting="auto-delete-acknowledge">
              <Switch variant="mac" v-model:checked="acknowledged" data-retention-ack />
            </SettingsRow>
          </SettingsGroup>
        </div>

        <div class="flex flex-wrap gap-2 items-center justify-end">
          <Button appearance="mac" :disabled="previewing() || !retentionLoaded()" @click="previewRetention">{{ settingsText.retentionPreview }}</Button>
          <Button appearance="mac" variant="primary" :disabled="!canSave()" @click="saveRetention">{{ settingsText.save }}</Button>
        </div>

        <p class="m-0 mt-3 text-xs" :data-tone="retentionTone()" x-show="retentionMessage()" :text="retentionMessage()" role="status" aria-live="polite" data-retention-message></p>
        <p class="m-0 mt-2 text-muted text-xs" x-show="lastRunText()" :text="lastRunText()" data-retention-last-run></p>
      </SettingsPane>

      {{--
        The workspace as one file (#209): export it, bring it into another
        install, or delete everything here. Sign-ins and keys never travel.
      --}}
      <SettingsPane id="data" title="{{ settingsText.data }}">
        <SettingsGroup footer="{{ settingsText.archiveHelp }}">
          <SettingsRow label="{{ settingsText.exportWorkspace }}" setting="export" keywords="{{ settingsText.exportKeywords }}">
            <a class="inline-flex items-center px-3 h-7 text-ink text-ui bg-panel border border-line rounded-md" href="/api/postline/settings/export" download data-no-router>{{ settingsText.exportArchive }}</a>
          </SettingsRow>
          <SettingsRow label="{{ settingsText.importArchive }}" description="{{ settingsText.importHelp }}" setting="import" keywords="{{ settingsText.importKeywords }}">
            <label class="inline-flex items-center px-3 h-7 text-ui bg-panel border border-line rounded-md cursor-pointer">
              <span :text="dataBusy() ? copy.archiveBusy : copy.chooseArchive">{{ settingsText.chooseArchive }}</span>
              <input class="sr-only" type="file" accept=".json,application/json" @change="importWorkspace($event)">
            </label>
          </SettingsRow>
        </SettingsGroup>
        <SettingsGroup title="{{ settingsText.deleteDataHeading }}" footer="{{ settingsText.deleteDataHelp }}">
          <SettingsRow label="{{ settingsText.deleteDataPhrase }}" setting="delete-everything" keywords="{{ settingsText.deleteDataKeywords }}">
            <TextInput variant="mac" v-model:value="deletePhrase" placeholder="DELETE EVERYTHING" autocomplete="off" data-delete-phrase />
          </SettingsRow>
        </SettingsGroup>
        <div class="flex gap-2 items-center justify-end mt-3">
          <p class="m-0 mr-auto text-xs" :data-tone="dataTone()" x-show="dataMessage()" :text="dataMessage()" role="status" aria-live="polite" data-workspace-data-message></p>
          <Button appearance="mac" variant="danger" :disabled="dataBusy() || deletePhrase() !== 'DELETE EVERYTHING'" @click="deleteEverything">{{ settingsText.deleteDataAction }}</Button>
        </div>
      </SettingsPane>

      <SettingsPane id="account" title="{{ settingsText.account }}">
        {{--
          Ways in besides the password (#95). The password always keeps
          working, so neither a lost passkey nor a lost phone locks the owner
          out; the recovery codes cover the phone, ./buddy user:add the rest.
        --}}
        <SettingsGroup title="{{ settingsText.passkeys }}" footer="{{ settingsText.passkeysHelp }}">
          <SettingsRow label="{{ settingsText.yourPasskeys }}" layout="stacked" setting="passkeys" keywords="{{ settingsText.passkeyKeywords }}">
            <ul class="grid gap-1.5 m-0 p-0 list-none" data-passkey-list>
              <li class="flex gap-2 items-center justify-between px-2.5 py-1.5 bg-panel-2 border border-line rounded-lg" x-for="key in passkeyRows()" data-passkey-row>
                <span class="grid min-w-0">
                  <span class="text-ink text-ui truncate" :text="key.name"></span>
                  <span class="text-muted text-xs" :text="key.detail"></span>
                </span>
                <button class="px-2 h-6 text-danger text-xs bg-panel border border-line rounded-md disabled:opacity-50" type="button" :disabled="securityBusy()" @click="askRemovePasskey(key.id)">{{ settingsText.removePasskey }}</button>
              </li>
              <li class="text-muted text-xs" x-show="!passkeyRows().length" :text="passkeyEmpty()">{{ settingsCopy.messages.emptyPasskeys }}</li>
            </ul>
          </SettingsRow>
          <SettingsRow label="{{ settingsText.addPasskey }}" :description="passkeyHint()" setting="passkey-add">
            <Button appearance="mac" :disabled="securityBusy() || !passkeysSupported()" @click="addPasskey">{{ settingsText.addPasskeyAction }}</Button>
          </SettingsRow>
        </SettingsGroup>

        <SettingsGroup title="{{ settingsText.twoFactor }}" footer="{{ settingsText.twoFactorHelp }}">
          <SettingsRow label="{{ settingsText.authenticator }}" setting="two-factor" keywords="{{ settingsText.authenticatorKeywords }}">
            <span :class="!twoFactorOn() && !setupQr() ? '' : 'hidden'"><Button appearance="mac" :disabled="securityBusy() || !securityLoaded()" @click="startTwoFactor">{{ settingsText.turnOnDialog }}</Button></span>
            <span :class="twoFactorOn() ? '' : 'hidden'"><Button appearance="mac" variant="danger" :disabled="securityBusy()" @click="askDisableTwoFactor">{{ settingsText.turnOffDialog }}</Button></span>
          </SettingsRow>
          <div class="gap-3 px-4 py-3" :class="setupQr() ? 'grid' : 'hidden'" data-two-factor-setup>
            <p class="m-0 text-body text-ui">{{ settingsText.scanQr }}</p>
            <img class="h-44 w-44 rounded-lg" :src="setupQr()" alt="{{ settingsText.qrLabel }}">
            <p class="m-0 text-muted text-xs">{{ settingsText.manualCode }} <code class="break-all text-body" :text="setupSecret()"></code></p>
            <div class="flex flex-wrap gap-2 items-center">
              <TextInput variant="mac" v-model:value="setupCode" placeholder="123456" autocomplete="one-time-code" maxlength="6" data-two-factor-setup-code />
              <Button appearance="mac" variant="primary" :disabled="securityBusy() || setupCode().trim().length !== 6" @click="confirmTwoFactor">{{ settingsText.turnOn }}</Button>
              <Button appearance="mac" :disabled="securityBusy()" @click="cancelTwoFactorSetup">{{ settingsText.cancel }}</Button>
            </div>
          </div>
          <div :class="twoFactorOn() ? '' : 'hidden'">
            <SettingsRow label="{{ settingsText.recoveryCodes }}" :description="recoveryDescription()" setting="recovery-codes" keywords="{{ settingsText.recoveryKeywords }}">
              <Button appearance="mac" :disabled="securityBusy()" @click="askNewRecoveryCodes">{{ settingsText.newCodes }}</Button>
            </SettingsRow>
          </div>
          <div class="gap-2 px-4 py-3" :class="recoveryCodes().length ? 'grid' : 'hidden'" data-recovery-codes>
            <p class="m-0 text-body text-ui">{{ settingsText.storeCodes }}</p>
            <ul class="grid gap-1 m-0 p-0 font-mono list-none text-ink text-ui">
              <li x-for="item in recoveryCodes()" :text="item"></li>
            </ul>
            <div class="flex gap-2">
              <Button appearance="mac" @click="copyRecoveryCodes">{{ settingsText.copyCodes }}</Button>
              <Button appearance="mac" @click="recoveryCodes.set([])">{{ settingsText.codesSaved }}</Button>
            </div>
          </div>
        </SettingsGroup>

        {{-- One confirmation for the changes that need proof: the password to
            remove a passkey or turn two-factor off, a current code for new
            recovery codes. --}}
        <div class="gap-2 mt-3 p-3 bg-panel-2 border border-line rounded-lg" :class="confirming() ? 'grid' : 'hidden'" data-security-confirm>
          <p class="m-0 text-body text-ui" :text="confirmPrompt()"></p>
          <div class="flex flex-wrap gap-2 items-center">
            <span :class="confirming() === 'codes' ? 'hidden' : ''"><TextInput variant="mac" type="password" v-model:value="confirmValue" autocomplete="current-password" placeholder="{{ settingsText.passwordLabel }}" data-security-confirm-password /></span>
            <span :class="confirming() === 'codes' ? '' : 'hidden'"><TextInput variant="mac" v-model:value="confirmValue" autocomplete="one-time-code" placeholder="123456" data-security-confirm-code /></span>
            <Button appearance="mac" variant="primary" :disabled="securityBusy() || !confirmValue().trim()" @click="runConfirmed">{{ settingsText.confirmSecurity }}</Button>
            <Button appearance="mac" :disabled="securityBusy()" @click="cancelConfirm">{{ settingsText.cancel }}</Button>
          </div>
        </div>
        <p class="m-0 mt-2 text-xs" :data-tone="securityTone()" x-show="securityMessage()" :text="securityMessage()" role="status" aria-live="polite" data-security-message></p>

        <SettingsGroup footer="{{ settingsText.signOutHelp }}">
          <SettingsRow label="{{ settingsText.signOutLabel }}" setting="sign-out">
            <Button appearance="mac" variant="danger" @click="signOut">{{ settingsText.signOut }}</Button>
          </SettingsRow>
        </SettingsGroup>
        <SettingsGroup footer="{{ settingsText.signOutEverywhereHelp }}">
          <SettingsRow label="{{ settingsText.signOutEverywhereLabel }}" setting="sign-out-everywhere" keywords="{{ settingsText.everywhereKeywords }}">
            <Button appearance="mac" variant="danger" @click="signOutEverywhere">{{ settingsText.signOutEverywhere }}</Button>
          </SettingsRow>
        </SettingsGroup>
      </SettingsPane>
      <SettingsPane id="about" title="{{ settingsText.about }}">
        <SettingsPaneHeader icon="i-hugeicons-sent" tone="red" title="Postline" description="{{ settingsText.aboutDescription }}" />
        <SettingsGroup>
          <SettingsRow label="{{ settingsText.versionLabel }}" setting="desktop-version" keywords="{{ settingsText.updateKeywords }}" :description="desktopUpdate()?.currentVersion || '{{ buildVersion }}'">
            <Button appearance="mac" x-show="ownWindow()" :disabled="checkingDesktopUpdate()" @click="checkDesktopUpdate">{{ settingsText.checkUpdates }}</Button>
          </SettingsRow>
          <SettingsRow label="{{ settingsText.updateAvailable }}" setting="desktop-install" :description="desktopUpdate()?.version || ''" x-show="desktopUpdate()?.state === 'available' && desktopUpdate()?.selfUpdating">
            <Button appearance="mac" :disabled="checkingDesktopUpdate()" @click="installDesktopUpdate">{{ settingsText.installUpdate }}</Button>
          </SettingsRow>
        </SettingsGroup>
        <p class="mt-2 text-muted text-xs" x-show="desktopUpdateMessage()" :text="desktopUpdateMessage()" role="status" aria-live="polite"></p>
        {{-- The Mac app's log, for a bug report (#202). Only the app has one. --}}
        <div class="mt-4" :class="ownWindow() ? '' : 'hidden'">
          <SettingsGroup title="{{ settingsText.troubleshooting }}" footer="{{ settingsText.logHelp }}">
            <SettingsRow label="{{ settingsText.logLabel }}" setting="reveal-log" keywords="{{ settingsText.logKeywords }}">
              <Button appearance="mac" @click="revealLog">{{ settingsText.finder }}</Button>
            </SettingsRow>
          </SettingsGroup>
        </div>
      </SettingsPane>

    </SettingsWindow>
  </main>


  <script client>
    import type { ImportReport } from '../../app/Services/WorkspaceArchiveService'
    import type { ComposerFormat } from '../functions/composer-draft'
    import type { DesktopAlertsBridge } from '../functions/desktop-alerts'
    import { COMPOSER_AUTOSAVE_KEY, COMPOSER_DEFAULT_FORMAT_KEY } from '../functions/composer-draft'
    import { passkeys } from '../functions/passkeys'
    import { fetchProviders } from '../functions/social-client'

    /**
     * The stored theme preference.
     *
     * `'system'`, not `'auto'` — `app.colorMode` in config/ui.ts sets
     * `autoValue: 'system'`, so the boot script reads and writes this app's
     * existing vocabulary and no saved preference is rewritten.
     */
    type ThemePreference = 'light' | 'dark' | 'system'

    const readStoredTheme = (): ThemePreference => {
      const boot = window.__STX_COLOR_MODE__
      try {
        return (localStorage.getItem(boot?.storageKey ?? 'theme') ?? 'system') as ThemePreference
      }
      catch {
        return 'system'
      }
    }

    const { locale: language, messages: copy } = {{ settingsCopy }}
    const numbers = new Intl.NumberFormat(language)
    const plural = new Intl.PluralRules(language)
    const age = new Intl.NumberFormat(language, { style: 'unit', unit: 'day', unitDisplay: 'long' })
    const themePref = state(readStoredTheme())
    const pane = state('general')
    const composerFormat = useLocalStorage<ComposerFormat>(COMPOSER_DEFAULT_FORMAT_KEY, 'single')
    const composerAutosave = useLocalStorage(COMPOSER_AUTOSAVE_KEY, true)
    const composerFormatOptions = [{ value: 'single', label: copy.singlePost }, { value: 'thread', label: copy.thread }]

    /**
     * Whether this page is the desktop app's Settings window.
     *
     * There it is a window of its own beside the workspace, so there is no
     * way back to offer and no account to sign out of (the app's agent has no
     * login). In a browser it is a page like any other.
     */
    const ownWindow = state(!!window.craft?.window)

    const desktopUpdate = state(null as import('@stacksjs/desktop-build').DesktopUpdateStatus | null)
    const checkingDesktopUpdate = state(false)
    const desktopUpdateError = state('')
    const desktopUpdateMessage = derived(() => {
      const update = desktopUpdate()
      if (checkingDesktopUpdate()) return copy.contactingUpdate
      if (desktopUpdateError()) return desktopUpdateError()
      if (!update) return ''
      if (update.state === 'current') return copy.upToDate
      if (update.state === 'installed') return copy.updateInstalled
      if (update.state === 'available') return update.selfUpdating ? copy.readyToInstall.replace('{version}', () => update.version || '') : copy.readyToDownload.replace('{version}', () => update.version || '')
      return update.error || update.message || ''
    })

    const requestDesktopUpdate = async (action?: 'check' | 'install'): Promise<void> => {
      if (checkingDesktopUpdate()) return
      checkingDesktopUpdate.set(true)
      desktopUpdateError.set('')
      try {
        const response = await fetch('/__desktop/update', action ? {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action }),
        } : undefined)
        if (!response.ok) throw new Error(copy.updateUnreachable)
        desktopUpdate.set(await response.json())
      }
      catch (error) {
        if (action) desktopUpdateError.set(error instanceof Error ? error.message : copy.updateFailed)
      }
      finally {
        checkingDesktopUpdate.set(false)
      }
    }

    const checkDesktopUpdate = () => requestDesktopUpdate('check')
    const installDesktopUpdate = () => requestDesktopUpdate('install')

    /**
     * What this window tells the workspace window.
     *
     * Two windows of one app share an origin and nothing else: a theme picked
     * here has to be applied there, and links to workspace pages belong in
     * the workspace window.
     */
    const workspace = typeof BroadcastChannel === 'function' ? new BroadcastChannel('postline:settings') : null
    const tellWorkspace = (message: { type: 'theme', pref: string } | { type: 'navigate', path: string }): void => {
      try {
        workspace?.postMessage(message)
      }
      catch {}
    }
    // The picker says 'auto' where this app's stored preference says 'system'.
    const appearanceOptions = {{ settingsAppearanceOptions }}
    const appearance = state(readStoredTheme() === 'system' ? 'auto' : readStoredTheme())
    const channelSummary = state(copy.checkingStatus)
    const channelPill = state(copy.checking)
    const charLimitText = state('—')
    const charLimitSource = state('—')

    /**
     * Applies the preference to the root html element.
     *
     * The pre-paint stamp itself now lives in `app.colorMode` (config/ui.ts),
     * which is why neither this view nor any layout carries a bootstrap any
     * more. But that boot script runs ONCE and exposes no re-apply hook — it
     * publishes `window.__STX_COLOR_MODE__` as plain config plus the resolved
     * `mode`, with no `sync()` and no `prefers-color-scheme` listener. So a
     * runtime switch still has to stamp, exactly as before.
     *
     * What changed is where the names come from: `darkClass` and `attribute`
     * are read off the published config rather than written out again here, so
     * this can no longer drift from config/ui.ts. The literals are only the
     * fallback for the window before the boot script has run.
     */
    const applyTheme = (pref: ThemePreference): void => {
      const boot = window.__STX_COLOR_MODE__
      const dark = pref === 'dark'
        || (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
      const root = document.documentElement
      const darkClass = boot?.darkClass ?? 'dark'
      const attribute = boot?.attribute ?? 'data-theme'
      if (darkClass)
        root.classList.toggle(darkClass, dark)
      if (attribute)
        root.setAttribute(attribute, dark ? 'dark' : 'light')
    }

    const setTheme = (pref: ThemePreference): void => {
      themePref.set(pref)
      try {
        localStorage.setItem(window.__STX_COLOR_MODE__?.storageKey ?? 'theme', pref)
      }
      catch {}
      applyTheme(pref)
      // The window's own chrome (its buttons, its material) follows the
      // window's appearance, not the page's.
      void window.craft?.window?.setAppearance?.(pref)
      tellWorkspace({ type: 'theme', pref })
    }

    const setAppearance = (mode: string): void => {
      setTheme(mode === 'light' || mode === 'dark' ? mode : 'system')
    }

    const openWorkspacePage = (path: '/accounts' | '/activity'): void => {
      if (ownWindow()) {
        tellWorkspace({ type: 'navigate', path })
        return
      }
      navigate(path, { reload: true })
    }

    // Signal-backed cookie: setting it to '' emits max-age=0, and it adds
    // Secure automatically over https, which the hand-rolled string did not.
    // This is the marker the app shell's pre-paint guard reads, not the session
    // itself — the session is an httpOnly cookie and only the server can end
    // it, which is what /api/logout is for.
    const signedInMarker = useCookie('postline-signed-in')

    /**
     * Sign out.
     *
     * The round trip IS the sign-out, not a courtesy. `useCookie('auth-token')`
     * used to stand in for it, and a write to an httpOnly cookie name is
     * discarded by the browser — so the session was neither revoked nor
     * cleared, the token stayed valid for its remaining 30 days, and the
     * "signed out" browser still held a working cookie (#45). /api/logout
     * revokes the token server-side AND clears the cookie; both are needed,
     * because revoking alone leaves the browser sending a dead cookie, and
     * clearing alone leaves a copied one usable until it expires.
     *
     * The marker is dropped and the navigation happens whatever the request
     * does: a sign-out that cannot reach the server should still leave this
     * browser, and with the marker gone the guard will not let the shell
     * render again.
     *
     * Deliberately a hard navigation rather than stx `navigate()` — signing out
     * should drop all in-memory state, which an SPA transition would preserve.
     */
    const endSession = async (endpoint: string): Promise<void> => {
      try {
        await fetch(endpoint, { method: 'POST' })
      }
      catch {}
      signedInMarker.set('')
      // Dropping in-memory state IS the rest of the sign-out. navigate()
      // preserves it, so the previous account's data would sit in the signals
      // behind the login screen.
      // stx-strict-ignore-next-line location.assign
      location.assign('/login')
    }

    const signOut = (): Promise<void> => endSession('/api/logout')

    /** Select the Mac app's log in Finder; the agent runs `open -R` on its fixed path. */
    const revealLog = async (): Promise<void> => {
      try {
        await fetch('/api/postline/desktop/reveal-log', { method: 'POST' })
      }
      catch {}
    }

    /** Every session and token, everywhere; then this browser leaves like a normal sign-out. */
    const signOutEverywhere = async (): Promise<void> => {
      if (!await stxConfirm(copy.signOutConfirm, { title: copy.signOutTitle, type: 'error', confirmText: copy.signOutAction })) return
      await endSession('/api/logout-all')
    }

    // --- Passkeys and two-factor sign-in (#95) -------------------------
    // lists, adds and removes, and walks the authenticator setup.

    interface PasskeyView { id: string, device: string, created_at: unknown, last_used_at: unknown }

    const passkeyList = state<PasskeyView[]>([])
    const passkeysLoaded = state(false)
    const securityLoaded = state(false)
    const twoFactorOn = state(false)
    const recoveryLeft = state(0)
    const setupQr = state('')
    const setupSecret = state('')
    const setupCode = state('')
    const recoveryCodes = state<string[]>([])
    const confirming = state<'' | 'remove' | 'disable' | 'codes'>('')
    const confirmTarget = state('')
    const confirmValue = state('')
    const securityBusy = state(false)
    const securityMessage = state('')
    const securityTone = state('muted')
    // stx-strict-ignore-next-line PublicKeyCredential
    const passkeysSupported = state(passkeys.supported())

    const shortDate = (value: unknown): string => {
      const date = value ? new Date(String(value).replace(' ', 'T') + (/[zZ]|[+-]\d\d:?\d\d$/.test(String(value)) ? '' : 'Z')) : null
      return date && !Number.isNaN(date.getTime()) ? date.toLocaleDateString(language, { year: 'numeric', month: 'short', day: 'numeric' }) : ''
    }
    const passkeyRows = derived(() => passkeyList().map((key) => {
      const added = shortDate(key.created_at)
      const used = shortDate(key.last_used_at)
      return {
        id: key.id,
        name: key.device === 'multiDevice' ? copy.syncedPasskey : key.device === 'singleDevice' ? copy.devicePasskey : (key.device || copy.passkey),
        detail: [added && copy.addedPasskey.replace('{date}', added), used ? copy.usedPasskey.replace('{date}', used) : copy.unusedPasskey].filter(Boolean).join(' · '),
      }
    }))
    const passkeyEmpty = derived(() => passkeysLoaded() ? copy.emptyPasskeys : copy.loadingPasskeys)
    const passkeyHint = derived(() => passkeysSupported()
      ? copy.passkeyStorage
      : copy.passkeyUnsupported)
    const recoveryDescription = derived(() => {
      const count = recoveryLeft()
      return (plural.select(count) === 'one' ? copy.unusedCodeOne : copy.unusedCodeMany)
        .replace('{count}', numbers.format(count))
    })
    const confirmPrompt = derived(() => confirming() === 'codes'
      ? copy.replaceCodesPrompt
      : confirming() === 'disable'
        ? copy.disableTwoFactorPrompt
        : copy.removePasskeyPrompt)

    const saySecurity = (message: string, tone = 'muted'): void => {
      securityMessage.set(message)
      securityTone.set(tone)
    }

    const loadSecurity = async (): Promise<void> => {
      try {
        const [keys, factor] = await Promise.all([
          requestJson('/api/auth/passkeys'),
          requestJson('/api/auth/two-factor'),
        ])
        passkeyList.set(Array.isArray(keys.passkeys) ? keys.passkeys : [])
        twoFactorOn.set(!!factor.data?.twoFactor)
        recoveryLeft.set(Number(factor.data?.recoveryCodesLeft) || 0)
        securityLoaded.set(true)
      }
      catch (error) {
        saySecurity(error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        passkeysLoaded.set(true)
      }
    }

    const busyWhile = async (work: () => Promise<void>): Promise<void> => {
      securityBusy.set(true)
      saySecurity('')
      try {
        await work()
      }
      catch (error) {
        saySecurity(error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        securityBusy.set(false)
      }
    }

    const addPasskey = (): Promise<void> => busyWhile(async () => {
      if (await passkeys.register()) {
        await loadSecurity()
        saySecurity(copy.passkeyAdded, 'success')
      }
    })

    const startTwoFactor = (): Promise<void> => busyWhile(async () => {
      const setup = await requestJson('/api/auth/two-factor/setup', { method: 'POST' })
      setupSecret.set(String(setup.secret ?? ''))
      setupQr.set(setup.qr ? `data:image/svg+xml;charset=utf-8,${encodeURIComponent(String(setup.qr))}` : '')
      setupCode.set('')
    })

    const cancelTwoFactorSetup = (): void => {
      setupQr.set('')
      setupSecret.set('')
      setupCode.set('')
    }

    const confirmTwoFactor = (): Promise<void> => busyWhile(async () => {
      const result = await requestJson('/api/auth/two-factor/enable', { method: 'POST', body: JSON.stringify({ code: setupCode().trim() }) })
      cancelTwoFactorSetup()
      recoveryCodes.set(Array.isArray(result.recoveryCodes) ? result.recoveryCodes : [])
      await loadSecurity()
      saySecurity(copy.twoFactorOn, 'success')
    })

    const askRemovePasskey = (id: string): void => {
      confirmTarget.set(id)
      confirmValue.set('')
      confirming.set('remove')
    }
    const askDisableTwoFactor = (): void => {
      confirmValue.set('')
      confirming.set('disable')
    }
    const askNewRecoveryCodes = (): void => {
      confirmValue.set('')
      confirming.set('codes')
    }
    const cancelConfirm = (): void => {
      confirming.set('')
      confirmValue.set('')
      confirmTarget.set('')
    }

    const runConfirmed = (): Promise<void> => busyWhile(async () => {
      const value = confirmValue().trim()
      const action = confirming()
      if (action === 'remove') {
        // A wrong password answers 422 with its own message; 404 is a passkey
        // already removed, from another tab or device.
        await requestJson(`/api/auth/passkeys/${encodeURIComponent(confirmTarget())}`, { method: 'DELETE', body: JSON.stringify({ password: confirmValue() }) })
          .catch((error) => {
            if (!(error instanceof Error) || error.message !== 'Not found.') throw error
          })
        saySecurity(copy.passkeyRemoved, 'success')
      }
      else if (action === 'disable') {
        await requestJson('/api/auth/two-factor/disable', { method: 'POST', body: JSON.stringify({ password: confirmValue() }) })
        recoveryCodes.set([])
        saySecurity(copy.twoFactorOff, 'success')
      }
      else if (action === 'codes') {
        const result = await requestJson('/api/auth/two-factor/recovery-codes', { method: 'POST', body: JSON.stringify({ code: value }) })
        recoveryCodes.set(Array.isArray(result.data?.recoveryCodes) ? result.data.recoveryCodes : [])
        saySecurity(copy.codesGenerated, 'success')
      }
      cancelConfirm()
      await loadSecurity()
    })

    const copyRecoveryCodes = async (): Promise<void> => {
      try {
        // stx-strict-ignore-next-line navigator.clipboard
        await navigator.clipboard.writeText(recoveryCodes().join('\n'))
        saySecurity(copy.codesCopied, 'success')
      }
      catch {
        saySecurity(copy.codesCopyFailed, 'error')
      }
    }

    if (!ownWindow()) void loadSecurity()

    // --- Automatic deletion ---------------------------------------------
    interface RetentionSettings {
      enabled: boolean
      days: number
      providers: string[]
      scope: 'all' | 'tracked'
    }

    interface RetentionLastRun {
      at: string
      matched: number
      deleted: number
      failed: number
    }

    // --- Workspace: name, owner and the one time zone ---
    const workspaceLoaded = state(false)
    const workspaceSaving = state(false)
    const workspaceName = state('')
    const ownerName = state('')
    const workspaceZone = state('')
    const shareMediaByTunnel = state(false)
    const publishingPaused = state(false)
    const savedWorkspace = state({ name: '', workspaceName: '', timezone: '', shareMediaByTunnel: false, publishingPaused: false })
    const workspaceMessage = state('')
    const workspaceTone = state('')

    /** Every zone the browser knows, with the saved one always present. */
    const zoneOptions = derived(() => {
      let zones: string[] = []
      try {
        zones = Intl.supportedValuesOf('timeZone')
      }
      catch {
        zones = ['UTC']
      }
      const saved = savedWorkspace().timezone
      if (saved && !zones.includes(saved)) zones = [saved, ...zones]
      if (!zones.includes('UTC')) zones = ['UTC', ...zones]
      return zones.map(zone => ({ value: zone, label: zone.replace(/_/g, ' ') }))
    })

    const canSaveWorkspace = derived(() => workspaceLoaded()
      && !workspaceSaving()
      && workspaceName().trim().length >= 2
      && ownerName().trim().length >= 2
      && Boolean(workspaceZone())
      && (workspaceName().trim() !== savedWorkspace().workspaceName
        || ownerName().trim() !== savedWorkspace().name
        || workspaceZone() !== savedWorkspace().timezone
        || shareMediaByTunnel() !== savedWorkspace().shareMediaByTunnel
        || publishingPaused() !== savedWorkspace().publishingPaused))

    const applyWorkspace = (profile: { name: string, workspaceName: string, timezone: string, shareMediaByTunnel?: boolean, publishingPaused?: boolean }): void => {
      savedWorkspace.set({ ...profile, shareMediaByTunnel: Boolean(profile.shareMediaByTunnel), publishingPaused: Boolean(profile.publishingPaused) })
      publishingPaused.set(Boolean(profile.publishingPaused))
      workspaceName.set(profile.workspaceName)
      ownerName.set(profile.name)
      workspaceZone.set(profile.timezone)
      shareMediaByTunnel.set(Boolean(profile.shareMediaByTunnel))
    }

    const loadWorkspace = async (): Promise<void> => {
      try {
        applyWorkspace((await fetchWorkspaceBootstrap()).workspace)
        workspaceLoaded.set(true)
      }
      catch (error) {
        workspaceMessage.set(error instanceof Error ? error.message : String(error))
        workspaceTone.set('error')
      }
    }

    const saveWorkspace = async (): Promise<void> => {
      if (!canSaveWorkspace()) return
      workspaceSaving.set(true)
      try {
        const body = new FormData()
        body.set('workspaceName', workspaceName().trim())
        body.set('name', ownerName().trim())
        body.set('timezone', workspaceZone())
        body.set('shareMediaByTunnel', shareMediaByTunnel() ? '1' : '0')
        body.set('publishingPaused', publishingPaused() ? '1' : '0')
        const payload = await requestJson('/api/postline/settings/workspace', { method: 'POST', body }, copy.saveFailed)
        applyWorkspace(payload.data)
        workspaceMessage.set(copy.saved)
        workspaceTone.set('success')
      }
      catch (error) {
        workspaceMessage.set(error instanceof Error ? error.message : String(error))
        workspaceTone.set('error')
      }
      finally {
        workspaceSaving.set(false)
      }
    }

    // Export, import, delete everything (#209).
    const dataBusy = state(false)
    const dataMessage = state('')
    const dataTone = state('neutral')
    const deletePhrase = state('')

    const dataAction = async (work: () => Promise<string>): Promise<void> => {
      dataBusy.set(true)
      dataMessage.set('')
      try {
        dataMessage.set(await work())
        dataTone.set('success')
      }
      catch (error) {
        dataMessage.set(error instanceof Error ? error.message : String(error))
        dataTone.set('error')
      }
      finally {
        dataBusy.set(false)
      }
    }

    const archiveList = new Intl.ListFormat(language, { type: 'conjunction' })
    const archiveCount = (count: number, forms: { one: string, other: string }): string =>
      forms[plural.select(count) === 'one' ? 'one' : 'other'].replace('{count}', () => numbers.format(count))

    const importWorkspace = (event: Event): Promise<void> => dataAction(async () => {
      const file = (event.target as HTMLInputElement | null)?.files?.[0]
      if (!file) return ''
      const body = new FormData()
      body.set('archive', await file.text())
      const payload = await requestJson('/api/postline/settings/import', { method: 'POST', body }, copy.importFailed)
      const report = payload.data.report as ImportReport
      const items = [
        archiveCount(report.posts, copy.importPosts),
        archiveCount(report.campaigns, copy.importCampaigns),
        archiveCount(report.blogPosts, copy.importBlogPosts),
        archiveCount(report.monitors, copy.importMonitors),
      ]
      if (report.composerPresets) items.push(archiveCount(report.composerPresets, copy.importPresets))
      if (report.trackedLinks) items.push(archiveCount(report.trackedLinks, copy.importLinks))
      if (report.draftFeeds) items.push(archiveCount(report.draftFeeds, copy.importFeeds))
      if (report.postingSlots) items.push(archiveCount(report.postingSlots, copy.importSlots))
      if (report.recurringPosts) items.push(archiveCount(report.recurringPosts, copy.importRepeats))
      items.push(archiveCount(report.media, copy.importImages))
      const summary = copy.importResults.replace('{items}', () => archiveList.format(items))
      return report.skipped ? `${summary} ${archiveCount(report.skipped, copy.importSkipped)}` : summary
    })

    const deleteEverything = async (): Promise<void> => {
      const confirmation = deletePhrase()
      if (!await stxConfirm(copy.deleteDataWarning, { title: copy.deleteDataQuestion, type: 'error', confirmText: copy.deleteDataConfirm, cancelText: copy.cancelDataDeletion })) return
      await dataAction(async () => {
        const body = new FormData()
        body.set('confirmation', confirmation)
        await requestJson('/api/postline/settings/delete-everything', { method: 'POST', body }, copy.deleteDataFailed)
        deletePhrase.set('')
        return copy.deleteDataCompleted
      })
    }

    // Whether email actually leaves this machine (#213). Without a mailer it
    // is written to the log, which is fine until someone expects it to arrive.
    const mail = state<{ configured: boolean, driver: string, from: string } | null>(null)
    const mailDescription = derived(() => {
      const current = mail()
      if (!current) return ''
      if (!current.configured) return copy.noMailer
      return current.from ? copy.mailerFrom.replace('{driver}', () => current.driver).replace('{sender}', () => current.from) : copy.mailer.replace('{driver}', () => current.driver)
    })
    const delivery = state<{ email: boolean, webhook: boolean } | null>(null)
    const desktop = useNativeDesktop()
    const notifications = () => (desktop() as DesktopAlertsBridge | null)?.notifications
    const notificationControls = derived(() => Boolean(notifications()?.getPermissionStatus && notifications()?.requestPermission))
    const nativeNotificationPermission = state('')
    const requestingNotifications = state(false)
    const nativeNotificationDescription = derived(() => {
      switch (nativeNotificationPermission()) {
        case 'authorized': return copy.on
        case 'provisional': return copy.quiet
        case 'denied': return copy.denied
        case 'notDetermined': return copy.needsPermission
        case 'unknown': return copy.unknownPermission
        default: return ''
      }
    })
    const loadNativeNotificationPermission = async () => {
      const permission = await notifications()?.getPermissionStatus?.().catch(() => 'unknown')
      nativeNotificationPermission.set(permission || 'unknown')
    }
    const allowNativeNotifications = async () => {
      if (requestingNotifications()) return
      requestingNotifications.set(true)
      try {
        await notifications()?.requestPermission?.()
        await loadNativeNotificationPermission()
      }
      catch {
        nativeNotificationPermission.set('unknown')
      }
      finally {
        requestingNotifications.set(false)
      }
    }
    effect(() => {
      if (pane() === 'notifications' && notificationControls()) void loadNativeNotificationPermission()
    })
    useEventListener('focus', () => {
      if (pane() === 'notifications' && notificationControls()) void loadNativeNotificationPermission()
    })
    const loadDelivery = async (): Promise<void> => {
      try {
        const response = await fetch('/api/postline/system')
        const payload = await response.json()
        if (response.ok && payload.ok) {
          mail.set(payload.data?.mail || null)
          delivery.set(payload.data?.alerts || null)
        }
      }
      catch {}
    }

    // AI provider for campaign planning (#138). The key field starts empty and
    // stays empty after saving: the saved key never comes back to the page.
    const aiProviderOptions = [
      { value: '', label: copy.providerFromEnvironment },
      { value: 'anthropic', label: 'Anthropic' },
      { value: 'openai', label: 'OpenAI' },
      { value: 'ollama', label: copy.localOllama },
    ]
    const aiProvider = state('')
    const aiKey = state('')
    const aiModel = state('')
    const aiHasKey = state(false)
    const aiActive = state<{ provider?: string, model?: string, configured?: boolean } | null>(null)
    const aiSaving = state(false)
    const aiMessage = state('')
    const aiTone = state('neutral')
    const aiKeyDescription = derived(() => aiHasKey() ? copy.replaceKey : copy.encryptedKey)
    const aiModelPlaceholder = derived(() => aiProvider() === 'anthropic' ? 'claude-sonnet-5-5' : aiProvider() === 'openai' ? 'gpt-5.6-terra' : aiProvider() === 'ollama' ? 'llama3.2' : '')
    const aiActiveText = derived(() => {
      const active = aiActive()
      if (!active) return '—'
      if (!active.configured) return copy.builtInPlanner
      const name = active.provider === 'openai' ? 'OpenAI' : active.provider === 'ollama' ? 'Ollama' : active.provider === 'anthropic' ? 'Anthropic' : String(active.provider)
      return active.model ? `${name}, ${active.model}` : name
    })

    const applyAi = (data: { provider: string, model: string, hasKey: boolean, active?: { provider?: string, model?: string, configured?: boolean } }): void => {
      aiProvider.set(data.provider || '')
      aiModel.set(data.model || '')
      aiHasKey.set(Boolean(data.hasKey))
      aiActive.set(data.active || null)
      aiKey.set('')
    }

    const loadAi = async (): Promise<void> => {
      try {
        const response = await fetch('/api/postline/settings/ai')
        const payload = await response.json()
        if (!response.ok || !payload.ok) throw new Error(payload.error || copy.loadAiFailed)
        applyAi(payload.data)
      }
      catch (error) {
        aiMessage.set(error instanceof Error ? error.message : String(error))
        aiTone.set('error')
      }
    }

    const sendAi = async (fields: Record<string, string>, done: string): Promise<void> => {
      aiSaving.set(true)
      try {
        const body = new FormData()
        for (const [key, value] of Object.entries(fields)) body.set(key, value)
        const response = await fetch('/api/postline/settings/ai', { method: 'POST', body })
        const payload = await response.json()
        if (!response.ok || !payload.ok) throw new Error(payload.error || copy.saveFailed)
        applyAi(payload.data)
        aiMessage.set(done)
        aiTone.set('success')
      }
      catch (error) {
        aiMessage.set(error instanceof Error ? error.message : String(error))
        aiTone.set('error')
      }
      finally {
        aiSaving.set(false)
      }
    }

    const saveAi = (): Promise<void> => sendAi({ provider: aiProvider(), model: aiModel().trim(), apiKey: aiKey().trim() }, copy.saved)
    const removeAiKey = (): Promise<void> => sendAi({ clearKey: '1' }, copy.keyRemoved)

    const retentionScopeOptions = [
      { value: 'all', label: copy.retentionAll },
      { value: 'tracked', label: copy.retentionTracked },
    ]
    const retentionLoaded = state(false)
    const savedEnabled = state(false)
    const savedDays = state(7)
    const savedScope = state<'all' | 'tracked'>('tracked')
    const savedProviders = state<string[]>([])
    const autoEnabled = state(false)
    // The number field's model is text; the saved value is the whole number in it.
    const autoDaysText = state('7')
    const autoDays = derived(() => Number(autoDaysText()))
    const autoScope = state<'all' | 'tracked'>('tracked')
    const onBluesky = state(false)
    const onTwitter = state(false)
    const onMastodon = state(false)
    const onLinkedin = state(false)
    const autoProviders = derived(() => [
      onBluesky() ? 'bluesky' : '',
      onTwitter() ? 'twitter' : '',
      onMastodon() ? 'mastodon' : '',
      onLinkedin() ? 'linkedin' : '',
    ].filter(Boolean))
    const acknowledged = state(false)
    const saving = state(false)
    const previewing = state(false)
    const retentionMessage = state('')
    const retentionTone = state('')
    const lastRunText = state('')

    const statusPill = derived(() => savedEnabled() ? copy.retention.replace('{age}', age.format(savedDays())) : copy.off)
    const daysValid = derived(() => Number.isInteger(autoDays()) && autoDays() >= 1 && autoDays() <= 3650)
    // Consent is asked for whenever a change makes it delete more: switching
    // it on, a shorter age limit, another network, or the wider scope. The
    // server applies the same rule (`widensDeletion`), so this only decides
    // whether the switch is shown.
    const needsAcknowledgement = derived(() => autoEnabled() && (
      !savedEnabled()
      || (daysValid() && autoDays() < savedDays())
      || autoProviders().some(provider => !savedProviders().includes(provider))
      || (autoScope() === 'all' && savedScope() !== 'all')
    ))
    const canSave = derived(() => retentionLoaded()
      && !saving()
      && daysValid()
      && (!autoEnabled() || autoProviders().length > 0)
      && (!needsAcknowledgement() || acknowledged()))

    const say = (message: string, tone: '' | 'success' | 'error' = ''): void => {
      retentionMessage.set(message)
      retentionTone.set(tone)
    }

    const describeLastRun = (run: RetentionLastRun | null): string => {
      if (!run) return ''
      const when = new Date(`${run.at.replace(' ', 'T')}Z`)
      const at = Number.isNaN(when.getTime()) ? run.at : when.toLocaleString(language)
      return copy.retentionLastRun
        .replace('{date}', () => at)
        .replace('{deleted}', numbers.format(run.deleted))
        .replace('{failed}', run.failed ? copy.retentionFailedCount.replace('{count}', numbers.format(run.failed)) : '')
    }

    const applyRetention = (settings: RetentionSettings, defaults: string[], lastRun: RetentionLastRun | null): void => {
      savedEnabled.set(settings.enabled)
      savedDays.set(settings.days)
      savedScope.set(settings.scope)
      savedProviders.set(settings.enabled ? [...settings.providers] : [])
      autoEnabled.set(settings.enabled)
      autoDaysText.set(String(settings.days))
      autoScope.set(settings.scope)
      const providers = settings.providers.length ? settings.providers : defaults
      onBluesky.set(providers.includes('bluesky'))
      onTwitter.set(providers.includes('twitter'))
      onMastodon.set(providers.includes('mastodon'))
      onLinkedin.set(providers.includes('linkedin'))
      acknowledged.set(false)
      lastRunText.set(describeLastRun(lastRun))
    }

    let defaultProviders: string[] = ['bluesky', 'twitter', 'mastodon', 'linkedin']

    const loadRetention = async (): Promise<void> => {
      try {
        const response = await fetch('/api/postline/settings/retention')
        const payload = await response.json()
        if (!response.ok || !payload.ok) throw new Error(payload.error || copy.retentionLoadFailed)
        defaultProviders = payload.data.defaultProviders || defaultProviders
        applyRetention(payload.data.settings, defaultProviders, payload.data.lastRun)
        retentionLoaded.set(true)
      }
      catch (error) {
        say(error instanceof Error ? error.message : String(error), 'error')
      }
    }

    const saveRetention = async (): Promise<void> => {
      if (!canSave()) return
      saving.set(true)
      try {
        const body = new FormData()
        body.set('enabled', autoEnabled() ? '1' : '0')
        body.set('days', String(autoDays()))
        body.set('scope', autoScope())
        body.set('providers', autoProviders().join(','))
        if (acknowledged()) body.set('acknowledged', '1')

        const response = await fetch('/api/postline/settings/retention', { method: 'POST', body })
        const payload = await response.json()
        if (!response.ok || !payload.ok) throw new Error(payload.error || copy.saveFailed)

        applyRetention(payload.data.settings, defaultProviders, payload.data.lastRun)
        say(payload.data.settings.enabled
          ? copy.retentionEnabled.replace('{age}', age.format(payload.data.settings.days))
          : copy.retentionDisabled, 'success')
      }
      catch (error) {
        say(error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        saving.set(false)
      }
    }

    /** Count what a run right now would delete, through the purge preview. */
    const previewRetention = async (): Promise<void> => {
      if (!daysValid()) {
        say(copy.retentionInvalidDays, 'error')
        return
      }
      if (!autoProviders().length) {
        say(copy.retentionNeedNetwork, 'error')
        return
      }

      previewing.set(true)
      say(copy.retentionCounting)
      try {
        const query = new URLSearchParams({
          scope: autoScope(),
          providers: autoProviders().join(','),
          older_than_days: String(autoDays()),
        })
        const response = await fetch(`/api/postline/purge/preview?${query.toString()}`)
        const payload = await response.json()
        if (!response.ok || !payload.ok) throw new Error(payload.error || copy.retentionPreviewFailed)

        const parts = (payload.data.providers || [])
          .filter((row: { connected: boolean }) => row.connected)
          .map((row: { provider: string, handle: string | null, matched: number, skippedReason?: string }) =>
            row.skippedReason ? `${row.handle || row.provider}: ${row.skippedReason}` : `${row.handle || row.provider}: ${row.matched}`)
        const matched = payload.data.matched
        const summary = plural.select(matched) === 'one' ? copy.retentionPreviewOne : copy.retentionPreviewMany
        say(summary.replace('{count}', numbers.format(matched))
          .replace('{age}', age.format(autoDays()))
          .replace('{accounts}', () => parts.length ? ' (' + parts.join(' · ') + ')' : ''))
      }
      catch (error) {
        say(error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        previewing.set(false)
      }
    }

    onMount(() => {
      void loadWorkspace()
      void loadRetention()
      void loadAi()
      void loadDelivery()
      if (ownWindow()) void requestDesktopUpdate()
      onDestroy(() => workspace?.close())
      onDestroy(bindWorkspaceChanges())

      // A window with a hidden titlebar moves only when the page hands the
      // press to AppKit: WebKit ignores -webkit-app-region.
      useEventListener('mousedown', (event: MouseEvent) => {
        const target = event.target instanceof Element ? event.target : null
        if (event.button !== 0 || !target?.closest('[data-window-drag]')) return
        if (target.closest('button, input, a, select, textarea, [role="button"], .stx-settings-search')) return
        void window.craft?.window?.startDrag?.()
      }, { target: document })

      // Keep 'system' live if the OS theme flips while the page is open.
      // useEventListener unsubscribes on destroy; a raw addEventListener here
      // would outlive the SPA swap.
      useEventListener('change', () => {
        if (themePref() === 'system') applyTheme('system')
      }, { target: matchMedia('(prefers-color-scheme: dark)') })

      /**
       * Summarise every channel, not whichever one was built first.
       *
       * This panel is titled "Publishing channels" and reported on Bluesky
       * alone, with the word "Bluesky" hardcoded into the Composer card beside
       * it and an unattributed 300-character limit. With nothing connected it
       * said "No Bluesky account connected yet." while the composer greyed out
       * every network — two panels disagreeing, and Bluesky looking like a
       * special case rather than one of several.
       *
       * `blog` and `postline` are filtered out: both are this workspace's own
       * targets, always available, and neither is an account anyone connects.
       * Counting them would report channels ready that the Channels page
       * cannot show.
       */
      void fetchProviders().then((all) => {
        const channels = all.filter(entry => entry.provider !== 'blog')
        const ready = channels.filter(entry => entry.canPublish)
        // Connected but not publishable: a token that lapsed, or a row whose
        // credential never arrived. Worth separating from "nothing here
        // yet", because the fix is a different one.
        const pending = channels.filter(entry => !entry.canPublish && entry.handle)

        channelSummary.set(
          ready.length > 0
            ? copy.readyChannels.replace('{ready}', numbers.format(ready.length)).replace('{total}', numbers.format(channels.length)).replace('{channels}', () => ready.map(entry => providerLabel(entry.provider)).join(', '))
            : pending.length > 0
              ? copy.pendingChannels.replace('{pending}', numbers.format(pending.length)).replace('{total}', numbers.format(channels.length))
              : copy.noChannels,
        )
        channelPill.set(ready.length > 0 ? `${ready.length}/${channels.length}` : copy.setup)

        // The binding limit is the tightest among the channels that can
        // actually publish: with Bluesky on, 300 constrains the post however
        // much room X would allow. Naming the network it came from is the
        // point — an unattributed number reads as a global setting rather
        // than one network's rule.
        const limited = ready.filter(entry => entry.characterLimit > 0)
        if (limited.length > 0) {
          const tightest = limited.reduce((a, b) => (b.characterLimit < a.characterLimit ? b : a))
          charLimitText.set(String(tightest.characterLimit))
          charLimitSource.set(providerLabel(tightest.provider))
        }
        else {
          charLimitText.set('—')
          charLimitSource.set(copy.noCharacterLimit)
        }
      }).catch(() => {
        channelSummary.set(copy.channelStatusFailed)
        channelPill.set(copy.unknown)
      })
    })
  </script>
@endsection
