@extends('layouts/marketing')

@section('title', 'Changelog - Postline')
@section('description', 'Every Postline release and what changed in it, from the release notes.')
@section('canonical', 'https://postline.stacksjs.com/changelog')

<script server>
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import { parseChangelog } from '../../app/Support/Marketing/changelog'

// Read at build time from the release script's own notes.
const releases = parseChangelog(readFileSync(join(process.cwd(), 'CHANGELOG.md'), 'utf8'))
</script>

@section('content')
  <LegalPage heading="Changelog" intro="Every release and what changed in it. Downloads are on the GitHub releases page.">
    @foreach (releases as release)
      <section class="grid gap-4 min-w-0">
        <div class="flex flex-wrap gap-3 items-baseline justify-between">
          <h2 class="m-0 text-2xl text-ink">{{ release.version }}</h2>
          @if (release.compare)
            <a class="text-[14px] text-muted underline underline-offset-4 hover:text-ink" href="{{ release.compare }}">Compare with the release before</a>
          @endif
        </div>
        @foreach (release.groups as group)
          <div class="grid gap-2 min-w-0">
            <h3 class="m-0 font-semibold text-[15px] text-ink">{{ group.title }}</h3>
            <ul class="grid gap-1.5 grid-cols-[minmax(0,1fr)] m-0 pl-5 min-w-0 break-words leading-relaxed text-[15px] text-body">
              @foreach (group.items as item)
                <li>
                  @if (item.scope)
                    <span class="font-medium text-ink">{{ item.scope }}:</span>
                  @endif
                  {{ item.text }}
                  @if (item.commit)
                    <a class="text-muted underline underline-offset-4 hover:text-ink" href="{{ item.commit }}">commit</a>
                  @endif
                </li>
              @endforeach
            </ul>
          </div>
        @endforeach
      </section>
    @endforeach
  </LegalPage>
@endsection
