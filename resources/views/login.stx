@extends('layouts/default')

@section('title', 'Postline - Sign in')

@section('content')
  @meta('description', 'Sign in to your Postline workspace.')
  <script>
    // Login uses a different layout, so it carries its own theme bootstrap.
    // Stays a plain pre-paint script on purpose: it must run before first paint,
    // and a hydrated directive would flash the wrong theme. See
    // stacksjs/stx#1788 for why useColorMode cannot express this yet.
    ;(() => {
      try {
        const s = localStorage.getItem('theme') || 'system'
        const d = s === 'dark' || (s === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', d)
        document.documentElement.setAttribute('data-theme', d ? 'dark' : 'light')
      } catch {}
    })()
  </script>
  <main class="grid place-items-center px-4 min-h-screen bg-bg" data-testid="login-page">
    <section class="grid gap-5 p-6 max-w-sm w-full bg-panel border border-line rounded-2xl shadow-sm">
      <header class="grid gap-2 justify-items-center text-center">
        <span class="grid place-items-center h-11 w-11 font-bold text-lg text-on-accent bg-accent rounded-xl">P</span>
        <h1 class="m-0 font-bold text-[20px] text-ink" :text="heading()">Sign in to Postline</h1>
        <p class="m-0 text-[13px] text-muted" :text="subtitle()">Your personal publishing workspace.</p>
      </header>

      <form class="grid gap-3" @submit.prevent="onSubmit">
        <!-- Inline display:none is the pre-hydration state. bindShow treats an
            initial 'none' as "no original display", so showing the row clears
            the inline style and the grid class takes over — no flash, and no
            fighting between a hidden class and x-show. -->
        <label class="grid gap-1.5" style="display:none" x-show="registering()">
          <span class="font-bold text-muted text-xs">Name</span>
          <input class="px-3 h-10 text-ink text-sm bg-panel border border-line outline-none rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100" name="name" autocomplete="name" placeholder="Your name" x-model="accountName" :required="registering()">
        </label>
        <label class="grid gap-1.5">
          <span class="font-bold text-muted text-xs">Email</span>
          <input class="px-3 h-10 text-ink text-sm bg-panel border border-line outline-none rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100" name="email" type="email" autocomplete="username" placeholder="you@example.com" required x-model="email">
        </label>
        <label class="grid gap-1.5">
          <span class="font-bold text-muted text-xs">Password</span>
          <input class="px-3 h-10 text-ink text-sm bg-panel border border-line outline-none rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100" name="password" type="password" autocomplete="current-password" placeholder="••••••••" required minlength="6" x-model="password">
        </label>
        <label class="grid gap-1.5" style="display:none" x-show="registering()">
          <span class="font-bold text-muted text-xs">Confirm password</span>
          <input class="px-3 h-10 text-ink text-sm bg-panel border border-line outline-none rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100" name="password_confirmation" type="password" autocomplete="new-password" placeholder="••••••••" minlength="6" x-model="confirmPassword" :required="registering()">
        </label>
        <p class="m-0 text-red-700 text-xs" style="display:none" x-show="errorMessage()" :text="errorMessage()"></p>
        <button class="inline-flex items-center justify-center px-4 h-10 font-bold text-on-accent text-sm bg-accent hover:bg-neutral-800 rounded-xl disabled:opacity-50 transition-colors" type="submit" :disabled="busy()" :text="submitLabel()">Sign in</button>
      </form>

      <button class="text-muted text-xs underline hover:text-body transition-colors" type="button" @click="toggleMode" :text="toggleLabel()">First run? Create the workspace account</button>
    </section>
  </main>

  <script client>
    const registering = state(false)
    const errorMessage = state('')
    const busy = state(false)

    const accountName = state('')
    const email = state('')
    const password = state('')
    const confirmPassword = state('')

    const heading = derived(() => registering() ? 'Create your workspace' : 'Sign in to Postline')
    const subtitle = derived(() => registering()
      ? 'One account owns this Postline instance.'
      : 'Your personal publishing workspace.')
    const submitLabel = derived(() => registering() ? 'Create account' : 'Sign in')
    const toggleLabel = derived(() => registering()
      ? 'Already set up? Sign in instead'
      : 'First run? Create the workspace account')

    const toggleMode = () => {
      registering.set(!registering())
      errorMessage.set('')
    }

    /**
     * Persist the session and enter the app.
     *
     * A hard navigation rather than stx `navigate()`: the app shell reads auth
     * state at boot, so a fresh document is what makes the new session take
     * effect everywhere.
     */
    const storeTokenAndEnter = (token: string, expiresIn?: number | string | null): void => {
      const maxAge = Number(expiresIn) > 0 ? Number(expiresIn) : 60 * 60 * 24 * 30
      useCookie('auth-token', { maxAge }).set(token)
      location.assign('/composer')
    }

    const onSubmit = async () => {
      errorMessage.set('')

      // The workspace-owning account has no recovery path, so a first-run typo
      // must not silently create an account nobody can sign into.
      if (registering() && password() !== confirmPassword()) {
        errorMessage.set('Passwords do not match.')
        return
      }

      busy.set(true)

      const body = new FormData()
      body.set('email', email().trim())
      body.set('password', password())
      if (registering()) body.set('name', accountName().trim())

      try {
        const response = await fetch(registering() ? '/api/register' : '/api/login', { method: 'POST', body })
        const payload = await response.json().catch(() => ({}))

        if (registering()) {
          if (!response.ok || payload.ok === false)
            throw new Error(payload.error || 'Could not create the account.')
          const token = payload.data?.access_token
          if (token) storeTokenAndEnter(token)
          else registering.set(false)
          return
        }

        const token = payload.access_token || payload.token
        if (!response.ok || !token)
          throw new Error(payload.error || payload.message || 'Incorrect email or password.')
        storeTokenAndEnter(token, payload.expires_in)
      }
      catch (error) {
        errorMessage.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        busy.set(false)
      }
    }
  </script>
@endsection
