@extends('layouts/default')

@section('title', 'Postline - Sign in')

@section('content')
  @meta('description', 'Sign in to your Postline workspace.')
  {{-- The theme bootstrap that used to live here is now `app.colorMode` in
      config/ui.ts, so this page gets the same pre-paint stamp as every layout
      without carrying its own copy. stacksjs/stx#1788, the reason it was
      hand-rolled, is closed. --}}
  <main class="grid place-items-center px-4 min-h-screen bg-bg" data-testid="login-page">
    <section class="grid gap-5 p-6 max-w-sm w-full bg-panel border border-line rounded-2xl shadow-sm">
      <header class="grid gap-2 justify-items-center text-center">
        {{-- The same mark as the favicon and the sidebar (`.brand-mark`). --}}
        <span class="h-11 w-11 brand-mark" aria-hidden="true"></span>
        <h1 class="m-0 font-semibold text-ink text-xl" :text="heading()">Sign in to Postline</h1>
        <p class="m-0 text-muted text-ui" :text="subtitle()">Compose once, publish everywhere.</p>
      </header>

      <form class="grid gap-3" @submit.prevent="onSubmit">
        {{-- Inline display:none is the pre-hydration state. bindShow treats an
            initial 'none' as "no original display", so showing the row clears
            the inline style and the grid class takes over — no flash, and no
            fighting between a hidden class and x-show. --}}
        <label class="grid gap-1.5" style="display:none" x-show="registering()">
          <span class="font-semibold text-muted text-xs">Name</span>
          <input class="px-3 h-10 text-ink text-sm bg-panel border border-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" name="name" autocomplete="name" placeholder="Your name" x-model="accountName" :required="registering()">
        </label>
        <label class="grid gap-1.5">
          <span class="font-semibold text-muted text-xs">Email</span>
          <input class="px-3 h-10 text-ink text-sm bg-panel border border-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" name="email" type="email" autocomplete="username" placeholder="you@example.com" required x-model="email">
        </label>
        <label class="grid gap-1.5">
          <span class="font-semibold text-muted text-xs">Password</span>
          <input class="px-3 h-10 text-ink text-sm bg-panel border border-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" name="password" type="password" autocomplete="current-password" placeholder="••••••••" required :minlength="registering() ? 8 : 1" x-model="password">
        </label>
        <label class="grid gap-1.5" style="display:none" x-show="registering()">
          <span class="font-semibold text-muted text-xs">Confirm password</span>
          <input class="px-3 h-10 text-ink text-sm bg-panel border border-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" name="password_confirmation" type="password" autocomplete="new-password" placeholder="••••••••" minlength="8" x-model="confirmPassword" :required="registering()">
        </label>
        <p class="m-0 text-danger text-xs" style="display:none" x-show="errorMessage()" :text="errorMessage()"></p>
        <button class="inline-flex items-center justify-center px-4 h-10 font-semibold text-on-accent text-sm bg-accent hover:bg-accent-hover rounded-xl disabled:opacity-50 transition-colors" type="submit" :disabled="busy()" :text="submitLabel()">Sign in</button>
      </form>

      <button class="text-muted text-xs underline hover:text-body transition-colors" type="button" @click="toggleMode" :text="toggleLabel()">First run? Create the workspace account</button>
      <p class="text-center text-muted text-xs" :class="registering() ? 'hidden' : ''">
        Lost the password? Reset it on the machine Postline runs on:
        <code class="block mt-1 text-body whitespace-nowrap">./buddy user:add you@example.com --update</code>
      </p>
    </section>
  </main>

  <script client>
    const registering = state(false)
    const errorMessage = state('')
    const busy = state(false)

    const accountName = state('')
    const email = state('')
    const password = state('')
    const confirmPassword = state('')

    const heading = derived(() => registering() ? 'Set up Postline' : 'Sign in to Postline')
    const subtitle = derived(() => registering()
      ? 'One account owns this workspace.'
      : 'Compose once, publish everywhere.')
    const submitLabel = derived(() => registering() ? 'Create account' : 'Sign in')
    const toggleLabel = derived(() => registering()
      ? 'Already set up? Sign in instead'
      : 'First run? Create the workspace account')

    const toggleMode = () => {
      registering.set(!registering())
      errorMessage.set('')
    }

    /**
     * Enter the app.
     *
     * The session itself is already established by the time this runs: the
     * login response carried it as the httpOnly `auth-token` cookie, the
     * browser stored it, and the API reads it off every /api/ request
     * (app/Middleware/Auth.ts). This function cannot create a session and
     * never could — JavaScript can neither read nor write an httpOnly cookie,
     * so the `useCookie('auth-token').set(token)` that used to live here was a
     * silent no-op, and every sign-in bounced straight back to this page (#45).
     *
     * What it does leave behind is a marker the pre-paint guard in
     * layouts/app.stx can actually see. It carries no token — only the fact
     * that a session was established — and it is given the session's own
     * lifetime so the two lapse together. The API stays the authority: a marker
     * that somehow outlives its session is cleared by the first 401 the app
     * shell sees.
     *
     * A hard navigation rather than stx `navigate()`: the app shell reads auth
     * state at boot, so a fresh document is what makes the new session take
     * effect everywhere. navigate() is the wrong call here, not merely the
     * discouraged one — an SPA transition keeps the shell that booted without a
     * session. The hard load IS the mechanism.
     */
    const enterApp = (expiresIn?: number | string | null): void => {
      const maxAge = Number(expiresIn) > 0 ? Number(expiresIn) : 60 * 60 * 24 * 30
      useCookie('postline-signed-in', { maxAge }).set('1')
      // stx-strict-ignore-next-line location.assign
      location.assign('/composer')
    }

    const onSubmit = async () => {
      errorMessage.set('')

      // There is no recovery email: the password is reset from the machine
      // Postline runs on (`./buddy user:add <email> --update`, see the README).
      // A first-run typo should still not create an account its owner then
      // has to recover.
      if (registering() && password() !== confirmPassword()) {
        errorMessage.set('Passwords do not match.')
        return
      }

      busy.set(true)

      const body = new FormData()
      body.set('email', email().trim())
      body.set('password', password())
      if (registering()) body.set('name', accountName().trim())

      try {
        const response = await fetch(registering() ? '/api/register' : '/api/login', { method: 'POST', body })
        const payload = await response.json().catch(() => ({}))

        if (registering()) {
          if (!response.ok || payload.ok === false)
            throw new Error(payload.error || 'Could not create the account.')
          const token = payload.data?.access_token
          if (token) enterApp(payload.data?.expires_in)
          else registering.set(false)
          return
        }

        const token = payload.access_token || payload.token
        if (!response.ok || !token)
          throw new Error(payload.error || payload.message || 'Incorrect email or password.')
        enterApp(payload.expires_in)
      }
      catch (error) {
        errorMessage.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        busy.set(false)
      }
    }
  </script>
@endsection
