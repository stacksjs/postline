@extends('layouts/default')

@section('title', 'Postline - Sign in')

<script server>
import { isMarketingSite } from '../../app/Support/Marketing/site'

const allowsFirstRun = !isMarketingSite()
</script>

@section('content')
  @meta('description', 'Sign in to your Postline workspace.')
  @meta('robots', 'noindex, nofollow')
  {{-- The theme is stamped before paint by `app.colorMode` in config/ui.ts,
      as on every layout. --}}
  <main class="grid place-items-center px-4 min-h-screen bg-bg" data-testid="login-page">
    <section class="grid gap-5 p-6 max-w-sm w-full bg-panel border border-line rounded-2xl shadow-sm">
      <header class="grid gap-2 justify-items-center text-center">
        {{-- The same mark as the favicon and the sidebar (`.brand-mark`). --}}
        <span class="h-11 w-11 brand-mark" aria-hidden="true"></span>
        <h1 class="m-0 font-semibold text-ink text-xl" :text="heading()">Sign in to Postline</h1>
        <p class="m-0 text-muted text-ui" :text="subtitle()">Compose once, publish everywhere.</p>
      </header>

      <form class="grid gap-3" @submit.prevent="onSubmit">
        <label class="grid gap-1.5" x-show="!challenge()">
          <span class="font-semibold text-muted text-xs">Email</span>
          <input class="px-3 h-10 text-ink text-sm bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" name="email" type="email" autocomplete="username" placeholder="you@example.com" x-model="email" :required="!challenge()" autofocus>
        </label>
        <label class="grid gap-1.5" x-show="!challenge()">
          <span class="font-semibold text-muted text-xs">Password</span>
          <input class="px-3 h-10 text-ink text-sm bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" name="password" type="password" autocomplete="current-password" placeholder="••••••••" :required="!challenge()" x-model="password">
        </label>
        {{-- The second step when two-factor sign-in is on (#95). --}}
        <label class="gap-1.5" :class="challenge() ? 'grid' : 'hidden'">
          <span class="font-semibold text-muted text-xs">Authenticator code</span>
          <input class="px-3 h-10 text-ink text-sm tracking-widest bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" name="code" autocomplete="one-time-code" inputmode="text" placeholder="123456" maxlength="64" x-model="code" :required="!!challenge()" ref="codeInput" data-two-factor-code>
          <span class="text-muted text-xs">The 6-digit code from your authenticator app, or one of your recovery codes.</span>
        </label>
        <p class="m-0 text-danger text-xs" :class="{ 'sr-only': !errorMessage() }" :text="errorMessage()" role="alert"></p>
        <button class="inline-flex items-center justify-center px-4 h-10 font-semibold text-on-accent text-sm bg-accent hover:bg-accent-hover rounded-xl disabled:opacity-50 transition-colors" type="submit" :disabled="busy()" :text="submitLabel()">Sign in</button>
      </form>

      <button class="gap-2 items-center justify-center px-4 h-10 font-semibold text-ink text-sm bg-panel hover:bg-hover border border-line rounded-xl disabled:opacity-50 transition-colors" type="button" :class="passkeysOffered() ? 'inline-flex' : 'hidden'" :disabled="busy()" @click="signInWithPasskey" data-passkey-sign-in>
        <span class="h-4 w-4 i-hugeicons-key-01" aria-hidden="true"></span>
        Sign in with a passkey
      </button>
      <button class="text-muted text-xs underline hover:text-body transition-colors" type="button" :class="challenge() ? '' : 'hidden'" @click="cancelChallenge">Use a different account</button>
      @if(allowsFirstRun)
        <a :if="setupAvailable() && !challenge()" class="justify-self-center text-info text-sm underline" href="/setup" data-stx-link>Set up a new workspace</a>
      @endif
      <p class="text-center text-muted text-xs">
        Lost the password? Reset it on the machine Postline runs on:
        <code class="block mt-1 text-body whitespace-nowrap">./buddy user:add you@example.com --update</code>
        <a class="inline-block mt-1.5 underline hover:text-body" href="https://github.com/stacksjs/postline/blob/main/docs/first-run.md#if-you-lose-the-password" target="_blank" rel="noopener noreferrer">Lost the authenticator too?</a>
      </p>
    </section>
  </main>

  <script client>
    import { passkeys } from '../functions/passkeys'

    const setupAvailable = state(false)
    const returnToSetup = useRoute().query.return === 'setup'
    const errorMessage = state('')
    const busy = state(false)

    const email = state('')
    const password = state('')
    /** The password step's challenge while an authenticator code is due. */
    const challenge = state('')
    const code = state('')
    const codeInput = useRef('codeInput')
    // The code field replaces the ones that had focus: put the cursor in it
    // once stx has shown it, on whichever path asked for the code.
    effect(() => {
      if (challenge()) void nextTick(() => codeInput.current?.focus())
    })

    const webAuthn = passkeys.supported()
    const passkeysOffered = derived(() => webAuthn && !challenge())

    const heading = derived(() => challenge() ? 'Verify your sign-in' : 'Sign in to Postline')
    const subtitle = derived(() => challenge() ? 'Enter a code from your authenticator app.' : 'Compose once, publish everywhere.')
    const submitLabel = derived(() => challenge() ? 'Verify' : 'Sign in')

    onMount(async () => {
      if (!{{ allowsFirstRun }}) return
      try {
        const response = await fetch('/api/postline/setup/availability')
        if (response.ok) setupAvailable.set(Boolean((await response.json()).data?.available))
      }
      catch {}
    })

    /**
     * Enter the app.
     *
     * The session itself is already established by the time this runs: the
     * login response carried it as the httpOnly `auth-token` cookie, the
     * browser stored it, and the API reads it off every /api/ request
     * (app/Middleware/Auth.ts). This function cannot create a session and
     * never could — JavaScript can neither read nor write an httpOnly cookie,
     * so the `useCookie('auth-token').set(token)` that used to live here was a
     * silent no-op, and every sign-in bounced straight back to this page (#45).
     *
     * What it does leave behind is a marker the pre-paint guard in
     * layouts/app.stx can actually see. It carries no token — only the fact
     * that a session was established — and it is given the session's own
     * lifetime so the two lapse together. The API stays the authority: a marker
     * that somehow outlives its session is cleared by the first 401 the app
     * shell sees.
     *
     * The app shell reads auth state at boot. Load a fresh document so the
     * new session takes effect everywhere.
     */
    const enterApp = (expiresIn?: number | string | null): void => {
      const maxAge = Number(expiresIn) > 0 ? Number(expiresIn) : 60 * 60 * 24 * 30
      useCookie('postline-signed-in', { maxAge }).set('1')
      navigate(returnToSetup ? '/setup' : '/composer', { reload: true, replace: true })
    }

    const cancelChallenge = () => {
      challenge.set('')
      code.set('')
      password.set('')
      errorMessage.set('')
    }

    /** The password was right; trade the challenge and a code for the session. */
    const verifyCode = async () => {
      const response = await fetch('/api/auth/two-factor/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ challenge_token: challenge(), code: code().replace(/\s+/g, '') }),
      })
      const payload = await response.json().catch(() => ({}))
      const token = payload.access_token || payload.token
      if (response.ok && token) {
        enterApp(payload.expires_in)
        return
      }
      if (response.status !== 401)
        throw new Error(payload.error || payload.message || 'That code is not right.')
      // A challenge is single-use, so a wrong code spends it. Ask for a fresh
      // one with the password still in hand, so a typo costs a retry rather
      // than the password. If that fails too, back to the password step.
      if (!await requestChallenge()) {
        cancelChallenge()
        throw new Error('That code is not right. Sign in again.')
      }
      code.set('')
      throw new Error('That code is not right. Try again.')
    }

    /** The password step on its own; true when it answered with a challenge. */
    const requestChallenge = async (): Promise<boolean> => {
      const body = new FormData()
      body.set('email', email().trim())
      body.set('password', password())
      const response = await fetch('/api/login', { method: 'POST', body })
      const payload = await response.json().catch(() => ({}))
      if (!response.ok || !payload.requires_two_factor || !payload.challenge_token) return false
      challenge.set(payload.challenge_token)
      return true
    }

    /**
     * Sign in with a passkey. A dismissed prompt leaves the sign-in form open.
     */
    const signInWithPasskey = async () => {
      errorMessage.set('')
      busy.set(true)
      try {
        const session = await passkeys.signIn()
        if (session?.token) enterApp(session.expires_in)
      }
      catch (error) {
        errorMessage.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        busy.set(false)
      }
    }

    const onSubmit = async () => {
      errorMessage.set('')

      if (challenge()) {
        busy.set(true)
        try {
          await verifyCode()
        }
        catch (error) {
          errorMessage.set(error instanceof Error ? error.message : String(error))
        }
        finally {
          busy.set(false)
        }
        return
      }

      busy.set(true)

      const body = new FormData()
      body.set('email', email().trim())
      body.set('password', password())

      try {
        const response = await fetch('/api/login', { method: 'POST', body })
        const payload = await response.json().catch(() => ({}))

        if (response.ok && payload.requires_two_factor && payload.challenge_token) {
          challenge.set(payload.challenge_token)
          return
        }

        const token = payload.access_token || payload.token
        if (!response.ok || !token)
          throw new Error(payload.error || payload.message || 'Incorrect email or password.')
        enterApp(payload.expires_in)
      }
      catch (error) {
        errorMessage.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        busy.set(false)
      }
    }
  </script>
@endsection
