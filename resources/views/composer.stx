@extends('layouts/app')

@section('title', 'Postline - Composer')

@section('content')
  @meta('description', 'Write, schedule, publish, and review social posts from a clean personal workspace.')
  <section class="grid gap-5" data-postline-page="composer" data-testid="composer-page">
    {{-- Crosswind safelist: utilities applied dynamically from the script below
        (provider toggles, active-post highlight, connection summary, char
        counter, per-network override rows) must appear in static markup so the
        CSS scanner emits them.
        display:none is inline, not a hidden class: this list now carries
        layout utilities of its own (grid, min-h-20, p-3), and relying on
        hidden to out-rank them would leave a visible empty block if the
        generated stylesheet ever ordered them the other way. --}}
    <div class="grid gap-2 mt-2 p-2 p-3 min-h-20 min-h-7 leading-relaxed text-danger text-ink text-muted text-muted text-muted text-on-accent text-sm text-success text-warning bg-accent bg-danger-solid bg-line-strong bg-panel bg-panel-2 bg-panel-3 bg-success-soft bg-success-solid bg-success-solid hover:bg-raised border-info-line border-ink border-line border-success-line outline-none rounded-lg rounded-xl shadow-sm cursor-not-allowed resize-none" style="display:none" aria-hidden="true"></div>
    <header class="flex gap-4 items-center justify-between min-h-11">
      <div>
        <p class="mb-1.5 font-semibold text-muted text-xs tracking-wider uppercase">Composer</p>
        <h1 class="m-0 font-semibold text-2xl text-ink tracking-normal">Write a post</h1>
        <p class="mb-0 mt-1.5 text-muted text-ui">Draft once, then publish to every connected account.</p>
      </div>
    </header>
    <div class="grid">
      <section class="grid content-start grid-rows-[auto_auto_auto] self-start bg-panel border border-line rounded-2xl shadow-sm" aria-label="Post composer" :class="dragDepth() > 0 ? 'ring-2 ring-accent' : ''" @dragenter="enterImageDrop" @dragleave="leaveImageDrop" @dragover="overImageDrop" @drop="dropImages" @paste="pasteImages" data-composer-image-drop>
        <div class="hidden flex-wrap gap-3 items-center justify-between px-3 py-2 text-xs bg-info-soft border-b border-info-line" :class="{ 'hidden': !editHeading(), 'flex': !!editHeading() }" data-edit-banner>
          <span class="font-semibold text-info">Editing a queued post</span>
          <a class="inline-flex items-center px-2.5 min-h-6 font-semibold text-info bg-panel hover:bg-info-line border border-info-line rounded-lg transition-colors" href="/composer" data-stx-link>Cancel</a>
        </div>
        <header class="flex flex-wrap gap-3 items-center justify-between p-3 border-b border-line">
          <div class="flex gap-2 items-center">
            <strong class="text-ui" :text="editHeading() || 'New post'" data-composer-heading>New post</strong>
            <a class="inline-flex gap-1.5 items-center px-2.5 min-h-7 font-semibold text-muted text-xs bg-panel-2 hover:bg-raised border border-line rounded-lg transition-colors" href="/accounts" data-stx-link data-bluesky-connection data-no-window-drag>
              <span class="h-2 w-2 bg-line-strong rounded-full" data-bluesky-connection-dot aria-hidden="true"></span>
              <span data-bluesky-connection-label>Checking accounts…</span>
            </a>
          </div>
          <div class="grid grid-cols-2 p-0.5 bg-panel-3 border border-line rounded-xl" role="group" aria-label="Post format">
            <button class="px-2.5 py-1.5 min-w-19 text-xs rounded-lg transition-colors" type="button" data-view-toggle data-composer-mode="single" :data-active="composerFormat() === 'single'" :aria-pressed="composerFormat() === 'single'" :disabled="editingQueued()" @click="chooseFormat('single')">Single</button>
            <button class="px-2.5 py-1.5 min-w-19 text-xs rounded-lg transition-colors" type="button" data-view-toggle data-composer-mode="thread" :data-active="composerFormat() === 'thread'" :aria-pressed="composerFormat() === 'thread'" :disabled="editingQueued()" @click="chooseFormat('thread')">Thread</button>
          </div>
        </header>

        <div class="grid gap-1 p-4">
          {{-- Chips render from the providerRows() signal: one per network, or
              one per account (icon + handle) for a network with several
              connected. Their selected / disabled / over-limit states ride on
              data-attributes and are styled in config/css.ts, because a
              class string composed in the browser is invisible to the
              Crosswind extractor. --}}
          <div class="flex flex-wrap gap-2 mb-3" role="group" aria-label="Publishing channels">
            {{-- Object-form :class, rather than an inline display rule plus
                x-show. The string form of :class MERGES with the static class
                list, so a static hidden class would never come back off; the
                object form goes through classList.add/remove instead. Its keys
                are single-quoted literals, so the Crosswind extractor still
                sees them, and the static class is the pre-hydration state. --}}
            <span class="flex items-center px-2.5 min-h-8 text-muted text-xs bg-panel-2 border border-line rounded-xl" :class="{ 'hidden': !providersPending() }">Loading accounts…</span>
            <a class="flex hidden items-center px-2.5 min-h-8 text-muted text-xs bg-panel-2 hover:bg-raised border border-line rounded-xl transition-colors" :class="{ 'hidden': !providersEmpty() }" href="/accounts" data-stx-link>No accounts yet. Connect one →</a>
            <button class="flex hidden gap-1.5 items-center px-2.5 min-h-8 text-danger text-xs bg-danger-soft hover:bg-raised border border-line rounded-xl transition-colors" :class="{ 'hidden': !providersFailed() }" type="button" @click="retryProviders()">
              <span class="h-3.5 w-3.5 i-hugeicons-refresh" aria-hidden="true"></span>
              Couldn't load your accounts. Try again
            </button>
            <button
              class="inline-flex gap-1.5 items-center px-2.5 min-h-8 font-semibold text-xs border rounded-xl transition-colors"
              type="button"
              x-for="row in providerRows()"
              :data-provider-toggle="row.key"
              :data-selected="row.selected"
              :data-over="row.over"
              :data-connect="!row.connected"
              :title="row.title"
              :aria-pressed="row.selected"
              @click="toggleProvider(row.key)"
            >
              <span class="h-2 w-2 rounded-full" data-provider-dot aria-hidden="true"></span>
              <span class="shrink-0 h-3.5 w-3.5" :class="row.icon || 'hidden'" aria-hidden="true"></span>
              <span :text="row.connected ? row.label : `Connect ${row.label}`"></span>
            </button>
          </div>
          {{-- Per-network overrides. Rows are built by the script, one per
              selected target. Hidden in thread mode: the server publishes a
              thread's shared segments, so an override there would be a lie. --}}
          <div class="hidden mb-3" data-variant-section>
            <button class="inline-flex gap-1.5 items-center px-2.5 min-h-7 font-semibold text-muted text-xs bg-panel-2 hover:bg-raised border border-line rounded-lg transition-colors" type="button" data-variant-toggle aria-expanded="false">
              <span class="h-3.5 w-3.5 i-hugeicons-edit-02" aria-hidden="true"></span>
              <span data-variant-toggle-label>Customize per network</span>
            </button>
            <div class="hidden gap-2 mt-2" data-variant-panel></div>
          </div>
          <label class="hidden gap-2 items-center mb-2.5" :class="{ 'hidden': !showImageUrl(), 'flex': showImageUrl() }" data-compose-image-row>
            <span class="h-4 w-4 text-muted i-hugeicons-image-01" aria-hidden="true"></span>
            <input class="px-3 h-9 w-full text-ink text-sm bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" type="url" inputmode="url" placeholder="Image URL for Instagram" aria-label="Image URL for Instagram" x-model="postImageUrl" data-compose-image>
          </label>
          <input class="hidden mb-2 w-full font-semibold leading-snug text-2xl text-ink placeholder:text-muted bg-transparent border-0 outline-none rounded-md" :class="{ 'hidden': !showTitle(), 'block': showTitle() }" data-focus-outline type="text" maxlength="200" placeholder="Post title" aria-label="Blog post title" x-model="postTitle" data-compose-title>
          <div class="grid overflow-y-auto content-start gap-4 pr-1 max-h-72" data-composer-posts>
            <article class="grid gap-2 pb-3 last:pb-0 border-b border-line last:border-b-0" data-composer-post data-active="true">
              <header class="flex gap-3 items-center justify-between">
                <button class="inline-flex gap-1.5 items-center px-2.5 min-h-7 font-semibold text-on-accent text-xs bg-accent rounded-lg" type="button" data-select-post>
                  <span class="h-3.5 w-3.5 i-hugeicons-edit-02" aria-hidden="true"></span>
                  <span data-post-label>Post 1</span>
                </button>
                <button class="hidden items-center justify-center h-7 w-7 text-muted hover:text-ink bg-panel hover:bg-hover border border-line rounded-lg shadow-sm transition-colors" type="button" aria-label="Remove post" title="Remove post" data-remove-post>
                  <span class="h-3.5 w-3.5 i-hugeicons-cancel-01" aria-hidden="true"></span>
                </button>
              </header>
              <textarea class="min-h-36 w-full leading-relaxed text-ink text-xl placeholder:text-muted bg-transparent border-0 outline-none rounded-md resize-none" data-focus-outline spellcheck="true" aria-label="Post body 1" placeholder="What do you want to share?" data-bluesky-text></textarea>
              {{-- Long-form rich text mounts here and writes Markdown back into
                  the textarea above, which stays the source of truth. Hidden
                  until the blog is a target. --}}
              <div class="hidden" data-richtext-host></div>
              <div class="hidden overflow-hidden bg-panel-2 border border-line rounded-2xl" data-link-preview></div>
            </article>
          </div>
          {{-- Bluesky shows images or a link card, never both (#132). --}}
          <p class="m-0 mt-2 text-muted text-xs" :class="linkCardShown() && attachedImages().length ? '' : 'hidden'" data-card-replaced>The attached image is shown on Bluesky instead of the link card.</p>
        </div>

        {{--
          Attached images, up to four, each with the text a screen reader
          says in its place. Images saved on a post being edited show as one
          row: attaching new ones replaces them.
        --}}
        <div class="grid hidden gap-2 pb-3 px-3" :class="{ 'hidden': imageRows().length === 0 && imageWarnings().length === 0 }" data-attached-images>
          <div class="grid gap-2 grid-cols-[minmax(0,1fr)_auto] items-center px-2.5 py-2 bg-panel-2 border border-line rounded-xl" x-for="image in imageRows()" :key="image.id" data-attached-image>
            <div class="flex gap-2 items-center min-w-0">
              <img :if="image.preview" class="object-cover shrink-0 h-8 w-8 rounded-md" :src="image.preview" alt="">
              <span :if="!image.preview" class="shrink-0 h-4 w-4 text-muted i-hugeicons-image-01" aria-hidden="true"></span>
              <span class="text-ink text-xs truncate" :text="image.name" :title="image.name" data-image-name></span>
            </div>
            <div class="flex gap-0.5">
              <button class="inline-grid place-items-center h-8 w-8 text-muted hover:text-ink rounded-md disabled:opacity-40" type="button" :if="image.editable && imageRows().length > 1" :disabled="!image.canMoveEarlier || submitting()" :aria-label="'Move ' + image.name + ' earlier'" @click="moveImage(image.id, -1)">
                <span class="h-4 w-4 i-hugeicons-arrow-up-01" aria-hidden="true"></span>
              </button>
              <button class="inline-grid place-items-center h-8 w-8 text-muted hover:text-ink rounded-md disabled:opacity-40" type="button" :if="image.editable && imageRows().length > 1" :disabled="!image.canMoveLater || submitting()" :aria-label="'Move ' + image.name + ' later'" @click="moveImage(image.id, 1)">
                <span class="h-4 w-4 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
              </button>
              <button class="inline-grid place-items-center h-8 w-8 text-muted hover:text-ink rounded-md" type="button" :disabled="submitting()" :aria-label="image.removeLabel" @click="removeImage(image.id)">
                <span class="h-3.5 w-3.5 i-hugeicons-cancel-01" aria-hidden="true"></span>
              </button>
            </div>
            <input class="col-span-2 px-2.5 h-8 min-w-0 text-ink text-ui bg-panel border border-field-line outline-none rounded-lg focus:border-info-solid focus:ring-2 focus:ring-info-soft" type="text" maxlength="1000" placeholder="Describe it for people who cannot see it" x-show="image.editable" :disabled="submitting()" :value="image.alt" :aria-label="image.altLabel" @input="setImageAlt(image.id, $event)" data-image-alt>
            <span class="col-span-2 text-muted text-xs" x-show="!image.editable">Saved with the post. Attach new images to replace them.</span>
          </div>
          <ul class="grid gap-1 m-0 p-0 list-none text-danger text-xs" role="status" data-image-warnings>
            <li x-for="warning in imageWarnings()" :text="warning"></li>
          </ul>
        </div>

        {{--
          The post's language (Bluesky and Mastodon record it), and Mastodon's
          own visibility and content warning. Shown only when a network that
          uses them is selected.
        --}}
        <div class="flex hidden flex-wrap gap-2 items-center pb-3 px-3" :class="{ 'hidden': !showPostOptions() }" data-post-options>
          <label class="inline-flex gap-1.5 items-center text-muted text-xs" x-show="showLanguage()">
            <span>Language</span>
            <select class="px-2 h-8 text-ink text-ui bg-panel border border-field-line outline-none rounded-lg focus:border-info-solid focus:ring-2 focus:ring-info-soft" x-model="postLanguage" data-post-language>
              <option x-for="option in languageOptions" :value="option.value" :text="option.label"></option>
            </select>
          </label>
          <label class="inline-flex gap-1.5 items-center text-muted text-xs" x-show="showMastodonOptions()">
            <span>Mastodon</span>
            <select class="px-2 h-8 text-ink text-ui bg-panel border border-field-line outline-none rounded-lg focus:border-info-solid focus:ring-2 focus:ring-info-soft" x-model="mastodonVisibility" aria-label="Who can see it on Mastodon" data-mastodon-visibility>
              <option value="public">Public</option>
              <option value="unlisted">Quiet public</option>
              <option value="private">Followers only</option>
              <option value="direct">Mentioned people only</option>
            </select>
          </label>
          <input class="flex-1 px-2.5 h-8 min-w-48 text-ink text-ui bg-panel border border-field-line outline-none rounded-lg focus:border-info-solid focus:ring-2 focus:ring-info-soft" type="text" maxlength="500" placeholder="Content warning on Mastodon (optional)" aria-label="Content warning on Mastodon" x-show="showMastodonOptions()" x-model="mastodonSpoiler" data-mastodon-spoiler>
        </div>

        <footer class="flex flex-col gap-3 items-stretch justify-between sm:flex-row sm:items-center p-3 border-line border-t">
          <div class="flex gap-2 items-center min-w-0">
            <span class="min-w-0 text-muted text-xs truncate" data-bluesky-count>0 / 300 characters</span>
          </div>
          <div class="flex flex-wrap gap-2 items-center justify-end w-full sm:w-auto">
            <input class="hidden" type="file" :accept="acceptedImageTypes" multiple aria-label="Attach images" ref="attachInput" @change="chooseImages" data-attach-input>
            <button class="inline-flex items-center justify-center h-9 w-9 text-ink bg-panel hover:bg-hover border border-line rounded-xl shadow-sm transition-colors" type="button" aria-label="Attach images" title="Choose, drop, or paste up to four images" :disabled="submitting()" @click="openImageChooser" data-attach-button>
              <span class="h-4 w-4 i-hugeicons-image-01" aria-hidden="true"></span>
            </button>
            <button class="inline-flex items-center justify-center h-9 w-9 text-ink bg-panel hover:bg-hover border border-line rounded-xl shadow-sm transition-colors" type="button" aria-label="Add post" title="Add post" data-add-post :disabled="editingQueued() && composerFormat() === 'single'" x-show="!editingQueued() || composerFormat() === 'thread'">
              <span class="h-4 w-4 i-hugeicons-plus-sign" aria-hidden="true"></span>
            </button>
            <button class="inline-flex items-center justify-center h-9 w-9 text-ink bg-panel hover:bg-hover border border-line rounded-xl shadow-sm transition-colors" type="button" aria-label="Preview post" title="Preview post" data-preview-post>
              <span class="h-4 w-4 i-hugeicons-view" aria-hidden="true"></span>
            </button>
            <div class="inline-flex ml-auto sm:ml-0 text-on-accent bg-accent rounded-xl">
              <button class="inline-flex gap-2 items-center justify-center px-4 h-9 font-semibold hover:bg-accent-hover rounded-l-xl disabled:opacity-50 transition-colors disabled:cursor-not-allowed" type="button" ref="publishTrigger" data-bluesky-publish aria-keyshortcuts="Meta+Enter Control+Enter" :disabled="!canPublish() || submitting() || mediaWarnings().length > 0" @click="runPostAction">
                <span class="shrink-0 h-4 w-4 i-hugeicons-sent" aria-hidden="true"></span>
                <span data-bluesky-publish-label :text="postActionLabel()">Publish</span>
              </button>
              <details class="relative border-current border-l" ref="publishActions" data-composer-actions @keydown="closePublishActionsOnEscape">
                <summary class="grid place-items-center h-9 w-9 list-none hover:bg-accent-hover rounded-r-xl cursor-pointer" aria-label="Publishing actions" ref="publishMenuTrigger">
                  <span class="h-4 w-4 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
                </summary>
                <div class="grid absolute bottom-full right-0 z-30 gap-1 mb-1 p-1.5 min-w-40 text-ink text-ui bg-panel border border-line rounded-xl shadow-lg">
                  <button class="px-3 py-2 text-left hover:bg-hover rounded-lg" type="button" x-show="!editingQueued()" @click="choosePostAction('publish')">Publish now</button>
                  <PostlineSchedulePicker :value="scheduledIso" :timeZone="scheduleZone" label="Schedule" @change="selectSchedule" />
                  <button class="px-3 py-2 text-left hover:bg-hover rounded-lg" type="button" aria-keyshortcuts="Meta+S Control+S" @click="choosePostAction('draft')">Save draft</button>
                </div>
              </details>
            </div>
          </div>
        </footer>
      </section>

    </div>
  </section>

  <script client>
    import { dismissPostlineToast, showPostlineToast } from '../functions/postline-toast'
    import { countText } from '../../app/Support/Social/count-text'
    import { MAX_IMAGE_BYTES, MAX_POST_IMAGES, mediaObjections, POST_IMAGE_FORMATS } from '../../app/Support/Social/media-rules'
    import { instantFromWallTime, systemTimeZone } from '../../app/Support/time'
    import type { ComposerAction, ComposerDraft, ComposerFormat } from '../functions/composer-draft'
    import { COMPOSER_DRAFT_KEY, readComposerDraft, writeComposerDraft } from '../functions/composer-draft'
    import { fetchLinkPreview, fetchProviders, fetchWorkspace, formatHandle, publishCrosspost, targetLabel } from '../functions/social-client'

    // What the template reads lives at the top level: stx binds `x-for`,
    // `:class` and `@click` to top-level declarations, so the chips stayed on
    // "Loading accounts…" while their signals were declared inside the IIFE
    // below. That IIFE still computes them (they depend on its DOM helpers)
    // and mirrors the results into these with effect().
    const providerRows = state([])
    const providersPending = state(true)
    const providersEmpty = state(false)
    // The accounts could not be read (offline, a server error): not the same
    // as having none, so it says so and offers to try again.
    const providersFailed = state(false)
    const composerHandlers = { toggleProvider: null, retryProviders: null, scheduleChanged: null, setFormat: null, publish: null }
    const composerFormat = state<ComposerFormat>('single')
    const editingQueued = state(Boolean(useRoute().query.edit))
    const canPublish = state(false)
    const submitting = state(false)
    const postAction = state<ComposerAction>('publish')
    const savedDraft = useLocalStorage<ComposerDraft | null>(COMPOSER_DRAFT_KEY, null, {
      serializer: { read: readComposerDraft, write: writeComposerDraft },
      listenToStorageChanges: false,
    })
    const scheduledIso = state<string | null>(null)
    const scheduleZone = state(systemTimeZone())
    const publishTrigger = useRef('publishTrigger')
    const publishActions = useRef('publishActions')
    const publishMenuTrigger = useRef('publishMenuTrigger')

    const postActionLabel = derived(() => {
      if (submitting()) return postAction() === 'publish' && !editingQueued() ? 'Publishing…' : 'Saving…'
      const iso = scheduledIso()
      if (postAction() === 'schedule' && iso) {
        const when = new Date(iso).toLocaleString(undefined, { weekday: 'short', hour: 'numeric', minute: '2-digit', timeZone: scheduleZone() })
        return `Schedule for ${when}`
      }
      if (editingQueued() && postAction() !== 'draft') return 'Update post'
      return postAction() === 'draft' ? 'Save draft' : 'Publish'
    })
    const chooseFormat = (format: ComposerFormat) => {
      if (!editingQueued() && !submitting()) composerHandlers.setFormat?.(format)
    }
    const runPostAction = () => composerHandlers.publish?.()

    function closePublishActions(restoreMenuFocus = false) {
      if (publishActions.current) publishActions.current.open = false
      if (restoreMenuFocus || publishTrigger.current?.disabled) publishMenuTrigger.current?.focus()
      else publishTrigger.current?.focus()
    }

    function closePublishActionsOnEscape(event: KeyboardEvent) {
      if (event.key !== 'Escape' || event.defaultPrevented || !publishActions.current?.open) return
      event.preventDefault()
      closePublishActions(true)
    }

    function choosePostAction(action: 'publish' | 'draft') {
      scheduledIso.set(null)
      postAction.set(action)
      composerHandlers.scheduleChanged?.()
      closePublishActions()
    }

    const selectSchedule = ({ value }: { value: string | null }) => {
      scheduledIso.set(value)
      postAction.set(value ? 'schedule' : editingQueued() ? 'draft' : 'publish')
      composerHandlers.scheduleChanged?.()
      void nextTick(() => closePublishActions())
    }

    useEventListener('keydown', (event: KeyboardEvent) => {
      if (event.defaultPrevented || event.isComposing || event.repeat || !(event.metaKey || event.ctrlKey) || event.altKey || event.shiftKey) return
      if (event.target instanceof Element && event.target.closest('[role=dialog], [role=alertdialog]')) return
      if (event.key === 'Enter') {
        event.preventDefault()
        runPostAction()
      }
      else if (event.key.toLowerCase() === 's' && !submitting()) {
        event.preventDefault()
        choosePostAction('draft')
        runPostAction()
      }
    })
    const toggleProvider = key => composerHandlers.toggleProvider?.(key)
    const retryProviders = () => composerHandlers.retryProviders?.()

    interface ComposerImage {
      id: string
      file: File | null
      name: string
      alt: string
      preview?: string
      kept?: boolean
    }

    const selectedNetworkIds = state<string[]>([])
    const acceptedImageTypes = POST_IMAGE_FORMATS.join(',')
    const attachInput = useRef('attachInput')
    const dragDepth = state(0)
    const imageError = state('')
    const attachedImages = state<ComposerImage[]>([])
    let nextImageId = 0
    const mediaWarnings = derived(() => mediaObjections(
      selectedNetworkIds(),
      attachedImages().flatMap(image => image.file ? [{ bytes: image.file.size, mimeType: image.file.type }] : []),
    ))
    const imageWarnings = derived(() => imageError() ? [imageError(), ...mediaWarnings()] : mediaWarnings())

    /** Whether the first post carries a link card, for the note that an image replaces it. */
    const linkCardShown = state(false)
    const imageRows = derived(() => attachedImages().map((image, index) => ({
      id: image.id,
      name: image.name,
      alt: image.alt,
      preview: image.preview,
      editable: !image.kept,
      canMoveEarlier: index > 0,
      canMoveLater: index < attachedImages().length - 1,
      altLabel: `Alt text for image ${index + 1}`,
      removeLabel: image.kept ? 'Remove the saved images' : `Remove ${image.name}`,
    })))
    const imageHandlers = { removeSaved: null, changed: null }

    function setImageAlt(id: string, event: Event) {
      const alt = (event.target as HTMLInputElement).value
      attachedImages.set(attachedImages().map(image => image.id === id ? { ...image, alt } : image))
      imageHandlers.changed?.()
    }

    function clearImagePreviews() {
      for (const image of attachedImages()) {
        if (image.preview) URL.revokeObjectURL(image.preview)
      }
    }

    function removeImage(id: string) {
      if (submitting()) return
      const removed = attachedImages().find(image => image.id === id)
      if (!removed) return
      if (removed.preview) URL.revokeObjectURL(removed.preview)
      if (removed.kept) imageHandlers.removeSaved?.()
      attachedImages.set(attachedImages().filter(image => image.id !== id))
      imageError.set('')
      imageHandlers.changed?.()
    }

    function moveImage(id: string, offset: -1 | 1) {
      if (submitting()) return
      const images = [...attachedImages()]
      const index = images.findIndex(image => image.id === id)
      const next = index + offset
      if (index < 0 || next < 0 || next >= images.length) return
      const [moved] = images.splice(index, 1)
      images.splice(next, 0, moved)
      attachedImages.set(images)
      imageHandlers.changed?.()
    }

    function addImages(files: FileList | null | undefined) {
      if (!files?.length || submitting()) return
      const picked = [...files]
      const images = attachedImages().filter(image => !image.kept)
      if (images.length + picked.length > MAX_POST_IMAGES) {
        imageError.set(`A post can carry up to ${MAX_POST_IMAGES} images. Remove one first.`)
        return
      }
      const invalid = picked.find(file => !file.size || (file.type && !POST_IMAGE_FORMATS.includes(file.type)))
      if (invalid) {
        imageError.set(`${invalid.name} could not be attached. Choose a JPEG, PNG, WebP, or GIF image.`)
        return
      }
      const oversized = picked.find(file => file.size > MAX_IMAGE_BYTES)
      if (oversized) {
        imageError.set(`${oversized.name} is larger than ${MAX_IMAGE_BYTES / 1024 / 1024} MB.`)
        return
      }
      attachedImages.set([...images, ...picked.map(file => ({
        id: String(++nextImageId),
        file,
        name: file.name,
        alt: '',
        preview: URL.createObjectURL(file),
      }))])
      imageError.set('')
      imageHandlers.changed?.()
    }

    const openImageChooser = () => attachInput.current?.click()

    function chooseImages(event: Event) {
      const input = event.target as HTMLInputElement
      addImages(input.files)
      input.value = ''
    }

    function overImageDrop(event: DragEvent) {
      if (!event.dataTransfer?.types.includes('Files')) return false
      event.preventDefault()
      event.dataTransfer.dropEffect = submitting() ? 'none' : 'copy'
      return !submitting()
    }

    function enterImageDrop(event: DragEvent) {
      if (overImageDrop(event)) dragDepth.update(depth => depth + 1)
    }

    function leaveImageDrop(event: DragEvent) {
      if (event.dataTransfer?.types.includes('Files')) dragDepth.update(depth => Math.max(0, depth - 1))
    }

    function dropImages(event: DragEvent) {
      dragDepth.set(0)
      if (!overImageDrop(event)) return
      addImages(event.dataTransfer?.files)
    }

    function pasteImages(event: ClipboardEvent) {
      const clipboard = event.clipboardData
      if (!clipboard?.files.length) return
      if (!clipboard.getData('text/plain') && !clipboard.getData('text/html')) event.preventDefault()
      addImages(clipboard.files)
    }

    onDestroy(clearImagePreviews)

    // Show post options only for the selected networks that apply them.
    const postLanguage = state('')
    const mastodonVisibility = state('public')
    const mastodonSpoiler = state('')
    const postTitle = state('')
    const postImageUrl = state('')
    const editHeading = state('')
    const showTitle = derived(() => composerFormat() === 'single' && selectedNetworkIds().includes('blog'))
    const showImageUrl = derived(() => selectedNetworkIds().includes('instagram'))
    const showMastodonOptions = derived(() => selectedNetworkIds().includes('mastodon'))
    const showLanguage = derived(() => selectedNetworkIds().some(id => id === 'bluesky' || id === 'mastodon'))
    const showPostOptions = derived(() => showLanguage() || showMastodonOptions())
    /** Common languages, named in the reader's own language, the browser's first. */
    const languageOptions = (() => {
      const codes = ['en', 'es', 'de', 'fr', 'pt', 'pt-BR', 'it', 'nl', 'sv', 'pl', 'tr', 'ru', 'uk', 'ar', 'hi', 'ja', 'ko', 'zh']
      const own = String(navigator.language || '').split('-')[0]
      const ordered = own && codes.includes(own) ? [own, ...codes.filter(code => code !== own)] : codes
      let names = null
      try {
        names = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' })
      }
      catch {}
      return [{ value: '', label: 'Not set' }, ...ordered.map(code => ({ value: code, label: names?.of(code) || code }))]
    })()

    ;(() => {
      const root = document.querySelector('[data-testid="composer-page"]')
      if (!root) return
      if (root.dataset.composerReady === 'true') return
      root.dataset.composerReady = 'true'

      const count = root.querySelector('[data-bluesky-count]')
      const connection = root.querySelector('[data-bluesky-connection]')
      const connectionDot = root.querySelector('[data-bluesky-connection-dot]')
      const connectionLabel = root.querySelector('[data-bluesky-connection-label]')
      const variantSection = root.querySelector('[data-variant-section]')
      const variantToggle = root.querySelector('[data-variant-toggle]')
      const variantToggleLabel = root.querySelector('[data-variant-toggle-label]')
      const variantPanel = root.querySelector('[data-variant-panel]')

      /** The images attached in this session, with their alt text; saved ones are not included. */
      const attachedFiles = () => attachedImages().filter(image => image.file).map(image => ({ file: image.file, alt: image.alt.trim() }))
      /** Add the attached images to a request: repeated `images`, alt text as a list in the same order. */
      const appendImages = (form) => {
        const files = attachedFiles()
        for (const entry of files) form.append('images', entry.file, entry.file.name)
        if (files.length) form.set('image_alts', JSON.stringify(files.map(entry => entry.alt)))
        return files.length
      }
      /** The options that apply to the selected networks; the rest go as empty, which clears them. */
      const postOptions = () => ({
        language: showLanguage() ? postLanguage() : '',
        mastodonVisibility: showMastodonOptions() ? mastodonVisibility() : '',
        mastodonSpoiler: showMastodonOptions() ? mastodonSpoiler().trim() : '',
      })
      const appendOptions = (form) => {
        const options = postOptions()
        form.set('language', options.language)
        form.set('mastodon_visibility', options.mastodonVisibility)
        form.set('mastodon_spoiler', options.mastodonSpoiler)
      }
      /** After a post goes out: the content warning was for that post. The language is kept. */
      const resetPostOptions = () => {
        mastodonVisibility.set('public')
        mastodonSpoiler.set('')
      }
      const composedTitle = () => postTitle().trim() || undefined

      const clearAttachment = () => {
        clearImagePreviews()
        attachedImages.set([])
        imageError.set('')
        postImageUrl.set('')
      }
      const postsRoot = root.querySelector('[data-composer-posts]')
      const addPostButton = root.querySelector('[data-add-post]')
      const previewButton = root.querySelector('[data-preview-post]')
      const refreshButton = root.querySelector('[data-composer-refresh]')
      const searchButton = root.querySelector('[data-composer-search]')
      const urlPattern = /https?:\/\/[^\s<>"']+/i
      let activePost = root.querySelector('[data-composer-post]')
      let postCounter = root.querySelectorAll('[data-composer-post]').length
      let savedActiveIndex = 0

      // Signals, not plain values: the provider chips render from these through
      // x-for, so every mutation repaints with no hand-written render pass.
      // `selected` is an array rather than a Set because a Set mutates in place
      // and would never trip the signal. It holds target keys — `bluesky:12`
      // for an account, `blog` for our own targets — not network names, so two
      // accounts on one network can be picked independently.
      const providers = state([])
      const selectedList = state([])
      const providersLoaded = state(false)

      const selectedHas = (key) => selectedList().includes(key)
      const selectedAdd = (key) => { if (!selectedHas(key)) selectedList.set([...selectedList(), key]) }
      const selectedDelete = (key) => selectedList.set(selectedList().filter(entry => entry !== key))
      const selectedClear = () => selectedList.set([])

      // Edit mode: /?edit=<id> loads a queued post into the composer.
      const editParam = useRoute().query.edit || null
      let editingId = null
      let editHadImage = false
      let editRemoveImage = false

      const setStatus = (message, tone = 'neutral', options = {}) => {
        showPostlineToast({
          title: options.title,
          message,
          tone: tone === 'success' ? 'success' : tone === 'error' ? 'error' : 'info',
          url: options.url,
          id: options.id,
          action: options.action,
          dedupeMs: options.dedupeMs,
          durationMs: options.durationMs,
        })
      }

      /**
       * Publish targets, flattened from the network statuses.
       *
       * A network with one connected account (or none) stays one target and one
       * chip, exactly as before accounts were plural — keyed to that account so
       * the server publishes through it. A network with several becomes one
       * target per account. Each target keeps its network's fields (limit,
       * provider) so the counter, the limit checks and the per-network text
       * all keep working unchanged.
       */
      const publishTargets = derived(() => providers().flatMap((status) => {
        const live = (status.accounts || []).filter(account => account.connected)
        if (live.length <= 1) {
          const account = live[0]
          return [{
            ...status,
            key: account ? `${status.provider}:${account.id}` : status.provider,
            account: account || null,
            multi: false,
          }]
        }
        return live.map(account => ({
          ...status,
          key: `${status.provider}:${account.id}`,
          canPublish: account.canPublish,
          handle: account.handle,
          account,
          multi: true,
        }))
      }))
      const connectedProviders = () => publishTargets().filter(target => target.canPublish)
      const selectedConnected = () => connectedProviders().filter(target => selectedHas(target.key))
      /** One selected target per network — what per-network overrides are keyed on. */
      const selectedNetworks = () => selectedConnected().filter((target, index, list) =>
        list.findIndex(other => other.provider === target.provider) === index)

      /**
       * The chip key a stored target spec maps to. An account spec maps to its
       * own chip; a bare network (a campaign post, or one saved before accounts
       * were plural) maps to that network's default account.
       */
      const keyForSpec = (spec) => {
        const value = String(spec || '')
        const exact = publishTargets().find(target => target.key === value)
        if (exact) return exact.key
        const provider = value.split(':')[0]
        const candidates = publishTargets().filter(target => target.provider === provider)
        return (candidates.find(target => target.account?.isDefault) || candidates[0])?.key || null
      }

      // The tightest limit among selected targets. Used for the counter's
      // denominator only — it is never enforced on the textarea, because
      // capping input at the shortest network's limit would silently shorten
      // the post for every other network too.
      const effectiveLimit = () => {
        const limits = selectedConnected().map(provider => provider.characterLimit).filter(Boolean)
        return limits.length ? Math.min(...limits) : 300
      }

      /**
       * A text's length as `provider` measures it: graphemes on Bluesky, a
       * weighted count on X, links as 23 on X and Mastodon. These are the
       * same rules the server uses.
       */
      const lengthFor = (provider, text) => {
        const value = String(text || '')
        return countText(provider, value)
      }

      /** The selected network with the tightest limit: the one the counter counts for. */
      const tightestProvider = () => selectedConnected()
        .filter(provider => provider.characterLimit)
        .sort((a, b) => a.characterLimit - b.characterLimit)[0]?.provider || ''

      /**
       * Selected targets that would reject what they are actually going to
       * receive. A provider with an override is measured against that override,
       * not the shared body — otherwise the advisory reports on text the
       * provider will never see, and is wrong in both directions.
       */
      const overLimitProviders = () => selectedConnected()
        .filter(provider => provider.characterLimit && lengthFor(provider.provider, bodyFor(provider.provider)) > provider.characterLimit)
      /** Over-limit targets named once per network, for the counter's message. */
      const overLimitNetworks = () => overLimitProviders().filter((target, index, list) =>
        list.findIndex(other => other.provider === target.provider) === index)

      /**
       * Everything one provider chip renders, as plain data.
       *
       * State rides on data-attributes and is styled from config/css.ts
       * rather than by composing a class string here. The Crosswind extractor
       * only pulls single-quoted literals out of a :class value, so a computed
       * class string generates no utilities at all and would need a
       * hand-maintained safelist entry to survive.
       *
       * The over-limit flag is folded in here too, replacing a pass that used to
       * walk the rendered chips and toggle dot classes by hand.
       */
      const providerRowsView = derived(() => {
        const overKeys = new Set(overLimitProviders().map(entry => entry.key))
        return publishTargets().map((target) => {
          const connected = Boolean(target.canPublish)
          const isSelected = connected && selectedHas(target.key)
          const network = providerLabel(target.provider)
          // A per-account chip reads as icon + handle; the network name moves
          // to the tooltip so a row of three Bluesky chips stays scannable.
          const label = target.multi ? formatHandle(target.provider, target.account?.handle) : network
          const full = target.multi ? targetLabel(target.provider, target.account?.handle) : network
          const over = isSelected && overKeys.has(target.key)
          return {
            key: target.key,
            provider: target.provider,
            icon: target.multi ? providerIcon(target.provider) : '',
            label,
            connected,
            selected: isSelected,
            over,
            title: !connected
              ? `Opens Channels, where ${network} is connected.`
              : over
                ? `Too long for ${network}. Shorten this version before publishing.`
                : target.multi ? full : '',
          }
        })
      })

      effect(() => providerRows.set(providerRowsView()))
      effect(() => selectedNetworkIds.set(selectedNetworks().map(target => target.provider)))
      effect(() => providersPending.set(!providersLoaded()))
      effect(() => providersEmpty.set(providersLoaded() && providers().length === 0 && !providersFailed()))

      composerHandlers.toggleProvider = (key) => {
        // A network with no account is a way to connect one, not a dead chip.
        if (!publishTargets().find(target => target.key === key)?.canPublish) {
          navigate('/accounts')
          return
        }
        if (selectedHas(key)) selectedDelete(key)
        else selectedAdd(key)
        markEdited()
        updatePublishability()
      }

      
      
      // Per-network overrides: provider -> { text, shared }. `shared` is the
      // body captured when the override was created, so a later edit to the
      // shared text can be reported as having left this copy behind.
      const variants = new Map()
      let variantsOpen = false

      const sharedBody = () => activeTextarea()?.value || ''

      /**
       * Overrides only apply to a single-post composer: `publishThread` strips
       * them server-side. Rendering and payload building share this one test so
       * a state that cannot show an override can never send one either.
       */
      const variantsAvailable = () => selectedConnected().length > 0 && composerFormat() === 'single'

      /** Overrides worth sending: blank ones inherit, so they are dropped. */
      const variantsPayload = () => {
        const payload = {}
        if (!variantsAvailable()) return payload
        // Overrides are per network: two Bluesky accounts share the Bluesky one.
        variants.forEach((entry, provider) => {
          if (entry.text.trim()) payload[provider] = entry.text
        })
        return payload
      }

      /** The body a provider will actually receive — mirrors resolveVariantBody. */
      const bodyFor = (provider) => {
        const entry = variantsAvailable() ? variants.get(provider) : undefined
        return entry && entry.text.trim() ? entry.text : sharedBody()
      }

      const isVariantStale = entry => entry.shared !== sharedBody()

      const variantRow = (status) => {
        const provider = status.provider
        const label = providerLabel(provider)
        const entry = variants.get(provider)
        const limit = status.characterLimit || 0

        const row = document.createElement('div')
        row.className = 'grid gap-2 p-3 bg-panel-2 border border-line rounded-xl'
        row.dataset.variantRow = provider

        const head = document.createElement('div')
        head.className = 'flex gap-2 items-center justify-between'

        const name = document.createElement('span')
        name.className = 'font-semibold text-ink text-xs'
        name.textContent = label

        const action = document.createElement('button')
        action.type = 'button'
        action.className = 'inline-flex items-center px-2.5 min-h-7 font-semibold text-muted text-xs bg-panel hover:bg-raised border border-line rounded-lg transition-colors'
        action.dataset.variantAction = entry ? 'reset' : 'fork'
        action.dataset.variantProvider = provider
        action.textContent = entry ? 'Use shared text' : 'Customize'

        head.append(name, action)
        row.append(head)

        if (!entry) {
          const inherit = document.createElement('p')
          inherit.className = 'text-muted text-xs'
          const length = lengthFor(provider, sharedBody())
          inherit.textContent = limit && length > limit
            ? `Uses the shared text - ${length} / ${limit}, too long for ${label}`
            : `Uses the shared text${limit ? ` - ${length} / ${limit}` : ''}`
          inherit.dataset.variantInherit = provider
          row.append(inherit)
          return row
        }

        const area = document.createElement('textarea')
        area.className = 'p-2 min-h-20 w-full leading-relaxed text-ink text-sm bg-panel border border-field-line outline-none rounded-lg focus:border-info-solid resize-none'
        area.value = entry.text
        area.setAttribute('aria-label', `${label} post body`)
        area.dataset.variantInput = provider
        row.append(area)

        const meta = document.createElement('p')
        meta.className = 'text-muted text-xs'
        meta.dataset.variantMeta = provider
        row.append(meta)

        // Always present, shown or hidden by updateVariantMeta. Creating it up
        // front means staleness can be re-evaluated on every keystroke without
        // rebuilding the row and stealing focus.
        const stale = document.createElement('p')
        stale.className = 'hidden text-warning text-xs'
        stale.dataset.variantStale = provider
        stale.textContent = 'The shared text changed after you customised this.'
        row.append(stale)

        return row
      }

      /**
       * Refresh per-row counts and the staleness notice in place, so typing in
       * either the shared body or an override never rebuilds the panel.
       */
      const updateVariantMeta = () => {
        selectedNetworks().forEach((status) => {
          const provider = status.provider
          const limit = status.characterLimit || 0
          const entry = variants.get(provider)
          const inherit = variantPanel?.querySelector(`[data-variant-inherit="${provider}"]`)
          if (inherit) {
            const length = lengthFor(provider, sharedBody())
            const over = Boolean(limit) && length > limit
            inherit.textContent = over
              ? `Uses the shared text - ${length} / ${limit}, too long for ${providerLabel(provider)}`
              : `Uses the shared text${limit ? ` - ${length} / ${limit}` : ''}`
            inherit.classList.toggle('text-danger', over)
            inherit.classList.toggle('text-muted', !over)
          }
          const meta = variantPanel?.querySelector(`[data-variant-meta="${provider}"]`)
          if (meta && entry) {
            const length = lengthFor(provider, entry.text)
            const over = Boolean(limit) && length > limit
            meta.textContent = limit ? `${length} / ${limit} characters` : `${length} characters`
            meta.classList.toggle('text-danger', over)
            meta.classList.toggle('text-muted', !over)
          }
          const stale = variantPanel?.querySelector(`[data-variant-stale="${provider}"]`)
          if (stale) stale.classList.toggle('hidden', !entry || !isVariantStale(entry))
        })
      }

      const updateVariantToggleLabel = () => {
        if (!variantToggleLabel) return
        const active = Object.keys(variantsPayload()).length
        variantToggleLabel.textContent = variantsOpen
          ? 'Hide per-network text'
          : active
            ? `Customize per network (${active})`
            : 'Customize per network'
      }

      /**
       * Replace one row after a fork/reset instead of the whole panel, so the
       * other rows keep their caret, selection and undo history.
       */
      const refreshVariantRow = (provider) => {
        const existing = variantPanel?.querySelector(`[data-variant-row="${provider}"]`)
        const status = selectedNetworks().find(item => item.provider === provider)
        if (!existing || !status) {
          renderVariantPanel()
          return
        }
        const replacement = variantRow(status)
        existing.replaceWith(replacement)
        replacement.querySelector('[data-variant-input]')?.focus()
        updateVariantToggleLabel()
        updateVariantMeta()
      }

      const renderVariantPanel = () => {
        if (!variantSection || !variantPanel) return
        const networks = selectedNetworks()
        const available = variantsAvailable()
        variantSection.classList.toggle('hidden', !available)
        if (!available) variantsOpen = false

        updateVariantToggleLabel()
        variantToggle?.setAttribute('aria-expanded', variantsOpen ? 'true' : 'false')
        variantPanel.classList.toggle('hidden', !variantsOpen)
        variantPanel.classList.toggle('grid', variantsOpen)
        if (!variantsOpen) {
          variantPanel.replaceChildren()
          return
        }

        variantPanel.replaceChildren(...networks.map(variantRow))
        updateVariantMeta()
      }

      const renderConnectionSummary = () => {
        const connected = connectedProviders()
        const ready = connected.length > 0
        if (connectionLabel) {
          // Named per network; a network with several accounts says how many.
          const counts = new Map()
          connected.forEach(target => counts.set(target.provider, (counts.get(target.provider) || 0) + 1))
          connectionLabel.textContent = ready
            ? `${[...counts].map(([provider, total]) => total > 1 ? `${providerLabel(provider)} (${total})` : providerLabel(provider)).join(', ')} ready`
            : 'Connect an account'
        }
        connection?.classList.toggle('border-success-line', ready)
        connection?.classList.toggle('bg-success-soft', ready)
        connection?.classList.toggle('text-success', ready)
        connectionDot?.classList.toggle('bg-success-solid', ready)
        connectionDot?.classList.toggle('bg-line-strong', !ready)
      }

      const updatePublishability = () => {
        canPublish.set(selectedConnected().length > 0 && (!editParam || editingId !== null))
        renderVariantPanel()
        updateCount()
      }

      const applyConnection = (list) => {
        providers.set(Array.isArray(list) ? list : [])
        providersLoaded.set(true)
        const connectedKeys = connectedProviders().map(target => target.key)
        // Default to every connected network — through its default account
        // only. A second account on a network is opt-in per post: posting the
        // same words from two of your own accounts should be a choice, never
        // what happens because nobody unticked a chip. Otherwise drop any
        // selected target that is no longer connected.
        if (selectedList().length === 0) {
          connectedProviders()
            .filter(target => !target.multi || target.account?.isDefault)
            .forEach(target => selectedAdd(target.key))
        }
        else {
          ;[...selectedList()].forEach((key) => {
            if (!connectedKeys.includes(key)) selectedDelete(key)
          })
        }
        renderConnectionSummary()
        updatePublishability()
      }

      const refreshConnection = async () => {
        providersFailed.set(false)
        try {
          applyConnection(await fetchProviders())
        }
        catch (error) {
          // Inline, not a toast: a toast on every load would be noise, and an
          // expired session is sent to sign-in by the session script anyway.
          // It is not "no accounts", though, so it does not say that.
          providersFailed.set(true)
          applyConnection([])
          console.warn('[postline] provider status failed:', error)
        }
      }
      composerHandlers.retryProviders = () => {
        // A failed read is never cached, so asking again really asks.
        providersLoaded.set(false)
        void refreshConnection()
      }

      const textareaFor = post => post?.querySelector('[data-bluesky-text]')
      const previewFor = post => post?.querySelector('[data-link-preview]')
      const allPosts = () => Array.from(root.querySelectorAll('[data-composer-post]'))
      const activeTextarea = () => textareaFor(activePost) || root.querySelector('[data-bluesky-text]')
      const activePreview = () => previewFor(activePost)
      const firstUrl = value => value.match(urlPattern)?.[0]?.replace(/[),.;]+$/, '')

      const postTemplate = (number, text = '') => `
        <header class="flex gap-3 items-center justify-between">
          <button class="inline-flex gap-1.5 items-center px-2.5 min-h-7 font-semibold text-muted text-xs bg-panel-3 rounded-lg" type="button" data-select-post>
            <span class="h-3.5 w-3.5 i-hugeicons-edit-02" aria-hidden="true"></span>
            <span data-post-label>Post ${number}</span>
          </button>
          <button class="inline-flex items-center justify-center h-7 w-7 text-muted hover:text-ink bg-panel hover:bg-hover border border-line rounded-lg shadow-sm transition-colors" type="button" aria-label="Remove post" title="Remove post" data-remove-post>
            <span class="h-3.5 w-3.5 i-hugeicons-cancel-01" aria-hidden="true"></span>
          </button>
        </header>
          <textarea class="min-h-36 w-full leading-relaxed text-ink text-xl bg-transparent border-0 outline-none rounded-md resize-none" data-focus-outline spellcheck="true" aria-label="Post body ${number}" data-bluesky-text>${escapeHtml(text)}</textarea>
        ${number === 1 ? '<div class="hidden" data-richtext-host></div>' : ''}
        <div class="hidden overflow-hidden bg-panel-2 border border-line rounded-2xl" data-link-preview></div>
      `

      const createPost = (number, text = '') => {
        const post = document.createElement('article')
        post.className = 'grid gap-2 pb-4 last:pb-0 border-b border-line last:border-b-0'
        post.dataset.composerPost = ''
        post.dataset.active = 'false'
        post.innerHTML = postTemplate(number, text)
        return post
      }

      const saveDraft = () => {
        if (editParam) return
        const posts = allPosts()
        savedDraft.set({
          activeIndex: Math.max(0, posts.indexOf(activePost)),
          mode: composerFormat(),
          action: postAction(),
          scheduledIso: scheduledIso(),
          posts: posts.map(post => ({ text: textareaFor(post)?.value || '' })),
          variants: Array.from(variants.entries())
            .map(([provider, entry]) => ({ provider, text: entry.text, shared: entry.shared })),
        })
      }

      // useDebounce, not a bare timer: it cancels its own pending call and is
      // torn down with the scope, so a pending save cannot fire against a
      // detached DOM after an SPA swap.
      const queueDraftSave = useDebounce(saveDraft, 100)

      const restoreDraft = () => {
        const draft = savedDraft()
        if (!draft || !postsRoot) return

        postsRoot.replaceChildren(...draft.posts.map((post, index) => createPost(index + 1, post.text)))
        composerFormat.set(draft.mode)
        postAction.set(draft.action)
        scheduledIso.set(draft.scheduledIso)
        savedActiveIndex = draft.mode === 'thread' ? Math.max(0, Math.min(draft.activeIndex, draft.posts.length - 1)) : 0
        postCounter = draft.posts.length
        activePost = allPosts()[savedActiveIndex] || root.querySelector('[data-composer-post]')
        variants.clear()
        draft.variants.forEach((entry) => {
          variants.set(entry.provider, { text: entry.text, shared: entry.shared })
        })
      }

      
      /**
       * Said before publishing, not found out after: these networks have no
       * replies to chain on, so each part of a thread lands as its own post.
       */
      const unthreadedNote = (posts) => {
        if (posts < 2) return ''
        const names = selectedConnected()
          .filter(target => ['instagram', 'linkedin'].includes(target.provider))
          .map(target => providerLabel(target.provider))
          .filter((name, index, list) => list.indexOf(name) === index)
        return names.length ? ` - ${names.join(' and ')} will post each part separately` : ''
      }

      const updateCount = () => {
        const textarea = activeTextarea()
        if (!textarea || !count) return
        const length = lengthFor(tightestProvider(), textarea.value)
        const limit = effectiveLimit()
        const over = overLimitProviders()
        const posts = composerFormat() === 'thread' ? allPosts().length : 1

        // Over-limit names the networks rather than the number, because with
        // mixed targets "over" is only true for some of them.
        count.textContent = over.length
          ? `${length} characters - too long for ${overLimitNetworks().map(provider => providerLabel(provider.provider)).join(', ')}`
          : `${length} / ${limit} characters - ${posts} post${posts === 1 ? '' : 's'}${unthreadedNote(posts)}`
        // The span truncates, and the network names are at the end — keep the
        // full message reachable when several targets are over at once.
        count.title = count.textContent

        count.classList.toggle('text-danger', over.length > 0)
        count.classList.toggle('text-warning', over.length === 0 && length > limit - 40)
        count.classList.toggle('text-muted', over.length === 0 && length <= limit - 40)

        updateVariantMeta()
      }

      const renderLinkPreview = (post, preview) => {
        const container = previewFor(post)
        if (!container) return

        if (post === allPosts()[0]) linkCardShown.set(Boolean(preview))
        if (!preview) {
          container.classList.add('hidden')
          container.innerHTML = ''
          delete post.dataset.externalUri
          delete post.dataset.externalTitle
          delete post.dataset.externalDescription
          return
        }

        post.dataset.externalUri = preview.url
        post.dataset.externalTitle = preview.title
        post.dataset.externalDescription = preview.description || ''
        container.classList.remove('hidden')
        container.innerHTML = `
          ${preview.image ? `<div class="h-28 bg-center bg-cover bg-panel-3 border-b border-line" style="background-image:url('${escapeHtml(preview.image)}')"></div>` : ''}
          <div class="grid gap-1 p-3">
            <div class="font-semibold text-muted text-xs uppercase">${escapeHtml(preview.domain)}</div>
            <div class="font-semibold text-ink text-sm">${escapeHtml(preview.title)}</div>
            ${preview.description ? `<div class="leading-normal line-clamp-2 text-muted text-ui">${escapeHtml(preview.description)}</div>` : ''}
          </div>
        `
      }

      const updateLinkPreview = async (post = activePost) => {
        const textarea = textareaFor(post)
        if (!post || !textarea) return
        const url = firstUrl(textarea.value)
        if (!url) {
          renderLinkPreview(post, null)
          return
        }

        if (post.dataset.previewUrl === url && post.dataset.externalTitle) return
        post.dataset.previewUrl = url

        try {
          // Shared and cached, so a redraw or a second visit does not ask again.
          const preview = await fetchLinkPreview(url)
          renderLinkPreview(post, preview)
        }
        catch {
          renderLinkPreview(post, {
            url,
            domain: new URL(url).hostname.replace(/^www\./, ''),
            title: url,
            description: '',
          })
        }
      }

      const runPreviewUpdate = useDebounce((post) => { void updateLinkPreview(post) }, 250)
      const queuePreviewUpdate = (post = activePost) => runPreviewUpdate(post)

      const renamePosts = () => {
        const posts = allPosts()
        const canRemove = composerFormat() === 'thread' && posts.length > 1
        posts.forEach((post, index) => {
          const number = index + 1
          const select = post.querySelector('[data-select-post]')
          const label = select?.querySelector('[data-post-label]')
          const remove = post.querySelector('[data-remove-post]')
          const textarea = textareaFor(post)
          if (label) label.textContent = `Post ${number}`
          if (textarea) textarea.setAttribute('aria-label', `Post body ${number}`)
          remove?.classList.toggle('hidden', !canRemove)
          remove?.classList.toggle('inline-flex', canRemove)
        })
      }

      const selectPost = (post, options = {}) => {
        if (!post) return
        activePost = post
        allPosts().forEach((item) => {
          const active = item === post
          item.hidden = !active && composerFormat() === 'single'
          item.classList.toggle('grid', !item.hidden)
          const select = item.querySelector('[data-select-post]')
          item.dataset.active = active ? 'true' : 'false'
          item.classList.toggle('border-ink', active)
          item.classList.toggle('border-info-line', active)
          item.classList.toggle('shadow-sm', active)
          item.classList.toggle('border-line', !active)
          select?.classList.toggle('bg-accent', active)
          select?.classList.toggle('text-on-accent', active)
          select?.classList.toggle('bg-panel-3', !active)
          select?.classList.toggle('text-muted', !active)
        })
        updateCount()
        void updateLinkPreview(post)
        if (!options.skipSave) queueDraftSave()
      }

      const addPost = (options = {}) => {
        postCounter += 1
        const post = createPost(postCounter, options.text || '')
        postsRoot?.append(post)
        renamePosts()
        selectPost(post, { skipSave: true })
        // Availability depends on the post count, so it has to be recomputed
        // here: a second post makes this a thread, where overrides never apply.
        renderVariantPanel()
        // No toast: the new editor appears and takes focus, so saying so is
        // narrating what the user can already see.
        if (options.focus !== false) textareaFor(post)?.focus()
        if (options.save !== false) saveDraft()
        return post
      }

      const removePost = (post) => {
        if (!post || allPosts().length === 1) return
        markEdited()
        const label = post.querySelector('[data-post-label]')?.textContent || 'Post'
        const hadText = Boolean(textareaFor(post)?.value.trim())
        const parent = post.parentElement
        const before = post.nextElementSibling
        const next = before?.matches('[data-composer-post]')
          ? before
          : post.previousElementSibling
        post.remove()
        renamePosts()
        selectPost(next || root.querySelector('[data-composer-post]'), { skipSave: true })
        renderVariantPanel()
        saveDraft()
        // An empty post goes without a word. One with writing in it can come
        // back: the node is kept, so Undo puts back exactly what was there.
        if (!hadText || !parent) return
        setStatus(`${label} removed.`, 'neutral', {
          title: 'Removed',
          id: 'composer-post-removed',
          dedupeMs: 0,
          durationMs: 10000,
          action: {
            label: 'Undo',
            run: () => {
              parent.insertBefore(post, before?.isConnected ? before : null)
              renamePosts()
              selectPost(post, { skipSave: true })
              renderVariantPanel()
              saveDraft()
            },
          },
        })
      }

      const zoneReady = fetchWorkspace()
        .then((workspace) => {
          if (workspace?.timezone) scheduleZone.set(workspace.timezone)
        })
        .catch(() => {})

      const scheduleTimestamp = (iso: string): string => new Date(iso).toISOString().slice(0, 19).replace('T', ' ')

      // Unsaved changes to a queued post. Edits never go to the local draft
      // (saveDraft refuses in edit mode), so leaving would drop them silently.
      let editDirty = false
      const markEdited = () => { if (editingId) editDirty = true }
      composerHandlers.scheduleChanged = () => {
        markEdited()
        queueDraftSave()
      }
      root.addEventListener('input', markEdited)
      root.addEventListener('change', markEdited)
      // A link or navigate() that would drop them is held, and the toast says
      // why and offers the way out. Back and forward cannot be held (the URL
      // has already moved); closing the window gets the browser's own prompt.
      useEventListener('stx:before-navigate', (event) => {
        if (!editingId || !editDirty || !event.cancelable) return
        event.preventDefault()
        const destination = event.detail?.url
        setStatus(`Your changes to post #${editingId} are not saved yet.`, 'neutral', {
          title: 'Unsaved changes',
          id: 'composer-unsaved',
          dedupeMs: 0,
          durationMs: 10000,
          action: {
            label: 'Leave without saving',
            run: () => {
              editDirty = false
              if (typeof destination === 'string') navigate(destination)
            },
          },
        })
      }, { target: window })
      useEventListener('beforeunload', (event) => {
        if (!editingId || !editDirty) return
        event.preventDefault()
        event.returnValue = ''
      }, { target: window })

      const enterEditMode = (item) => {
        editingId = item.id
        editHeading.set(item.thread ? 'Editing thread' : `Editing post #${item.id}`)

        if (item.thread && postsRoot) {
          const posts = item.thread.texts.map((text, index) => createPost(index + 1, text))
          postsRoot.replaceChildren(...posts)
          postCounter = posts.length
          composerFormat.set('thread')
          renamePosts()
          selectPost(posts[item.thread.postIds.indexOf(item.id)] || posts[0], { skipSave: true })
        }
        else {
          const textarea = activeTextarea()
          if (textarea) textarea.value = item.text || ''
        }
        postTitle.set(item.title || '')

        // Overrides. `shared` is seeded from the stored body so a restored
        // override only reads as stale once this edit actually changes the text.
        variants.clear()
        Object.entries(item.variants || {}).forEach(([provider, text]) => {
          if (typeof text === 'string' && text.trim())
            variants.set(provider, { text, shared: item.text || '' })
        })

        // Targets: select exactly the post's accounts (intersected with what is
        // still connected). `targets` holds specs; older payloads only had
        // network names, which map to each network's default account.
        selectedClear()
        for (const spec of item.targets || item.providers || []) {
          const key = keyForSpec(spec)
          if (key) selectedAdd(key)
        }
        updatePublishability()

        // Schedule.
        const savedSchedule = item.scheduledAt ? new Date(`${item.scheduledAt.replace(' ', 'T')}Z`) : null
        scheduledIso.set(savedSchedule && Number.isFinite(savedSchedule.getTime()) ? savedSchedule.toISOString() : null)
        postAction.set(scheduledIso() ? 'schedule' : item.status === 'draft' ? 'draft' : 'publish')

        // Link card.
        const lead = item.thread ? allPosts()[0] : activePost
        if (item.external?.uri && lead) {
          lead.dataset.externalUri = item.external.uri
          lead.dataset.externalTitle = item.external.title || ''
          lead.dataset.externalDescription = item.external.description || ''
        }

        // Existing image → show a "kept" chip; attaching a new file replaces,
        // clearing it marks removal.
        const saved = item.images?.length || (item.image ? 1 : 0)
        editHadImage = saved > 0
        editRemoveImage = false
        postLanguage.set(item.options?.language || '')
        mastodonVisibility.set(item.options?.mastodon?.visibility || 'public')
        mastodonSpoiler.set(item.options?.mastodon?.spoilerText || '')
        attachedImages.set(saved ? [{ id: 'saved', file: null, name: saved === 1 ? '1 saved image' : `${saved} saved images`, alt: '', kept: true }] : [])

        updateCount()
        void updateLinkPreview(activePost)
        if (lead !== activePost) void updateLinkPreview(lead)
      }

      const loadEditPost = async (id) => {
        try {
          const response = await fetch(`/api/postline/queue/item?id=${encodeURIComponent(id)}`)
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Could not load the post.')
          await zoneReady
          enterEditMode(payload.data)
        }
        catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), 'error', { title: 'Edit' })
        }
      }

      const composedThread = () => composerFormat() === 'thread'
        ? allPosts().map(post => textareaFor(post)?.value.trim()).filter(Boolean)
        : []

      const leadingPost = () => allPosts().find(post => textareaFor(post)?.value.trim())

      const linkCardFor = post => post?.dataset.externalUri && post.dataset.externalTitle
        ? {
            uri: post.dataset.externalUri,
            title: post.dataset.externalTitle,
            description: post.dataset.externalDescription || '',
          }
        : undefined

      function appendLinkCard(form: FormData, post) {
        const external = linkCardFor(post)
        if (!external) return
        form.set('external_uri', external.uri)
        form.set('external_title', external.title)
        form.set('external_description', external.description)
      }

      const updateQueued = async () => {
        const threadTexts = composedThread()
        if (composerFormat() === 'thread' && threadTexts.length < 2) {
          setStatus('Write at least two posts before updating the thread.', 'error')
          activeTextarea()?.focus()
          return
        }
        const text = threadTexts[0] || activeTextarea()?.value.trim()
        if (!text) {
          setStatus('Write something before updating.', 'error')
          activeTextarea()?.focus()
          return
        }
        const targetProviders = selectedConnected().map(target => target.key)
        if (targetProviders.length === 0) {
          setStatus('Select a connected account.', 'error', { title: 'Not connected' })
          return
        }

        const form = new FormData()
        form.set('id', String(editingId))
        form.set('text', text)
        if (threadTexts.length) form.set('thread', JSON.stringify(threadTexts))
        form.set('providers', targetProviders.join(','))
        const editTitle = composedTitle()
        if (editTitle) form.set('title', editTitle)
        const scheduled = scheduledIso()
        if (scheduled) form.set('scheduled_at', scheduleTimestamp(scheduled))
        appendLinkCard(form, threadTexts.length ? leadingPost() : activePost)
        const editImageUrl = postImageUrl().trim()
        if (editImageUrl) form.set('image_url', editImageUrl)
        // New images replace the saved ones; with none, the saved ones stay
        // unless their row was removed.
        if (!appendImages(form) && editRemoveImage) form.set('remove_image', '1')
        appendOptions(form)
        // Always sent, never conditional: the server treats an absent field as
        // "keep what is stored", so clearing every override has to be explicit.
        form.set('variants', JSON.stringify(variantsPayload()))

        try {
          const response = await fetch('/api/postline/queue/update', { method: 'POST', body: form })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Could not update the post.')
          editDirty = false
          setStatus(threadTexts.length ? 'Thread updated.' : 'Post updated.', 'success', { title: 'Updated' })
          // Back to the queue to see the change. A router visit, not a full
          // load: a reload took the "Post updated" toast down with the page.
          navigate('/queue')
        }
        catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), 'error', { title: 'Update failed' })
        }
      }

      // Draft mode and schedule-time both save to the server-side queue
      // instead of publishing immediately.
      const saveToQueue = async (scheduleValue) => {
        const threadTexts = composedThread()
        const text = threadTexts[0] || activeTextarea()?.value.trim()
        if (!text) {
          setStatus('Write something before saving.', 'error')
          activeTextarea()?.focus()
          return
        }
        const targetProviders = selectedConnected().map(target => target.key)
        if (targetProviders.length === 0) {
          setStatus('Select a connected account before saving to the queue.', 'error', { title: 'Not connected' })
          return
        }
        const form = new FormData()
        if (threadTexts.length > 1) form.set('thread', JSON.stringify(threadTexts))
        form.set('text', text)
        form.set('providers', targetProviders.join(','))
        const queueTitle = composedTitle()
        if (queueTitle) form.set('title', queueTitle)
        if (scheduleValue) form.set('scheduled_at', scheduleTimestamp(scheduleValue))
        appendLinkCard(form, threadTexts.length > 1 ? leadingPost() : activePost)
        const queueImageUrl = postImageUrl().trim()
        if (queueImageUrl) form.set('image_url', queueImageUrl)
        appendImages(form)
        appendOptions(form)
        const queueVariants = variantsPayload()
        if (Object.keys(queueVariants).length) form.set('variants', JSON.stringify(queueVariants))

        try {
          const response = await fetch('/api/postline/queue', { method: 'POST', body: form })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Could not save to the queue.')

          // Clear every segment committed to the queue.
          if (threadTexts.length > 1) {
            allPosts().forEach((post) => {
              const segment = textareaFor(post)
              if (segment) segment.value = ''
              renderLinkPreview(post, null)
            })
          }
          const textarea = activeTextarea()
          if (textarea) textarea.value = ''
          scheduledIso.set(null)
          if (scheduleValue) postAction.set('publish')
          postTitle.set('')
          clearAttachment()
          resetPostOptions()
          renderLinkPreview(activePost, null)
          // Same reason as the publish path: the overrides went with that post.
          variants.clear()
          renderVariantPanel()
          updateCount()
          saveDraft()
          setStatus(
            payload.data.status === 'scheduled'
              ? `Scheduled. Check the Queue page to manage it.`
              : 'Draft saved to the queue.',
            'success',
            { title: payload.data.status === 'scheduled' ? 'Scheduled' : 'Draft saved' },
          )
        }
        catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), 'error', { title: 'Queue' })
        }
      }

      const setMode = (mode, options = {}) => {
        composerFormat.set(mode)
        if (mode === 'thread' && allPosts().length === 1 && !options.skipThreadPost) {
          addPost({ focus: false, save: false })
        }
        else {
          renamePosts()
          selectPost(mode === 'single' ? allPosts()[0] : activePost, { skipSave: true })
        }
        updatePublishability()
        if (!options.skipSave) saveDraft()
      }

      const publishOne = async (post, targetProviders) => {
        const textarea = textareaFor(post)
        if (!textarea) throw new Error('Missing post body.')
        const text = textarea.value.trim()
        if (!text) throw new Error('Write something before publishing.')
        const external = linkCardFor(post)
        const imageUrl = postImageUrl().trim()
        const image = imageUrl ? { url: imageUrl } : undefined
        return await publishCrosspost({ text, title: composedTitle(), providers: targetProviders, external, image, imageFiles: attachedFiles(), variants: variantsPayload(), options: postOptions() })
      }

      const publish = async () => {
        const targetProviders = selectedConnected().map(target => target.key)
        if (targetProviders.length === 0) {
          setStatus('Select a connected account in Settings → Channels before publishing.', 'error', { title: 'Not connected' })
          return
        }

        const targets = composerFormat() === 'thread'
          ? allPosts().filter(post => textareaFor(post)?.value.trim())
          : [activePost].filter(Boolean)

        if (targets.length === 0) {
          setStatus('Write something before publishing.', 'error')
          activeTextarea()?.focus()
          return
        }

        const providerNames = selectedConnected()
          .map(target => target.multi ? targetLabel(target.provider, target.account?.handle) : providerLabel(target.provider))
          .join(', ')
        setStatus(
          targets.length > 1 ? `Publishing ${targets.length} posts to ${providerNames}…` : `Publishing to ${providerNames}…`,
          'info',
          { title: 'Publishing', id: 'publish' },
        )

        try {
          let lastUrl
          const failures = []
          let successCount = 0
          const collect = (data) => {
            for (const result of data.results || []) {
              if (result.ok) {
                successCount += 1
                if (result.url) lastUrl = result.url
              }
              else {
                failures.push(`${targetLabel(result.provider, result.handle)}: ${result.error || 'failed'}`)
              }
            }
          }

          if (targets.length > 1) {
            // Threads go up in one request so the server can reply-chain the
            // segments on providers that support it (Bluesky).
            const first = targets[0]
            const external = linkCardFor(first)
            const imageUrl = postImageUrl().trim()
            const thread = targets.map(post => textareaFor(post)?.value.trim() || '')
            collect(await publishCrosspost({
              text: thread[0],
              title: composedTitle(),
              thread,
              providers: targetProviders,
              external,
              image: imageUrl ? { url: imageUrl } : undefined,
              imageFiles: attachedFiles(),
              options: postOptions(),
            }))
          }
          else {
            collect(await publishOne(targets[0], targetProviders))
          }

          if (targets.length > 1) {
            allPosts().forEach((post) => {
              const textarea = textareaFor(post)
              if (textarea) textarea.value = ''
              renderLinkPreview(post, null)
            })
          }
          else {
            const textarea = textareaFor(targets[0])
            if (textarea) textarea.value = ''
            renderLinkPreview(targets[0], null)
          }

          // Overrides belong to the post that just went out. Leaving them set
          // would send the previous post's per-network copy with the next one,
          // while the shared body reads as empty — before saveDraft persists it.
          variants.clear()
          renderVariantPanel()
          updateCount()
          saveDraft()
          clearAttachment()
          resetPostOptions()
          postTitle.set('')
          dismissPostlineToast('publish')
          if (failures.length && successCount === 0) {
            setStatus(`Publish failed. ${failures.join('; ')}`, 'error', { title: 'Publish failed' })
          }
          else if (failures.length) {
            setStatus(`Published to some channels. ${failures.join('; ')}`, 'info', { title: 'Partially published', url: lastUrl })
          }
          else {
            setStatus(
              targets.length > 1
                ? `Published ${targets.length} posts to ${providerNames}.`
                : `Your post is live on ${providerNames}.`,
              'success',
              { title: 'Published', url: lastUrl },
            )
          }
        }
        catch (error) {
          dismissPostlineToast('publish')
          setStatus(error instanceof Error ? error.message : String(error), 'error', { title: 'Publish failed' })
        }
      }

      composerHandlers.setFormat = setMode
      composerHandlers.publish = async () => {
        if (!canPublish() || submitting() || mediaWarnings().length) return
        submitting.set(true)
        try {
          if (editingId) await updateQueued()
          else if (postAction() === 'publish') await publish()
          else await saveToQueue(postAction() === 'schedule' ? scheduledIso() : null)
        }
        finally {
          submitting.set(false)
        }
      }

      postsRoot?.addEventListener('click', (event) => {
        const target = event.target
        if (!(target instanceof HTMLElement)) return
        const post = target.closest('[data-composer-post]')
        if (target.closest('[data-select-post]')) selectPost(post)
        if (target.closest('[data-remove-post]')) removePost(post)
      })
      postsRoot?.addEventListener('input', (event) => {
        const target = event.target
        if (!(target instanceof HTMLTextAreaElement)) return
        const post = target.closest('[data-composer-post]')
        selectPost(post, { skipSave: true })
        queuePreviewUpdate(post)
        queueDraftSave()
      })
      postsRoot?.addEventListener('focusin', (event) => {
        const target = event.target
        if (!(target instanceof HTMLTextAreaElement)) return
        const post = target.closest('[data-composer-post]')
        selectPost(post)
        updateCount()
      })
      imageHandlers.changed = markEdited
      imageHandlers.removeSaved = () => {
        if (editingId && editHadImage) editRemoveImage = true
      }
      addPostButton?.addEventListener('click', () => {
        if (submitting() || (editingQueued() && composerFormat() === 'single')) return
        setMode('thread', { skipSave: true, skipThreadPost: true })
        addPost()
        markEdited()
      })
      previewButton?.addEventListener('click', () => {
        const text = activeTextarea()?.value.trim()
        void updateLinkPreview()
        // This used to toast the entire post body back at its author under the
        // word "Preview:", which is neither a preview nor news to the person
        // who typed it. What the button does is refresh the link card, and
        // that shows up in the card.
        //
        // The empty case keeps its message, because there the button genuinely
        // does nothing and silence would read as broken — `updateLinkPreview`
        // only touches a link card, so plain text with no URL has no effect at
        // all. That is a missing feature the toast was covering for.
        if (!text) setStatus('Nothing to preview yet.', 'error')
      })
      refreshButton?.addEventListener('click', async () => {
        refreshButton.setAttribute('disabled', 'disabled')
        try {
          await refreshConnection()
          setStatus(
            canPublish() ? 'Accounts are ready to publish.' : 'Connect an account in Settings → Channels.',
            canPublish() ? 'success' : 'error',
            { title: 'Channels' },
          )
        }
        finally {
          refreshButton.removeAttribute('disabled')
        }
      })
            variantToggle?.addEventListener('click', () => {
        variantsOpen = !variantsOpen
        renderVariantPanel()
      })
      variantPanel?.addEventListener('click', (event) => {
        const target = event.target
        if (!(target instanceof HTMLElement)) return
        const button = target.closest('[data-variant-action]')
        if (!button) return
        const provider = button.dataset.variantProvider
        if (!provider) return
        if (button.dataset.variantAction === 'fork') {
          // Seed the override from the shared body so the user edits down from
          // what they already wrote rather than starting on an empty box.
          variants.set(provider, { text: sharedBody(), shared: sharedBody() })
        }
        else {
          variants.delete(provider)
        }
        // Swap just this row: rebuilding the panel would drop every other row's
        // caret and undo history, and leave focus on <body>.
        refreshVariantRow(provider)
        updateCount()
        saveDraft()
      })
      variantPanel?.addEventListener('input', (event) => {
        const target = event.target
        if (!(target instanceof HTMLElement)) return
        const provider = target.dataset.variantInput
        if (!provider) return
        const entry = variants.get(provider)
        if (!entry) return
        entry.text = target.value
        // An override changing can flip that provider's over-limit state, which
        // the footer counter and chip dots also report on.
        updateCount()
        updateVariantToggleLabel()
        queueDraftSave()
      })
      searchButton?.addEventListener('click', () => {
        const text = activeTextarea()?.value.trim()
        setStatus(text ? `Searching local drafts for: ${text.slice(0, 80)}` : 'Write a phrase first, then search local drafts.', text ? 'success' : 'error')
      })
      // Editing a queued post — don't restore a local draft over it. The
      // reciprocal guard (never writing an edit back into the draft) lives in
      // saveDraft itself, so it holds for every caller.
      if (!editParam) {
        useEventListener('beforeunload', saveDraft, { target: window })
        restoreDraft()
      }
      renamePosts()
      selectPost(allPosts()[savedActiveIndex] || activePost, { skipSave: true })
      updateCount()
      void updateLinkPreview(activePost)
      // Load the edit post only after connection so provider toggles resolve.
      // The queue calendar prefills 09:00 on the chosen workspace date.
      const scheduleParam = useRoute().query.schedule || null
      const applyScheduleParam = () => {
        if (!scheduleParam || !/^\d{4}-\d{2}-\d{2}$/.test(scheduleParam)) return
        const instant = instantFromWallTime(`${scheduleParam} 09:00:00`, scheduleZone())
        if (instant) {
          scheduledIso.set(instant.toISOString())
          postAction.set('schedule')
        }
        activeTextarea()?.focus()
      }

      const start = async () => {
        await refreshConnection()
        if (editParam) await loadEditPost(editParam)
        else {
          await zoneReady
          applyScheduleParam()
        }
      }
      onMount(() => { void start() })
    })()
  </script>
@endsection
