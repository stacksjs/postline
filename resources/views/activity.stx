@extends('layouts/app')

<script server cache>
import { workspaceActivityText, workspaceLocale, workspaceQueueText } from '../../app/Support/Localization/workspace'

export const activityLocale = workspaceLocale
export const activityText = workspaceActivityText
export const activityClient = {
  locale: workspaceLocale,
  messages: {
    ...workspaceActivityText,
    retryAt: workspaceQueueText.retryAt,
    schedulerNever: workspaceQueueText.schedulerNever,
    schedulerStopped: workspaceQueueText.schedulerStopped,
    schedulerStoppedSince: workspaceQueueText.schedulerStoppedSince,
  },
}
</script>

@section('title')Postline - {{ activityText.region }}@endsection

@section('content')
  @meta('description', 'What Postline sent, what failed, and when each job last ran.')
  <section class="grid gap-5" data-postline-page="activity" data-testid="activity-page" lang="{{ activityLocale }}">
    <WorkspacePageHeader titleKey="workspace.navigation.activity" descriptionKey="workspace.pages.activity.description">
      <SegmentedControl label="{{ activityText.sendStatus }}" size="sm" :value="filter()" :options="statuses" @change="setFilter" />
    </WorkspacePageHeader>

    <p class="hidden m-0 px-3 py-2 text-ui text-warning bg-warning-soft border border-warning-line rounded-xl" :class="{ 'hidden': !schedulerWarning() }" :text="schedulerWarning()" role="status" data-scheduler-warning></p>

    {{-- Unread alerts: what will not sort itself out. Read ones are dropped
        from the page; the sends below remain the full record. --}}
    <section class="hidden overflow-hidden bg-panel border border-warning-line rounded-2xl shadow-sm" :class="{ 'hidden': attention().length === 0 }" aria-label="{{ activityText.attention }}" data-activity-attention>
      <div class="flex items-center justify-between px-4 py-3 bg-warning-soft border-b border-warning-line">
        <strong class="font-semibold text-sm text-warning">{{ activityText.attention }}</strong>
        <button class="text-warning text-xs underline disabled:opacity-50" type="button" :disabled="marking()" @click="markAllRead()">{{ activityText.markRead }}</button>
      </div>
      <div>
        <article class="grid gap-0.5 px-4 py-3 border-b border-line last:border-b-0" x-for="alert in attention()" :data-command-context="alert.title" data-activity-alert>
          <div class="flex gap-2 items-center justify-between">
            <span class="font-medium text-ink text-ui" :text="alert.title"></span>
            <span class="shrink-0 text-muted text-xs" :text="alert.when"></span>
          </div>
          <p class="m-0 text-body text-xs" x-show="alert.body" :text="alert.body"></p>
          <a class="text-muted text-xs underline hover:text-ink" x-show="alert.link" :href="alert.link" data-stx-link :text="alert.action"></a>
        </article>
      </div>
    </section>

    <div class="grid gap-5 items-start lg:grid-cols-[minmax(0,1fr)_320px]">
      <section aria-label="{{ activityText.sends }}">
        <Card padding="none" className="shadow-sm">
          <div class="flex items-center justify-between px-4 py-3 border-b border-line">
            <strong class="font-semibold text-ink text-sm">{{ activityText.sends }}</strong>
            <span class="text-muted text-xs" :text="countText()"></span>
          </div>
          <WorkspaceListSkeleton :show="!loaded()" label="{{ activityText.loadingActivity }}" />
          <ErrorState :show="loadError() && loaded()" title="{{ activityText.loadFailure }}" :message="loadError()" @retry="refresh()" />
          <EmptyState :show="showEmpty()" variant="bare" :title="filter() === 'failed' ? copy.emptyFailed : copy.emptySends" description="{{ activityText.emptyDescription }}">
            <StxLink class="text-info text-ui underline" to="/composer" :show="filter() !== 'failed'">{{ activityText.writePost }}</StxLink>
          </EmptyState>
          <div>
            <article class="grid gap-1 px-4 py-3 border-b border-line last:border-b-0" x-for="row in rows()" data-activity-row>
              <div class="flex flex-wrap gap-2 items-center">
                <span class="px-2 py-0.5 font-semibold text-xs rounded-full" :class="row.failed ? 'text-danger bg-danger-soft' : 'text-success bg-success-soft'" :text="row.outcome"></span>
                <span class="font-medium text-ink text-ui" :text="row.where"></span>
                <span class="ml-auto text-muted text-xs" :text="row.when" :title="row.whenFull"></span>
              </div>
              <p class="m-0 text-body text-ui truncate" :text="row.excerpt"></p>
              <p class="m-0 text-danger text-xs" x-show="row.reason" :text="row.reason"></p>
              <div class="flex gap-3 items-center" x-show="row.url || row.failed">
                <a class="text-muted text-xs underline hover:text-ink" x-show="row.url" :href="row.url" target="_blank" rel="noopener noreferrer">{{ activityText.viewOnNetwork }}</a>
                <a class="text-muted text-xs underline hover:text-ink" x-show="row.failed" href="/queue" data-stx-link>{{ activityText.retryInQueue }}</a>
              </div>
            </article>
          </div>
          <div class="flex justify-center p-3" x-show="nextCursor()">
            <button class="inline-flex items-center justify-center px-3 h-8 font-medium text-ink text-ui bg-panel hover:bg-hover border border-line rounded-lg shadow-sm disabled:opacity-50 transition-colors" type="button" :disabled="loadingMore()" @click="loadMore()" :text="loadingMore() ? copy.loading : copy.loadOlder">{{ activityText.loadOlder }}</button>
          </div>
        </Card>
      </section>

      <section aria-label="{{ activityText.jobs }}">
        <Card padding="none" className="shadow-sm">
          <div class="px-4 py-3 border-b border-line">
            <strong class="font-semibold text-ink text-sm">{{ activityText.jobs }}</strong>
            <p class="m-0 mt-0.5 text-muted text-xs" :text="schedulerText()"></p>
          </div>
          <p class="m-0 p-4 text-muted text-ui" x-show="showNoJobs()">{{ activityText.noJobs }}</p>
          <div>
            <div class="grid gap-0.5 px-4 py-2.5 border-b border-line last:border-b-0" x-for="job in jobRows()" data-activity-job>
              <div class="flex gap-2 items-center justify-between">
                <span class="font-medium text-ink text-ui" :text="job.label"></span>
                <span class="px-2 py-0.5 font-semibold text-xs rounded-full" :class="job.failed ? 'text-danger bg-danger-soft' : 'text-success bg-success-soft'" :text="job.status"></span>
              </div>
              <p class="m-0 text-muted text-xs" :text="job.detail"></p>
              <p class="m-0 text-danger text-xs" x-show="job.error" :text="job.error"></p>
            </div>
          </div>
        </Card>
      </section>
    </div>
  </section>

  <script client>
    import { createI18n } from '@stacksjs/i18n/client'

    const { locale: language, messages: copy } = {{ activityClient }}
    const words = createI18n({ locale: language, messages: { [language]: copy } })
    const dateLocale = language === 'en' ? undefined : language
    const secondsFormat = new Intl.NumberFormat(language, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
    const statuses = [{ value: '', label: copy.all }, { value: 'published', label: copy.sent }, { value: 'failed', label: copy.failed }]

    interface ActivityEvent {
      id: number
      kind: 'published' | 'failed'
      at: string | null
      provider: string
      handle: string | null
      excerpt: string
      url: string | null
      reason: string | null
      attempts: number
      nextAttemptAt: string | null
    }

    interface JobBeat {
      job: string
      lastStartedAt: string | null
      lastFinishedAt: string | null
      lastDurationMs: number | null
      lastStatus: 'running' | 'ok' | 'failed' | null
      lastError: string | null
      runs: number
    }

    const events = state<ActivityEvent[]>([])
    const jobs = state<JobBeat[]>([])
    const scheduler = state<{ state: string, lastRunAt: string | null }>({ state: 'ok', lastRunAt: null })
    const filter = state('')
    const loaded = state(false)
    let activityRequest = 0
    const loadError = state('')
    const nextCursor = state(0)
    const loadingMore = state(false)

    interface AlertItem {
      id: number
      kind: string
      title: string
      body: string | null
      link: string | null
      at: string | null
      read: boolean
    }
    const alertItems = state<AlertItem[]>([])
    const marking = state(false)

    const NETWORKS: Record<string, string> = {
      bluesky: 'Bluesky',
      twitter: 'X',
      mastodon: 'Mastodon',
      linkedin: 'LinkedIn',
      instagram: 'Instagram',
      threads: 'Threads',
      blog: 'Blog',
    }

    const JOBS: Record<string, string> = {
      PublishScheduledPosts: copy.publishScheduledPosts,
      SyncEngagementMetrics: copy.syncEngagementMetrics,
      ScanKeywordMonitors: copy.scanKeywordMonitors,
      SyncDirectMessages: copy.syncDirectMessages,
      AutoDeletePosts: copy.autoDeletePosts,
      KeepTokensAlive: copy.keepTokensAlive,
    }

    const parse = (value: string | null): Date | null => {
      if (!value) return null
      const date = new Date(value)
      return Number.isNaN(date.getTime()) ? null : date
    }

    /** "5 minutes ago", falling back to a date once it is older than a week. */
    const ago = (value: string | null): string => {
      const date = parse(value)
      if (!date) return ''
      const seconds = Math.round((Date.now() - date.getTime()) / 1000)
      if (seconds < 60) return copy.justNow
      if (seconds < 3600) return words.t('minutesAgo', { count: Math.floor(seconds / 60) })
      if (seconds < 86_400) return words.t('hoursAgo', { count: Math.floor(seconds / 3600) })
      if (seconds < 7 * 86_400) return words.t('daysAgo', { count: Math.floor(seconds / 86_400) })
      return date.toLocaleDateString(dateLocale, { dateStyle: 'medium' })
    }

    const full = (value: string | null): string => parse(value)?.toLocaleString(dateLocale, { dateStyle: 'medium', timeStyle: 'short' }) || ''

    const rows = derived(() => events().map((event) => {
      const failed = event.kind === 'failed'
      const network = NETWORKS[event.provider] || event.provider
      const retry = parse(event.nextAttemptAt)
      const again = retry ? words.t('retryAt', { time: retry.toLocaleTimeString(dateLocale, { hour: '2-digit', minute: '2-digit' }) }) : ''
      return {
        id: event.id,
        failed,
        outcome: failed ? copy.failed : copy.sent,
        where: event.handle ? `${network} · ${event.handle}` : network,
        when: ago(event.at),
        whenFull: full(event.at),
        excerpt: event.excerpt || copy.noText,
        reason: failed ? `${event.reason || ''}${again}` : '',
        url: event.url || '',
      }
    }))

    const jobRows = derived(() => jobs().map((job) => {
      const failed = job.lastStatus === 'failed'
      const time = ago(job.lastStartedAt) || copy.never
      const duration = job.lastDurationMs === null ? '' : job.lastDurationMs < 1000 ? `${job.lastDurationMs} ms` : `${secondsFormat.format(job.lastDurationMs / 1000)} s`
      return {
        label: JOBS[job.job] || job.job,
        failed,
        status: failed ? copy.failed : job.lastStatus === 'running' ? copy.running : copy.ok,
        detail: duration ? words.t('lastRanWithDuration', { time, duration }) : words.t('lastRan', { time }),
        error: failed ? job.lastError || '' : '',
      }
    }))

    const attention = derived(() => alertItems().filter(alert => !alert.read).map(alert => ({
      id: alert.id,
      title: alert.title,
      body: alert.body || '',
      link: alert.link || '',
      action: alert.link === '/accounts' ? copy.openChannels : alert.link === '/listening' ? copy.openListening : copy.openQueue,
      when: ago(alert.at),
    })))

    const loadAlerts = async () => {
      try {
        const response = await fetch('/api/postline/alerts')
        const payload = await response.json()
        if (response.ok && payload.ok) alertItems.set(payload.data.alerts || [])
      }
      catch {
        // The feed below still loads; a missing alert list is not worth an error.
      }
    }

    const markAllRead = async () => {
      if (marking()) return
      marking.set(true)
      try {
        const response = await fetch('/api/postline/alerts/read', { method: 'POST', body: new FormData() })
        const payload = await response.json()
        if (response.ok && payload.ok) alertItems.set(payload.data.alerts || [])
      }
      finally {
        marking.set(false)
      }
    }

    const showEmpty = derived(() => loaded() && !loadError() && events().length === 0)
    const showNoJobs = derived(() => loaded() && jobs().length === 0)
    const countText = derived(() => !loaded() ? copy.loading : words.t('shown', { count: `${events().length}${nextCursor() ? '+' : ''}` }))

    const schedulerWarning = derived(() => {
      const status = scheduler()
      if (status.state === 'ok') return ''
      if (status.state === 'never') return copy.schedulerNever
      const time = full(status.lastRunAt)
      return time ? words.t('schedulerStoppedSince', { time }) : copy.schedulerStopped
    })
    const schedulerText = derived(() => scheduler().state === 'ok' ? copy.schedulerRunning : copy.schedulerNotRunning)

    const url = (before = 0): string => {
      const query = new URLSearchParams()
      if (filter()) query.set('kind', filter())
      if (before) query.set('before', String(before))
      const text = query.toString()
      return `/api/postline/activity${text ? `?${text}` : ''}`
    }

    const refresh = async () => {
      const request = ++activityRequest
      loadingMore.set(false)
      loaded.set(false)
      try {
        const response = await fetch(url())
        const payload = await response.json()
        if (request !== activityRequest) return
        if (!response.ok || !payload.ok) throw new Error(payload.error || copy.loadFailure)
        events.set(payload.data.events || [])
        nextCursor.set(payload.data.nextCursor || 0)
        jobs.set(payload.data.jobs || [])
        if (payload.data.scheduler) scheduler.set(payload.data.scheduler)
        loadError.set('')
      }
      catch (error) {
        if (request !== activityRequest) return
        events.set([])
        nextCursor.set(0)
        loadError.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        if (request === activityRequest) loaded.set(true)
      }
    }

    const loadMore = async () => {
      if (!loaded() || !nextCursor() || loadingMore()) return
      const request = activityRequest
      loadingMore.set(true)
      try {
        const response = await fetch(url(nextCursor()))
        const payload = await response.json()
        if (request !== activityRequest) return
        if (!response.ok || !payload.ok) throw new Error(payload.error || copy.olderFailure)
        events.set([...events(), ...(payload.data.events || [])])
        nextCursor.set(payload.data.nextCursor || 0)
      }
      catch (error) {
        if (request === activityRequest) loadError.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        if (request === activityRequest) loadingMore.set(false)
      }
    }

    const setFilter = (next: string) => {
      filter.set(next)
      void refresh()
    }

    onMount(() => {
      void refresh()
      void loadAlerts()
    })
  </script>
@endsection
