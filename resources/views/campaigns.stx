@extends('layouts/app')

<script server cache>
import { workspaceCampaignText, workspaceLocale } from '../../app/Support/Localization/workspace'

export const campaignLocale = workspaceLocale
export const campaignText = workspaceCampaignText.labels
export const campaignCopy = workspaceCampaignText.client
export const campaignClient = { locale: workspaceLocale, messages: campaignCopy }
</script>

@section('title'){{ campaignText.title }}@endsection

@section('content')
  @meta('description', campaignText.description)
  <section class="grid gap-4" data-postline-page="campaigns" data-testid="campaigns-page" lang="{{ campaignLocale }}">
    <WorkspacePageHeader titleKey="workspace.navigation.campaigns" descriptionKey="workspace.pages.campaigns.description">
      <template #status>
        <span x-show="campaign()">
          <Badge size="sm" className="capitalize" :variant="postStatusVariant(campaign()?.status)">{{ campaignStatus(campaign()?.status) }}</Badge>
        </span>
      </template>
      <div class="flex flex-wrap gap-2 items-center">
        <label class="sr-only" for="campaign-picker">{{ campaignText.campaignPicker }}</label>
        <select id="campaign-picker" class="px-3 h-9 min-w-44 text-ink text-ui bg-panel border border-field-line outline-none rounded-xl focus:ring-2 focus:ring-focus" x-show="campaignsList().length" @change="selectCampaign($event)">
          <option x-for="option in campaignsList()" :value="option.id" :selected="option.id === campaign()?.id">{{ option.name }}</option>
        </select>
        <SegmentedControl label="{{ campaignText.view }}" size="sm" :show="campaign()" v-model:value="view" :options="[{ value: 'calendar', label: copy.calendar }, { value: 'list', label: copy.list }]" />
        <span x-show="campaign()">
          <Button variant="primary" size="sm" @click="openCampaignForm()">
            <span class="size-4 i-hugeicons-plus-sign" aria-hidden="true"></span>
            {{ campaignCopy.newCampaign }}
          </Button>
        </span>
      </div>
    </WorkspacePageHeader>

    <dl class="grid overflow-hidden gap-px grid-cols-2 sm:grid-cols-4 m-0 bg-line border border-line rounded-2xl" x-show="campaign()">
      <div class="grid gap-1 px-3.5 py-3 min-w-0 bg-panel"><dt class="text-muted text-xs">{{ campaignText.window }}</dt><dd class="m-0 font-semibold text-ink text-sm truncate" :text="campaignWindow()"></dd></div>
      <div class="grid gap-1 px-3.5 py-3 bg-panel"><dt class="text-muted text-xs">{{ campaignText.planned }}</dt><dd class="m-0 font-semibold text-ink text-sm">{{ numbers.format(posts().length) }}</dd></div>
      <div class="grid gap-1 px-3.5 py-3 bg-panel"><dt class="text-muted text-xs">{{ campaignText.ready }}</dt><dd class="m-0 font-semibold text-ink text-sm">{{ numbers.format(readyCount()) }}</dd></div>
      <div class="grid gap-1 px-3.5 py-3 bg-panel"><dt class="text-muted text-xs">{{ campaignText.inQueue }}</dt><dd class="m-0 font-semibold text-ink text-sm">{{ numbers.format(queuedCount()) }}</dd></div>
    </dl>

    <WorkspaceListSkeleton :show="loading()" label="{{ campaignText.loading }}" />
    <ErrorState :show="!loading() && loadError()" title="{{ campaignText.loadFailed }}" :message="loadError()" @retry="retryLoad()" />
    <EmptyState :show="!loading() && !loadError() && !campaign() && panelMode() !== 'campaign'" title="{{ campaignText.firstCampaign }}" description="{{ campaignText.firstDescription }}">
      <Button variant="primary" size="sm" @click="openCampaignForm()">
        <span class="size-4 i-hugeicons-plus-sign" aria-hidden="true"></span>
        {{ campaignText.create }}
      </Button>
    </EmptyState>

    <div class="grid gap-3.5 items-start lg:grid-cols-[minmax(0,1fr)_minmax(18rem,21rem)]" x-show="!loading() && (campaign() || panelMode() === 'campaign')">
      <section class="overflow-hidden min-w-0 bg-panel border border-line rounded-2xl shadow-sm" aria-label="{{ campaignText.plan }}" x-show="campaign()">
        <header class="flex flex-wrap gap-3 items-center justify-between px-3 py-2.5 min-h-14 border-b border-line">
          <div class="flex gap-2 items-center">
            <WorkspaceIconButton label="{{ campaignText.previous }}" icon="i-hugeicons-arrow-left-02" @activate="shiftCalendar(-42)" />
            <Button variant="secondary" size="xs" @click="goToCampaign">{{ campaignText.campaignStart }}</Button>
            <WorkspaceIconButton label="{{ campaignText.next }}" icon="i-hugeicons-arrow-right-02" @activate="shiftCalendar(42)" />
          </div>
          <div class="min-w-0 text-right">
            <strong class="block text-ink text-ui" :text="calendarTitle()">{{ campaignCopy.sixWeekPlan }}</strong>
            <span class="hidden sm:block mt-0.5 text-muted text-xs" x-show="view() === 'calendar'">{{ campaignText.moveHint }}</span>
          </div>
        </header>

        <div class="overflow-x-auto" x-show="view() === 'calendar'">
          <div class="grid gap-px grid-cols-7 min-w-[38rem] bg-line">
            <div class="px-2.5 py-2 font-medium text-muted text-right text-xs bg-panel">{{ campaignText.sunday }}</div>
            <div class="px-2.5 py-2 font-medium text-muted text-right text-xs bg-panel">{{ campaignText.monday }}</div>
            <div class="px-2.5 py-2 font-medium text-muted text-right text-xs bg-panel">{{ campaignText.tuesday }}</div>
            <div class="px-2.5 py-2 font-medium text-muted text-right text-xs bg-panel">{{ campaignText.wednesday }}</div>
            <div class="px-2.5 py-2 font-medium text-muted text-right text-xs bg-panel">{{ campaignText.thursday }}</div>
            <div class="px-2.5 py-2 font-medium text-muted text-right text-xs bg-panel">{{ campaignText.friday }}</div>
            <div class="px-2.5 py-2 font-medium text-muted text-right text-xs bg-panel">{{ campaignText.saturday }}</div>
            <div
              class="p-2 min-h-36 bg-panel data-[drop-active=true]:bg-info-soft data-[outside=true]:bg-panel-2 data-[drop-active=true]:ring-2 data-[drop-active=true]:ring-focus data-[drop-active=true]:ring-inset transition-colors group"
              x-for="cell in calendarCells()"
              :data-outside="cell.outside"
              :data-drop-active="dragOverDay() === cell.key"
              @dragover="allowDrop($event, cell.key)"
              @dragleave="leaveDrop(cell.key)"
              @drop="dropOnDay($event, cell.key)"
            >
              <header class="flex items-center justify-between mb-1 font-medium text-muted text-xs">
                <span class="grid place-items-center size-6 data-[today=true]:text-on-accent data-[today=true]:bg-accent rounded-full" :data-today="cell.today" :aria-current="cell.today ? 'date' : null">{{ cell.day }}</span>
                <button class="grid place-items-center size-6 text-muted hover:text-ink hover:bg-hover rounded-lg group-focus-within:opacity-100 group-hover:opacity-100 pointer-fine:opacity-0 transition-opacity" type="button" :aria-label="copy.addOn.replace('{date}', cell.label)" @click="openPostForm(null, cell.key)"><span class="size-3.5 i-hugeicons-plus-sign" aria-hidden="true"></span></button>
              </header>
              <div class="grid gap-1.5">
                <article
                  class="grid overflow-hidden gap-1.5 p-2 bg-panel focus-visible:bg-hover hover:bg-hover border border-l-[3px] border-l-info border-line data-[pillar=education]:border-l-success data-[pillar=follow-up]:border-l-muted data-[pillar=launch]:border-l-danger data-[pillar=proof]:border-l-warning data-[pillar=teaser]:border-l-note rounded-xl shadow-sm transition-colors cursor-grab data-[queued=true]:cursor-pointer active:cursor-grabbing"
                  x-for="item in cell.posts"
                  :data-pillar="item.pillar"
                  :data-queued="!!item.postId"
                  :draggable="!item.postId"
                  @dragstart="beginDrag($event, item)"
                  @dragend="endDrag"
                  @click="openPostForm(item)"
                  @keydown="openOnKey($event, item)"
                  tabindex="0"
                  role="button"
                >
                  <div class="flex flex-wrap gap-1 justify-between capitalize text-muted text-xs">
                    <span>{{ timeLabel(item.scheduledAt) }}</span>
                    <span>{{ campaignStatus(item.pillar) }}</span>
                  </div>
                  <strong class="text-ink text-xs truncate">{{ item.title }}</strong>
                  <p class="m-0 line-clamp-2 text-body text-xs">{{ item.body }}</p>
                  <footer class="flex flex-wrap gap-1 items-center justify-between">
                    <span class="flex pl-0.5"><span class="grid place-items-center -ml-0.5 size-5 font-medium text-body text-xs bg-panel-3 border border-panel rounded-full" x-for="provider in item.providers.slice(0, 3)" :title="providerLabel(provider)">{{ providerInitial(provider) }}</span></span>
                    <Badge size="sm" className="capitalize" :variant="postStatusVariant(item.status)">{{ campaignStatus(item.status) }}</Badge>
                  </footer>
                </article>
              </div>
            </div>
          </div>
        </div>

        <div x-show="view() === 'list'">
          <EmptyState :show="posts().length === 0" variant="bare" title="{{ campaignText.noPosts }}" description="{{ campaignText.noPostsDescription }}" />
          <article class="grid gap-3 grid-cols-[4.5rem_minmax(0,1fr)_auto] items-center sm:grid-cols-[5rem_minmax(0,1fr)_auto_auto] xl:grid-cols-[5rem_minmax(0,1fr)_auto_minmax(0,7rem)_auto] px-3.5 py-3 focus-visible:bg-hover hover:bg-hover border-b border-line last:border-b-0 transition-colors cursor-pointer" data-campaign-list-row x-for="item in posts()" @click="openPostForm(item)" @keydown="openOnKey($event, item)" tabindex="0" role="button">
            <div class="grid gap-0.5 min-w-0">
              <strong class="text-ink text-ui truncate">{{ shortDate(item.scheduledAt) }}</strong>
              <span class="text-muted text-xs">{{ timeLabel(item.scheduledAt) }}</span>
            </div>
            <div class="grid gap-0.5 min-w-0">
              <strong class="text-ink text-ui truncate">{{ item.title }}</strong>
              <p class="m-0 text-body text-xs truncate">{{ item.body }}</p>
            </div>
            <span class="hidden sm:inline-flex px-2 py-0.5 capitalize text-muted text-xs bg-panel-3 rounded-full">{{ campaignStatus(item.pillar) }}</span>
            <span class="hidden xl:block text-muted text-xs truncate">{{ item.providers.map(providerLabel).join(', ') }}</span>
            <Badge size="sm" className="capitalize" :variant="postStatusVariant(item.status)">{{ campaignStatus(item.status) }}</Badge>
          </article>
        </div>
      </section>

      <aside class="overflow-y-auto lg:order-none lg:sticky lg:top-3.5 min-w-0 lg:max-h-[calc(100dvh-1.75rem)] bg-panel border border-line rounded-2xl shadow-sm -order-1" aria-label="{{ campaignText.tools }}">
        <section class="grid gap-3 p-4" x-show="panelMode() === 'planner' && campaign()">
          <div class="flex flex-wrap gap-2.5 items-start justify-between">
            <header class="flex flex-1 gap-2.5 items-start min-w-40">
              <span class="grid place-items-center shrink-0 size-9 text-info bg-info-soft rounded-xl" aria-hidden="true"><span class="size-5 i-hugeicons-ai-beautify"></span></span>
              <div><h2 class="m-0 font-semibold text-ink text-ui">{{ campaignText.assistant }}</h2><p class="m-0 mt-0.5 text-muted text-xs">{{ campaignText.assistantDescription }}</p></div>
            </header>
            <span class="inline-flex gap-1.5 items-center shrink-0 px-2 py-1 data-[mode=ai]:text-info text-muted text-xs bg-panel-3 data-[mode=ai]:bg-info-soft border border-line data-[mode=ai]:border-info-line rounded-full" :data-mode="aiStatus().mode">
              <span class="size-3" :class="aiStatus().mode === 'ai' ? 'i-hugeicons-ai-beautify' : 'i-hugeicons-cpu'" aria-hidden="true"></span>
              <span :text="aiProviderLabel()"></span>
            </span>
          </div>

          <div class="grid gap-2.5 p-3 bg-panel-2 border border-line rounded-xl">
            <div><span class="font-medium text-muted text-xs">{{ campaignText.goal }}</span><p class="m-0 text-body text-ui" :text="campaign()?.objective || copy.emptyGoal"></p></div>
            <div><span class="font-medium text-muted text-xs">{{ campaignText.audience }}</span><p class="m-0 text-body text-ui" :text="campaign()?.audience || copy.defaultAudience"></p></div>
            <dl class="grid gap-2 grid-cols-2 m-0 pt-2.5 border-line border-t">
              <div><dt class="text-muted text-xs">{{ campaignText.tone }}</dt><dd class="m-0 capitalize font-medium text-ink text-ui" :text="campaignStatus(campaign()?.tone)"></dd></div>
              <div><dt class="text-muted text-xs">{{ campaignText.duration }}</dt><dd class="m-0 font-medium text-ink text-ui" :text="withCount(campaignDuration(), copy.oneDay, copy.days)"></dd></div>
            </dl>
          </div>

          <div class="grid overflow-y-auto gap-2 p-2.5 max-h-64 bg-panel-2 border border-line rounded-xl" aria-live="polite">
            <article class="flex gap-2 items-start">
              <span class="grid place-items-center shrink-0 size-6 text-info bg-info-soft rounded-lg" aria-hidden="true"><span class="size-3.5 i-hugeicons-ai-beautify"></span></span>
              <p class="m-0 px-2 py-1.5 text-body text-xs bg-panel border border-line rounded-xl" :text="assistantIntro()"></p>
            </article>
            <article class="flex data-[role=user]:flex-row-reverse gap-2 items-start group" x-for="message in assistantMessages()" :data-role="message.role">
              <span class="grid place-items-center shrink-0 size-6 group-data-[role=user]:text-body text-info bg-info-soft group-data-[role=user]:bg-panel-3 rounded-lg" aria-hidden="true">
                <span class="size-3.5" :class="message.role === 'assistant' ? 'i-hugeicons-ai-beautify' : 'i-hugeicons-user-circle'"></span>
              </span>
              <p class="m-0 px-2 py-1.5 group-data-[role=user]:text-on-accent text-body text-xs bg-panel group-data-[role=user]:bg-accent border border-line rounded-xl">
                <span :text="message.text"></span>
                <small class="block mt-1 text-xs" x-show="message.meta" :text="message.meta"></small>
              </p>
            </article>
            <article class="flex gap-2 items-start" x-show="busyAction() === 'generate'">
              <span class="grid place-items-center shrink-0 size-6 text-info bg-info-soft rounded-lg motion-safe:animate-pulse" aria-hidden="true"><span class="size-3.5 i-hugeicons-ai-beautify"></span></span>
              <p class="m-0 px-2 py-1.5 text-body text-xs bg-panel border border-line rounded-xl">{{ campaignText.reading }}</p>
            </article>
          </div>

          <div class="flex flex-wrap gap-1.5" role="group" aria-label="{{ campaignText.shortcuts }}">
            <button class="inline-flex gap-1.5 items-center px-2 py-1 font-medium text-muted text-xs aria-pressed:text-info bg-panel aria-pressed:bg-info-soft hover:bg-hover border border-line rounded-lg aria-pressed:border-info-line" type="button" x-for="suggestion in assistantSuggestions" :aria-pressed="assistantStrategy() === suggestion.id" @click="chooseAssistantPrompt(suggestion)">
              <span class="size-3" :class="suggestion.icon" aria-hidden="true"></span>
              <span>{{ suggestion.label }}</span>
            </button>
          </div>

          {{-- A group, not a <label>: a label names one control, and wrapping
              a row of buttons in one gave none of them a name (#160). --}}
          <div class="grid gap-1.5" role="group" aria-label="{{ campaignText.channels }}">
            <span class="font-medium text-body text-ui" aria-hidden="true">{{ campaignText.channels }}</span>
            <div class="flex flex-wrap gap-1.5" x-show="connectedProviders().length">
              <button class="inline-flex gap-1.5 items-center px-2 py-1 font-medium text-muted text-xs aria-pressed:text-info bg-panel aria-pressed:bg-info-soft hover:bg-hover border border-line rounded-lg aria-pressed:border-info-line group" type="button" x-for="provider in connectedProviders()" :aria-pressed="plannerProviders().includes(provider.provider)" @click="togglePlannerProvider(provider.provider)">
                <span class="grid place-items-center size-5 text-body text-xs group-aria-pressed:text-info bg-panel-3 group-aria-pressed:bg-panel rounded">{{ providerInitial(provider.provider) }}</span><span>{{ providerLabel(provider.provider) }}</span>
              </button>
            </div>
            <a class="text-info text-xs underline underline-offset-2" href="/accounts" data-stx-link x-show="providersLoaded() && connectedProviders().length === 0">{{ campaignText.connectAccount }}</a>
            <small class="text-muted text-xs" x-show="!providersLoaded()">{{ campaignText.checkingAccounts }}</small>
          </div>

          <label class="grid gap-1.5 font-medium text-body text-ui">
            <span>{{ campaignText.askAssistant }} <small class="font-normal text-muted text-xs">{{ campaignText.optional }}</small></span>
            <textarea class="px-2.5 py-2 w-full font-normal text-ink text-ui bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus resize-y" rows="4" maxlength="2000" placeholder="{{ campaignText.directionPlaceholder }}" x-model="direction"></textarea>
          </label>
          <label class="flex gap-2 items-center justify-between font-medium text-body text-ui">
            <span>{{ campaignText.postCount }}</span>
            <select class="px-2.5 h-9 font-normal text-ink text-ui bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus" x-model="generationCount">
              <option value="6">{{ campaignText.sixPosts }}</option><option value="8">{{ campaignText.eightPosts }}</option><option value="12">{{ campaignText.twelvePosts }}</option><option value="16">{{ campaignText.sixteenPosts }}</option>
            </select>
          </label>

          <Button variant="primary" size="sm" fullWidth="true" :loading="busyAction() === 'generate'" :disabled="busy() || plannerProviders().length === 0" :label="busyAction() === 'generate' ? copy.generating : posts().length ? copy.anotherSequence : copy.buildPlan" @click="generatePlan">{{ campaignCopy.buildPlan }}</Button>
          <p class="m-0 text-muted text-xs" x-show="lastPlanMode()" :text="lastPlanMode() === 'ai' ? copy.modeAI : copy.modeTemplate"></p>

          <div class="grid gap-2 grid-cols-2" x-show="posts().length">
            <Button variant="secondary" size="sm" @click="openCampaignForm(campaign())">{{ campaignText.editBrief }}</Button>
            <Button variant="secondary" size="sm" @click="openPostForm(null)">{{ campaignText.addPost }}</Button>
          </div>

          <div class="grid gap-2.5 p-3 bg-info-soft border border-info-line rounded-xl" x-show="unqueuedCount()">
            <div><strong class="text-info text-ui">{{ campaignText.readyForQueue }}</strong><p class="m-0 mt-0.5 text-body text-xs">{{ campaignText.readyForQueueDescription }}</p></div>
            <Button variant="primary" size="sm" :loading="busyAction() === 'activate'" :disabled="busy()" :label="busyAction() === 'activate' ? copy.scheduling : withCount(unqueuedCount(), copy.scheduleOne, copy.scheduleMany)" @click="activateCampaign">{{ campaignText.schedulePosts }}</Button>
          </div>
        </section>

        <template :if="panelMode() === 'campaign'">
        <section class="grid gap-4 p-4">
          <header class="flex gap-2.5 items-start">
            <span class="grid place-items-center shrink-0 size-9 text-info bg-info-soft rounded-xl" aria-hidden="true"><span class="size-5 i-hugeicons-rocket-01"></span></span>
            <div><h2 class="m-0 font-semibold text-ink text-ui" :text="campaignDraftId() ? copy.editCampaign : copy.newCampaign"></h2><p class="m-0 mt-0.5 text-muted text-xs">{{ campaignText.briefHelp }}</p></div>
          </header>
          <form class="grid gap-3" @submit="saveCampaign($event)">
            <button class="flex gap-2.5 items-center p-2.5 text-ink text-left bg-info-soft border border-info-line rounded-xl hover:border-info transition-colors" type="button" x-show="!campaignDraftId()" @click="applyStacksLaunchPreset">
              <span class="shrink-0 size-5 text-info i-hugeicons-source-code" aria-hidden="true"></span>
              <span class="flex-1"><strong class="block text-ui">{{ campaignText.useStacksBrief }}</strong><small class="block mt-0.5 text-muted text-xs">{{ campaignText.stacksBriefDescription }}</small></span>
              <span class="shrink-0 size-4 text-info i-hugeicons-arrow-right-02" aria-hidden="true"></span>
            </button>
            <label class="grid gap-1.5 font-medium text-body text-ui">
              <span>{{ campaignText.name }}</span>
              <input class="px-2.5 h-9 w-full font-normal text-ink bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus" required maxlength="120" placeholder="{{ campaignText.namePlaceholder }}" x-model="campaignName">
            </label>
            <label class="grid gap-1.5 font-medium text-body text-ui">
              <span>{{ campaignText.goal }}</span>
              <textarea class="px-2.5 py-2 w-full font-normal text-ink bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus resize-y" required rows="4" placeholder="{{ campaignText.goalPlaceholder }}" x-model="campaignObjective"></textarea>
            </label>
            <label class="grid gap-1.5 font-medium text-body text-ui">
              <span>{{ campaignText.audience }}</span>
              <input class="px-2.5 h-9 w-full font-normal text-ink bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus" placeholder="{{ campaignText.audiencePlaceholder }}" x-model="campaignAudience">
            </label>
            <label class="grid gap-1.5 font-medium text-body text-ui">
              <span>{{ campaignText.tone }}</span>
              <select class="px-2.5 h-9 w-full font-normal text-ink bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus" x-model="campaignTone">
                <option value="clear">{{ campaignCopy.clear }}</option><option value="bold">{{ campaignCopy.bold }}</option><option value="warm">{{ campaignCopy.warm }}</option><option value="technical">{{ campaignCopy.technical }}</option><option value="playful">{{ campaignCopy.playful }}</option>
              </select>
            </label>
            <div class="grid gap-2.5 sm:grid-cols-2">
              <label class="grid gap-1.5 min-w-0 font-medium text-body text-ui">
                <span>{{ campaignText.start }}</span>
                <input class="px-2.5 h-9 w-full font-normal text-ink bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus" required type="date" x-model="campaignStartDate">
              </label>
              <label class="grid gap-1.5 min-w-0 font-medium text-body text-ui">
                <span>{{ campaignText.end }}</span>
                <input class="px-2.5 h-9 w-full font-normal text-ink bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus" required type="date" x-model="campaignEndDate">
              </label>
            </div>
            <div class="flex flex-wrap gap-2 justify-end pt-3 border-line border-t">
              <Button variant="secondary" size="sm" :disabled="busy()" @click="closePanel">{{ campaignText.cancel }}</Button>
              <Button variant="primary" size="sm" type="submit" :loading="busyAction() === 'campaign'" :disabled="busy()" :label="busyAction() === 'campaign' ? copy.saving : copy.saveCampaign">{{ campaignCopy.saveCampaign }}</Button>
            </div>
          </form>
        </section>
        </template>

        <template :if="panelMode() === 'post'">
        <section class="grid gap-4 p-4">
          <header class="flex gap-2.5 items-start">
            <span class="grid place-items-center shrink-0 size-9 text-info bg-info-soft rounded-xl" aria-hidden="true"><span class="size-5 i-hugeicons-edit-02"></span></span>
            <div><h2 class="m-0 font-semibold text-ink text-ui" :text="postDraftId() ? copy.editPlannedPost : copy.addPlannedPost"></h2><p class="m-0 mt-0.5 text-muted text-xs" x-show="!queuedPostId()">{{ campaignText.editPostHelp }}</p><p class="m-0 mt-0.5 text-muted text-xs" x-show="queuedPostId()">{{ campaignText.alreadyQueued }}</p></div>
          </header>
          <form class="grid gap-3" @submit="savePost($event)">
            <div class="flex gap-2 items-start p-2.5 text-success bg-success-soft border border-success-line rounded-xl" x-show="queuedPostId()">
              <span class="shrink-0 size-4 i-hugeicons-checkmark-circle-02" aria-hidden="true"></span>
              <p class="grid gap-1 m-0 text-ui"><strong>{{ postTitle() }}</strong><span class="text-ink">{{ postBody() }}</span><small class="text-xs">{{ campaignText.editInQueue }}</small></p>
            </div>
            <div class="grid gap-3" x-show="!queuedPostId()">
              <label class="grid gap-1.5 font-medium text-body text-ui">
                <span>{{ campaignText.workingTitle }}</span>
                <input class="px-2.5 h-9 w-full font-normal text-ink bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus" required maxlength="160" placeholder="{{ campaignText.postTitlePlaceholder }}" x-model="postTitle">
              </label>
              <label class="grid gap-1.5 font-medium text-body text-ui">
                <span>{{ campaignText.postBody }}</span>
                <textarea class="px-2.5 py-2 w-full font-normal text-ink bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus resize-y" required rows="8" maxlength="4000" placeholder="{{ campaignText.postBodyPlaceholder }}" x-model="postBody"></textarea>
                <small class="font-normal text-muted text-xs">{{ withCount(postBody().length, copy.character, copy.characters) }}</small>
              </label>
              <div class="grid gap-2.5">
                <div class="grid gap-1.5">
                  <span class="font-medium text-body text-ui" aria-hidden="true">{{ campaignText.dateTime }}</span>
                  <PostlineSchedulePicker :value="postScheduledAt" :timeZone="postScheduleZone" label="{{ campaignText.dateTime }}" placeholder="{{ campaignText.dateTimePlaceholder }}" :allowPast="true" :clearable="false" @change="selectPostSchedule" />
                </div>
                <label class="grid gap-1.5 font-medium text-body text-ui">
                  <span>{{ campaignText.pillar }}</span>
                  <select class="px-2.5 h-9 w-full font-normal text-ink bg-panel border border-field-line rounded-xl focus:ring-2 focus:ring-focus" x-model="postPillar">
                    <option value="teaser">{{ campaignCopy.teaser }}</option><option value="story">{{ campaignCopy.story }}</option><option value="education">{{ campaignCopy.education }}</option><option value="proof">{{ campaignCopy.proof }}</option><option value="launch">{{ campaignCopy.launch }}</option><option value="follow-up">{{ campaignCopy['follow-up'] }}</option>
                  </select>
                </label>
              </div>
              <div class="grid gap-1.5" role="group" aria-label="{{ campaignText.channels }}">
                <span class="font-medium text-body text-ui" aria-hidden="true">{{ campaignText.channels }}</span>
                <div class="flex flex-wrap gap-1.5">
                  <button class="inline-flex gap-1.5 items-center px-2 py-1 font-medium text-muted text-xs aria-pressed:text-info bg-panel aria-pressed:bg-info-soft hover:bg-hover border border-line rounded-lg aria-pressed:border-info-line group" type="button" x-for="provider in connectedProviders()" :aria-pressed="postProviders().includes(provider.provider)" @click="togglePostProvider(provider.provider)">
                    <span class="grid place-items-center size-5 text-body text-xs group-aria-pressed:text-info bg-panel-3 group-aria-pressed:bg-panel rounded">{{ providerInitial(provider.provider) }}</span><span>{{ providerLabel(provider.provider) }}</span>
                  </button>
                </div>
              </div>
              <label class="flex gap-2 items-start p-2.5 bg-panel-2 border border-line rounded-xl">
                <input class="mt-1 accent-info" type="checkbox" :checked="postStatus() === 'ready'" @change="postStatus.set($event.target.checked ? 'ready' : 'idea')">
                <span><strong class="block text-ink text-ui">{{ campaignText.markReady }}</strong><small class="block text-muted text-xs">{{ campaignText.markReadyDescription }}</small></span>
              </label>
            </div>
            <div class="flex flex-wrap gap-2 items-center justify-end pt-3 border-line border-t">
              <span class="mr-auto" x-show="postDraftId() && !queuedPostId()">
                <Button variant="danger" size="sm" :loading="busyAction() === 'delete'" :disabled="busy()" :label="busyAction() === 'delete' ? copy.deleting : copy.deletePostLabel" @click="deletePost">{{ campaignCopy.deletePostLabel }}</Button>
              </span>
              <Button variant="secondary" size="sm" :disabled="busy()" @click="closePanel">{{ campaignText.close }}</Button>
              <a class="inline-flex px-3 py-1.5 font-semibold text-on-accent text-sm bg-accent hover:bg-accent-hover rounded-xl transition-colors" x-show="queuedPostId()" :href="`/composer?edit=${queuedPostId()}`" data-stx-link>{{ campaignText.editInComposer }}</a>
              <span x-show="!queuedPostId()">
                <Button variant="primary" size="sm" type="submit" :loading="busyAction() === 'post'" :disabled="busy() || !postScheduledAt()" :label="busyAction() === 'post' ? copy.saving : copy.savePost">{{ campaignCopy.savePost }}</Button>
              </span>
            </div>
          </form>
        </section>
        </template>
      </aside>
    </div>

  </section>

  <script client>
    import { instantFromWallTime, systemTimeZone, wallTimeInZone } from '../../app/Support/time'
    import { fetchProviders } from '../functions/social-client'
    import { postStatusVariant } from '../functions/status-badge'

    const { locale: language, messages: copy } = {{ campaignClient }}
    const numbers = new Intl.NumberFormat(language)
    const plural = new Intl.PluralRules(language)
    const clock = new Intl.DateTimeFormat(language, { hour: 'numeric', minute: '2-digit', timeZone: 'UTC' })
    const withCount = (value, one, many) => (plural.select(value) === 'one' ? one : many).replace('{count}', numbers.format(value))
    const campaignStatus = (value) => copy[value] ?? value ?? ''

    const campaignsList = state([])
    const campaign = state(null)
    const posts = state([])
    const loading = state(true)
    const busyAction = state('')
    const panelMode = state('planner')
    const view = useLocalStorage('postline.campaigns.view', 'calendar')
    const connectedProviders = state([])
    const providersLoaded = state(false)
    const plannerProviders = state([])
    const generationCount = state(8)
    const direction = state('')
    const assistantStrategy = state('full-launch')
    const assistantMessages = state([])
    const aiStatus = state({ mode: 'checking', provider: '', model: '', configured: false })
    const lastPlanMode = state('')
    const calendarStart = state('')
    const draggedPostId = state(0)
    const dragOverDay = state('')
    const campaignDraftId = state(0)
    const campaignName = state('')
    const campaignObjective = state('')
    const campaignAudience = state('')
    const campaignTone = state('clear')
    const workspaceTimezone = state(systemTimeZone())
    const campaignStartDate = state('')
    const campaignEndDate = state('')
    const postDraftId = state(0)
    const queuedPostId = state(0)
    const postTitle = state('')
    const postBody = state('')
    const postProviders = state([])
    const postPillar = state('story')
    const postStatus = state('idea')
    const postScheduledAt = state<string | null>(null)
    const postScheduleZone = derived(() => campaign()?.timezone || workspaceTimezone())
    const selectPostSchedule = ({ value }: { value: string | null }) => postScheduledAt.set(value)
    // The campaigns could not be read: not the same as having none.
    const loadError = state('')
    // What the open form held when it opened, to tell an edit from a glance.
    let openedWith = ''
    let confirmingDiscard = false
    const formSnapshot = () => JSON.stringify(panelMode() === 'campaign'
      ? [campaignName(), campaignObjective(), campaignAudience(), campaignTone(), campaignStartDate(), campaignEndDate()]
      : panelMode() === 'post'
        ? [postTitle(), postBody(), postProviders(), postPillar(), postStatus(), postScheduledAt()]
        : [])
    const formChanged = () => (panelMode() === 'campaign' || panelMode() === 'post') && formSnapshot() !== openedWith

    const busy = derived(() => Boolean(busyAction()))
    const readyCount = derived(() => posts().filter(item => item.status === 'ready').length)
    const queuedCount = derived(() => posts().filter(item => item.postId).length)
    const unqueuedCount = derived(() => posts().filter(item => !item.postId && item.status !== 'skipped').length)
    const assistantSuggestions = [
      { id: 'stacks-launch', label: copy.stacksPlaybook, prompt: copy.stacksPrompt, icon: 'i-hugeicons-source-code' },
      { id: 'full-launch', label: copy.fullLaunch, prompt: copy.fullPrompt, icon: 'i-hugeicons-rocket-01' },
      { id: 'launch-week', label: copy.launchWeek, prompt: copy.launchPrompt, icon: 'i-hugeicons-calendar-03' },
      { id: 'education', label: copy.teachFirst, prompt: copy.educationPrompt, icon: 'i-hugeicons-book-open-02' },
      { id: 'proof', label: copy.showProof, prompt: copy.proofPrompt, icon: 'i-hugeicons-chart-evaluation' },
      { id: 'fill-gaps', label: copy.fillGaps, prompt: copy.fillPrompt, icon: 'i-hugeicons-grid-table' },
    ]

    const aiProviderLabel = derived(() => {
      const status = aiStatus()
      if (status.mode === 'checking') return copy.checkingAI
      if (status.mode !== 'ai') return copy.localPlanner
      const provider = `${status.provider || 'AI'}`
      return `${provider.charAt(0).toUpperCase()}${provider.slice(1)}`
    })

    const assistantIntro = derived(() => aiStatus().mode === 'ai'
      ? copy.assistantIntroAI
      : copy.assistantIntroLocal)

    // A calendar date, from the date's own day. toISOString() gave the UTC
    // day, which in an evening west of Greenwich is already tomorrow.
    function dateKey(date) {
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`
    }

    function parseDay(key) {
      return new Date(`${String(key).slice(0, 10)}T12:00:00`)
    }

    function addDays(key, amount) {
      const date = parseDay(key)
      date.setDate(date.getDate() + amount)
      return dateKey(date)
    }

    function sundayFor(key) {
      const date = parseDay(key)
      date.setDate(date.getDate() - date.getDay())
      return dateKey(date)
    }

    function todayIn(timeZone) {
      return wallTimeInZone(new Date(), timeZone).slice(0, 10)
    }

    function emptyCampaignDraft() {
      const startDate = todayIn(workspaceTimezone())
      return { id: 0, name: '', objective: '', audience: '', tone: 'clear', startDate, endDate: addDays(startDate, 41) }
    }

    function emptyPostDraft(day) {
      const key = day || campaign()?.startDate || todayIn(postScheduleZone())
      return { id: 0, postId: null, title: '', body: '', providers: [...plannerProviders()], pillar: 'story', status: 'idea', scheduledAt: `${key}T09:00` }
    }

    function timeLabel(value) {
      const raw = String(value || '')
      const parts = raw.slice(11, 16).split(':')
      return clock.format(Date.UTC(2000, 0, 1, Number(parts[0] || 0), Number(parts[1] || 0)))
    }

    function shortDate(value) {
      return parseDay(String(value).slice(0, 10)).toLocaleDateString(language, { month: 'short', day: 'numeric', weekday: 'short' })
    }

    const campaignWindow = derived(() => {
      const current = campaign()
      if (!current) return '-'
      const start = parseDay(current.startDate).toLocaleDateString(language, { month: 'short', day: 'numeric' })
      const end = parseDay(current.endDate).toLocaleDateString(language, { month: 'short', day: 'numeric' })
      return `${start} - ${end}`
    })

    const campaignDuration = derived(() => {
      const current = campaign()
      if (!current) return 0
      return Math.max(1, Math.round((parseDay(current.endDate) - parseDay(current.startDate)) / 86400000) + 1)
    })

    const calendarTitle = derived(() => {
      if (!calendarStart()) return copy.sixWeekPlan
      const start = parseDay(calendarStart())
      const end = parseDay(addDays(calendarStart(), 41))
      const first = start.toLocaleDateString(language, { month: 'long', day: 'numeric' })
      const last = end.toLocaleDateString(language, { month: 'long', day: 'numeric', year: 'numeric' })
      return `${first} - ${last}`
    })

    const calendarCells = derived(() => {
      if (!calendarStart()) return []
      const current = campaign()
      const today = todayIn(postScheduleZone())
      return Array.from({ length: 42 }, (_, index) => {
        const key = addDays(calendarStart(), index)
        const date = parseDay(key)
        return {
          key,
          day: date.getDate(),
          label: date.toLocaleDateString(language, { month: 'long', day: 'numeric' }),
          today: key === today,
          outside: current ? key < current.startDate || key > current.endDate : false,
          posts: posts().filter(item => item.scheduledAt.slice(0, 10) === key),
        }
      })
    })

    async function api(path, fields, method = 'POST') {
      const body = new FormData()
      for (const [key, value] of Object.entries(fields || {})) {
        if (value !== undefined && value !== null) body.set(key, Array.isArray(value) ? value.join(',') : String(value))
      }
      const response = await fetch(path, method === 'GET' ? undefined : { method, body })
      const payload = await response.json()
      if (!response.ok || !payload.ok) throw new Error(payload.error || copy.requestFailed)
      return payload.data
    }

    function showNotice(title, message, tone = 'success') {
      const options = { title, duration: tone === 'error' ? 12000 : 5200 }
      if (tone === 'error') toast.error(message, options)
      else toast.success(message, options)
    }

    async function loadCampaigns(selectedId) {
      loading.set(true)
      try {
        const query = selectedId ? `?id=${encodeURIComponent(selectedId)}` : ''
        const data = await api(`/api/postline/campaigns${query}`, {}, 'GET')
        workspaceTimezone.set(data.workspaceTimezone || systemTimeZone())
        campaignsList.set(data.campaigns || [])
        campaign.set(data.selected?.campaign || null)
        posts.set(data.selected?.posts || [])
        if (campaign()) calendarStart.set(sundayFor(campaign().startDate))
        loadError.set('')
      }
      catch (error) {
        // Only a first load that failed hides the board; with campaigns
        // already on screen the notice is enough.
        const message = error instanceof Error ? error.message : String(error)
        if (!campaignsList().length) loadError.set(message)
        else showNotice(copy.openFailed, message, 'error')
      }
      finally {
        loading.set(false)
      }
    }

    async function loadProviders() {
      try {
        const all = await fetchProviders()
        // Same rule as the composer: anything that can publish. Postline
        // feed and the blog report canPublish without a `connected` flag, so
        // requiring both left a fresh workspace with nothing to plan for.
        const connected = all.filter(item => item.canPublish && item.connected !== false)
        connectedProviders.set(connected)
        plannerProviders.set(connected.map(item => item.provider))
      }
      catch {
        connectedProviders.set([])
      }
      finally {
        providersLoaded.set(true)
      }
    }

    async function loadAIStatus() {
      try {
        const status = await api('/api/postline/campaigns/ai/status', {}, 'GET')
        aiStatus.set(status)
      }
      catch {
        aiStatus.set({ mode: 'template', provider: '', model: '', configured: false })
      }
    }

    function chooseAssistantPrompt(suggestion) {
      assistantStrategy.set(suggestion.id)
      direction.set(suggestion.prompt)
    }

    async function selectCampaign(event) {
      const select = event.target
      const id = Number(select.value)
      select.value = String(campaign()?.id || '')
      if (!await canLeaveForm()) return
      panelMode.set('planner')
      await loadCampaigns(id)
    }

    async function openCampaignForm(current) {
      if (!await canLeaveForm()) return
      const source = current || null
      const draft = source
        ? { id: source.id, name: source.name, objective: source.objective, audience: source.audience, tone: source.tone, startDate: source.startDate, endDate: source.endDate }
        : emptyCampaignDraft()
      campaignDraftId.set(draft.id)
      campaignName.set(draft.name)
      campaignObjective.set(draft.objective)
      campaignAudience.set(draft.audience)
      campaignTone.set(draft.tone)
      campaignStartDate.set(draft.startDate)
      campaignEndDate.set(draft.endDate)
      panelMode.set('campaign')
      openedWith = formSnapshot()
    }

    function applyStacksLaunchPreset() {
      const start = addDays(todayIn(workspaceTimezone()), 1)
      const end = addDays(start, 55)
      const objective = 'Move Stacks from pre-alpha awareness toward an engaged alpha and beta community. Show how one cohesive TypeScript framework covers web and Craft desktop apps, APIs, models and migrations, queues, AI, cloud infrastructure, testing, releases, and deployment through Buddy. Lead with working product proof, transparent build notes, and useful lessons rather than dependency-count claims or hype.'
      const audience = 'TypeScript and Bun developers, open-source maintainers, technical founders, and small teams tired of stitching together a full-stack toolchain'
      const creativeDirection = 'Treat the repository as the source of truth. Build a narrative around one TypeScript application model from local development to cloud deployment. Rotate product proof across Buddy, STX reactive views, Crosswind, Craft desktop, Actions and Router, ORM models and migrations, queues and scheduled jobs, the AI package, Pantry provisioning, and Stacks Cloud. Include honest pre-alpha updates, invitations for focused feedback, demos, architecture explanations, build-in-public notes, and clear milestones toward alpha and beta. Never claim literally zero external dependencies; say the major framework capabilities are designed and maintained in-house as one cohesive toolkit.'

      campaignName.set('Stacks: Pre-alpha to Beta')
      campaignObjective.set(objective)
      campaignAudience.set(audience)
      campaignTone.set('technical')
      campaignStartDate.set(start)
      campaignEndDate.set(end)
      assistantStrategy.set('stacks-launch')
      direction.set(creativeDirection)
    }

    async function openPostForm(item, day) {
      if (!await canLeaveForm()) return
      if (!campaign()) return
      const draft = item
        ? item
        : emptyPostDraft(day)
      postDraftId.set(draft.id)
      queuedPostId.set(draft.postId || 0)
      postTitle.set(draft.title)
      postBody.set(draft.body)
      postProviders.set([...draft.providers])
      postPillar.set(draft.pillar)
      postStatus.set(draft.status)
      const timestamp = draft.scheduledAt.replace('T', ' ')
      const selected = instantFromWallTime(timestamp.length === 16 ? `${timestamp}:00` : timestamp, postScheduleZone())
      postScheduledAt.set(selected?.toISOString() ?? null)
      panelMode.set('post')
      openedWith = formSnapshot()
    }

    // Cards that open a post answer the keyboard as a button does (#160).
    function openOnKey(event, item) {
      if (event.key !== 'Enter' && event.key !== ' ') return
      event.preventDefault()
      openPostForm(item)
    }

    async function canLeaveForm() {
      if (busy() || confirmingDiscard) return false
      if (!formChanged()) return true
      confirmingDiscard = true
      try {
        return await stxConfirm(copy.unsaved, { title: copy.discardTitle, type: 'error', confirmText: copy.discard })
      }
      finally {
        confirmingDiscard = false
      }
    }

    async function closePanel() {
      if (!await canLeaveForm()) return
      panelMode.set(campaign() ? 'planner' : '')
    }

    function retryLoad() {
      void loadCampaigns()
    }

    // Escape closes the open form, through the same unsaved-edits check.
    useEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.key !== 'Escape' || (panelMode() !== 'campaign' && panelMode() !== 'post')) return
      event.preventDefault()
      closePanel()
    })

    async function saveCampaign(event) {
      event.preventDefault()
      busyAction.set('campaign')
      try {
        const data = await api('/api/postline/campaigns', {
          id: campaignDraftId() || undefined,
          name: campaignName(),
          objective: campaignObjective(),
          audience: campaignAudience(),
          tone: campaignTone(),
          start_date: campaignStartDate(),
          end_date: campaignEndDate(),
          // No zone sent: post times are wall-clock times in the workspace's
          // zone, which the server uses when none is given (#106). This sent
          // the browser's, so a campaign planned while travelling ran hours off.
        })
        await loadCampaigns(data.campaign.id)
        panelMode.set('planner')
        showNotice(campaignDraftId() ? copy.briefUpdated : copy.campaignCreated, copy.campaignPlannable.replace('{name}', () => data.campaign.name))
      }
      catch (error) {
        showNotice(copy.campaignSaveFailed, error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        busyAction.set('')
      }
    }

    function togglePlannerProvider(provider) {
      const current = plannerProviders()
      plannerProviders.set(current.includes(provider) ? current.filter(value => value !== provider) : [...current, provider])
    }

    function togglePostProvider(provider) {
      if (queuedPostId()) return
      const current = postProviders()
      postProviders.set(current.includes(provider) ? current.filter(value => value !== provider) : [...current, provider])
    }

    async function savePost(event) {
      event.preventDefault()
      const scheduled = postScheduledAt()
      if (queuedPostId() || !scheduled) return
      busyAction.set('post')
      try {
        await api('/api/postline/campaigns/post', {
          campaign_id: campaign().id,
          id: postDraftId() || undefined,
          title: postTitle(),
          body: postBody(),
          providers: postProviders(),
          pillar: postPillar(),
          status: postStatus(),
          scheduled_at: wallTimeInZone(new Date(scheduled), postScheduleZone()),
        })
        await loadCampaigns(campaign().id)
        panelMode.set('planner')
        showNotice(postDraftId() ? copy.postUpdated : copy.postAdded, copy.planCurrent)
      }
      catch (error) {
        showNotice(copy.postSaveFailed, error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        busyAction.set('')
      }
    }

    async function deletePost() {
      const id = postDraftId()
      const campaignId = campaign()?.id
      if (!id || !campaignId || queuedPostId()) return
      if (!await stxConfirm(copy.postDeleteDescription, { title: copy.postDeleteTitle, type: 'error', confirmText: copy.postDelete })) return
      busyAction.set('delete')
      try {
        await api('/api/postline/campaigns/post/delete', { campaign_id: campaignId, id })
        await loadCampaigns(campaignId)
        panelMode.set('planner')
        showNotice(copy.postRemoved, copy.remainingPlan)
      }
      catch (error) {
        showNotice(copy.postRemoveFailed, error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        busyAction.set('')
      }
    }

    async function generatePlan() {
      if (!campaign() || plannerProviders().length === 0) return
      busyAction.set('generate')
      const requestText = direction().trim() || assistantSuggestions.find(item => item.id === assistantStrategy())?.prompt || copy.defaultPrompt
      assistantMessages.set([...assistantMessages(), { role: 'user', text: requestText, meta: '' }])
      try {
        const data = await api('/api/postline/campaigns/generate', {
          campaign_id: campaign().id,
          count: generationCount(),
          providers: plannerProviders(),
          direction: direction(),
          strategy: assistantStrategy(),
        })
        lastPlanMode.set(data.mode)
        aiStatus.set({
          ...aiStatus(),
          mode: data.mode,
          provider: data.mode === 'ai' ? data.provider : '',
          model: data.model || '',
          configured: data.mode === 'ai',
        })
        assistantMessages.set([
          ...assistantMessages(),
          {
            role: 'assistant',
            text: data.assistant,
            meta: withCount(data.posts.length, copy.generatedOne, copy.generatedMany)
              + (data.model ? copy.generatedWith.replace('{model}', () => data.model) : '')
              + (data.promptAdjusted ? copy.promptAdjusted : ''),
          },
        ])
        direction.set('')
        await loadCampaigns(campaign().id)
        showNotice(copy.planDrafted, withCount(data.posts.length, copy.draftOne, copy.draftMany))
      }
      catch (error) {
        assistantMessages.set([
          ...assistantMessages(),
          { role: 'assistant', text: error instanceof Error ? error.message : String(error), meta: copy.noPostsAdded },
        ])
        showNotice(copy.draftFailed, error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        busyAction.set('')
      }
    }

    async function activateCampaign() {
      if (!campaign() || !unqueuedCount()) return
      busyAction.set('activate')
      try {
        const data = await api('/api/postline/campaigns/activate', { campaign_id: campaign().id })
        await loadCampaigns(campaign().id)
        // Activation is all or nothing: with any problem, nothing was queued,
        // and every problem is listed so they can be fixed in one pass.
        if (data.errors.length)
          showNotice(copy.nothingScheduled, data.errors.join(' · '), 'error')
        else
          showNotice(copy.campaignScheduled, withCount(data.queued, copy.queuedOne, copy.queuedMany), 'success')
      }
      catch (error) {
        showNotice(copy.scheduleFailed, error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        busyAction.set('')
      }
    }

    function beginDrag(event, item) {
      if (item.postId) return
      draggedPostId.set(item.id)
      event.dataTransfer.effectAllowed = 'move'
      event.dataTransfer.setData('text/plain', String(item.id))
    }

    function allowDrop(event, day) {
      if (!draggedPostId()) return
      event.preventDefault()
      event.dataTransfer.dropEffect = 'move'
      dragOverDay.set(day)
    }

    function leaveDrop(day) {
      if (dragOverDay() === day) dragOverDay.set('')
    }

    async function dropOnDay(event, day) {
      event.preventDefault()
      const id = draggedPostId() || Number(event.dataTransfer.getData('text/plain'))
      const item = posts().find(candidate => candidate.id === id)
      dragOverDay.set('')
      draggedPostId.set(0)
      if (!item || item.postId || item.scheduledAt.slice(0, 10) === day) return
      const previous = item.scheduledAt
      const next = `${day} ${item.scheduledAt.slice(11, 19) || '09:00:00'}`
      posts.set(posts().map(candidate => candidate.id === id ? { ...candidate, scheduledAt: next } : candidate))
      try {
        await api('/api/postline/campaigns/post/move', { campaign_id: campaign().id, id, scheduled_at: next })
        showNotice(copy.postMoved, copy.dateChanged.replace('{date}', shortDate(next)).replace('{title}', () => item.title))
      }
      catch (error) {
        posts.set(posts().map(candidate => candidate.id === id ? { ...candidate, scheduledAt: previous } : candidate))
        showNotice(copy.moveFailed, error instanceof Error ? error.message : String(error), 'error')
      }
    }

    function endDrag() {
      draggedPostId.set(0)
      dragOverDay.set('')
    }

    function shiftCalendar(days) {
      calendarStart.set(addDays(calendarStart(), days))
    }

    function goToCampaign() {
      if (campaign()) calendarStart.set(sundayFor(campaign().startDate))
    }

    onMount(() => {
      void loadCampaigns()
      void loadProviders()
      void loadAIStatus()
    })
  </script>
@endsection
