@extends('layouts/app')

<script server cache>
import { workspaceInboxText, workspaceLocale } from '../../app/Support/Localization/workspace'

export const inboxLocale = workspaceLocale
export const inboxText = workspaceInboxText
export const inboxClient = { locale: workspaceLocale, messages: inboxText }
</script>

@section('title')Postline - {{ inboxText.title }}@endsection

@section('content')
  @meta('description', inboxText.description)
  <section class="grid gap-4" data-postline-page="inbox" data-testid="inbox-page" lang="{{ inboxLocale }}">
    <WorkspacePageHeader titleKey="workspace.navigation.inbox">
      <template #description><span :show="inboxSection() === 'messages' && !loading()" :text="inboxOverview()"></span>
        <span :show="inboxSection() === 'public'">{{ inboxText.publicDescription }}</span></template>
      <div class="flex flex-wrap gap-2 items-center" :show="inboxSection() === 'messages'">
        <button class="inline-flex gap-2 items-center justify-center px-3 h-9 font-semibold text-ink text-xs bg-panel hover:bg-raised border border-line rounded-xl disabled:opacity-50 transition-colors" type="button" :disabled="unreadCount() === 0" @click="markAllRead">{{ inboxText.markAllRead }}</button>
        <button class="inline-flex gap-2 items-center justify-center px-4 h-9 font-semibold text-on-accent text-sm bg-accent hover:bg-accent-hover rounded-xl disabled:opacity-50 transition-colors" type="button" :show="providerFilter() !== 'twitter'" :disabled="syncing() || connectedCount() === 0" @click="runSync">
          <span class="h-4 w-4 i-hugeicons-refresh" :class="syncing() ? 'animate-spin' : ''" aria-hidden="true"></span>
          <span :text="syncing() ? copy.syncing : copy.sync">{{ inboxText.sync }}</span>
        </button>
      </div>
    </WorkspacePageHeader>

    <div class="flex flex-wrap gap-2" role="group" aria-label="{{ inboxText.sections }}">
      <button class="px-3 py-2 font-semibold text-ui border border-line rounded-xl" type="button" :class="inboxSection() === 'messages' ? 'bg-accent text-on-accent' : 'bg-panel text-ink hover:bg-raised'" :aria-pressed="inboxSection() === 'messages'" @click="inboxSection.set('messages')">{{ inboxText.direct }}</button>
      <button class="px-3 py-2 font-semibold text-ui border border-line rounded-xl" type="button" :class="inboxSection() === 'public' ? 'bg-accent text-on-accent' : 'bg-panel text-ink hover:bg-raised'" :aria-pressed="inboxSection() === 'public'" @click="inboxSection.set('public')">{{ inboxText.publicActivity }}</button>
    </div>

    <div :if="inboxSection() === 'public'"><InboxPublicActivity /></div>

    <div :show="inboxSection() === 'messages'" class="grid gap-4 lg:grid-cols-[minmax(13rem,18rem)_minmax(0,1fr)] xl:grid-cols-[22rem_minmax(0,1fr)]">
      <aside class="grid content-start gap-4" aria-label="{{ inboxText.conversations }}">
        <section class="grid gap-2 p-4 bg-panel border border-line rounded-2xl" :show="xInbox().accounts.length && providerFilter() !== 'bluesky' && providerFilter() !== 'mastodon'" aria-labelledby="x-inbox-title">
          <h2 id="x-inbox-title" class="m-0 font-semibold text-ink text-sm">{{ inboxText.xMessages }}</h2>
          <p class="m-0 text-body text-xs" :text="xReadCost()" data-x-inbox-cost></p>
          <div class="grid gap-1" role="group" :aria-label="words.t('xAccountMessages', { handle: account.handle })" x-for="account in xInbox().accounts">
            <p class="m-0 font-medium text-body text-xs" :text="'@' + account.handle"></p>
            <div class="flex flex-wrap gap-1.5">
              <Button variant="secondary" size="xs" :disabled="Boolean(xSyncing())" @click="runXSync(account.id)">{{ inboxText.syncX }}</Button>
              <Button variant="quiet" size="xs" :show="account.older" :disabled="Boolean(xSyncing())" @click="runXSync(account.id, true)">{{ inboxText.olderX }}</Button>
            </div>
          </div>
        </section>
        <Card padding="none" className="shadow-sm">
          <header class="grid gap-2.5 px-4 py-3 border-b border-line">
            <div class="flex gap-2 items-center justify-between">
              <h2 class="m-0 font-semibold text-ink text-sm" :text="statusFilter() === 'archived' ? copy.archived : copy.title">{{ inboxText.title }}</h2>
              <button class="px-2.5 h-7 font-semibold text-muted text-xs hover:text-ink bg-panel-2 hover:bg-raised border border-line rounded-lg transition-colors" type="button" @click="toggleStatusFilter" :text="statusFilter() === 'archived' ? copy.showInbox : copy.showArchived">{{ inboxText.showArchived }}</button>
            </div>
            <select class="px-3 h-8 text-ink text-xs bg-panel-2 border border-field-line rounded-lg" aria-label="{{ inboxText.network }}" @change="setProviderFilter($event.target.value)">
              <option value="">{{ inboxText.allNetworks }}</option>
              <option x-for="provider in providerOptions" :value="provider" :text="providerLabel(provider)"></option>
            </select>
            {{-- Each connected account has its own inbox (#136); shown once there is more than one. --}}
            <select class="px-3 h-8 text-ink text-xs bg-panel-2 border border-field-line rounded-lg" :class="accountOptions().length > 1 ? '' : 'hidden'" aria-label="{{ inboxText.account }}" @change="setAccountFilter($event.target.value)">
              <option value="">{{ inboxText.allAccounts }}</option>
              <option x-for="account in accountOptions()" :value="account.id" :text="account.label"></option>
            </select>
          </header>

          <WorkspaceListSkeleton :show="loading()" label="{{ inboxText.loadingConversations }}" />
          <ErrorState :show="conversationError() && !loading()" title="{{ inboxText.couldNotLoadConversations }}" :message="conversationError()" @retry="loadConversations()" />
          <EmptyState :show="showEmptyList()" variant="bare" :title="connectedCount() || xInbox().accounts.length ? copy.noConversations : copy.connectNetwork" :description="connectedCount() || xInbox().accounts.length ? copy.syncLatest : copy.supportedNetworks">
            <StxLink class="text-info text-ui underline" to="/accounts" :show="!connectedCount() && !xInbox().accounts.length">{{ inboxText.openChannels }}</StxLink>
            <button class="text-info text-ui underline disabled:opacity-50" type="button" :show="connectedCount() && providerFilter() !== 'twitter'" :disabled="syncing()" @click="runSync">{{ inboxText.sync }}</button>
          </EmptyState>

          <div class="overflow-y-auto max-h-80 lg:max-h-[32rem] divide-line divide-y" x-show="!loading() && conversations().length">
            <button class="grid gap-1.5 p-3 w-full text-left hover:bg-panel-2 transition-colors" type="button" x-for="conversation in conversations()" :aria-current="conversation.id === activeId() ? 'true' : 'false'" @click="openConversation(conversation.id)" :class="conversation.id === activeId() ? 'bg-panel-2' : conversation.unreadCount ? 'bg-info-soft' : ''">
              <div class="flex gap-2 items-center">
                <NetworkChip :provider="conversation.provider" size="small" />
                <div class="flex-1 min-w-0">
                  <div class="flex gap-2 items-center justify-between">
                    <strong class="text-ink text-ui truncate" :text="conversation.participantName || conversation.participantHandle"></strong>
                    <time class="shrink-0 text-muted text-xs" :datetime="conversation.lastMessageAt" :text="relativeTime(conversation.lastMessageAt, { formatter: elapsed })"></time>
                  </div>
                  <p class="m-0 mt-0.5 text-muted text-xs truncate" :text="previewFor(conversation)"></p>
                </div>
                <span class="grid place-items-center shrink-0 px-1.5 h-5 min-w-5 font-semibold text-on-solid text-xs bg-net-bluesky rounded-full" x-show="conversation.unreadCount > 0" :text="String(conversation.unreadCount)"></span>
              </div>
            </button>
            <button class="p-3 w-full text-center text-muted text-ui hover:text-ink hover:bg-panel-2 transition-colors" type="button" x-show="nextOffset() !== null" :disabled="loadingMore()" @click="loadMoreConversations" :text="loadingMore() ? copy.loading : copy.moreConversations">{{ inboxText.moreConversations }}</button>
          </div>
        </Card>

        <section class="p-4 bg-panel border border-line rounded-2xl shadow-sm" x-show="unavailable().length">
          <h2 class="m-0 font-semibold text-ink text-sm">{{ inboxText.notAvailable }}</h2>
          <p class="m-0 mt-1 text-muted text-xs">{{ inboxText.unavailableDescription }}</p>
          <ul class="grid gap-2 m-0 mt-3 p-0 list-none">
            <li class="grid gap-0.5" x-for="entry in unavailable()">
              <strong class="text-ink text-xs" :text="providerLabel(entry.provider)"></strong>
              <span class="leading-4 text-muted text-xs" :text="entry.reason"></span>
            </li>
          </ul>
        </section>
      </aside>

      <section class="flex overflow-hidden flex-col min-h-[34rem] bg-panel border border-line rounded-2xl shadow-sm" aria-label="{{ inboxText.conversation }}">
        <div class="grid flex-1 gap-3 place-items-center px-6 py-20 text-center" x-show="!activeId()">
          <span class="grid place-items-center h-14 w-14 text-2xl text-info bg-info-soft rounded-2xl" aria-hidden="true"><span class="i-hugeicons-message-01"></span></span>
          <div>
            <h2 class="m-0 font-semibold text-base text-ink">{{ inboxText.pickConversation }}</h2>
            <p class="m-0 mt-1 max-w-md text-muted text-sm">{{ inboxText.pickDescription }}</p>
          </div>
        </div>

        <div class="contents" x-show="activeId()">
          <header class="flex flex-wrap gap-3 items-center justify-between px-4 py-3.5 border-b border-line">
            <div class="flex gap-3 items-center min-w-0">
              <NetworkChip :provider="activeProvider()" />
              <div class="min-w-0">
                <h2 class="m-0 font-semibold text-ink text-sm truncate" :text="activeTitle()"></h2>
                <p class="m-0 mt-0.5 text-muted text-xs truncate" :text="activeSubtitle()"></p>
              </div>
            </div>
            <div class="flex gap-2 items-center">
              <button class="px-3 h-8 font-semibold text-ink text-xs bg-panel-2 hover:bg-raised border border-line rounded-lg disabled:opacity-50" type="button" :show="activeProvider() !== 'twitter'" :disabled="refreshing()" @click="refreshThread" :text="refreshing() ? copy.refreshing : copy.refresh">{{ inboxText.refresh }}</button>
              <button class="px-3 h-8 font-semibold text-xs border rounded-lg transition-colors" type="button" @click="toggleArchive" :class="statusFilter() === 'archived' ? 'text-ink bg-panel-2 border-line hover:bg-raised' : 'text-danger border-danger-line hover:bg-danger-soft'" :text="statusFilter() === 'archived' ? copy.restore : copy.archive">{{ inboxText.archive }}</button>
            </div>
          </header>

          <div class="grid overflow-y-auto content-start flex-1 gap-3 px-4 py-4 max-h-[30rem]" ref="threadList" data-inbox-thread>
            <WorkspaceListSkeleton :show="threadLoading()" label="{{ inboxText.loadingMessages }}" />
            <ErrorState :show="threadError() && !threadLoading()" title="{{ inboxText.couldNotLoadMessages }}" :message="threadError()" @retry="loadThread()" />
            <EmptyState :show="!threadLoading() && !threadError() && !messages().length" variant="bare" title="{{ inboxText.noSyncedMessages }}" description="{{ inboxText.syncHistory }}">
              <button class="text-info text-ui underline disabled:opacity-50" type="button" :show="activeProvider() !== 'twitter'" :disabled="syncing()" @click="runSync">{{ inboxText.sync }}</button>
            </EmptyState>
            <button class="justify-self-center px-3 py-1 text-muted text-xs hover:text-ink rounded-lg" type="button" x-show="olderOffset() !== null" :disabled="loadingOlder()" @click="loadOlderMessages" :text="loadingOlder() ? copy.loading : copy.olderMessages">{{ inboxText.olderMessages }}</button>
            <article class="flex" x-for="message in messages()" :class="message.direction === 'outgoing' ? 'justify-end' : 'justify-start'">
              <div class="grid gap-1 max-w-[80%]">
                <div class="px-3.5 py-2.5 rounded-2xl" :class="message.direction === 'outgoing' ? 'bg-accent text-on-accent' : 'bg-panel-2 text-body border border-line'">
                  <p class="m-0 leading-5 text-ui whitespace-pre-line" :text="message.body"></p>
                </div>
                <div class="flex gap-2 items-center px-1" :class="message.direction === 'outgoing' ? 'justify-end' : 'justify-start'">
                  <span class="text-muted text-xs" :text="message.direction === 'outgoing' ? copy.you : (message.authorName || message.authorHandle)"></span>
                  <time class="text-muted text-xs" :datetime="message.sentAt" :text="relativeTime(message.sentAt, { formatter: elapsed })"></time>
                  <span class="font-semibold text-danger text-xs" x-show="message.status === 'failed'" :text="message.failureReason || copy.failedToSend"></span>
                </div>
              </div>
            </article>
          </div>

          <form class="grid gap-2 px-4 py-3 border-line border-t" @submit="sendReply($event)">
            <textarea class="px-3 py-2.5 min-h-20 text-ink text-sm bg-bg border border-field-line outline-none rounded-xl focus:ring-2 focus:ring-focus resize-y" placeholder="{{ inboxText.writeReply }}" aria-label="{{ inboxText.reply }}" x-model="draftBody" :maxlength="String(characterLimit())" @keydown="maybeSend($event)"></textarea>
            <div class="flex flex-wrap gap-2 items-center justify-between">
              <span class="text-muted text-xs" :text="words.tc('replyCharacters', remaining())"></span>
              <button class="inline-flex gap-2 items-center justify-center px-4 h-9 font-semibold text-on-accent text-sm bg-accent hover:bg-accent-hover rounded-xl disabled:opacity-50 transition-colors" type="submit" :disabled="sending() || !canReply() || !draftBody().trim()">
                <span class="h-4 w-4 i-hugeicons-sent" aria-hidden="true"></span>
                <span :text="sending() ? copy.sending : replyLabel()">{{ inboxText.send }}</span>
              </button>
            </div>
          </form>
        </div>

        <div role="alert">
          <p class="m-0 px-4 py-3 text-danger text-sm bg-danger-soft border-danger-line border-t" x-show="errorMessage()" :text="errorMessage()"></p>
        </div>
      </section>
    </div>
  </section>

  <script client>
    import { createI18n } from '@stacksjs/i18n/client'
    import { showNotification } from '../functions/notification'

    const { locale: language, messages: copy } = {{ inboxClient }}
    const words = createI18n({ locale: language, messages: { [language]: copy } })
    const elapsed = language === 'en' ? undefined : new Intl.RelativeTimeFormat(language, { numeric: 'auto' })

    const inboxSection = state<'messages' | 'public'>('messages')
    interface InboxConversation {
      id: number
      provider: string
      identityId?: number | null
      participantHandle: string
      participantName?: string | null
      lastMessageAt?: string | null
      lastMessagePreview?: string | null
      lastMessageOutgoing: boolean
      unreadCount: number
      status: string
    }

    interface InboxMessage {
      id: number
      provider: string
      direction: string
      authorHandle: string
      authorName?: string | null
      body: string
      status: string
      failureReason?: string | null
      sentAt: string
    }

    // The networks the inbox reads. Why the others are missing comes from the
    // server and is shown above the list.
    const providerOptions = ['bluesky', 'mastodon', 'twitter']

    const conversations = state([])
    const messages = state([])
    const supported = state([])
    const unavailable = state([])
    const loading = state(true)
    const threadLoading = state(false)
    const syncing = state(false)
    const refreshing = state(false)
    const sending = state(false)
    const errorMessage = state('')
    const conversationError = state('')
    const threadError = state('')
    const activeId = state(0)
    let threadSelection = 0
    let listRequest = 0
    const statusFilter = state('open')
    const providerFilter = state('')
    const accountFilter = state('')
    const accounts = state([])
    const xInbox = state({ accounts: [], readUsage: null, maxReadUsd: 0, replyUsd: 0 })
    const xSyncing = state(0)
    const usd = new Intl.NumberFormat(language === 'en' ? 'en-US' : language, { style: 'currency', currency: 'USD', maximumFractionDigits: 3 })
    const xReadCost = derived(() => {
      const usage = xInbox().readUsage
      if (!usage) return ''
      return words.t('xReadCost', { pageCost: usd.format(xInbox().maxReadUsd), spent: usd.format(usage.estimatedUsd), limit: usd.format(usage.limitUsd) })
    })
    const accountOptions = derived(() => accounts()
      .filter(account => !providerFilter() || account.provider === providerFilter())
      .map(account => ({ id: String(account.id), label: `@${String(account.handle).replace(/^@/, '')}` })))
    const draftBody = state('')
    // A reply half-written in one conversation waits there while you read
    // another (#173). Kept for the visit; a sent reply clears its own.
    const drafts = new Map<number, string>()
    const keepDraft = () => {
      if (!activeId()) return
      if (draftBody().trim()) drafts.set(activeId(), draftBody())
      else drafts.delete(activeId())
    }
    const threadList = useRef('threadList')
    /** Within this many pixels of the bottom counts as reading the newest. */
    const NEAR_BOTTOM = 80
    const scrollToNewest = () => {
      const selection = threadSelection
      void nextTick(() => {
        const list = threadList.current
        if (selection === threadSelection && list) list.scrollTop = list.scrollHeight
      })
    }
    const activeCharacterLimit = state(1000)
    let pollTimer = 0

    // The whole inbox's unread count, from the server: the list is paged (#105).
    const unreadCount = state(0)
    const inboxOverview = derived(() => {
      const count = conversations().length
      const values = { conversations: count, unread: unreadCount() }
      return nextOffset() !== null ? words.t('pagedOverview', values) : words.tc('overview', count, values)
    })
    const nextOffset = state<number | null>(null)
    const olderOffset = state<number | null>(null)
    const loadingMore = state(false)
    const loadingOlder = state(false)
    const connected = derived(() => supported().filter(item => item.connected))
    const connectedCount = derived(() => connected().length)
    const showEmptyList = derived(() => !loading() && !conversationError() && conversations().length === 0)
    const activeConversation = derived(() => conversations().find(item => item.id === activeId()) || null)
    const activeProvider = derived(() => activeConversation()?.provider || 'bluesky')
    const canReply = derived(() => activeProvider() !== 'twitter' || xInbox().accounts.some(account => account.id === activeConversation()?.identityId))
    const replyLabel = derived(() => activeProvider() === 'twitter' && xInbox().replyUsd ? words.t('sendCost', { cost: usd.format(xInbox().replyUsd) }) : copy.send)
    const activeTitle = derived(() => activeConversation()?.participantName || activeConversation()?.participantHandle || copy.conversation)
    const activeSubtitle = derived(() => {
      const conversation = activeConversation()
      if (!conversation) return ''
      return `${providerLabel(conversation.provider)} · ${conversation.participantHandle}`
    })
    const characterLimit = derived(() => activeCharacterLimit())
    const remaining = derived(() => Math.max(0, characterLimit() - draftBody().length))
    const previewFor = (conversation: InboxConversation): string => {
      const preview = conversation.lastMessagePreview || copy.noMessages
      return conversation.lastMessageOutgoing ? words.t('youPreview', { preview }) : preview
    }
    const postJson = (url: string, body: Record<string, unknown>) =>
      requestJson(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }, copy.requestFailed)

    const loadConversations = async ({ quiet = false } = {}) => {
      if (quiet && (loading() || loadingMore())) return
      const request = ++listRequest
      if (!quiet) {
        loading.set(true)
        loadingMore.set(false)
      }
      conversationError.set('')
      try {
        const query = new URLSearchParams({ status: statusFilter(), provider: providerFilter(), identity_id: accountFilter() })
        const payload = await requestJson(`/api/postline/inbox?${query}`, {}, copy.requestFailed)
        if (request !== listRequest) return
        const first = payload.data?.conversations || []
        // A quiet refresh updates the first page in place and keeps any pages
        // already loaded below it; a full load starts over.
        if (quiet && nextOffset() !== null && conversations().length > first.length) {
          const fresh = new Set(first.map(item => item.id))
          conversations.set([...first, ...conversations().filter(item => !fresh.has(item.id))])
        }
        else {
          conversations.set(first)
          nextOffset.set(payload.data?.nextOffset ?? null)
        }
        unreadCount.set(Number(payload.data?.unreadCount || 0))
        supported.set(payload.data?.providers?.supported || [])
        accounts.set(payload.data?.providers?.accounts || [])
        unavailable.set(payload.data?.providers?.unavailable || [])
        if (payload.data?.providers?.twitter) xInbox.set(payload.data.providers.twitter)
        // A thread that has been archived or filtered away should not stay open.
        if (activeId() && !conversations().some(item => item.id === activeId())) selectConversation(0)
      }
      catch (error) {
        if (request === listRequest) conversationError.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        if (request === listRequest) loading.set(false)
      }
    }

    const selectConversation = (id: number) => {
      keepDraft()
      threadSelection++
      activeId.set(id)
      messages.set([])
      threadError.set('')
      errorMessage.set('')
      threadLoading.set(false)
      loadingOlder.set(false)
      olderOffset.set(null)
      activeCharacterLimit.set(1000)
      draftBody.set(drafts.get(id) || '')
    }

    const loadThread = async ({ markRead = true, quiet = false } = {}) => {
      const conversationId = activeId()
      if (!conversationId || (quiet && (threadLoading() || loadingOlder()))) return
      const selection = threadSelection
      if (!quiet) threadLoading.set(true)
      threadError.set('')
      try {
        const query = new URLSearchParams({ conversation_id: String(conversationId) })
        const payload = await requestJson(`/api/postline/inbox/thread?${query}`, {}, copy.requestFailed)
        if (selection !== threadSelection) return
        // A quiet refresh keeps older messages already loaded above the newest page.
        const newest = payload.data?.messages || []
        // A quiet refresh follows new messages only for someone already at the
        // bottom; scrolled up into the history, they stay where they are.
        const list = threadList.current
        const following = !quiet || !list || list.scrollHeight - list.scrollTop - list.clientHeight < NEAR_BOTTOM
        if (quiet && messages().length > newest.length) {
          const fresh = new Set(newest.map(item => item.id))
          messages.set([...messages().filter(item => !fresh.has(item.id)), ...newest])
        }
        else {
          messages.set(newest)
          olderOffset.set(payload.data?.olderOffset ?? null)
        }
        activeCharacterLimit.set(Number(payload.data?.characterLimit || 1000))
        if (following) scrollToNewest()
        if (markRead) {
          await postJson('/api/postline/inbox/read', { conversation_id: conversationId })
          const opened = conversations().find(item => item.id === conversationId)
          unreadCount.set(Math.max(0, unreadCount() - Number(opened?.unreadCount || 0)))
          conversations.set(conversations().map(item => item.id === conversationId ? { ...item, unreadCount: 0 } : item))
        }
      }
      catch (error) {
        if (selection === threadSelection) threadError.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        if (selection === threadSelection) threadLoading.set(false)
      }
    }

    const loadMoreConversations = async () => {
      const offset = nextOffset()
      if (offset === null || loading() || loadingMore()) return
      const request = listRequest
      loadingMore.set(true)
      try {
        const query = new URLSearchParams({ status: statusFilter(), provider: providerFilter(), identity_id: accountFilter(), offset: String(offset) })
        const payload = await requestJson(`/api/postline/inbox?${query}`, {}, copy.requestFailed)
        if (request !== listRequest) return
        const seen = new Set(conversations().map(item => item.id))
        conversations.set([...conversations(), ...(payload.data?.conversations || []).filter(item => !seen.has(item.id))])
        nextOffset.set(payload.data?.nextOffset ?? null)
      }
      catch (error) {
        if (request === listRequest)
          showNotification({ title: copy.couldNotLoadConversations, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'inbox-pagination' })
      }
      finally {
        if (request === listRequest) loadingMore.set(false)
      }
    }

    const loadOlderMessages = async () => {
      const offset = olderOffset()
      const conversationId = activeId()
      if (offset === null || loadingOlder() || !conversationId) return
      const selection = threadSelection
      loadingOlder.set(true)
      errorMessage.set('')
      try {
        const query = new URLSearchParams({ conversation_id: String(conversationId), offset: String(offset) })
        const payload = await requestJson(`/api/postline/inbox/thread?${query}`, {}, copy.requestFailed)
        if (selection !== threadSelection) return
        const seen = new Set(messages().map(item => item.id))
        messages.set([...(payload.data?.messages || []).filter(item => !seen.has(item.id)), ...messages()])
        olderOffset.set(payload.data?.olderOffset ?? null)
      }
      catch (error) {
        if (selection === threadSelection) errorMessage.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        if (selection === threadSelection) loadingOlder.set(false)
      }
    }

    const openConversation = async (id: number) => {
      if (activeId() === id) return
      selectConversation(id)
      await loadThread()
    }

    // j and k move through the list, as in most mail apps; never while typing.
    useEventListener('keydown', (event: KeyboardEvent) => {
      if (event.metaKey || event.ctrlKey || event.altKey || (event.key !== 'j' && event.key !== 'k')) return
      const target = event.target as HTMLElement | null
      if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return
      const list = conversations()
      if (!list.length) return
      const at = list.findIndex(item => item.id === activeId())
      const next = event.key === 'j' ? Math.min(list.length - 1, at + 1) : Math.max(0, at === -1 ? 0 : at - 1)
      event.preventDefault()
      void openConversation(list[next].id)
    })

    const setProviderFilter = async (value: string) => {
      providerFilter.set(value)
      accountFilter.set('')
      await loadConversations()
    }

    const setAccountFilter = async (value: string) => {
      accountFilter.set(value)
      await loadConversations()
    }

    const toggleStatusFilter = async () => {
      statusFilter.set(statusFilter() === 'archived' ? 'open' : 'archived')
      selectConversation(0)
      await loadConversations()
    }

    const runSync = async () => {
      syncing.set(true)
      try {
        const payload = await postJson('/api/postline/inbox/sync', { provider: providerFilter() })
        await loadConversations({ quiet: true })
        if (activeId()) await loadThread({ markRead: false, quiet: true })
        const failures = payload.data?.errors?.length || 0
        const message = words.tc('newMessages', payload.data?.messages || 0)
        const attention = failures ? words.tc('syncAttention', failures) : ''
        showNotification({
          title: copy.synced,
          message: [message, attention].filter(Boolean).join(' '),
          tone: failures ? 'neutral' : 'success',
          id: 'inbox-sync',
        })
      }
      catch (error) {
        showNotification({ title: copy.syncFailed, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'inbox-sync' })
      }
      finally {
        syncing.set(false)
      }
    }

    const runXSync = async (identityId: number, older = false) => {
      if (xSyncing()) return
      xSyncing.set(identityId)
      try {
        const payload = await postJson('/api/postline/inbox/sync', { twitter_identity_id: identityId, older })
        const count = payload.data?.messages || 0
        showNotification({ title: copy.xSynced, message: words.tc('newMessages', count), tone: 'success', id: 'x-inbox-sync' })
        if (activeId() && activeProvider() === 'twitter') await loadThread({ markRead: false, quiet: true })
      }
      catch (error) {
        showNotification({ title: copy.xSyncFailed, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'x-inbox-sync' })
      }
      finally {
        await loadConversations({ quiet: true })
        xSyncing.set(0)
      }
    }

    const refreshThread = async () => {
      const conversationId = activeId()
      if (!conversationId || refreshing()) return
      const selection = threadSelection
      refreshing.set(true)
      try {
        await postJson('/api/postline/inbox/sync', { conversation_id: conversationId })
        if (selection === threadSelection) await loadThread({ quiet: true })
        await loadConversations({ quiet: true })
      }
      catch (error) {
        showNotification({ title: copy.refreshFailed, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'inbox-refresh' })
      }
      finally {
        refreshing.set(false)
      }
    }

    const sendReply = async (event: SubmitEvent) => {
      event.preventDefault()
      const submittedDraft = draftBody()
      const body = submittedDraft.trim()
      const conversationId = activeId()
      const isX = activeProvider() === 'twitter'
      if (!body || !conversationId || !canReply() || sending()) return
      sending.set(true)
      try {
        const payload = await postJson('/api/postline/inbox/reply', { conversation_id: conversationId, body })
        const stillOpen = activeId() === conversationId
        const latestDraft = stillOpen ? draftBody() : drafts.get(conversationId)
        if (latestDraft === submittedDraft) {
          drafts.delete(conversationId)
          if (stillOpen) draftBody.set('')
        }
        if (stillOpen) {
          const sent = payload.data?.message
          if (sent && !messages().some(item => item.id === sent.id)) messages.set([...messages(), sent])
          scrollToNewest()
        }
        await loadConversations({ quiet: true })
      }
      catch (error) {
        showNotification({ title: isX ? copy.xReplyFailed : copy.replyFailed, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'inbox-reply' })
      }
      finally {
        sending.set(false)
      }
    }

    const maybeSend = (event: KeyboardEvent) => {
      if (event.key !== 'Enter' || !(event.metaKey || event.ctrlKey)) return
      event.preventDefault()
      void sendReply(new SubmitEvent('submit'))
    }

    const markAllRead = async () => {
      try {
        await postJson('/api/postline/inbox/read', { conversation_id: 0 })
        conversations.set(conversations().map(item => ({ ...item, unreadCount: 0 })))
        unreadCount.set(0)
      }
      catch (error) {
        showNotification({ title: copy.updateInboxFailed, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'inbox-read' })
      }
    }

    const toggleArchive = async () => {
      const conversationId = activeId()
      if (!conversationId) return
      const nextStatus = statusFilter() === 'archived' ? 'open' : 'archived'
      try {
        await postJson('/api/postline/inbox/archive', { conversation_id: conversationId, status: nextStatus })
        if (activeId() === conversationId) selectConversation(0)
        await loadConversations()
        showNotification({
          title: nextStatus === 'archived' ? copy.archivedTitle : copy.restoredTitle,
          message: nextStatus === 'archived' ? copy.archivedDescription : copy.restoredDescription,
          tone: 'success',
          id: 'inbox-archive',
        })
      }
      catch (error) {
        showNotification({ title: copy.updateConversationFailed, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'inbox-archive' })
      }
    }

    // A hidden tab asks for nothing (#184); quiet refreshes merge by id.
    const visibility = useDocumentVisibility()
    onMount(() => {
      void loadConversations()
      // Reads hit the local mirror, so polling is cheap; the scheduler is what
      // actually talks to the networks, every five minutes.
      pollTimer = window.setInterval(() => {
        if (visibility.value === 'hidden') return
        void loadConversations({ quiet: true })
        if (activeId()) void loadThread({ markRead: false, quiet: true })
      }, 45_000)
    })
    onUnmounted(() => window.clearInterval(pollTimer))
  </script>
@endsection
