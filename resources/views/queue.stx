@extends('layouts/app')

@section('title', 'Postline - Queue')

@section('content')
  @meta('description', 'Review scheduled and drafted social posts in Postline.')
  <section class="grid gap-5" data-postline-page="queue" data-testid="queue-page">
    <p class="hidden m-0 px-3 py-2 text-ui text-warning bg-warning-soft border border-warning-line rounded-xl" :class="{ 'hidden': !schedulerWarning() }" :text="schedulerWarning()" role="status" data-scheduler-warning></p>
    <a class="hidden m-0 px-3 py-2 text-ui text-warning bg-warning-soft border border-warning-line rounded-xl" :class="{ 'hidden': !attentionText() }" href="/activity" data-stx-link :text="attentionText()" data-attention-link></a>
    <header class="flex flex-wrap gap-4 items-center justify-between min-h-11">
      <div>
        <p class="mb-1.5 font-semibold text-muted text-xs tracking-wider uppercase">Queue</p>
        <h1 class="m-0 font-semibold text-2xl text-ink tracking-normal">Scheduled posts</h1>
        <p class="mb-0 mt-1.5 text-muted text-ui">What's drafted, scheduled, and recently published.</p>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <div class="grid grid-cols-2 p-0.5 bg-panel-3 border border-line rounded-xl" role="group" aria-label="Queue view" x-show="!activeSearch()">
          <button class="inline-flex gap-1.5 items-center justify-center px-3 py-1.5 font-semibold text-xs rounded-lg transition-colors" type="button" data-view-toggle :data-active="view() === 'list'" :aria-pressed="view() === 'list'" @click="setView('list')">
            <span class="h-3.5 w-3.5 i-hugeicons-menu-01" aria-hidden="true"></span><span>List</span>
          </button>
          <button class="inline-flex gap-1.5 items-center justify-center px-3 py-1.5 font-semibold text-xs rounded-lg transition-colors" type="button" data-view-toggle :data-active="view() === 'calendar'" :aria-pressed="view() === 'calendar'" @click="setView('calendar')">
            <span class="h-3.5 w-3.5 i-hugeicons-calendar-03" aria-hidden="true"></span><span class="sm:hidden">Agenda</span><span class="hidden sm:inline">Calendar</span>
          </button>
        </div>
        <a href="/composer" data-stx-link class="inline-flex gap-2 items-center justify-center px-4 h-9 font-semibold text-on-accent text-sm bg-accent hover:bg-accent-hover rounded-xl transition-colors">
          <span class="h-4 w-4 i-hugeicons-plus-sign" aria-hidden="true"></span>
          <span>New post</span>
        </a>
      </div>
    </header>

    <form class="flex flex-wrap gap-2 items-center" role="search" aria-label="Posts" @submit.prevent="searchPosts">
      <label class="sr-only" for="queue-search">Search posts</label>
      <input class="px-3 h-9 w-full sm:max-w-xs text-ink text-ui bg-panel border border-field-line rounded-lg" id="queue-search" type="search" placeholder="Search all posts" maxlength="200" x-model="searchText">
      <button class="px-3 h-9 font-semibold text-on-accent text-ui bg-accent hover:bg-accent-hover rounded-lg" type="submit">Search</button>
      <button class="px-3 h-9 font-medium text-muted text-ui hover:text-ink rounded-lg" type="button" x-show="activeSearch()" @click="clearSearch">Clear search</button>
    </form>

    {{-- x-cloak on both views: neither paints before the stored choice is
        read, so a queue left on Calendar no longer flashes the list first. --}}
    <section class="bg-panel border border-line rounded-2xl shadow-sm" x-cloak x-show="activeSearch() || view() === 'list'">
      <header class="flex flex-wrap gap-3 items-center justify-between p-2.5 border-b border-line">
        <div class="flex flex-wrap gap-1" role="tablist" aria-label="Queue" x-show="!activeSearch()">
          <button class="inline-flex gap-1.5 items-center px-3 h-8 font-semibold text-xs rounded-lg transition-colors" type="button" role="tab" x-for="entry in tabs()" :id="'queue-tab-' + entry.id" aria-controls="queue-results" :aria-selected="tab() === entry.id" :tabindex="tab() === entry.id ? 0 : -1" :data-active="tab() === entry.id" :data-tone="entry.tone" data-queue-tab @click="setTab(entry.id)" @keydown="moveTab($event, entry.id)">
            <span :text="entry.label"></span>
            <span class="px-1.5 min-w-5 text-center text-xs rounded-full" data-queue-tab-count :text="entry.count"></span>
          </button>
        </div>
        <h2 class="m-0 px-1 font-semibold text-ui" x-show="activeSearch()">Search results</h2>
        <span class="pr-1 text-muted text-xs" aria-live="polite" :text="metaText()">Loading…</span>
      </header>
      <div class="grid gap-2.5 p-3" id="queue-results" :role="activeSearch() ? 'region' : 'tabpanel'" :aria-label="activeSearch() ? 'Matching posts' : null" :aria-labelledby="activeSearch() ? null : 'queue-tab-' + tab()">
        <p class="m-0 p-3 text-muted text-ui" x-show="loadError()" :text="loadError()"></p>
        <p class="m-0 p-3 text-muted text-ui" x-show="showEmpty()" :text="emptyText()"></p>
        <article class="grid gap-2.5 p-3.5 bg-panel border border-line rounded-2xl group" x-for="row in visible()" :data-command-context="row.body">
          <header class="flex gap-3 items-start justify-between">
            <div class="grid gap-1.5">
              <span class="font-semibold text-xs">{{ row.when }}</span>
              {{-- One chip per network: sent, failed (the reason on hover and
                  below), or still to go. --}}
              <div class="flex flex-wrap gap-1.5 items-center">
                <span class="inline-flex gap-1 items-center px-2 py-0.5 text-xs border rounded-full" x-for="target in row.targets" data-target-chip :data-state="target.state" :title="target.title">
                  <span class="h-1.5 w-1.5 rounded-full" data-target-dot aria-hidden="true"></span>
                  <span :text="target.label"></span>
                </span>
                <span class="text-muted text-xs" x-show="row.meta" :text="row.meta"></span>
              </div>
            </div>
            <span class="px-2 py-1 font-semibold text-xs whitespace-nowrap border rounded-full" data-status-pill :data-status="row.pill">{{ row.statusLabel }}</span>
          </header>
          <p class="m-0 leading-normal text-body text-ui">{{ row.body }}</p>
          <p class="m-0 text-danger text-xs" x-show="row.failure" :text="row.failure"></p>
          <footer class="flex flex-wrap gap-1.5 items-center justify-end" x-show="row.liveUrl || row.actionable || row.partial || row.resumeLabel">
            <div class="group-focus-within:opacity-100 group-hover:opacity-100 transition-opacity" :class="row.attention ? '' : 'pointer-fine:opacity-0'">
              <a class="inline-flex items-center justify-center px-2.5 h-7 font-semibold text-ink text-xs bg-panel hover:bg-hover border border-line rounded-lg shadow-sm transition-colors" x-show="row.liveUrl && !row.actionable && !row.partial && !row.resumeLabel" :href="row.liveUrl" target="_blank" rel="noopener noreferrer">View post</a>
              <button class="inline-flex items-center justify-center px-2.5 h-7 font-semibold text-ink text-xs bg-panel hover:bg-hover border border-line rounded-lg shadow-sm disabled:opacity-50 transition-colors" type="button" x-show="row.resumeLabel" :disabled="busyId() === row.id" @click="resumeItem(row.id)" :text="row.resumeLabel"></button>
              <button class="inline-flex items-center justify-center px-2.5 h-7 font-semibold text-ink text-xs bg-panel hover:bg-hover border border-line rounded-lg shadow-sm disabled:opacity-50 transition-colors" type="button" x-show="row.partial && !row.resumeLabel" :disabled="busyId() === row.id" @click="retryItem(row.id)">Retry failed networks</button>
              <button class="inline-flex items-center justify-center px-2.5 h-7 font-semibold text-on-accent text-xs bg-accent hover:bg-accent-hover rounded-lg disabled:opacity-50 transition-colors" type="button" x-show="row.actionable && !row.partial && !row.resumeLabel" :disabled="busyId() === row.id" @click="publishItem(row.id)" :text="row.status === 'failed' ? 'Try again now' : 'Publish now'">Publish now</button>
            </div>
            <details class="relative" x-show="row.actionable || (row.liveUrl && (row.partial || row.resumeLabel))" @keydown="closeActionsOnEscape($event)">
              <summary class="grid place-items-center h-7 w-8 list-none text-muted bg-panel hover:bg-hover border border-line rounded-lg cursor-pointer" aria-label="More post actions" title="More post actions">
                <span class="h-4 w-4 i-hugeicons-more-horizontal" aria-hidden="true"></span>
              </summary>
              <div class="grid absolute right-0 top-full z-10 gap-0.5 mt-1 p-1 min-w-28 text-ui bg-panel border border-line rounded-lg shadow-sm">
                <a class="block px-2 py-1 text-ink hover:bg-hover rounded-md" x-show="row.liveUrl" :href="row.liveUrl" target="_blank" rel="noopener noreferrer">View post</a>
                <a class="block px-2 py-1 text-ink hover:bg-hover rounded-md" x-show="row.actionable" :href="row.editUrl" data-stx-link>Edit</a>
                <button class="px-2 py-1 text-danger text-left hover:bg-danger-soft rounded-md disabled:opacity-50" type="button" x-show="row.actionable" :disabled="busyId() === row.id" @click="deleteItem(row.id)">Delete</button>
              </div>
            </details>
          </footer>
        </article>
      </div>
      {{-- The list is paged; this fetches the page of older posts. --}}
      <div class="flex justify-center p-3" x-show="(activeSearch() || tab() === 'published') && nextCursor()">
        <button class="inline-flex items-center justify-center px-3 h-8 font-medium text-ink text-ui bg-panel hover:bg-hover border border-line rounded-lg shadow-sm disabled:opacity-50 transition-colors" type="button" :disabled="loadingMore()" @click="loadMore" :text="loadingMore() ? 'Loading…' : (activeSearch() ? 'Load more results' : 'Load older posts')">Load older posts</button>
      </div>
    </section>

    <section class="bg-panel border border-line rounded-2xl shadow-sm" x-cloak x-show="!activeSearch() && view() === 'calendar'">
      <header class="flex gap-3 items-center justify-between p-3.5 border-b border-line">
        <div class="flex gap-2 items-center">
          <button class="inline-flex items-center justify-center h-8 w-8 text-muted bg-panel hover:bg-hover border border-line rounded-lg shadow-sm transition-colors" type="button" aria-label="Previous month" @click="prevMonth">
            <span class="h-4 w-4 i-hugeicons-arrow-left-02" aria-hidden="true"></span>
          </button>
          <button class="inline-flex items-center justify-center px-3 h-8 font-semibold text-ink text-xs bg-panel hover:bg-hover border border-line rounded-lg shadow-sm transition-colors" type="button" @click="goToday">Today</button>
          <button class="inline-flex items-center justify-center h-8 w-8 text-muted bg-panel hover:bg-hover border border-line rounded-lg shadow-sm transition-colors" type="button" aria-label="Next month" @click="nextMonth">
            <span class="h-4 w-4 i-hugeicons-arrow-right-02" aria-hidden="true"></span>
          </button>
        </div>
        <strong class="text-ui" :text="calTitle()">Calendar</strong>
      </header>
      <div class="sm:hidden divide-line divide-y" aria-label="Monthly agenda" role="list">
        <article class="grid gap-2 px-3 py-2" role="listitem" x-for="day in calDays()" :key="day.key">
          <header class="flex gap-3 items-center justify-between">
            <time class="font-semibold text-ui" :datetime="day.key" :aria-current="day.isToday ? 'date' : null" :text="day.label"></time>
            <a class="grid place-items-center shrink-0 h-11 w-11 text-ink bg-panel-2 hover:bg-raised rounded-xl" :href="day.scheduleUrl" :aria-label="'Schedule a post on ' + day.label" data-stx-link>
              <span class="h-4 w-4 i-hugeicons-plus-sign" aria-hidden="true"></span>
            </a>
          </header>
          <div class="grid gap-1" x-show="day.chips.length">
            <a class="grid gap-1 p-2.5 min-w-0 text-body text-ui bg-panel-2 hover:bg-raised rounded-xl" x-for="chip in day.chips" :href="chip.href" data-stx-link>
              <span class="flex gap-2 items-center font-semibold text-xs">
                <span class="h-1.5 w-1.5 rounded-full" data-cal-dot :data-status="chip.status" aria-hidden="true"></span>
                <span :text="chip.time"></span>
              </span>
              <span class="min-w-0 break-words" :text="chip.label"></span>
            </a>
          </div>
        </article>
      </div>
      <div class="hidden sm:block overflow-x-auto">
        <div class="min-w-[560px]">
          <div class="grid grid-cols-7 font-semibold text-muted text-xs border-b border-line">
            <div class="p-2 text-center">Sun</div><div class="p-2 text-center">Mon</div><div class="p-2 text-center">Tue</div><div class="p-2 text-center">Wed</div><div class="p-2 text-center">Thu</div><div class="p-2 text-center">Fri</div><div class="p-2 text-center">Sat</div>
          </div>
          <div class="grid grid-cols-7">
            <div class="grid content-start gap-1 p-1.5 min-h-24 border-b border-line border-r" data-cal-cell :data-blank="cell.blank" :data-today="cell.isToday" x-for="cell in calCells()">
              <a class="font-semibold text-xs hover:text-ink transition-colors" data-cal-day x-show="!cell.blank" :href="cell.scheduleUrl" data-stx-link title="Schedule a post on this day">{{ cell.day }}</a>
              <a class="flex gap-1 items-center px-1 py-0.5 text-body text-xs bg-panel-2 hover:bg-panel-2 rounded transition-colors" x-for="chip in cell.chips.slice(0, 3)" :href="chip.href" data-stx-link>
                <span class="shrink-0 h-1.5 w-1.5 rounded-full" data-cal-dot :data-status="chip.status"></span>
                <span class="truncate">{{ chip.time }} {{ chip.label }}</span>
              </a>
              <span class="px-1 text-muted text-xs" x-show="cell.chips.length > 3" :text="`+${cell.chips.length - 3} more`"></span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </section>


  <script client>
    import { showPostlineToast } from '../functions/postline-toast'
    import { fetchWorkspace, targetLabel } from '../functions/social-client'

    /**
     * Wire shapes for `/api/postline/queue/*`, declared where they are used.
     *
     * These describe what the BROWSER receives, which is a flattened projection
     * of `app/Support/Social/types.ts` — deliberately separate, because the wire
     * shape and the server shape are free to diverge. Local to this block on
     * purpose: nothing outside this view refers to them, and a shared ambient
     * `.d.ts` would be an unenforced second source of truth for one file's
     * internals.
     */
    interface QueueApiTarget {
      provider: string
      /** The account's handle, when the target names one. */
      handle?: string | null
      status?: string
      failureReason?: string | null
      remoteUri?: string | null
      nextAttemptAt?: string | null
    }

    interface QueueApiItem {
      id: number
      status: string
      body: string
      title?: string | null
      createdAt?: string | null
      scheduledAt?: string | null
      publishedAt?: string | null
      hasImage?: boolean
      hasLink?: boolean
      partial?: boolean
      thread?: { position: number, length: number, resumeFrom: number | null } | null
      providers: QueueApiTarget[]
    }

    /** A queue entry flattened to exactly what one row renders. */
    interface QueueRow {
      id: number
      status: string
      body: string
      when: string
      /** One chip per network the post went to, or will go to. */
      targets: Array<{ label: string, state: 'sent' | 'failed' | 'waiting', title: string }>
      /** "image · link card · thread · post 2 of 3", or ''. */
      meta: string
      /** Failed outright or on some networks: the "Needs attention" tab. */
      attention: boolean
      failure: string
      liveUrl: string
      editUrl: string
      actionable: boolean
      /** Went out on some networks and failed on others. */
      partial: boolean
      /** "Resume thread from 3", for a thread that stopped part way; '' otherwise. */
      resumeLabel: string
      statusLabel: string
      pill: string
      scheduledAt?: string | null
      publishedAt?: string | null
      title?: string | null
    }

    /** Toast copy for a queue action's success branch. */
    interface QueueActionCopy {
      title: string
      message: string
    }

    const ACTIONABLE = new Set(['draft', 'scheduled', 'failed'])

    const items = state([])
    const loadError = state('')
    const loaded = state(false)
    const searchText = state('')
    const activeSearch = state('')
    const queueRequest = state(0)
    /** The cursor for the next page of older posts; 0 when there are none. */
    const nextCursor = state(0)
    const loadingMore = state(false)
    const busyId = state(0)
    // The workspace's time zone, which every schedule is set in. The calendar
    // groups posts by the day it is there, not on this browser's clock, so a
    // laptop travelling with its owner shows the same calendar (#106).
    // Undefined until loaded: Intl then uses the browser's zone.
    const zone = state<string | undefined>(undefined)

    /** A moment's calendar date in the workspace zone, as YYYY-MM-DD. */
    function dayKey(date: Date): string {
      return new Intl.DateTimeFormat('en-CA', { timeZone: zone(), year: 'numeric', month: '2-digit', day: '2-digit' }).format(date)
    }

    function monthOf(date: Date): { year: number, month: number } {
      const [year, month] = dayKey(date).split('-').map(Number)
      return { year, month: month - 1 }
    }

    const calMonth = state(monthOf(new Date()))

    // A fresh key, not the legacy 'postline.queue.view': useLocalStorage
    // JSON.parses whatever is already stored, and the old value was a bare
    // string ("list"), which would throw and take the whole script down.
    const view = useLocalStorage('postline.queue.view.v2', 'list')

    // Server timestamps are UTC "YYYY-MM-DD HH:MM:SS" — render in local time.
    const parseUtc = (value: string | null | undefined): Date | null => {
      if (!value) return null
      const date = new Date(`${String(value).replace(' ', 'T')}Z`)
      return Number.isNaN(date.getTime()) ? null : date
    }

    const formatTime = (value: string | null | undefined): string => {
      const date = parseUtc(value)
      if (!date) return value || ''
      return date.toLocaleString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: zone() })
    }


    /**
     * A row's channels. A network appears once per account, so when one post
     * goes to two accounts on the same network each is named by its handle —
     * "Bluesky, Bluesky" would not say which went where.
     */
    const channelLabels = (targets: QueueApiTarget[]): string[] => targets.map((target) => {
      const shared = targets.filter(other => other.provider === target.provider).length > 1
      return shared && target.handle
        ? targetLabel(target.provider, target.handle)
        : providerLabel(target.provider)
    })

    const liveUrlFor = (uri: string | null | undefined): string => {
      const value = String(uri || '')
      if (value.startsWith('/')) return value
      // A stored permalink (Mastodon, and any provider persisting a URL) is
      // already linkable as-is.
      if (/^https?:\/\//i.test(value)) return value
      const match = value.match(/^at:\/\/([^/]+)\/app\.bsky\.feed\.post\/(.+)$/)
      return match ? `https://bsky.app/profile/${encodeURIComponent(match[1])}/post/${encodeURIComponent(match[2])}` : ''
    }

    /**
     * What failed, per network. One network's reason on its own reads as if
     * the whole post failed, which is wrong for a post that went out
     * elsewhere.
     */
    /** " Trying again at 14:05." when Postline will resend the network itself. */
    const retryNote = (target: QueueApiTarget): string => {
      if (!target.nextAttemptAt) return ''
      const at = new Date(target.nextAttemptAt)
      if (Number.isNaN(at.getTime())) return ''
      return ` Trying again at ${at.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}.`
    }

    const failureText = (item: QueueApiItem): string => {
      const failed = item.providers.filter(target => target.status === 'failed' || target.failureReason)
      if (failed.length === 0) return ''
      const lines = failed.map(target => `${channelLabels([target])[0] || target.provider}: ${target.failureReason || 'failed'}${retryNote(target)}`)
      return item.partial ? `Sent to the others. ${lines.join(' ')}` : lines.join(' ')
    }

    /** Held back because it was due while Postline was not running. Nothing was sent. */
    const isMissed = (item: QueueApiItem): boolean => item.status === 'failed'
      && item.providers.length > 0
      && item.providers.every(target => String(target.failureReason || '').startsWith('Missed:'))

    /** Flatten an API item into exactly what a row renders. */
    const toRow = (item: QueueApiItem): QueueRow => {
      const when = item.status === 'scheduled'
        ? `Scheduled · ${formatTime(item.scheduledAt)}`
        : item.status === 'published'
          ? `Published · ${formatTime(item.publishedAt || item.createdAt)}`
          : item.status === 'draft'
            ? `Draft · saved ${formatTime(item.createdAt)}`
            : `${item.status[0].toUpperCase()}${item.status.slice(1)} · ${formatTime(item.createdAt)}`
      const extras = [item.hasImage ? 'image' : '', item.hasLink ? 'link card' : ''].filter(Boolean).join(' · ')
      const thread = item.thread ? `thread · post ${item.thread.position} of ${item.thread.length}` : ''
      const labels = channelLabels(item.providers)
      const targets = item.providers.map((target, index) => {
        const failed = target.status === 'failed' || Boolean(target.failureReason)
        const sent = !failed && (target.status === 'published' || Boolean(target.remoteUri))
        const label = labels[index] || target.provider
        return {
          label,
          state: failed ? 'failed' as const : sent ? 'sent' as const : 'waiting' as const,
          title: failed ? `${label}: ${target.failureReason || 'failed'}${retryNote(target)}` : sent ? `Sent to ${label}` : `Not sent to ${label} yet`,
        }
      })
      return {
        id: item.id,
        status: item.status,
        body: item.body,
        when,
        targets,
        meta: [extras, thread].filter(Boolean).join(' · '),
        attention: item.status === 'failed' || Boolean(item.partial),
        failure: failureText(item),
        liveUrl: liveUrlFor(item.providers.find(target => target.remoteUri)?.remoteUri),
        editUrl: `/composer?edit=${item.id}`,
        actionable: ACTIONABLE.has(item.status),
        partial: Boolean(item.partial),
        resumeLabel: item.thread?.resumeFrom ? `Resume thread from ${item.thread.resumeFrom}` : '',
        // A post that reached only some networks is not simply "published".
        // It borrows the amber of an unfinished publish.
        statusLabel: item.partial ? 'partly sent' : isMissed(item) ? 'missed' : item.status,
        pill: item.partial || isMissed(item) ? 'publishing' : item.status,
        scheduledAt: item.scheduledAt,
        publishedAt: item.publishedAt,
        title: item.title,
      }
    }

    const rows = derived(() => items().map(toRow))

    function closeActionsOnEscape(event) {
      const details = event.currentTarget
      if (event.key !== 'Escape' || !details.open) return
      event.stopPropagation()
      details.open = false
      details.firstElementChild?.focus()
    }

    // One list, four tabs (#168). A post that failed anywhere is under "Needs
    // attention" and nowhere else, so it cannot hide among the published.
    type QueueTab = 'scheduled' | 'drafts' | 'published' | 'attention'
    const tab = useLocalStorage('postline.queue.tab', 'scheduled')
    const setTab = (next: QueueTab) => tab.set(next)

    function moveTab(event, id: QueueTab) {
      const entries = tabs()
      const index = entries.findIndex(entry => entry.id === id)
      const positions = { ArrowLeft: index - 1, ArrowRight: index + 1, Home: 0, End: entries.length - 1 }
      if (!Object.hasOwn(positions, event.key)) return
      event.preventDefault()
      const next = (positions[event.key] + entries.length) % entries.length
      const button = event.currentTarget.parentElement.children[next]
      setTab(entries[next].id)
      button.focus()
    }
    const inTab = (row: QueueRow, which: string): boolean => {
      if (which === 'attention') return row.attention
      if (row.attention) return false
      if (which === 'drafts') return row.status === 'draft'
      if (which === 'published') return row.status === 'published'
      return row.status === 'scheduled' || row.status === 'publishing'
    }
    const tabs = derived(() => {
      const count = (which: string) => rows().filter(row => inTab(row, which)).length
      return [
        { id: 'scheduled', label: 'Scheduled', count: count('scheduled'), tone: '' },
        { id: 'drafts', label: 'Drafts', count: count('drafts'), tone: '' },
        { id: 'published', label: 'Published', count: count('published'), tone: '' },
        { id: 'attention', label: 'Needs attention', count: count('attention'), tone: count('attention') ? 'danger' : '' },
      ]
    })
    const visible = derived(() => activeSearch() ? rows() : rows().filter(row => inTab(row, tab())))
    const showEmpty = derived(() => loaded() && !loadError() && visible().length === 0)
    const emptyText = derived(() => activeSearch() ? 'No posts match your search.' : ({
      scheduled: 'Nothing scheduled. Pick a time in the composer and the post waits here.',
      drafts: 'No drafts. Save one from the composer to finish it later.',
      published: 'Nothing published yet.',
      attention: 'Nothing needs attention. A post that fails on any network shows up here.',
    } as Record<string, string>)[tab()] || '')

    const metaText = derived(() => {
      if (!loaded()) return 'Loading…'
      if (loadError()) return 'Could not load'
      const n = visible().length
      return `${n} ${activeSearch() ? 'matching ' : ''}post${n === 1 ? '' : 's'}${activeSearch() && nextCursor() ? ' shown' : ''}`
    })

    const calTitle = derived(() =>
      new Date(Date.UTC(calMonth().year, calMonth().month, 1)).toLocaleDateString(undefined, { month: 'long', year: 'numeric', timeZone: 'UTC' }))

    /**
     * The month grid as plain data. Derived rather than painted, so changing
     * month or reloading the queue rebuilds it with no manual repaint call.
     */
    const agendaDateFormat = new Intl.DateTimeFormat(undefined, { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' })

    const calDays = derived(() => {
      const { year, month } = calMonth()
      const byDay = new Map()
      for (const row of rows()) {
        const date = parseUtc(row.scheduledAt || row.publishedAt)
        if (!date) continue
        const key = dayKey(date)
        if (!byDay.has(key)) byDay.set(key, [])
        byDay.get(key).push({ row, date })
      }

      const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate()
      const todayKey = dayKey(new Date())
      return Array.from({ length: daysInMonth }, (_, index) => {
        const day = index + 1
        const key = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`
        const dayItems = (byDay.get(key) || []).sort((a, b) => a.date - b.date)
        return {
          blank: false,
          day,
          key,
          label: agendaDateFormat.format(new Date(Date.UTC(year, month, day))),
          isToday: key === todayKey,
          scheduleUrl: `/composer?schedule=${key}`,
          chips: dayItems.map(({ row, date }) => ({
            status: row.status,
            href: row.actionable ? row.editUrl : row.liveUrl || row.editUrl,
            time: date.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit', timeZone: zone() }),
            label: (row.title || row.body || '').trim().slice(0, 160) || 'Post',
          })),
        }
      })
    })

    const calCells = derived(() => {
      // The grid itself is plain calendar arithmetic, the same in every zone.
      const { year, month } = calMonth()
      const startOffset = new Date(Date.UTC(year, month, 1)).getUTCDay()
      const emptyCell = { blank: true, chips: [] }
      const cells = [...Array.from({ length: startOffset }, () => emptyCell), ...calDays()]
      while (cells.length % 7 !== 0) cells.push(emptyCell)
      return cells
    })

    const setView = next => view.set(next === 'calendar' ? 'calendar' : 'list')
    const shiftMonth = (by: number) => {
      const at = new Date(Date.UTC(calMonth().year, calMonth().month + by, 1))
      calMonth.set({ year: at.getUTCFullYear(), month: at.getUTCMonth() })
    }
    const prevMonth = () => shiftMonth(-1)
    const nextMonth = () => shiftMonth(1)
    const goToday = () => calMonth.set(monthOf(new Date()))

    const loadZone = async () => {
      try {
        const workspace = await fetchWorkspace()
        const timezone = workspace?.timezone
        if (typeof timezone === 'string' && timezone) {
          zone.set(timezone)
          calMonth.set(monthOf(new Date()))
        }
      }
      catch {
        // The browser's own zone stays in use; the queue still works.
      }
    }

    async function fetchQueuePage(parameters: Record<string, string>) {
      const query = new URLSearchParams(parameters)
      if (activeSearch()) query.set('q', activeSearch())
      const response = await fetch(`/api/postline/queue?${query}`)
      const payload = await response.json()
      if (!response.ok || !payload.ok) throw new Error(payload.error || 'Could not load posts.')
      return payload.data
    }

    const refresh = async () => {
      const request = queueRequest() + 1
      queueRequest.set(request)
      loadingMore.set(false)
      try {
        // Reload as many rows as are on screen, so a refresh after an action
        // does not throw away the older pages the owner had loaded.
        const page = await fetchQueuePage({ limit: String(Math.max(50, items().length)) })
        if (request !== queueRequest()) return
        items.set(page.items || [])
        nextCursor.set(page.nextCursor || 0)
        loadError.set('')
      }
      catch (error) {
        // Degrade to the inline error state; no toast on load/refresh so a
        // failing fetch (e.g. an expired session) can't spam or stack.
        if (request !== queueRequest()) return
        items.set([])
        nextCursor.set(0)
        loadError.set(error instanceof Error ? error.message : String(error))
        console.warn('[postline] queue load failed:', error)
      }
      finally {
        if (request === queueRequest()) loaded.set(true)
      }
    }

    function searchPosts() {
      const term = searchText().trim()
      if (activeSearch() !== term) {
        activeSearch.set(term)
        loaded.set(false)
        loadError.set('')
        items.set([])
        nextCursor.set(0)
      }
      void refresh()
    }

    function clearSearch() {
      searchText.set('')
      searchPosts()
    }

    // --- Scheduler: say so when it is not running ---
    // A stopped scheduler fails nothing: posts just stay scheduled. The
    // heartbeat of the every-minute publish job is the only sign.
    const schedulerStatus = state({ state: 'ok', lastRunAt: null })
    const publishingPaused = state(false)
    const schedulerWarning = derived(() => {
      if (publishingPaused()) return 'Scheduled publishing is paused: nothing goes out on its own until you resume it in Settings or from the menu bar.'
      const status = schedulerStatus()
      if (status.state === 'ok') return ''
      if (status.state === 'never') return 'Scheduled posts are not going out: the scheduler has not run yet. Start it with ./buddy schedule:run.'
      const at = new Date(String(status.lastRunAt))
      const when = Number.isNaN(at.getTime()) ? '' : ` since ${at.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' })}`
      return `Scheduled posts are not going out: the scheduler has not run${when}.`
    })
    /** How many alerts are unread: a failed post, a missed one, a refused sign-in. */
    const unreadAlerts = state(0)
    const attentionText = derived(() => {
      const count = unreadAlerts()
      if (!count) return ''
      return `${count} thing${count === 1 ? ' needs' : 's need'} your attention. See what happened.`
    })
    const refreshAlerts = async () => {
      try {
        const response = await fetch('/api/postline/alerts')
        const payload = await response.json()
        if (response.ok && payload.ok) unreadAlerts.set(Number(payload.data.unread) || 0)
      }
      catch {
        // Unknown is not worth an error on a page that otherwise loaded.
      }
    }

    const refreshScheduler = async () => {
      try {
        const response = await fetch('/api/postline/system')
        const payload = await response.json()
        if (response.ok && payload.ok) {
          schedulerStatus.set(payload.data.scheduler)
          publishingPaused.set(Boolean(payload.data.paused))
        }
      }
      catch {
        // Unknown is not the same as stopped: say nothing rather than alarm.
      }
    }

    const loadMore = async () => {
      if (!nextCursor() || loadingMore()) return
      const request = queueRequest()
      loadingMore.set(true)
      try {
        const page = await fetchQueuePage({ before: String(nextCursor()) })
        if (request !== queueRequest()) return
        items.set([...items(), ...(page.items || [])])
        nextCursor.set(page.nextCursor || 0)
        loadError.set('')
      }
      catch (error) {
        if (request === queueRequest()) loadError.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        if (request === queueRequest()) loadingMore.set(false)
      }
    }

    const post = async (path: string, id: number): Promise<unknown> => {
      const form = new FormData()
      form.set('id', String(id))
      const response = await fetch(path, { method: 'POST', body: form })
      const payload = await response.json()
      if (!response.ok || !payload.ok) throw new Error(payload.error || 'Request failed.')
      return payload.data
    }

    const runAction = async (id: number, path: string, success: QueueActionCopy, failure: string): Promise<void> => {
      busyId.set(id)
      try {
        await post(path, id)
        showPostlineToast({ title: success.title, message: success.message, tone: 'success' })
      }
      catch (error) {
        showPostlineToast({
          title: failure,
          message: error instanceof Error ? error.message : String(error),
          tone: 'error',
        })
      }
      finally {
        busyId.set(0)
      }
      await refresh()
    }

    const publishItem = (id: number): void => void runAction(
      id,
      '/api/postline/queue/publish-now',
      { title: 'Published', message: 'Post published.' },
      'Publish failed',
    )

    const retryItem = (id: number): void => void runAction(
      id,
      '/api/postline/queue/publish-now',
      { title: 'Retried', message: 'The failed networks were sent again.' },
      'Retry failed',
    )

    // A thread that stopped part way carries on from that segment, as replies
    // to the last one that went out (#100). The same endpoint as retry: the
    // server sees the post is a thread segment and resumes the thread.
    const resumeItem = (id: number): void => void runAction(
      id,
      '/api/postline/queue/publish-now',
      { title: 'Thread resumed', message: 'The rest of the thread was sent from where it stopped.' },
      'Resume failed',
    )

    const deleteItem = async (id: number): Promise<void> => {
      if (!await stxConfirm('This cannot be undone.', { title: 'Delete this post?', type: 'error', confirmText: 'Delete post' })) return
      await runAction(
        id,
        '/api/postline/queue/delete',
        { title: 'Removed', message: 'Post removed from the queue.' },
        'Delete failed',
      )
    }

    onMount(() => {
      void loadZone()
      void refresh()
      void refreshScheduler()
      void refreshAlerts()
    })
  </script>
@endsection
