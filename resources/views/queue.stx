@extends('layouts/app')

<script server cache>
import { workspaceLocale, workspaceQueueText, workspaceText } from '../../app/Support/Localization/workspace'

export const queueLocale = workspaceLocale
export const queueText = workspaceQueueText
export const queueDescription = workspaceText('workspace.pages.queue.description')
export const queueActivity = workspaceText('workspace.navigation.activity')
export const queueAlertSize = workspaceText('workspace.queue.alertCount', { count: 999999 })
export const queueClient = { locale: workspaceLocale, messages: workspaceQueueText, activity: queueActivity }
</script>

@section('title')Postline - {{ queueText.tablist }}@endsection

@section('content')
  @meta('description', 'Review scheduled and drafted social posts in Postline.')
  <section class="grid gap-5" data-postline-page="queue" data-testid="queue-page" lang="{{ queueLocale }}">
    <WorkspacePageHeader titleKey="workspace.pages.queue.title">
      <div class="flex flex-wrap gap-2 items-center">
        <SegmentedControl label="{{ queueText.view }}" size="sm" :show="!activeSearch()" :value="view()" :options="queueViews()" @change="setView" />
        <a href="/composer" data-stx-link class="inline-flex gap-2 items-center justify-center px-4 h-9 font-semibold text-on-accent text-sm bg-accent hover:bg-accent-hover rounded-xl transition-colors">
          <span class="h-4 w-4 i-hugeicons-plus-sign" aria-hidden="true"></span>
          <span>{{ queueText.newPost }}</span>
        </a>
      </div>
    </WorkspacePageHeader>

    {{-- Keep notice rows the same height when their requests settle. The
         sizing text wraps with the same width and language as the notices. --}}
    <div class="grid gap-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,16rem)]">
      <div class="grid px-3 py-2 text-ui border rounded-xl" :class="schedulerWarning() ? 'text-warning bg-warning-soft border-warning-line' : 'text-muted bg-panel border-line'">
        <span class="invisible col-start-1 row-start-1" aria-hidden="true">{{ queueText.paused }}</span>
        <span class="invisible col-start-1 row-start-1" aria-hidden="true">{{ queueText.schedulerNever }}</span>
        <span class="col-start-1 row-start-1" :class="{ 'invisible': schedulerWarning() }">{{ queueDescription }}</span>
        <p class="hidden col-start-1 row-start-1 m-0" :class="{ 'hidden': !schedulerWarning() }" :text="schedulerWarning()" role="status" data-scheduler-warning></p>
      </div>
      <a class="grid px-3 py-2 text-ui hover:underline border rounded-xl" :class="attentionText() ? 'text-warning bg-warning-soft border-warning-line' : 'text-muted bg-panel border-line'" href="/activity" data-stx-link data-attention-link>
        <span class="invisible col-start-1 row-start-1" aria-hidden="true">{{ queueAlertSize }}</span>
        <span class="col-start-1 row-start-1" :text="attentionText() || activityLabel">{{ queueActivity }}</span>
      </a>
    </div>

    <PostingSlotsPanel />
    <DraftFeedsPanel @drafts-created="refresh()" />
    <RecurringPostsPanel :source="repeatSelection()" :timeZone="zone()" @closed="repeatSelection.set(null)" />

    <form class="flex flex-wrap gap-2 items-center" role="search" aria-label="{{ queueText.posts }}" @submit.prevent="searchPosts">
      <label class="sr-only" for="queue-search">{{ queueText.searchField }}</label>
      <input class="px-3 h-9 w-full sm:max-w-xs text-ink text-ui bg-panel border border-field-line rounded-lg" id="queue-search" type="search" placeholder="{{ queueText.searchPlaceholder }}" maxlength="200" x-model="searchText">
      <button class="px-3 h-9 font-semibold text-on-accent text-ui bg-accent hover:bg-accent-hover rounded-lg" type="submit">{{ queueText.search }}</button>
      <button class="px-3 h-9 font-medium text-muted text-ui hover:text-ink rounded-lg" type="button" x-show="activeSearch()" @click="clearSearch">{{ queueText.clearSearch }}</button>
    </form>

    {{-- x-cloak on both views: neither paints before the stored choice is
        read, so a queue left on Calendar no longer flashes the list first. --}}
    <section class="bg-panel border border-line rounded-2xl shadow-sm" x-cloak x-show="activeSearch() || view() === 'list'">
      <header class="flex flex-wrap gap-3 items-center justify-between p-2.5 border-b border-line">
        <div class="flex flex-wrap gap-1" role="tablist" aria-label="{{ queueText.tablist }}" x-show="!activeSearch()">
          <button class="inline-flex gap-1.5 items-center px-3 h-8 font-semibold text-xs rounded-lg transition-colors" type="button" role="tab" x-for="entry in tabs()" :id="'queue-tab-' + entry.id" aria-controls="queue-results" :aria-selected="tab() === entry.id" :tabindex="tab() === entry.id ? 0 : -1" :data-active="tab() === entry.id" :data-tone="entry.tone" data-queue-tab @click="setTab(entry.id)" @keydown="moveTab($event, entry.id)">
            <span :text="entry.label"></span>
            <span class="px-1.5 min-w-8 tabular-nums text-center text-xs rounded-full" data-queue-tab-count :text="entry.count"></span>
          </button>
        </div>
        <h2 class="m-0 px-1 font-semibold text-ui" x-show="activeSearch()">{{ queueText.searchResults }}</h2>
        <div class="flex gap-2 items-center">
          <span class="pr-1 min-w-24 text-muted text-xs" aria-live="polite" :text="metaText()">{{ queueText.loading }}</span>
          <button class="px-2.5 h-8 font-semibold text-ink text-xs bg-panel hover:bg-hover border border-line rounded-lg disabled:opacity-50" type="button" :class="{ 'invisible': !hasSelectableRows() && !selectionOpen() }" :aria-pressed="selectionOpen()" :disabled="queueChanging() || (!hasSelectableRows() && !selectionOpen())" @click="toggleSelection">
            {{ queueText.selectPosts }}
          </button>
        </div>
      </header>
      <div class="flex flex-wrap gap-2 items-end p-3 border-b border-line" x-show="selectionOpen()">
        <span class="self-center font-semibold text-muted text-xs" role="status" :text="queueWords.t('selectedCount', { count: selectedPosts().length })"></span>
        <button class="px-3 h-9 font-semibold text-on-accent text-ui bg-accent hover:bg-accent-hover rounded-lg disabled:opacity-50" type="button" x-show="hasScheduledRows()" :disabled="!canReschedule() || queueChanging()" @click="rescheduleSelection({ days: 7 })">
          {{ queueText.moveWeek }}
        </button>
        <form class="flex flex-wrap gap-2 items-end" x-show="hasScheduledRows()" @submit.prevent="rescheduleSelection({ date: rescheduleDate() })">
          <PostlineDatePicker :value="rescheduleDate" :timeZone="zone" @change="selectRescheduleDate" />
          <button class="px-3 h-9 font-semibold text-ink text-ui bg-panel hover:bg-hover border border-line rounded-lg disabled:opacity-50" type="submit" :disabled="!canReschedule() || !rescheduleDate() || queueChanging()">
            {{ queueText.moveDate }}
          </button>
        </form>
        <button class="px-3 h-9 font-semibold text-danger text-ui bg-panel hover:bg-danger-soft border border-danger-line rounded-lg disabled:opacity-50" type="button" :disabled="!selectedPosts().length || queueChanging()" @click="deleteSelected">
          {{ queueText.deleteSelected }}
        </button>
        <button class="px-3 h-9 font-semibold text-muted text-ui hover:text-ink rounded-lg disabled:opacity-50" type="button" :disabled="!selectedPosts().length || queueChanging()" @click="clearSelection">
          {{ queueText.clearSelection }}
        </button>
      </div>
      <div class="grid gap-2.5 p-3" id="queue-results" :role="activeSearch() ? 'region' : 'tabpanel'" :aria-label="activeSearch() ? queueCopy.matchingPosts : null" :aria-labelledby="activeSearch() ? null : 'queue-tab-' + tab()">
        <WorkspaceListSkeleton :show="!loaded() && !loadError()" label="{{ queueText.loadingPosts }}" />
        <ErrorState retryLabel="{{ queueText.retry }}" busyLabel="{{ queueText.retrying }}" :show="loadError()" title="{{ queueText.couldNotLoadPosts }}" :message="loadError()" :busy="readingQueue()" @retry="refresh()" />
        <EmptyState :show="showEmpty()" variant="bare" :title="emptyQueue().title" :description="emptyQueue().description">
          <StxLink class="text-info text-ui underline" to="/composer" :show="!activeSearch() && tab() !== 'attention'">{{ queueText.writePost }}</StxLink>
          <button class="text-info text-ui underline" type="button" :show="activeSearch()" @click="clearSearch">{{ queueText.clearSearch }}</button>
        </EmptyState>
        <article class="grid gap-2.5 p-3.5 bg-panel border border-line rounded-2xl group" x-for="row in visible()" :data-command-context="row.body">
          <header class="flex gap-3 items-start justify-between">
            <div class="grid gap-1.5 min-w-0">
              <div class="flex gap-2 items-center">
                <input class="shrink-0 h-4 w-4 accent-accent disabled:opacity-50 cursor-pointer" type="checkbox" x-show="selectionOpen() && row.actionable" :checked="isSelected(row.id)" :disabled="queueChanging() || (selectedPosts().length >= MAX_QUEUE_SELECTION && !isSelected(row.id))" :aria-label="queueWords.t('selectPost', { post: (row.title || row.body).slice(0, 80), when: row.when })" @change="selectPost(row)">
                <span class="font-semibold text-xs">{{ row.when }}</span>
              </div>
              {{-- One chip per network: sent, failed (the reason on hover and
                  below), or still to go. --}}
              <div class="flex flex-wrap gap-1.5 items-center">
                <span class="inline-flex gap-1 items-center px-2 py-0.5 text-xs border rounded-full" x-for="target in row.targets" data-target-chip :data-state="target.state" :title="target.title">
                  <span class="h-1.5 w-1.5 rounded-full" data-target-dot aria-hidden="true"></span>
                  <span :text="target.label"></span>
                </span>
                <span class="text-muted text-xs" x-show="row.meta" :text="row.meta"></span>
              </div>
            </div>
            <Badge size="sm" className="whitespace-nowrap" :variant="postStatusVariant(row.statusLabel)">{{ row.statusName }}</Badge>
          </header>
          <p class="m-0 leading-normal text-body text-ui">{{ row.body }}</p>
          <p class="m-0 text-danger text-xs" x-show="row.failure" :text="row.failure"></p>
          <div class="flex flex-wrap gap-2 items-center justify-between text-xs" x-for="comment in row.comments" :key="comment.targetId" :class="comment.needsAttention ? 'text-danger' : 'text-muted'">
            <span :text="comment.message"></span>
            <a class="text-info underline" x-show="comment.url" :href="comment.url" target="_blank" rel="noopener noreferrer">{{ queueText.checkComments }}</a>
            <span x-show="comment.canRetry">
              <Button variant="secondary" size="xs" :disabled="Boolean(commentBusy())" :loading="commentBusy() === comment.targetId" @click="retryFirstComment(comment.targetId)">{{ queueText.retryComment }}</Button>
            </span>
          </div>
          <footer class="flex flex-wrap gap-1.5 items-center justify-end" x-show="row.liveUrl || row.actionable || row.partial || row.resumeLabel || row.canRepeat">
            <div class="group-focus-within:opacity-100 group-hover:opacity-100 transition-opacity" :class="row.attention ? '' : 'pointer-fine:opacity-0'">
              <a class="inline-flex items-center justify-center px-2.5 h-7 font-semibold text-ink text-xs bg-panel hover:bg-hover border border-line rounded-lg shadow-sm transition-colors" x-show="row.liveUrl && !row.actionable && !row.partial && !row.resumeLabel" :href="row.liveUrl" target="_blank" rel="noopener noreferrer">{{ queueText.viewPost }}</a>
              <span x-show="row.resumeLabel && row.retryable">
                <Button variant="secondary" size="xs" :loading="busyId() === row.id" :label="row.resumeLabel" @click="resumeItem(row.id)" />
              </span>
              <span x-show="row.xBrowserReview">
                <Button variant="secondary" size="xs" :loading="busyId() === row.id" @click="reviewXBrowser(row, false)">{{ queueText.findOnX }}</Button>
                <Button variant="secondary" size="xs" :disabled="busyId() === row.id" @click="reviewXBrowser(row, true)">{{ queueText.linkOpenX }}</Button>
              </span>
              <span x-show="row.partial && !row.resumeLabel && row.retryable">
                <Button variant="secondary" size="xs" :loading="busyId() === row.id" @click="retryItem(row.id)">{{ queueText.retryNetworks }}</Button>
              </span>
              <span x-show="row.actionable && row.targets.length && !row.partial && !row.resumeLabel && row.retryable">
                <Button variant="ghost" size="xs" :loading="busyId() === row.id" :label="row.status === 'failed' ? queueCopy.tryAgain : queueCopy.publishNow" @click="publishItem(row.id)" />
              </span>
              <a class="inline-flex items-center justify-center px-2.5 h-7 font-semibold text-info text-xs" x-show="row.actionable && !row.targets.length" :href="row.editUrl" data-stx-link>{{ queueText.chooseChannels }}</a>
            </div>
            <details class="relative" x-show="row.actionable || row.canRepeat || (row.liveUrl && (row.partial || row.resumeLabel))" @keydown="closeActionsOnEscape($event)">
              <summary class="grid place-items-center h-7 w-8 list-none text-muted bg-panel hover:bg-hover border border-line rounded-lg cursor-pointer" aria-label="{{ queueText.moreActions }}" title="{{ queueText.moreActions }}">
                <span class="h-4 w-4 i-hugeicons-more-horizontal" aria-hidden="true"></span>
              </summary>
              <div class="grid absolute right-0 top-full z-10 gap-0.5 mt-1 p-1 min-w-28 text-ui bg-panel border border-line rounded-lg shadow-sm">
                <a class="block px-2 py-1 text-ink hover:bg-hover rounded-md" x-show="row.liveUrl" :href="row.liveUrl" target="_blank" rel="noopener noreferrer">{{ queueText.viewPost }}</a>
                <a class="block px-2 py-1 text-ink hover:bg-hover rounded-md" x-show="row.actionable" :href="row.editUrl" data-stx-link>{{ queueText.edit }}</a>
                <button class="px-2 py-1 text-left hover:bg-hover rounded-md" type="button" x-show="row.canRepeat" @click="chooseRepeat(row, $event)">{{ queueText.repeat }}</button>
                <button class="px-2 py-1 text-danger text-left hover:bg-danger-soft rounded-md disabled:opacity-50" type="button" x-show="row.actionable" :disabled="queueChanging() || busyId() === row.id" @click="deleteItem(row.id)">{{ queueText.deleteAction }}</button>
              </div>
            </details>
          </footer>
        </article>
      </div>
      {{-- The list is paged; this fetches the page of older posts. --}}
      <div class="flex justify-center p-3" x-show="(activeSearch() || tab() === 'published') && nextCursor()">
        <button class="inline-flex items-center justify-center px-3 h-8 font-medium text-ink text-ui bg-panel hover:bg-hover border border-line rounded-lg shadow-sm disabled:opacity-50 transition-colors" type="button" :disabled="loadingMore()" @click="loadMore" :text="loadingMore() ? queueCopy.loading : (activeSearch() ? queueCopy.moreResults : queueCopy.olderPosts)">{{ queueText.olderPosts }}</button>
      </div>
    </section>

    <section aria-label="{{ queueText.calendarRegion }}" x-cloak x-show="!activeSearch() && view() === 'calendar'">
      <Card padding="none" className="shadow-sm">
        <header class="flex flex-wrap gap-3 items-center justify-between p-3.5 border-b border-line">
          <div class="flex gap-2 items-center">
            <button class="inline-flex items-center justify-center h-8 w-8 text-muted bg-panel hover:bg-hover border border-line rounded-lg shadow-sm transition-colors" type="button" :aria-label="calendarPeriod() === 'week' ? queueCopy.previousWeek : queueCopy.previousMonth" @click="shiftCalendar(-1)">
              <span class="h-4 w-4 i-hugeicons-arrow-left-02" aria-hidden="true"></span>
            </button>
            <button class="inline-flex items-center justify-center px-3 h-8 font-semibold text-ink text-xs bg-panel hover:bg-hover border border-line rounded-lg shadow-sm transition-colors" type="button" @click="goToday">{{ queueText.today }}</button>
            <button class="inline-flex items-center justify-center h-8 w-8 text-muted bg-panel hover:bg-hover border border-line rounded-lg shadow-sm transition-colors" type="button" :aria-label="calendarPeriod() === 'week' ? queueCopy.nextWeek : queueCopy.nextMonth" @click="shiftCalendar(1)">
              <span class="h-4 w-4 i-hugeicons-arrow-right-02" aria-hidden="true"></span>
            </button>
          </div>
          <strong class="text-ui" aria-live="polite" :text="calTitle()">{{ queueText.calendar }}</strong>
          <SegmentedControl label="{{ queueText.calendarPeriod }}" size="sm" v-model:value="calendarPeriod" :options="[{ value: 'month', label: queueCopy.month }, { value: 'week', label: queueCopy.week }]" />
        </header>
        <WorkspaceListSkeleton :show="calendarBusy()" label="{{ queueText.loadingCalendar }}" />
        <ErrorState retryLabel="{{ queueText.retry }}" busyLabel="{{ queueText.retrying }}" :show="calendarError() && !calendarBusy()" title="{{ queueText.couldNotLoadCalendar }}" :message="calendarError()" @retry="loadCalendar()" />
        <div class="sm:hidden divide-line divide-y" :aria-label="calendarPeriod() === 'week' ? queueCopy.weeklyAgenda : queueCopy.monthlyAgenda" role="list">
          <article class="grid gap-2 px-3 py-2" role="listitem" x-for="day in calDays()" :key="day.key">
            <header class="flex gap-3 items-center justify-between">
              <time class="font-semibold text-ui" :datetime="day.key" :aria-current="day.isToday ? 'date' : null" :text="day.label"></time>
              <a class="grid place-items-center shrink-0 h-11 w-11 text-ink bg-panel-2 hover:bg-raised rounded-xl" :href="day.scheduleUrl" :aria-label="queueWords.t('scheduleOn', { day: day.label })" data-stx-link>
                <span class="h-4 w-4 i-hugeicons-plus-sign" aria-hidden="true"></span>
              </a>
            </header>
            <div class="grid gap-1" x-show="day.chips.length">
              <a class="grid gap-1 p-2.5 min-w-0 text-body text-ui bg-panel-2 hover:bg-raised rounded-xl" x-for="chip in day.chips" :href="chip.href" data-stx-link>
                <span class="flex gap-2 items-center font-semibold text-xs">
                  <span class="h-1.5 w-1.5 rounded-full" data-cal-dot :data-status="chip.status" aria-hidden="true"></span>
                  <span :text="chip.time"></span>
                </span>
                <span class="min-w-0 break-words" :text="chip.label"></span>
              </a>
            </div>
          </article>
        </div>
        <div class="hidden sm:block overflow-x-auto">
          <div class="min-w-[560px]">
            <div class="grid grid-cols-7 font-semibold text-muted text-xs border-b border-line">
              <div class="p-2 text-center">{{ queueText.sun }}</div><div class="p-2 text-center">{{ queueText.mon }}</div><div class="p-2 text-center">{{ queueText.tue }}</div><div class="p-2 text-center">{{ queueText.wed }}</div><div class="p-2 text-center">{{ queueText.thu }}</div><div class="p-2 text-center">{{ queueText.fri }}</div><div class="p-2 text-center">{{ queueText.sat }}</div>
            </div>
            <div class="grid grid-cols-7">
              <div class="grid content-start gap-1 p-1.5 min-h-24 border-b border-line border-r data-[drop-target=true]:ring-2 data-[drop-target=true]:ring-focus data-[drop-target=true]:ring-inset" data-cal-cell :data-blank="cell.blank" :data-today="cell.isToday" :data-calendar-date="cell.blank ? null : cell.key" :data-drop-target="!cell.blank && dropDay() === cell.key" x-for="cell in calCells()" :key="cell.key" @dragover="allowCalendarDrop($event, cell)" @drop="dropOnCalendar($event, cell)">
                <a class="font-semibold text-xs hover:text-ink transition-colors" data-cal-day x-show="!cell.blank" :href="cell.scheduleUrl" data-stx-link title="{{ queueText.scheduleThisDay }}">{{ cell.day }}</a>
                <a class="flex gap-1 items-center px-1 py-0.5 text-body text-xs bg-panel-2 hover:bg-panel-2 rounded transition-colors" x-for="chip in cell.chips" :key="chip.id" :href="chip.href" :draggable="chip.schedule ? 'true' : 'false'" @dragstart="startCalendarDrag($event, chip.schedule)" @dragend="endCalendarDrag" data-stx-link>
                  <span class="shrink-0 h-1.5 w-1.5 rounded-full" data-cal-dot :data-status="chip.status" aria-hidden="true"></span>
                  <span class="truncate">{{ chip.time }} {{ chip.label }}</span>
                </a>
                <button class="px-1 text-left text-muted text-xs hover:text-ink" type="button" x-show="cell.more" :text="queueWords.t('moreOnDay', { count: cell.more })" :aria-label="queueWords.t('showAllOn', { day: cell.label })" @click="showCalendarWeek(cell.key)"></button>
              </div>
            </div>
          </div>
        </div>
      </Card>
    </section>
  </section>


  <script client>
    import type { QueueRemovalReceipt } from '../../app/Services/Social/QueueService'
    import type { ScheduledSelection, ScheduleDestination } from '../../app/Support/Social/rescheduling'
    import { MAX_QUEUE_SELECTION } from '../../app/Support/Social/rescheduling'
    import { createI18n } from '@stacksjs/i18n/client'
    import { systemTimeZone } from '../../app/Support/time'
    import { requestJson } from '../functions/postline-client'
    import { showNotification } from '../functions/notification'
    import { fetchWorkspace, targetLabel } from '../functions/social-client'
    import { postStatusVariant } from '../functions/status-badge'
    import { openXBrowser, readXBrowserSession, withXBrowserProfile, xBrowserWindow } from '../functions/x-browser-session'

    const { locale: language, messages: queueCopy, activity: activityLabel } = {{ queueClient }}
    const queueWords = createI18n({ locale: language, messages: { [language]: queueCopy } })
    const dateLocale = language === 'en' ? undefined : language
    const native = useNativeDesktop()
    const xBrowser = state<ReturnType<typeof xBrowserWindow>>(null)
    native.onReady(host => xBrowser.set(xBrowserWindow(host)))

    /**
     * Wire shapes for `/api/postline/queue/*`, declared where they are used.
     *
     * These describe what the BROWSER receives, which is a flattened projection
     * of `app/Support/Social/types.ts` — deliberately separate, because the wire
     * shape and the server shape are free to diverge. Local to this block on
     * purpose: nothing outside this view refers to them, and a shared ambient
     * `.d.ts` would be an unenforced second source of truth for one file's
     * internals.
     */
    interface QueueApiTarget {
      provider: string
      /** The account's handle, when the target names one. */
      handle?: string | null
      status?: string
      failureReason?: string | null
      remoteUri?: string | null
      remoteUrl?: string | null
      nextAttemptAt?: string | null
      xBrowserReview?: number
      firstComment?: { targetId: number, status: 'pending' | 'sending' | 'sent' | 'failed' | 'uncertain', error: string | null }
    }

    interface QueueApiItem {
      id: number
      status: string
      body: string
      title?: string | null
      createdAt?: string | null
      scheduledAt?: string | null
      publishedAt?: string | null
      hasImage?: boolean
      hasVideo?: boolean
      hasLink?: boolean
      partial?: boolean
      thread?: { position: number, length: number, resumeFrom: number | null } | null
      providers: QueueApiTarget[]
    }

    /** A queue entry flattened to exactly what one row renders. */
    interface QueueRow {
      id: number
      status: string
      body: string
      when: string
      /** One chip per network the post went to, or will go to. */
      targets: Array<{ label: string, state: 'sent' | 'failed' | 'waiting', title: string }>
      /** "image · link card · thread · post 2 of 3", or ''. */
      meta: string
      /** Failed outright or on some networks: the "Needs attention" tab. */
      attention: boolean
      comments: Array<{ targetId: number, message: string, needsAttention: boolean, canRetry: boolean, url: string }>
      failure: string
      liveUrl: string
      editUrl: string
      actionable: boolean
      retryable: boolean
      xBrowserReview: { id: number, handle: string } | null
      canRepeat: boolean
      hasImages: boolean
      /** Went out on some networks and failed on others. */
      partial: boolean
      /** "Resume thread from 3", for a thread that stopped part way; '' otherwise. */
      resumeLabel: string
      statusLabel: string
      statusName: string
      scheduledAt?: string | null
      publishedAt?: string | null
      title?: string | null
    }

    /** Toast copy for a queue action's success branch. */
    interface QueueActionCopy {
      title: string
      message: string
    }

    const ACTIONABLE = new Set(['draft', 'scheduled', 'failed'])
    const repeatSelection = state<{ id: number, title?: string | null, hasImages: boolean } | null>(null)

    function chooseRepeat(row: QueueRow, event: Event) {
      const menu = (event.currentTarget as HTMLElement).closest('details')
      if (menu) {
        menu.open = false
        menu.querySelector('summary')?.focus()
      }
      repeatSelection.set({ id: row.id, title: row.title, hasImages: row.hasImages })
    }

    const items = state([])
    const loadError = state('')
    const loaded = state(false)
    const readingQueue = state(false)
    const searchText = state('')
    const activeSearch = state('')
    const queueRequest = state(0)
    /** The cursor for the next page of older posts; 0 when there are none. */
    const nextCursor = state(0)
    const loadingMore = state(false)
    const busyId = state(0)
    const commentBusy = state(0)
    const selectionOpen = state(false)
    const selectedPosts = state<{ id: number, scheduledAt: string | null }[]>([])
    const canReschedule = derived(() => selectedPosts().length > 0 && selectedPosts().every(post => post.scheduledAt !== null))
    const queueChanging = state(false)
    const rescheduleDate = state('')
    const selectRescheduleDate = ({ value }: { value: string }) => rescheduleDate.set(value)
    // The workspace's time zone, which every schedule is set in. The calendar
    // groups posts by the day it is there, not on this browser's clock, so a
    // laptop travelling with its owner shows the same calendar (#106).
    // The browser's own zone is used until the workspace is available.
    const zone = state(systemTimeZone())
    const zoneReady = state(false)

    /** A moment's calendar date in the workspace zone, as YYYY-MM-DD. */
    function dayKey(date: Date): string {
      return new Intl.DateTimeFormat('en-CA', { timeZone: zone(), year: 'numeric', month: '2-digit', day: '2-digit' }).format(date)
    }

    const calAnchor = state(dayKey(new Date()))
    const calendarPeriod = useLocalStorage('postline.queue.calendar-period', 'month')
    const fullCalendar = useMediaQuery('(min-width: 640px)')
    const queueViews = derived(() => [
      { value: 'list', label: queueCopy.list },
      { value: 'calendar', label: fullCalendar() ? queueCopy.calendar : queueCopy.agenda },
    ])
    const calendarItems = state<QueueApiItem[]>([])
    const calendarBusy = state(false)
    const calendarError = state('')
    const draggedPost = state<ScheduledSelection | null>(null)
    const dropDay = state('')
    let calendarRequest: AbortController | undefined

    // A fresh key, not the legacy 'postline.queue.view': useLocalStorage
    // JSON.parses whatever is already stored, and the old value was a bare
    // string ("list"), which would throw and take the whole script down.
    const view = useLocalStorage('postline.queue.view.v2', 'list')

    // Server timestamps are UTC "YYYY-MM-DD HH:MM:SS" — render in local time.
    const parseUtc = (value: string | null | undefined): Date | null => {
      if (!value) return null
      const date = new Date(`${String(value).replace(' ', 'T')}Z`)
      return Number.isNaN(date.getTime()) ? null : date
    }

    const formatTime = (value: string | null | undefined): string => {
      const date = parseUtc(value)
      if (!date) return value || ''
      return date.toLocaleString(dateLocale, { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: zone() })
    }


    /**
     * A row's channels. A network appears once per account, so when one post
     * goes to two accounts on the same network each is named by its handle —
     * "Bluesky, Bluesky" would not say which went where.
     */
    const channelLabels = (targets: QueueApiTarget[]): string[] => targets.map((target) => {
      const shared = targets.filter(other => other.provider === target.provider).length > 1
      return shared && target.handle
        ? targetLabel(target.provider, target.handle)
        : providerLabel(target.provider)
    })

    const liveUrlFor = (uri: string | null | undefined): string => {
      const value = String(uri || '')
      if (value.startsWith('/')) return value
      // A stored permalink (Mastodon, and any provider persisting a URL) is
      // already linkable as-is.
      if (/^https?:\/\//i.test(value)) return value
      const match = value.match(/^at:\/\/([^/]+)\/app\.bsky\.feed\.post\/(.+)$/)
      return match ? `https://bsky.app/profile/${encodeURIComponent(match[1])}/post/${encodeURIComponent(match[2])}` : ''
    }

    /**
     * What failed, per network. One network's reason on its own reads as if
     * the whole post failed, which is wrong for a post that went out
     * elsewhere.
     */
    /** " Trying again at 14:05." when Postline will resend the network itself. */
    const retryNote = (target: QueueApiTarget): string => {
      if (!target.nextAttemptAt) return ''
      const at = new Date(target.nextAttemptAt)
      if (Number.isNaN(at.getTime())) return ''
      return queueWords.t('retryAt', { time: at.toLocaleTimeString(dateLocale, { hour: '2-digit', minute: '2-digit' }) })
    }

    const failureText = (item: QueueApiItem): string => {
      const failed = item.providers.filter(target => target.status === 'failed' || target.failureReason)
      if (failed.length === 0) return ''
      const lines = failed.map(target => `${channelLabels([target])[0] || target.provider}: ${target.failureReason || queueCopy.failed}${retryNote(target)}`)
      return item.partial ? queueWords.t('sentToOthers', { errors: lines.join(' ') }) : lines.join(' ')
    }

    /** Held back because it was due while Postline was not running. Nothing was sent. */
    const isMissed = (item: QueueApiItem): boolean => item.status === 'failed'
      && item.providers.length > 0
      && item.providers.every(target => String(target.failureReason || '').startsWith('Missed:'))

    /** Flatten an API item into exactly what a row renders. */
    const toRow = (item: QueueApiItem): QueueRow => {
      const at = item.status === 'scheduled' ? item.scheduledAt
        : item.status === 'published' ? item.publishedAt || item.createdAt
          : item.createdAt
      const time = formatTime(at)
      const status = queueCopy.statuses[item.status] || item.status
      const when = item.status === 'draft' ? queueWords.t('draftWhen', { time }) : `${status} · ${time}`
      const extras = [item.hasImage ? queueCopy.image : '', item.hasVideo ? queueCopy.video : '', item.hasLink ? queueCopy.linkCard : ''].filter(Boolean).join(' · ')
      const thread = item.thread ? queueWords.t('threadPosition', item.thread) : ''
      const labels = channelLabels(item.providers)
      const targets = item.providers.map((target, index) => {
        const failed = target.status === 'failed' || Boolean(target.failureReason)
        const sent = !failed && (target.status === 'published' || Boolean(target.remoteUri))
        const label = labels[index] || target.provider
        return {
          label,
          state: failed ? 'failed' as const : sent ? 'sent' as const : 'waiting' as const,
          title: failed ? `${label}: ${target.failureReason || queueCopy.failed}${retryNote(target)}` : sent ? queueWords.t('sentTo', { network: label }) : queueWords.t('waitingFor', { network: label }),
        }
      })
      const comments = item.providers.flatMap(({ firstComment, remoteUrl }, index) => {
        if (!firstComment) return []
        const { targetId, status, error } = firstComment
        const canRetry = status === 'failed'
        const needsAttention = canRetry || status === 'uncertain'
        const detail = error || (status === 'sent' ? queueCopy.sent : queueCopy.waitingToSend)
        const url = status === 'uncertain' ? liveUrlFor(remoteUrl) : ''
        return [{ targetId, message: queueWords.t('firstComment', { network: targets[index].label, detail }), needsAttention, canRetry, url }]
      })
      const review = item.providers.find(target => target.xBrowserReview && target.handle)
      const statusLabel = item.partial ? 'partly sent' : isMissed(item) ? 'missed' : item.status
      return {
        id: item.id,
        status: item.status,
        body: item.body,
        when,
        targets,
        meta: [extras, thread].filter(Boolean).join(' · '),
        attention: item.status === 'failed' || Boolean(item.partial) || comments.some(comment => comment.needsAttention),
        comments,
        failure: failureText(item),
        liveUrl: item.providers.map(target => liveUrlFor(target.remoteUrl || target.remoteUri)).find(Boolean) || '',
        editUrl: `/composer?edit=${item.id}`,
        actionable: ACTIONABLE.has(item.status),
        retryable: !review || item.providers.some(target => target.status === 'failed' && !target.xBrowserReview),
        xBrowserReview: review && xBrowser() ? { id: review.xBrowserReview!, handle: review.handle! } : null,
        canRepeat: targets.length > 0 && (ACTIONABLE.has(item.status) || item.status === 'published'),
        hasImages: Boolean(item.hasImage || item.hasVideo || item.thread),
        partial: Boolean(item.partial),
        resumeLabel: item.thread?.resumeFrom ? queueWords.t('resumeFrom', { position: item.thread.resumeFrom }) : '',
        // A post that reached only some networks is not simply "published".
        // It borrows the amber of an unfinished publish.
        statusLabel,
        statusName: language === 'en' ? statusLabel : queueCopy.statuses[statusLabel] || statusLabel,
        scheduledAt: item.scheduledAt,
        publishedAt: item.publishedAt,
        title: item.title,
      }
    }

    const rows = derived(() => items().map(toRow))

    function closeActionsOnEscape(event) {
      const details = event.currentTarget
      if (event.key !== 'Escape' || !details.open) return
      event.stopPropagation()
      details.open = false
      details.firstElementChild?.focus()
    }

    // One list, four tabs (#168). A post that failed anywhere is under "Needs
    // attention" and nowhere else, so it cannot hide among the published.
    type QueueTab = 'scheduled' | 'drafts' | 'published' | 'attention'
    const tab = useLocalStorage('postline.queue.tab', 'scheduled')
    const setTab = (next: QueueTab) => {
      if (next !== tab()) closeSelection()
      tab.set(next)
    }

    function moveTab(event, id: QueueTab) {
      const entries = tabs()
      const index = entries.findIndex(entry => entry.id === id)
      const positions = { ArrowLeft: index - 1, ArrowRight: index + 1, Home: 0, End: entries.length - 1 }
      if (!Object.hasOwn(positions, event.key)) return
      event.preventDefault()
      const next = (positions[event.key] + entries.length) % entries.length
      const button = event.currentTarget.parentElement.children[next]
      setTab(entries[next].id)
      button.focus()
    }
    const inTab = (row: QueueRow, which: string): boolean => {
      if (which === 'attention') return row.attention
      if (row.attention) return false
      if (which === 'drafts') return row.status === 'draft'
      if (which === 'published') return row.status === 'published'
      return row.status === 'scheduled' || row.status === 'publishing'
    }
    const tabs = derived(() => {
      const count = (which: string) => rows().filter(row => inTab(row, which)).length
      return [
        { id: 'scheduled', label: queueCopy.scheduledTab, count: count('scheduled'), tone: '' },
        { id: 'drafts', label: queueCopy.draftsTab, count: count('drafts'), tone: '' },
        { id: 'published', label: queueCopy.publishedTab, count: count('published'), tone: '' },
        { id: 'attention', label: queueCopy.attentionTab, count: count('attention'), tone: count('attention') ? 'danger' : '' },
      ]
    })
    const visible = derived(() => activeSearch() ? rows() : rows().filter(row => inTab(row, tab())))
    const showEmpty = derived(() => loaded() && !loadError() && visible().length === 0)
    const emptyQueue = derived(() => activeSearch()
      ? { title: queueCopy.noMatches, description: queueCopy.noMatchesDescription }
      : ({
          scheduled: { title: queueCopy.noScheduled, description: queueCopy.noScheduledDescription },
          drafts: { title: queueCopy.noDrafts, description: queueCopy.noDraftsDescription },
          published: { title: queueCopy.noPublished, description: queueCopy.noPublishedDescription },
          attention: { title: queueCopy.noAttention, description: queueCopy.noAttentionDescription },
        })[tab()])

    const metaText = derived(() => {
      if (!loaded()) return queueCopy.loading
      if (loadError()) return queueCopy.couldNotLoad
      const count = visible().length
      const name = activeSearch() ? (nextCursor() ? 'shownCount' : 'matchingCount') : 'postCount'
      return queueWords.tc(name, count, { count })
    })

    const utcDate = (day: string): Date => new Date(`${day}T00:00:00Z`)
    const utcKey = (date: Date): string => date.toISOString().slice(0, 10)
    function calendarDay(date: Date, shift: number): Date {
      const next = new Date(date.getTime())
      next.setUTCDate(next.getUTCDate() + shift)
      return next
    }

    const calRange = derived(() => {
      const anchor = utcDate(calAnchor())
      if (calendarPeriod() === 'week') return { start: calendarDay(anchor, -anchor.getUTCDay()), days: 7 }
      const year = anchor.getUTCFullYear()
      const month = anchor.getUTCMonth()
      return { start: new Date(Date.UTC(year, month, 1)), days: new Date(Date.UTC(year, month + 1, 0)).getUTCDate() }
    })
    const agendaDateFormat = new Intl.DateTimeFormat(dateLocale, { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' })
    const weekDateFormat = new Intl.DateTimeFormat(dateLocale, { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    const calTitle = derived(() => {
      const { start, days } = calRange()
      if (calendarPeriod() === 'week') return weekDateFormat.formatRange(start, calendarDay(start, days - 1))
      return start.toLocaleDateString(dateLocale, { month: 'long', year: 'numeric', timeZone: 'UTC' })
    })

    const calDays = derived(() => {
      const { start, days } = calRange()
      const byDay = new Map<string, Array<{ row: QueueRow, date: Date }>>()
      for (const item of calendarItems()) {
        const row = toRow(item)
        const date = parseUtc(row.scheduledAt || row.publishedAt)
        if (!date) continue
        const key = dayKey(date)
        const posts = byDay.get(key) ?? []
        posts.push({ row, date })
        byDay.set(key, posts)
      }

      const todayKey = dayKey(new Date())
      return Array.from({ length: days }, (_, index) => {
        const at = calendarDay(start, index)
        const key = utcKey(at)
        const dayItems = (byDay.get(key) ?? []).sort((a, b) => a.date.getTime() - b.date.getTime())
        return {
          blank: false,
          day: at.getUTCDate(),
          key,
          label: agendaDateFormat.format(at),
          isToday: key === todayKey,
          scheduleUrl: `/composer?schedule=${key}`,
          chips: dayItems.map(({ row, date }) => ({
            id: row.id,
            status: row.status,
            href: row.actionable ? row.editUrl : row.liveUrl || row.editUrl,
            time: date.toLocaleTimeString(dateLocale, { hour: 'numeric', minute: '2-digit', timeZone: zone() }),
            label: (row.title || row.body || '').trim().slice(0, 160) || queueCopy.post,
            schedule: row.status === 'scheduled' && row.scheduledAt ? { id: row.id, scheduledAt: row.scheduledAt } : null,
          })),
        }
      })
    })

    const calCells = derived(() => {
      const days = calDays()
      if (calendarPeriod() === 'week') return days
      const startOffset = calRange().start.getUTCDay()
      const emptyCell = (index: number) => ({ key: `blank-${index}`, blank: true, chips: [], more: 0 })
      const cells = [
        ...Array.from({ length: startOffset }, (_, index) => emptyCell(index)),
        ...days.map(day => ({ ...day, chips: day.chips.slice(0, 3), more: Math.max(0, day.chips.length - 3) })),
      ]
      while (cells.length % 7 !== 0) cells.push(emptyCell(cells.length))
      return cells
    })

    const setView = (next: 'calendar' | 'list') => {
      if (next !== view()) closeSelection()
      view.set(next)
    }

    function shiftCalendar(by: number) {
      const { start } = calRange()
      const next = calendarPeriod() === 'week'
        ? calendarDay(start, by * 7)
        : new Date(Date.UTC(start.getUTCFullYear(), start.getUTCMonth() + by, 1))
      calAnchor.set(utcKey(next))
    }

    const goToday = () => calAnchor.set(dayKey(new Date()))

    function showCalendarWeek(day: string) {
      calAnchor.set(day)
      calendarPeriod.set('week')
    }

    async function loadCalendar() {
      calendarRequest?.abort()
      const controller = new AbortController()
      calendarRequest = controller
      const { signal } = controller
      const { start, days } = calRange()
      const query = new URLSearchParams({ calendar_from: utcKey(start), calendar_to: utcKey(calendarDay(start, days)), limit: '200' })
      const posts: QueueApiItem[] = []
      calendarBusy.set(true)
      calendarError.set('')
      calendarItems.set([])
      try {
        let before: number | null
        do {
          const { data } = await requestJson(`/api/postline/queue?${query}`, { signal, cache: 'no-store' }, queueCopy.calendarRequestError)
          posts.push(...data.items)
          before = data.nextCursor
          if (before) query.set('before', String(before))
        } while (before && !signal.aborted)
        if (!signal.aborted) calendarItems.set(posts)
      }
      catch (error) {
        if (!signal.aborted) calendarError.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        if (!signal.aborted) calendarBusy.set(false)
      }
    }

    effect(() => {
      if (zoneReady() && view() === 'calendar' && !activeSearch()) void loadCalendar()
      else calendarRequest?.abort()
    })
    onDestroy(() => calendarRequest?.abort())

    const loadZone = async () => {
      try {
        const workspace = await fetchWorkspace()
        const timezone = workspace?.timezone
        if (typeof timezone === 'string' && timezone) {
          zone.set(timezone)
          goToday()
        }
      }
      catch {
        // The browser's own zone stays in use if the workspace is unavailable.
      }
      finally {
        zoneReady.set(true)
      }
    }

    function startCalendarDrag(event: DragEvent, post: ScheduledSelection | null) {
      if (!post || !event.dataTransfer || queueChanging()) {
        event.preventDefault()
        return
      }
      draggedPost.set(post)
      event.dataTransfer.effectAllowed = 'move'
      event.dataTransfer.setData('application/x-postline-queue', String(post.id))
    }

    function endCalendarDrag() {
      draggedPost.set(null)
      dropDay.set('')
    }

    function allowCalendarDrop(event: DragEvent, cell: { key: string, blank: boolean }) {
      if (!draggedPost()) return
      if (cell.blank || cell.key < dayKey(new Date())) {
        dropDay.set('')
        return
      }
      event.preventDefault()
      if (event.dataTransfer) event.dataTransfer.dropEffect = 'move'
      dropDay.set(cell.key)
    }

    function dropOnCalendar(event: DragEvent, cell: { key: string, blank: boolean }) {
      const post = draggedPost()
      if (!post) return
      endCalendarDrag()
      event.preventDefault()
      if (cell.blank || cell.key < dayKey(new Date()) || event.dataTransfer?.getData('application/x-postline-queue') !== String(post.id)) return
      const original = parseUtc(post.scheduledAt)
      if (original && dayKey(original) === cell.key) return
      void reschedulePosts([post], { date: cell.key })
    }

    async function fetchQueuePage(parameters: Record<string, string>) {
      const query = new URLSearchParams(parameters)
      if (activeSearch()) query.set('q', activeSearch())
      const response = await fetch(`/api/postline/queue?${query}`)
      const payload = await response.json()
      if (!response.ok || !payload.ok) throw new Error(payload.error || queueCopy.queueRequestError)
      return payload.data
    }

    const refresh = async (includeUndo = false) => {
      const request = queueRequest() + 1
      queueRequest.set(request)
      readingQueue.set(true)
      loadingMore.set(false)
      try {
        // Reload as many rows as are on screen, so a refresh after an action
        // does not throw away the older pages the owner had loaded.
        const page = await fetchQueuePage({
          limit: String(Math.max(50, items().length)),
          ...(includeUndo ? { include_undo: '1' } : {}),
        })
        if (request !== queueRequest()) return
        items.set(page.items || [])
        if (includeUndo) for (const removal of page.removals ?? []) showRemoval(removal)
        nextCursor.set(page.nextCursor || 0)
        loadError.set('')
      }
      catch (error) {
        // Degrade to the inline error state; no toast on load/refresh so a
        // failing fetch (e.g. an expired session) can't spam or stack.
        if (request !== queueRequest()) return
        items.set([])
        nextCursor.set(0)
        loadError.set(error instanceof Error ? error.message : String(error))
        console.warn('[postline] queue load failed:', error)
      }
      finally {
        if (request === queueRequest()) {
          readingQueue.set(false)
          loaded.set(true)
        }
      }
    }

    function searchPosts() {
      const term = searchText().trim()
      if (activeSearch() !== term) {
        closeSelection()
        activeSearch.set(term)
        loaded.set(false)
        loadError.set('')
        items.set([])
        nextCursor.set(0)
      }
      void refresh()
    }

    function clearSearch() {
      searchText.set('')
      searchPosts()
    }

    // --- Scheduler: say so when it is not running ---
    // A stopped scheduler fails nothing: posts just stay scheduled. The
    // heartbeat of the every-minute publish job is the only sign.
    const schedulerStatus = state({ state: 'ok', lastRunAt: null })
    const publishingPaused = state(false)
    const schedulerWarning = derived(() => {
      if (publishingPaused()) return queueCopy.paused
      const status = schedulerStatus()
      if (status.state === 'ok') return ''
      if (status.state === 'never') return queueCopy.schedulerNever
      const at = new Date(String(status.lastRunAt))
      if (Number.isNaN(at.getTime())) return queueCopy.schedulerStopped
      const time = at.toLocaleString(dateLocale, { dateStyle: 'medium', timeStyle: 'short' })
      return queueWords.t('schedulerStoppedSince', { time })
    })
    /** How many alerts are unread: a failed post, a missed one, a refused sign-in. */
    const unreadAlerts = state(0)
    const attentionText = derived(() => {
      const count = unreadAlerts()
      if (!count) return ''
      return queueWords.tc('alertCount', count, { count })
    })
    const refreshAlerts = async () => {
      try {
        const response = await fetch('/api/postline/alerts')
        const payload = await response.json()
        if (response.ok && payload.ok) unreadAlerts.set(Number(payload.data.unread) || 0)
      }
      catch {
        // Unknown is not worth an error on a page that otherwise loaded.
      }
    }

    const refreshScheduler = async () => {
      try {
        const response = await fetch('/api/postline/system')
        const payload = await response.json()
        if (response.ok && payload.ok) {
          schedulerStatus.set(payload.data.scheduler)
          publishingPaused.set(Boolean(payload.data.paused))
        }
      }
      catch {
        // Unknown is not the same as stopped: say nothing rather than alarm.
      }
    }

    const loadMore = async () => {
      if (!nextCursor() || loadingMore()) return
      const request = queueRequest()
      loadingMore.set(true)
      try {
        const page = await fetchQueuePage({ before: String(nextCursor()) })
        if (request !== queueRequest()) return
        items.set([...items(), ...(page.items || [])])
        nextCursor.set(page.nextCursor || 0)
        loadError.set('')
      }
      catch (error) {
        if (request === queueRequest()) loadError.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        if (request === queueRequest()) loadingMore.set(false)
      }
    }

    const post = async (path: string, id: number, field = 'id'): Promise<unknown> => {
      const form = new FormData()
      form.set(field, String(id))
      const response = await fetch(path, { method: 'POST', body: form })
      const payload = await response.json()
      if (!response.ok || !payload.ok) throw new Error(payload.error || queueCopy.requestFailed)
      return payload.data
    }

    const hasSelectableRows = derived(() => visible().some(row => row.actionable))
    const hasScheduledRows = derived(() => visible().some(row => row.status === 'scheduled' && row.scheduledAt))
    const isSelected = (id: number): boolean => selectedPosts().some(post => post.id === id)
    const clearSelection = () => selectedPosts.set([])

    function closeSelection() {
      selectionOpen.set(false)
      clearSelection()
      rescheduleDate.set('')
    }

    function toggleSelection() {
      selectionOpen.set(!selectionOpen())
      if (!selectionOpen()) clearSelection()
    }

    function selectPost(row: QueueRow) {
      if (queueChanging() || !row.actionable) return
      if (isSelected(row.id)) selectedPosts.set(selectedPosts().filter(post => post.id !== row.id))
      else if (selectedPosts().length < MAX_QUEUE_SELECTION) {
        const scheduledAt = row.status === 'scheduled' ? row.scheduledAt ?? null : null
        selectedPosts.set([...selectedPosts(), { id: row.id, scheduledAt }])
      }
    }

    function rescheduleSelection(destination: ScheduleDestination) {
      if (!canReschedule()) return
      void reschedulePosts(selectedPosts().filter((post): post is ScheduledSelection => post.scheduledAt !== null), destination)
    }

    async function reschedulePosts(posts: readonly ScheduledSelection[], destination: ScheduleDestination) {
      if (!posts.length || queueChanging()) return
      queueChanging.set(true)
      try {
        const { data } = await requestJson('/api/postline/queue/reschedule', { method: 'POST', body: JSON.stringify({ posts, ...destination }) })
        clearSelection()
        rescheduleDate.set('')
        showNotification({
          title: queueCopy.scheduleUpdated,
          message: queueWords.tc('movedCount', data.count, { count: data.count }),
          tone: 'success',
        })
      }
      catch (error) {
        showNotification({ title: queueCopy.couldNotMove, message: error instanceof Error ? error.message : String(error), tone: 'error' })
      }
      finally {
        await refresh()
        if (view() === 'calendar' && !activeSearch()) await loadCalendar()
        const current = new Map(items().filter(item => item.status === 'scheduled').map(item => [item.id, item.scheduledAt]))
        selectedPosts.set(selectedPosts().filter(post => current.get(post.id) === post.scheduledAt))
        queueChanging.set(false)
      }
    }

    const runAction = async (id: number, path: string, success: QueueActionCopy, failure: string): Promise<void> => {
      busyId.set(id)
      try {
        await post(path, id)
        showNotification({ title: success.title, message: success.message, tone: 'success' })
      }
      catch (error) {
        showNotification({
          title: failure,
          message: error instanceof Error ? error.message : String(error),
          tone: 'error',
        })
      }
      finally {
        busyId.set(0)
      }
      await refresh()
    }

    const publishItem = (id: number): void => void runAction(
      id,
      '/api/postline/queue/publish-now',
      { title: queueCopy.published, message: queueCopy.postPublished },
      queueCopy.publishFailed,
    )

    async function reviewXBrowser(row: QueueRow, confirmPost: boolean) {
      const browser = xBrowser()
      const target = row.xBrowserReview
      if (!browser || !target || busyId()) return
      busyId.set(row.id)
      try {
        const found = await withXBrowserProfile(async () => {
          const { data: session } = await requestJson('/api/postline/twitter/browser-session')
          if (session.needsCheck || session.handle?.toLowerCase() !== target.handle.toLowerCase())
            throw new Error(queueCopy.checkXSignIn)
          const profile = session.profile
          if (!confirmPost) {
            const url = 'https://x.com/' + encodeURIComponent(target.handle)
            const current = await readXBrowserSession(browser, profile)
            await openXBrowser(browser, profile, url)
            if (current.state === 'unavailable') return null
            if (current.state !== 'connected' || current.handle.toLowerCase() !== target.handle.toLowerCase())
              throw new Error(queueCopy.checkXSignIn)
            await browser._call('loadURL', { url }, profile)
            return null
          }
          const current = await readXBrowserSession(browser, profile, 'post')
          if (current.state !== 'connected' || current.handle.toLowerCase() !== target.handle.toLowerCase()
            || current.posts?.length !== 1) throw new Error(queueCopy.openMatchingXPost)
          return current.posts[0]
        })
        if (!found) {
          showNotification({ title: queueCopy.findOnX, message: queueCopy.openMatchingXPost, tone: 'success' })
          return
        }
        if (!await stxConfirm(queueCopy.confirmXMatch, { title: queueCopy.linkOpenX, confirmText: queueCopy.linkXPost, cancelText: queueCopy.cancel })) return
        await requestJson('/api/postline/queue/link-x-browser-post', {
          method: 'POST', body: JSON.stringify({ target_id: target.id, post: found }),
        })
        showNotification({ title: queueCopy.xPostLinked, tone: 'success' })
        await refresh()
      }
      catch (error) {
        showNotification({ title: queueCopy.couldNotLinkX, message: error instanceof Error ? error.message : String(error), tone: 'error' })
      }
      finally {
        busyId.set(0)
      }
    }

    async function retryFirstComment(id: number): Promise<void> {
      if (commentBusy()) return
      commentBusy.set(id)
      try {
        const result = await post('/api/postline/queue/first-comment/retry', id, 'target_id') as { status: string, error?: string }
        if (result.status === 'sent') {
          showNotification({ title: queueCopy.commentSent, message: queueCopy.commentAdded, tone: 'success' })
        }
        else {
          showNotification({ title: queueCopy.commentNeedsAttention, message: result.error, tone: 'error' })
        }
      }
      catch (error) {
        showNotification({ title: queueCopy.couldNotRetryComment, message: error instanceof Error ? error.message : String(error), tone: 'error' })
      }
      finally {
        await refresh()
        commentBusy.set(0)
      }
    }

    const retryItem = (id: number): void => void runAction(
      id,
      '/api/postline/queue/publish-now',
      { title: queueCopy.retried, message: queueCopy.retriedNetworks },
      queueCopy.retryFailed,
    )

    // A thread that stopped part way carries on from that segment, as replies
    // to the last one that went out (#100). The same endpoint as retry: the
    // server sees the post is a thread segment and resumes the thread.
    const resumeItem = (id: number): void => void runAction(
      id,
      '/api/postline/queue/publish-now',
      { title: queueCopy.threadResumed, message: queueCopy.threadSent },
      queueCopy.resumeFailed,
    )

    function showRemoval(receipt: QueueRemovalReceipt) {
      const durationMs = Date.parse(receipt.expiresAt) - Date.now()
      if (!(durationMs > 0)) return
      showNotification({
        title: queueCopy.removed,
        message: queueWords.tc('removedCount', receipt.count, { count: receipt.count }),
        tone: 'success',
        id: `queue-removal-${receipt.token}`,
        durationMs,
        dedupeMs: 0,
        action: { label: queueCopy.undo, run: () => void undoRemoval(receipt.token) },
      })
    }

    async function undoRemoval(token: string) {
      try {
        const { data } = await requestJson('/api/postline/queue/undo-delete', { method: 'POST', body: JSON.stringify({ token }) })
        showNotification({ title: queueCopy.restored, message: queueWords.tc('restoredCount', data.count, { count: data.count }), tone: 'success' })
      }
      catch (error) {
        showNotification({ title: queueCopy.undoFailed, message: error instanceof Error ? error.message : String(error), tone: 'error' })
      }
      await refresh()
      if (view() === 'calendar' && !activeSearch()) await loadCalendar()
    }

    async function deletePosts(ids: number[]) {
      if (!ids.length || queueChanging()) return
      queueChanging.set(true)
      try {
        const { data } = await requestJson('/api/postline/queue/delete', { method: 'POST', body: JSON.stringify({ ids }) })
        selectedPosts.set(selectedPosts().filter(post => !ids.includes(post.id)))
        showRemoval(data)
      }
      catch (error) {
        showNotification({ title: queueCopy.deleteFailed, message: error instanceof Error ? error.message : String(error), tone: 'error' })
      }
      finally {
        await refresh()
        queueChanging.set(false)
      }
    }

    async function deleteSelected() {
      const ids = selectedPosts().map(post => post.id)
      if (!ids.length || queueChanging()) return
      if (ids.length === 1) return deleteItem(ids[0]!)
      if (!await stxConfirm(queueCopy.undoHint, { title: queueWords.t('confirmDeleteMultiple', { count: ids.length }), type: 'error', confirmText: queueCopy.deletePosts, cancelText: queueCopy.cancel })) return
      await deletePosts(ids)
    }

    async function deleteItem(id: number) {
      if (queueChanging()) return
      if (!await stxConfirm(queueCopy.undoHint, { title: queueCopy.confirmDeleteOne, type: 'error', confirmText: queueCopy.deletePost, cancelText: queueCopy.cancel })) return
      await deletePosts([id])
    }

    onMount(() => {
      void loadZone()
      void refresh(true)
      void refreshScheduler()
      void refreshAlerts()
    })
  </script>
@endsection
