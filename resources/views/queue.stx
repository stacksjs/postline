@extends('layouts/postline')

@section('title', 'Postline - Queue')

@section('content')
  @meta('description', 'Review scheduled and drafted social posts in Postline.')
  <section class="grid gap-5" data-postline-page="queue" data-testid="queue-page">
    <header class="flex flex-wrap gap-4 items-center justify-between min-h-11">
      <div>
        <p class="mb-1.5 font-bold text-[11px] text-muted tracking-wider uppercase">Queue</p>
        <h1 class="m-0 font-bold text-[22px] text-ink tracking-normal">Scheduled posts</h1>
        <p class="mb-0 mt-1.5 text-[13px] text-muted">What's drafted, scheduled, and recently published.</p>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <div class="grid grid-cols-2 p-0.5 bg-panel-3 border border-line rounded-xl" role="group" aria-label="Queue view">
          <button class="inline-flex gap-1.5 items-center justify-center px-3 py-1.5 font-bold text-xs rounded-lg transition-colors" type="button" data-view-toggle :data-active="view() === 'list'" @click="setView('list')">
            <span class="h-3.5 w-3.5 i-hugeicons-menu-01" aria-hidden="true"></span><span>List</span>
          </button>
          <button class="inline-flex gap-1.5 items-center justify-center px-3 py-1.5 font-bold text-xs rounded-lg transition-colors" type="button" data-view-toggle :data-active="view() === 'calendar'" @click="setView('calendar')">
            <span class="h-3.5 w-3.5 i-hugeicons-calendar-03" aria-hidden="true"></span><span>Calendar</span>
          </button>
        </div>
        <a href="/" data-stx-link class="inline-flex gap-2 items-center justify-center px-4 h-9 font-bold text-on-accent text-sm bg-accent hover:bg-neutral-800 rounded-xl transition-colors">
          <span class="h-4 w-4 i-hugeicons-plus-sign" aria-hidden="true"></span>
          <span>New post</span>
        </a>
      </div>
    </header>

    <div class="grid gap-5" x-show="view() === 'list'">
      <section class="bg-panel border border-line rounded-2xl shadow-sm">
        <header class="flex gap-3 items-center justify-between p-3.5 border-b border-line">
          <strong class="text-[13px]">Upcoming &amp; drafts</strong>
          <span class="text-muted text-xs" :text="metaText()">Loading…</span>
        </header>
        <div class="grid gap-2.5 p-3">
          <p class="m-0 p-3 text-[13px] text-muted" x-show="loadError()" :text="loadError()"></p>
          <p class="m-0 p-3 text-[13px] text-muted" x-show="showPendingEmpty()">Nothing queued yet. Schedule a post from the composer and it will show up here.</p>
          <article class="grid gap-2.5 p-3.5 bg-panel border border-line rounded-2xl" x-for="row in pending()">
            <header class="flex gap-3 items-center justify-between">
              <div class="grid gap-1">
                <span class="font-bold text-xs">{{ row.when }}</span>
                <span class="text-muted text-xs">{{ row.channels }}</span>
              </div>
              <span class="px-2 py-1 font-bold text-[11px] whitespace-nowrap border rounded-full" data-status-pill :data-status="row.status">{{ row.status }}</span>
            </header>
            <p class="m-0 leading-normal text-[13px] text-body">{{ row.body }}</p>
            <p class="m-0 text-red-700 text-xs" x-show="row.failure" :text="row.failure"></p>
            <footer class="flex flex-wrap gap-2 items-center justify-end">
              <a class="inline-flex items-center justify-center px-2.5 h-7 font-bold text-ink text-xs bg-panel hover:bg-zinc-50 border border-line rounded-lg shadow-sm transition-colors" x-show="row.liveUrl" :href="row.liveUrl" target="_blank" rel="noopener noreferrer">View</a>
              <a class="inline-flex items-center justify-center px-2.5 h-7 font-bold text-ink text-xs bg-panel hover:bg-zinc-50 border border-line rounded-lg shadow-sm transition-colors" x-show="row.actionable" :href="row.editUrl" data-stx-link>Edit</a>
              <button class="inline-flex items-center justify-center px-2.5 h-7 font-bold text-on-accent text-xs bg-accent hover:bg-neutral-800 rounded-lg transition-colors" type="button" x-show="row.actionable" :disabled="busyId() === row.id" @click="publishItem(row.id)">Publish now</button>
              <button class="inline-flex items-center justify-center px-2.5 h-7 font-bold text-red-700 text-xs bg-panel hover:bg-zinc-50 border border-line rounded-lg shadow-sm transition-colors" type="button" x-show="row.actionable" :disabled="busyId() === row.id" @click="deleteItem(row.id)">Delete</button>
            </footer>
          </article>
        </div>
      </section>

      <section class="bg-panel border border-line rounded-2xl shadow-sm">
        <header class="flex gap-3 items-center justify-between p-3.5 border-b border-line">
          <strong class="text-[13px]">Recent</strong>
          <span class="text-muted text-xs" :text="recentMetaText()"></span>
        </header>
        <div class="grid gap-2.5 p-3">
          <p class="m-0 p-3 text-[13px] text-muted" x-show="showRecentEmpty()">No published posts yet.</p>
          <article class="grid gap-2.5 p-3.5 bg-panel border border-line rounded-2xl" x-for="row in recent()">
            <header class="flex gap-3 items-center justify-between">
              <div class="grid gap-1">
                <span class="font-bold text-xs">{{ row.when }}</span>
                <span class="text-muted text-xs">{{ row.channels }}</span>
              </div>
              <span class="px-2 py-1 font-bold text-[11px] whitespace-nowrap border rounded-full" data-status-pill :data-status="row.status">{{ row.status }}</span>
            </header>
            <p class="m-0 leading-normal text-[13px] text-body">{{ row.body }}</p>
            <p class="m-0 text-red-700 text-xs" x-show="row.failure" :text="row.failure"></p>
            <footer class="flex flex-wrap gap-2 items-center justify-end">
              <a class="inline-flex items-center justify-center px-2.5 h-7 font-bold text-ink text-xs bg-panel hover:bg-zinc-50 border border-line rounded-lg shadow-sm transition-colors" x-show="row.liveUrl" :href="row.liveUrl" target="_blank" rel="noopener noreferrer">View</a>
            </footer>
          </article>
        </div>
      </section>
    </div>

    <section class="bg-panel border border-line rounded-2xl shadow-sm" style="display:none" x-show="view() === 'calendar'">
      <header class="flex gap-3 items-center justify-between p-3.5 border-b border-line">
        <div class="flex gap-2 items-center">
          <button class="inline-flex items-center justify-center h-8 w-8 text-muted bg-panel hover:bg-zinc-50 border border-line rounded-lg shadow-sm transition-colors" type="button" aria-label="Previous month" @click="prevMonth">
            <span class="h-4 w-4 i-hugeicons-arrow-left-02" aria-hidden="true"></span>
          </button>
          <button class="inline-flex items-center justify-center px-3 h-8 font-bold text-ink text-xs bg-panel hover:bg-zinc-50 border border-line rounded-lg shadow-sm transition-colors" type="button" @click="goToday">Today</button>
          <button class="inline-flex items-center justify-center h-8 w-8 text-muted bg-panel hover:bg-zinc-50 border border-line rounded-lg shadow-sm transition-colors" type="button" aria-label="Next month" @click="nextMonth">
            <span class="h-4 w-4 i-hugeicons-arrow-right-02" aria-hidden="true"></span>
          </button>
        </div>
        <strong class="text-[13px]" :text="calTitle()">Calendar</strong>
      </header>
      <div class="overflow-x-auto">
        <div class="min-w-[560px]">
          <div class="grid grid-cols-7 font-bold text-[11px] text-muted border-b border-line">
            <div class="p-2 text-center">Sun</div><div class="p-2 text-center">Mon</div><div class="p-2 text-center">Tue</div><div class="p-2 text-center">Wed</div><div class="p-2 text-center">Thu</div><div class="p-2 text-center">Fri</div><div class="p-2 text-center">Sat</div>
          </div>
          <div class="grid grid-cols-7">
            <div class="grid content-start gap-1 p-1.5 min-h-24 border-b border-line border-r" data-cal-cell :data-blank="cell.blank" :data-today="cell.isToday" x-for="cell in calCells()">
              <a class="font-bold text-[11px] hover:text-neutral-950 transition-colors" data-cal-day x-show="!cell.blank" :href="cell.scheduleUrl" data-stx-link title="Schedule a post on this day">{{ cell.day }}</a>
              <a class="flex gap-1 items-center px-1 py-0.5 text-[10px] text-body bg-panel-2 hover:bg-zinc-100 rounded transition-colors" x-for="chip in cell.chips" :href="chip.href" data-stx-link>
                <span class="shrink-0 h-1.5 w-1.5 rounded-full" data-cal-dot :data-status="chip.status"></span>
                <span class="truncate">{{ chip.label }}</span>
              </a>
              <span class="px-1 text-[10px] text-zinc-400" x-show="cell.more" :text="cell.more"></span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </section>


  <script client>
    /**
     * Wire shapes for `/api/postline/queue/*`, declared where they are used.
     *
     * These describe what the BROWSER receives, which is a flattened projection
     * of `app/Support/Social/types.ts` — deliberately separate, because the wire
     * shape and the server shape are free to diverge. Local to this block on
     * purpose: nothing outside this view refers to them, and a shared ambient
     * `.d.ts` would be an unenforced second source of truth for one file's
     * internals.
     */
    interface QueueApiTarget {
      provider: string
      failureReason?: string | null
      remoteUri?: string | null
    }

    interface QueueApiItem {
      id: number
      status: string
      body: string
      title?: string | null
      createdAt?: string | null
      scheduledAt?: string | null
      publishedAt?: string | null
      hasImage?: boolean
      hasLink?: boolean
      providers: QueueApiTarget[]
    }

    /** A queue entry flattened to exactly what one row renders. */
    interface QueueRow {
      id: number
      status: string
      body: string
      when: string
      channels: string
      failure: string
      liveUrl: string
      editUrl: string
      actionable: boolean
      scheduledAt?: string | null
      publishedAt?: string | null
      title?: string | null
    }

    /** Toast copy for a queue action's success branch. */
    interface QueueActionCopy {
      title: string
      message: string
    }

    const PENDING = new Set(['draft', 'scheduled', 'publishing', 'failed'])
    const ACTIONABLE = new Set(['draft', 'scheduled', 'failed'])

    const items = state([])
    const loadError = state('')
    const loaded = state(false)
    const busyId = state(0)
    const calMonthStart = state(monthStart(new Date()))

    // A fresh key, not the legacy 'postline.queue.view': useLocalStorage
    // JSON.parses whatever is already stored, and the old value was a bare
    // string ("list"), which would throw and take the whole script down.
    const view = useLocalStorage('postline.queue.view.v2', 'list')

    function monthStart(date: Date): Date {
      return new Date(date.getFullYear(), date.getMonth(), 1)
    }

    function localDayKey(date: Date): string {
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`
    }

    // Server timestamps are UTC "YYYY-MM-DD HH:MM:SS" — render in local time.
    const parseUtc = (value: string | null | undefined): Date | null => {
      if (!value) return null
      const date = new Date(`${String(value).replace(' ', 'T')}Z`)
      return Number.isNaN(date.getTime()) ? null : date
    }

    const formatTime = (value: string | null | undefined): string => {
      const date = parseUtc(value)
      if (!date) return value || ''
      return date.toLocaleString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })
    }

    const providerLabel = (provider: string): string => postlineSocial?.providerLabel(provider) || provider

    const liveUrlFor = (uri: string | null | undefined): string => {
      const value = String(uri || '')
      if (value.startsWith('/')) return value
      // A stored permalink (Mastodon, and any provider persisting a URL) is
      // already linkable as-is.
      if (/^https?:\/\//i.test(value)) return value
      const match = value.match(/^at:\/\/([^/]+)\/app\.bsky\.feed\.post\/(.+)$/)
      return match ? `https://bsky.app/profile/${encodeURIComponent(match[1])}/post/${encodeURIComponent(match[2])}` : ''
    }

    /** Flatten an API item into exactly what a row renders. */
    const toRow = (item: QueueApiItem): QueueRow => {
      const when = item.status === 'scheduled'
        ? `Scheduled · ${formatTime(item.scheduledAt)}`
        : item.status === 'published'
          ? `Published · ${formatTime(item.publishedAt || item.createdAt)}`
          : `${item.status[0].toUpperCase()}${item.status.slice(1)} · ${formatTime(item.createdAt)}`
      const extras = [item.hasImage ? 'image' : '', item.hasLink ? 'link card' : ''].filter(Boolean).join(' · ')
      const channels = (item.providers.map(target => providerLabel(target.provider)).join(', ') || 'No channel')
        + (extras ? ` · ${extras}` : '')
      return {
        id: item.id,
        status: item.status,
        body: item.body,
        when,
        channels,
        failure: item.providers.find(target => target.failureReason)?.failureReason || '',
        liveUrl: liveUrlFor(item.providers.find(target => target.remoteUri)?.remoteUri),
        editUrl: `/?edit=${item.id}`,
        actionable: ACTIONABLE.has(item.status),
        scheduledAt: item.scheduledAt,
        publishedAt: item.publishedAt,
        title: item.title,
      }
    }

    const rows = derived(() => items().map(toRow))
    const pending = derived(() => rows().filter(row => PENDING.has(row.status)))
    const recent = derived(() => rows().filter(row => !PENDING.has(row.status)).slice(0, 10))

    const showPendingEmpty = derived(() => loaded() && !loadError() && pending().length === 0)
    const showRecentEmpty = derived(() => loaded() && !loadError() && recent().length === 0)

    const metaText = derived(() => {
      if (!loaded()) return 'Loading…'
      if (loadError()) return 'Could not load'
      const scheduled = pending().filter(row => row.status === 'scheduled').length
      const drafts = pending().filter(row => row.status === 'draft').length
      return `${scheduled} scheduled · ${drafts} draft${drafts === 1 ? '' : 's'}`
    })

    const recentMetaText = derived(() => {
      const n = recent().length
      return `${n} post${n === 1 ? '' : 's'}`
    })

    const calTitle = derived(() =>
      calMonthStart().toLocaleDateString(undefined, { month: 'long', year: 'numeric' }))

    /**
     * The month grid as plain data. Derived rather than painted, so changing
     * month or reloading the queue rebuilds it with no manual repaint call.
     */
    const calCells = derived(() => {
      const start = calMonthStart()
      const year = start.getFullYear()
      const month = start.getMonth()

      const byDay = new Map()
      for (const row of rows()) {
        const date = parseUtc(row.scheduledAt || row.publishedAt)
        if (!date) continue
        const key = localDayKey(date)
        if (!byDay.has(key)) byDay.set(key, [])
        byDay.get(key).push({ row, date })
      }

      const cells = []
      const startOffset = new Date(year, month, 1).getDay()
      const daysInMonth = new Date(year, month + 1, 0).getDate()
      const todayKey = localDayKey(new Date())

      for (let i = 0; i < startOffset; i++) cells.push({ blank: true, chips: [] })

      for (let day = 1; day <= daysInMonth; day++) {
        const key = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`
        const dayItems = (byDay.get(key) || []).sort((a, b) => a.date - b.date)
        cells.push({
          blank: false,
          day,
          isToday: key === todayKey,
          scheduleUrl: `/?schedule=${key}`,
          chips: dayItems.slice(0, 3).map(({ row, date }) => ({
            status: row.status,
            href: row.actionable ? row.editUrl : row.liveUrl || row.editUrl,
            label: `${date.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' })} ${(row.title || row.body || '').slice(0, 22) || 'post'}`,
          })),
          more: dayItems.length > 3 ? `+${dayItems.length - 3} more` : '',
        })
      }

      while (cells.length % 7 !== 0) cells.push({ blank: true, chips: [] })
      return cells
    })

    const setView = next => view.set(next === 'calendar' ? 'calendar' : 'list')
    const prevMonth = () => calMonthStart.set(new Date(calMonthStart().getFullYear(), calMonthStart().getMonth() - 1, 1))
    const nextMonth = () => calMonthStart.set(new Date(calMonthStart().getFullYear(), calMonthStart().getMonth() + 1, 1))
    const goToday = () => calMonthStart.set(monthStart(new Date()))

    const refresh = async () => {
      try {
        const response = await fetch('/api/postline/queue')
        const payload = await response.json()
        if (!response.ok || !payload.ok) throw new Error(payload.error || 'Could not load the queue.')
        items.set(payload.data.items || [])
        loadError.set('')
      }
      catch (error) {
        // Degrade to the inline error state; no toast on load/refresh so a
        // failing fetch (e.g. an expired session) can't spam or stack.
        items.set([])
        loadError.set(error instanceof Error ? error.message : String(error))
        console.warn('[postline] queue load failed:', error)
      }
      finally {
        loaded.set(true)
      }
    }

    const post = async (path: string, id: number): Promise<unknown> => {
      const form = new FormData()
      form.set('id', String(id))
      const response = await fetch(path, { method: 'POST', body: form })
      const payload = await response.json()
      if (!response.ok || !payload.ok) throw new Error(payload.error || 'Request failed.')
      return payload.data
    }

    const runAction = async (id: number, path: string, success: QueueActionCopy, failure: string): Promise<void> => {
      busyId.set(id)
      try {
        await post(path, id)
        postlineToast?.show?.({ title: success.title, message: success.message, tone: 'success' })
      }
      catch (error) {
        postlineToast?.show?.({
          title: failure,
          message: error instanceof Error ? error.message : String(error),
          tone: 'error',
        })
      }
      finally {
        busyId.set(0)
      }
      await refresh()
    }

    const publishItem = (id: number): void => void runAction(
      id,
      '/api/postline/queue/publish-now',
      { title: 'Published', message: 'Post published.' },
      'Publish failed',
    )

    const deleteItem = (id: number): void => {
      if (!confirm('Delete this post? This cannot be undone.')) return
      void runAction(
        id,
        '/api/postline/queue/delete',
        { title: 'Removed', message: 'Post removed from the queue.' },
        'Delete failed',
      )
    }

    onMount(() => {
      void refresh()
    })
  </script>
@endsection
