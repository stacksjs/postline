            {{-- Every connected Mastodon account, from the mastodonAccounts() signal. --}}
            <ul class="grid hidden gap-1.5 m-0 mt-3 p-0 list-none" :class="{ 'hidden': mastodonAccounts().length === 0 }" data-account-list="mastodon">
