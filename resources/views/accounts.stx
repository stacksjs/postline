@extends('layouts/postline')

@section('title', 'Postline - Settings - Channels')

@section('content')
  @meta('description', 'Connect and manage publishing channels in Postline settings.')
  <section class="grid gap-4" data-postline-page="accounts" data-testid="accounts-page">
    <!-- Crosswind safelist: connection status-pill colors are set dynamically
        via JS, so list them in static markup for the CSS scanner. -->
    <div class="hidden text-amber-800 text-emerald-700 text-muted bg-amber-50 bg-emerald-50 border-amber-200 border-emerald-200 border-line" aria-hidden="true"></div>
    <header class="flex flex-col gap-4 items-stretch justify-between sm:flex-row sm:items-end min-h-11">
      <div>
        <p class="mb-1.5 font-bold text-[11px] text-muted tracking-wider uppercase">Settings</p>
        <h1 class="m-0 font-bold text-[22px] text-ink tracking-normal">Connect your channels</h1>
        <p class="mb-0 mt-1.5 text-[13px] text-muted">Bring every place you publish into one calm, reliable workspace.</p>
      </div>
      <a class="inline-flex gap-2 items-center justify-center px-4 h-9 w-fit font-bold text-ink text-sm bg-panel hover:bg-white border border-line rounded-xl shadow-sm transition-colors" href="/composer" data-stx-link>
        <span class="h-4 w-4 i-hugeicons-edit-02" aria-hidden="true"></span>
        Open Composer
      </a>
    </header>

    <nav class="flex gap-1 p-1 w-fit bg-panel-3 border border-line rounded-xl" aria-label="Settings sections">
      <a class="inline-flex items-center justify-center px-3 h-8 font-bold text-muted text-xs hover:text-ink rounded-lg transition-colors" href="/settings" data-stx-link>General</a>
      <a class="inline-flex items-center justify-center px-3 h-8 font-bold text-ink text-xs bg-panel border border-line rounded-lg shadow-sm" href="/accounts" data-stx-link aria-current="page">Channels</a>
    </nav>

    <div class="grid gap-3 sm:grid-cols-3">
      <article class="flex gap-3 items-center p-4 bg-panel border border-line rounded-2xl shadow-sm">
        <span class="grid place-items-center shrink-0 h-10 w-10 text-blue-700 text-lg bg-blue-50 rounded-xl i-hugeicons-share-08" aria-hidden="true"></span>
        <div><span class="block font-bold text-[10px] text-muted tracking-wider uppercase">Destinations</span><strong class="block mt-1 text-ink text-sm">7 publishing channels</strong></div>
      </article>
      <article class="flex gap-3 items-center p-4 bg-panel border border-line rounded-2xl shadow-sm">
        <span class="grid place-items-center shrink-0 h-10 w-10 text-emerald-700 text-lg bg-emerald-50 rounded-xl i-hugeicons-shield-key" aria-hidden="true"></span>
        <div><span class="block font-bold text-[10px] text-muted tracking-wider uppercase">Credentials</span><strong class="block mt-1 text-ink text-sm">Stored in your workspace</strong></div>
      </article>
      <article class="flex gap-3 items-center p-4 bg-panel border border-line rounded-2xl shadow-sm">
        <span class="grid place-items-center shrink-0 h-10 w-10 text-lg text-violet-700 bg-violet-50 rounded-xl i-hugeicons-radar-02" aria-hidden="true"></span>
        <div><span class="block font-bold text-[10px] text-muted tracking-wider uppercase">Listening</span><a class="block mt-1 font-bold text-ink text-sm hover:underline" href="/listening" data-stx-link>Watch brand mentions</a></div>
      </article>
    </div>

    <section class="overflow-hidden bg-panel border border-line rounded-2xl shadow-sm" data-bluesky-channel-card>
      <header class="flex gap-3 items-center justify-between px-4 py-3.5 border-b border-line">
        <div><strong class="text-ink text-sm">Publishing destinations</strong><p class="m-0 mt-1 text-muted text-xs">Connect only the channels you actually use.</p></div>
        <span class="px-2.5 py-1 font-bold text-[11px] text-muted bg-panel-2 border border-line rounded-full">7 destinations</span>
      </header>
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3 p-3" data-bluesky-channels>
        <article class="flex flex-col gap-4 justify-between p-4 min-h-52 bg-panel border border-line rounded-2xl hover:border-zinc-300 hover:shadow-sm transition-all" data-channel="bluesky">
          <div><div class="flex gap-3 items-start justify-between"><span class="grid place-items-center h-10 w-10 text-blue-600 text-xl bg-blue-50 rounded-xl i-simple-icons-bluesky" aria-hidden="true"></span><span class="px-2.5 py-1 font-bold text-[11px] text-muted whitespace-nowrap border border-line rounded-full" data-bluesky-channel-status>Setup</span></div>
            <h2 class="mb-0 mt-4 font-bold text-[15px]">Bluesky</h2>
            <p class="my-1.5 text-[13px] text-body" data-bluesky-channel-handle>Not connected</p>
            <p class="m-0 text-muted text-xs" data-bluesky-channel-detail>Add an app password to publish and sync your timeline.</p>
          </div>
          <details class="group">
            <summary class="inline-flex items-center justify-center h-9 w-full font-bold list-none text-ink text-xs bg-panel-2 hover:bg-white border border-line rounded-xl transition-colors cursor-pointer">Manage Bluesky</summary>
            <form id="bluesky-connect-form" class="grid gap-2 pt-3" data-bluesky-connect-form>
              <input class="px-3 h-9 text-ink text-xs bg-white border border-line outline-none rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100" name="identifier" placeholder="name.bsky.social" autocomplete="username" aria-label="Bluesky handle" data-bluesky-identifier required>
              <input class="px-3 h-9 text-ink text-xs bg-white border border-line outline-none rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100" name="password" type="password" autocomplete="current-password" placeholder="App password" aria-label="Bluesky app password" data-bluesky-password required>
              <button class="inline-flex items-center justify-center px-3 h-9 w-full font-bold text-on-accent text-xs bg-accent hover:bg-neutral-800 rounded-xl disabled:opacity-50 transition-colors" type="submit" data-bluesky-connect-submit>Connect Bluesky</button>
              <p class="m-0 text-[11px] text-muted">Use an app password from Bluesky Settings, never your account password.</p>
            </form>
          </details>
        </article>
        <article class="flex flex-col gap-4 justify-between p-4 min-h-52 bg-panel border border-line rounded-2xl hover:border-zinc-300 hover:shadow-sm transition-all" data-channel="linkedin">
          <div><div class="flex gap-3 items-start justify-between"><span class="grid place-items-center h-10 w-10 text-[#0a66c2] text-xl bg-blue-50 rounded-xl i-simple-icons-linkedin" aria-hidden="true"></span><span class="px-2.5 py-1 font-bold text-[11px] text-muted whitespace-nowrap border border-line rounded-full" data-linkedin-channel-status>Setup</span></div>
            <h2 class="mb-0 mt-4 font-bold text-[15px]">LinkedIn</h2>
            <p class="my-1.5 text-[13px] text-body" data-linkedin-channel-handle>Not connected</p>
            <p class="m-0 text-muted text-xs" data-linkedin-channel-detail>Connect with LinkedIn to crosspost member shares.</p>
          </div>
          <div class="grid gap-2">
            <button class="inline-flex items-center justify-center px-3 h-9 w-full font-bold text-on-accent text-xs bg-accent hover:bg-neutral-800 rounded-xl disabled:opacity-50 transition-colors" type="button" data-linkedin-connect>Connect LinkedIn</button>
            <button class="hidden text-muted text-xs underline hover:text-zinc-700 transition-colors" type="button" data-linkedin-connect-env>Use configured token</button>
          </div>
        </article>
        <article class="flex flex-col gap-4 justify-between p-4 min-h-52 bg-panel border border-line rounded-2xl hover:border-zinc-300 hover:shadow-sm transition-all" data-channel="instagram">
          <div><div class="flex gap-3 items-start justify-between"><span class="grid place-items-center h-10 w-10 text-pink-600 text-xl bg-pink-50 rounded-xl i-simple-icons-instagram" aria-hidden="true"></span><span class="px-2.5 py-1 font-bold text-[11px] text-muted whitespace-nowrap border border-line rounded-full" data-instagram-channel-status>Setup</span></div>
            <h2 class="mb-0 mt-4 font-bold text-[15px]">Instagram</h2>
            <p class="my-1.5 text-[13px] text-body" data-instagram-channel-handle>Not connected</p>
            <p class="m-0 text-muted text-xs" data-instagram-channel-detail>Connect an Instagram Business account to crosspost. Posts require an image.</p>
          </div>
          <div class="grid gap-2">
            <button class="inline-flex items-center justify-center px-3 h-9 w-full font-bold text-on-accent text-xs bg-accent hover:bg-neutral-800 rounded-xl disabled:opacity-50 transition-colors" type="button" data-instagram-connect>Connect Instagram</button>
            <button class="hidden text-muted text-xs underline hover:text-zinc-700 transition-colors" type="button" data-instagram-connect-env>Use configured token</button>
          </div>
        </article>
        <article class="flex flex-col gap-4 justify-between p-4 min-h-52 bg-panel border border-line rounded-2xl hover:border-zinc-300 hover:shadow-sm transition-all" data-channel="threads">
          <div><div class="flex gap-3 items-start justify-between"><span class="grid place-items-center h-10 w-10 text-ink text-xl bg-panel-2 rounded-xl i-simple-icons-threads" aria-hidden="true"></span><span class="px-2.5 py-1 font-bold text-[11px] text-muted whitespace-nowrap border border-line rounded-full" data-threads-channel-status>Setup</span></div>
            <h2 class="mb-0 mt-4 font-bold text-[15px]">Threads</h2>
            <p class="my-1.5 text-[13px] text-body" data-threads-channel-handle>Not connected</p>
            <p class="m-0 text-muted text-xs" data-threads-channel-detail>Connect a Threads account to crosspost.</p>
          </div>
          <div class="grid gap-2">
            <button class="inline-flex items-center justify-center px-3 h-9 w-full font-bold text-on-accent text-xs bg-accent hover:bg-neutral-800 rounded-xl disabled:opacity-50 transition-colors" type="button" data-threads-connect>Connect Threads</button>
            <button class="hidden text-muted text-xs underline hover:text-zinc-700 transition-colors" type="button" data-threads-connect-env>Use configured token</button>
          </div>
        </article>
        <article class="flex flex-col gap-4 justify-between p-4 min-h-52 bg-panel border border-line rounded-2xl hover:border-zinc-300 hover:shadow-sm transition-all" data-channel="twitter">
          <div><div class="flex gap-3 items-start justify-between"><span class="grid place-items-center h-10 w-10 text-ink text-lg bg-panel-2 rounded-xl i-simple-icons-x" aria-hidden="true"></span><span class="px-2.5 py-1 font-bold text-[11px] text-muted whitespace-nowrap border border-line rounded-full" data-twitter-channel-status>Setup</span></div>
            <h2 class="mb-0 mt-4 font-bold text-[15px]">X</h2>
            <p class="my-1.5 text-[13px] text-body" data-twitter-channel-handle>Not connected</p>
            <p class="m-0 text-muted text-xs" data-twitter-channel-detail>Connect X to crosspost tweets. Posting needs a paid X API tier.</p>
          </div>
          <div class="grid gap-2">
            <button class="inline-flex items-center justify-center px-3 h-9 w-full font-bold text-on-accent text-xs bg-accent hover:bg-neutral-800 rounded-xl disabled:opacity-50 transition-colors" type="button" data-twitter-connect>Connect X</button>
            <button class="hidden text-muted text-xs underline hover:text-zinc-700 transition-colors" type="button" data-twitter-connect-env>Use configured token</button>
          </div>
        </article>
        <article class="flex flex-col gap-4 justify-between p-4 min-h-52 bg-panel border border-line rounded-2xl hover:border-zinc-300 hover:shadow-sm transition-all" data-channel="blog">
          <div><div class="flex gap-3 items-start justify-between"><span class="grid place-items-center h-10 w-10 text-ink text-xl bg-panel-2 rounded-xl i-hugeicons-quill-write-02" aria-hidden="true"></span><span class="px-2.5 py-1 font-bold text-[11px] text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full">Ready</span></div>
            <h2 class="mb-0 mt-4 font-bold text-[15px]">Blog</h2>
            <p class="my-1.5 text-[13px] text-body">Built into Postline</p>
            <p class="m-0 text-muted text-xs">Publish long-form posts to your site without another account.</p>
          </div>
          <a class="inline-flex items-center justify-center h-9 font-bold text-ink text-xs bg-panel-2 hover:bg-white border border-line rounded-xl" href="/blog" data-stx-link>Open Blog</a>
        </article>
        <article class="flex flex-col gap-4 justify-between p-4 min-h-52 bg-panel border border-line rounded-2xl hover:border-zinc-300 hover:shadow-sm transition-all" data-channel="mastodon">
          <div><div class="flex gap-3 items-start justify-between"><span class="grid place-items-center h-10 w-10 text-indigo-600 text-xl bg-indigo-50 rounded-xl i-simple-icons-mastodon" aria-hidden="true"></span><span class="px-2.5 py-1 font-bold text-[11px] text-muted whitespace-nowrap border border-line rounded-full" data-mastodon-channel-status>Setup</span></div>
            <h2 class="mb-0 mt-4 font-bold text-[15px]">Mastodon</h2>
            <p class="my-1.5 text-[13px] text-body" data-mastodon-channel-handle>Not connected</p>
            <p class="m-0 text-muted text-xs" data-mastodon-channel-detail>Connect any Mastodon instance with an access token to crosspost.</p>
          </div>
          <details class="group">
            <summary class="inline-flex items-center justify-center h-9 w-full font-bold list-none text-ink text-xs bg-panel-2 hover:bg-white border border-line rounded-xl transition-colors cursor-pointer">Manage Mastodon</summary>
            <form class="grid gap-2 pt-3" data-mastodon-connect-form>
              <input class="px-3 h-9 text-ink text-xs bg-white border border-line outline-none rounded-xl focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" name="instance" placeholder="mastodon.social" autocomplete="url" aria-label="Mastodon instance" data-mastodon-instance required>
              <input class="px-3 h-9 text-ink text-xs bg-white border border-line outline-none rounded-xl focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" name="access_token" type="password" placeholder="Access token" autocomplete="off" aria-label="Mastodon access token" data-mastodon-token required>
              <button class="inline-flex items-center justify-center px-3 h-9 w-full font-bold text-on-accent text-xs bg-accent hover:bg-neutral-800 rounded-xl disabled:opacity-50 transition-colors" type="submit" data-mastodon-connect-submit>Connect Mastodon</button>
              <p class="m-0 text-[11px] text-muted">Create a token in your instance settings with status and media write access.</p>
            </form>
          </details>
        </article>
      </div>
    </section>

    <details class="overflow-hidden bg-panel border border-line rounded-2xl open:border-red-200 shadow-sm group" data-purge-card>
      <summary class="flex gap-3 items-center justify-between p-4 list-none hover:bg-panel-2 transition-colors cursor-pointer">
        <div class="flex gap-3 items-center"><span class="grid place-items-center h-9 w-9 text-red-600 bg-red-50 rounded-xl i-lucide-triangle-alert" aria-hidden="true"></span><div>
          <strong class="text-[13px] text-ink">Post removal tools</strong>
          <p class="mb-0 mt-1 text-muted text-xs">Preview or permanently remove posts from connected accounts.</p>
        </div></div>
        <span class="h-4 w-4 text-muted transition-transform group-open:rotate-180 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
      </summary>

      <div class="grid gap-4 p-4 border-red-200 border-t">
        <div class="flex gap-2 items-center p-3 text-red-800 text-xs bg-red-50 border border-red-200 rounded-xl"><span class="shrink-0 h-4 w-4 i-hugeicons-alert-02" aria-hidden="true"></span><span>Deletion is permanent. Postline always shows a preview and requires an exact confirmation phrase first.</span></div>
        <fieldset class="grid gap-2 m-0 p-0 border-0">
          <legend class="mb-1 p-0 font-bold text-muted text-xs">What to delete</legend>
          <label class="flex gap-2.5 items-start p-3 border border-line rounded-xl cursor-pointer">
            <input class="mt-0.5" type="radio" name="purge-scope" value="tracked" checked data-purge-scope>
            <span>
              <span class="block font-bold text-[13px] text-ink">Posts Postline published</span>
              <span class="block mt-0.5 text-muted text-xs">Only posts sent from this workspace. Anything you posted elsewhere stays.</span>
            </span>
          </label>
          <label class="flex gap-2.5 items-start p-3 border border-line rounded-xl cursor-pointer">
            <input class="mt-0.5" type="radio" name="purge-scope" value="all" data-purge-scope>
            <span>
              <span class="block font-bold text-[13px] text-ink">Everything on the account</span>
              <span class="block mt-0.5 text-muted text-xs">Every post the account ever made, including posts created outside Postline.</span>
            </span>
          </label>
        </fieldset>

        <fieldset class="grid gap-2 m-0 p-0 border-0">
          <legend class="mb-1 p-0 font-bold text-muted text-xs">Accounts</legend>
          <div class="flex flex-wrap gap-3">
            <label class="inline-flex gap-2 items-center text-[13px]">
              <input type="checkbox" value="bluesky" checked data-purge-provider> Bluesky
            </label>
            <label class="inline-flex gap-2 items-center text-[13px]">
              <input type="checkbox" value="twitter" checked data-purge-provider> X (Twitter)
            </label>
            <label class="inline-flex gap-2 items-center text-[13px]">
              <input type="checkbox" value="mastodon" checked data-purge-provider> Mastodon
            </label>
            <label class="inline-flex gap-2 items-center text-[13px]">
              <input type="checkbox" value="linkedin" checked data-purge-provider> LinkedIn
            </label>
          </div>
          <p class="m-0 text-muted text-xs">LinkedIn can delete the posts Postline published; listing its full history needs a partner permission most apps don't hold. Instagram and Threads can't delete posts at all through their APIs — remove those in their own apps.</p>
        </fieldset>

        <div class="flex flex-wrap gap-3 items-center">
          <button class="inline-flex items-center justify-center px-4 h-10 font-bold text-ink text-sm bg-panel hover:bg-panel-3 border border-line rounded-xl disabled:opacity-50 transition-colors" type="button" data-purge-preview>Preview what would be deleted</button>
          <span class="text-muted text-xs" data-purge-summary>No preview yet.</span>
        </div>

        <!-- Rendered from the purgeRows() signal. Object-form :class, because
            the string form of :class merges with the static list and a static
            hidden class would never come back off. -->
        <div class="grid hidden gap-2" :class="{ 'hidden': purgeRows().length === 0 }" data-purge-results>
          <div class="p-3 text-[13px] border border-line rounded-xl" x-for="row in purgeRows()">
            <strong :text="row.heading"></strong>
            <p class="my-1 text-muted" :text="row.detail"></p>
          </div>
        </div>

        <div class="grid gap-2 p-3 bg-red-50 border border-red-200 rounded-xl">
          <label class="grid gap-1.5">
            <span class="font-bold text-red-800 text-xs">Type <code class="px-1 py-0.5 text-xs bg-panel rounded">DELETE ALL POSTS</code> to confirm</span>
            <input class="px-3 h-10 text-ink text-sm bg-panel border border-red-200 outline-none rounded-xl focus:border-red-500 focus:ring-2 focus:ring-red-100" type="text" autocomplete="off" placeholder="DELETE ALL POSTS" aria-label="Deletion confirmation phrase" data-purge-confirmation>
          </label>
          <button class="inline-flex items-center justify-center px-4 h-10 font-bold text-sm text-white bg-red-600 hover:bg-red-700 rounded-xl disabled:opacity-50 transition-colors disabled:cursor-not-allowed" type="button" disabled data-purge-run>Delete permanently</button>
          <p class="m-0 text-red-800 text-xs" data-purge-hint>Run a preview first, then type the phrase to enable deletion.</p>
        </div>
      </div>
    </details>
  </section>

  <script client>
    ;(() => {
      const root = document.querySelector('[data-testid="accounts-page"]')
      if (!root) return

      const form = root.querySelector('[data-bluesky-connect-form]')
      const identifier = root.querySelector('[data-bluesky-identifier]')
      const password = root.querySelector('[data-bluesky-password]')
      const submit = root.querySelector('[data-bluesky-connect-submit]')
      const handle = root.querySelector('[data-bluesky-channel-handle]')
      const detail = root.querySelector('[data-bluesky-channel-detail]')
      const status = root.querySelector('[data-bluesky-channel-status]')
      const notify = (message, tone = 'neutral', options = {}) => {
        // Resolve the toast helper at call time — it's a deferred module that
        // loads after this inline script parses, so an eager capture is
        // undefined on a full page load (e.g. the OAuth redirect back here).
        const show = window.postlineToast?.show
        if (show) show({ message, tone: tone === 'success' ? 'success' : tone === 'error' ? 'error' : 'info', title: options.title })
        else console.log(message)
      }

      const renderStatus = (data) => {
        const connected = Boolean(data?.canPublish)
        const label = data?.handle ? `@${data.handle}` : 'Not connected'
        if (identifier && data?.handle) identifier.value = data.handle.replace(/^@/, '')
        if (handle) handle.textContent = label
        if (detail) {
          detail.textContent = connected
            ? 'Ready to publish and sync timeline from Postline.'
            : data?.handle
              ? 'Saved handle found. Add a valid app password to publish.'
              : 'Add an app password to publish and sync your timeline.'
        }
        if (status) {
          status.textContent = connected ? 'Connected' : data?.handle ? 'Needs password' : 'Setup'
          status.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-[11px] font-bold ${
            connected
              ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
              : data?.handle
                ? 'border-amber-200 bg-amber-50 text-amber-800'
                : 'border-line text-muted'
          }`
        }
        if (submit) submit.textContent = connected ? 'Reconnect Bluesky' : 'Connect Bluesky'
      }

      const refreshStatus = async () => {
        try {
          const data = await window.postlineBluesky?.fetchStatus()
          renderStatus(data)
        }
        catch (error) {
          // Inline status ("Setup" / "Not connected") communicates the failure;
          // no toast on load so an expired session can't spam one each visit.
          renderStatus(null)
          console.warn('[postline] bluesky status failed:', error)
        }
      }

      form?.addEventListener('submit', async (event) => {
        event.preventDefault()
        submit?.setAttribute('disabled', 'disabled')
        notify('Connecting to Bluesky…', 'info', { title: 'Channels' })

        try {
          const response = await fetch('/api/postline/bluesky/connect', {
            method: 'POST',
            body: new FormData(form),
          })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Bluesky connect failed.')
          if (password) password.value = ''
          await refreshStatus()
          notify(`${payload.data.handle} is connected. You can publish from the composer.`, 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          submit?.removeAttribute('disabled')
        }
      })

      // --- LinkedIn ---
      const linkedinHandle = root.querySelector('[data-linkedin-channel-handle]')
      const linkedinDetail = root.querySelector('[data-linkedin-channel-detail]')
      const linkedinStatusPill = root.querySelector('[data-linkedin-channel-status]')
      const linkedinConnect = root.querySelector('[data-linkedin-connect]')
      const linkedinConnectEnv = root.querySelector('[data-linkedin-connect-env]')

      const renderLinkedIn = (data) => {
        const connected = Boolean(data?.canPublish)
        const label = data?.displayName || data?.handle || 'Not connected'
        if (linkedinHandle) {
          linkedinHandle.textContent = connected ? label : (data?.handle ? `${label}, reconnect` : 'Not connected')
        }
        if (linkedinDetail) {
          linkedinDetail.textContent = connected
            ? 'Ready to crosspost member shares from Postline.'
            : data?.oauthConfigured
              ? 'Connect with LinkedIn to crosspost member shares.'
              : data?.configuredFromEnv
                ? 'Token found in .env. Connect to start crossposting.'
                : 'Add LinkedIn API keys to .env, then connect.'
        }
        if (linkedinStatusPill) {
          linkedinStatusPill.textContent = connected ? 'Connected' : (data?.handle ? 'Reconnect' : 'Setup')
          linkedinStatusPill.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-[11px] font-bold ${
            connected
              ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
              : data?.handle
                ? 'border-amber-200 bg-amber-50 text-amber-800'
                : 'border-line text-muted'
          }`
        }
        if (linkedinConnect) {
          linkedinConnect.textContent = connected ? 'Reconnect LinkedIn' : 'Connect with LinkedIn'
          if (data && !data.oauthConfigured) linkedinConnect.setAttribute('disabled', 'disabled')
          else linkedinConnect.removeAttribute('disabled')
        }
        if (linkedinConnectEnv) linkedinConnectEnv.classList.toggle('hidden', !data?.configuredFromEnv)
      }

      const refreshLinkedIn = async () => {
        try {
          const data = await window.postlineLinkedin?.fetchStatus()
          renderLinkedIn(data)
        }
        catch (error) {
          renderLinkedIn(null)
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'LinkedIn' })
        }
      }

      linkedinConnect?.addEventListener('click', () => {
        notify('Redirecting to LinkedIn…', 'info', { title: 'LinkedIn' })
        navigate('/api/postline/linkedin/auth', true)
      })

      linkedinConnectEnv?.addEventListener('click', async () => {
        linkedinConnectEnv.setAttribute('disabled', 'disabled')
        notify('Connecting LinkedIn from .env…', 'info', { title: 'LinkedIn' })
        try {
          const response = await fetch('/api/postline/linkedin/connect', { method: 'POST' })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'LinkedIn connect failed.')
          await refreshLinkedIn()
          notify('LinkedIn connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          linkedinConnectEnv.removeAttribute('disabled')
        }
      })

      /**
       * Read a provider's OAuth callback result, then strip it from the URL.
       *
       * Reads the query FRESH on every call. The previous code built one
       * URLSearchParams for LinkedIn and mutated it with delete(); Instagram and
       * Threads then read from that already-mutated object, so a callback
       * carrying both a provider key and a message could lose the message.
       *
       * replaceState, not navigate(): navigate() pushes a history entry, so Back
       * would land on a URL still carrying the callback params and re-run this
       * handler. The runtime offers no replace-mode navigation, which is why
       * this one raw history call survives.
       */
      const consumeOAuthResult = (provider) => {
        const route = useRoute()
        const value = route.query[provider]
        if (!value) return null
        const params = new URLSearchParams(route.fullPath.split('?')[1] || '')
        const message = params.get('message')
        params.delete(provider)
        params.delete('message')
        const query = params.toString()
        window.history.replaceState({}, '', `${route.path}${query ? `?${query}` : ''}`)
        return { value, message }
      }

      const linkedinCallback = consumeOAuthResult('linkedin')
      if (linkedinCallback?.value === 'connected')
        notify('LinkedIn connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
      else if (linkedinCallback?.value === 'error')
        notify(linkedinCallback.message || 'LinkedIn connection failed.', 'error', { title: 'LinkedIn' })

      const startLinkedIn = () => void refreshLinkedIn()
      onMount(startLinkedIn)

      // --- X (Twitter) ---
      const twitterHandle = root.querySelector('[data-twitter-channel-handle]')
      const twitterDetail = root.querySelector('[data-twitter-channel-detail]')
      const twitterStatusPill = root.querySelector('[data-twitter-channel-status]')
      const twitterConnect = root.querySelector('[data-twitter-connect]')
      const twitterConnectEnv = root.querySelector('[data-twitter-connect-env]')

      const renderTwitter = (data) => {
        const connected = Boolean(data?.canPublish)
        const label = data?.handle ? `@${data.handle}` : 'Not connected'
        if (twitterHandle) {
          twitterHandle.textContent = connected ? label : (data?.handle ? `${label}, reconnect` : 'Not connected')
        }
        if (twitterDetail) {
          twitterDetail.textContent = connected
            ? 'Ready to crosspost tweets from Postline.'
            : data?.oauthConfigured
              ? 'Connect X to crosspost tweets. Posting needs a paid X API tier.'
              : data?.configuredFromEnv
                ? 'Token found in .env. Connect to start crossposting.'
                : 'Add X (Twitter) API keys to .env, then connect.'
        }
        if (twitterStatusPill) {
          twitterStatusPill.textContent = connected ? 'Connected' : (data?.handle ? 'Reconnect' : 'Setup')
          twitterStatusPill.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-[11px] font-bold ${
            connected
              ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
              : data?.handle
                ? 'border-amber-200 bg-amber-50 text-amber-800'
                : 'border-line text-muted'
          }`
        }
        if (twitterConnect) {
          twitterConnect.textContent = connected ? 'Reconnect X' : 'Connect with X'
          if (data && !data.oauthConfigured) twitterConnect.setAttribute('disabled', 'disabled')
          else twitterConnect.removeAttribute('disabled')
        }
        if (twitterConnectEnv) twitterConnectEnv.classList.toggle('hidden', !data?.configuredFromEnv)
      }

      const refreshTwitter = async () => {
        try {
          const response = await fetch('/api/postline/twitter/status')
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Could not load X/Twitter status.')
          renderTwitter(payload.data)
        }
        catch (error) {
          renderTwitter(null)
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'X/Twitter' })
        }
      }

      twitterConnect?.addEventListener('click', () => {
        notify('Redirecting to X…', 'info', { title: 'X/Twitter' })
        navigate('/api/postline/twitter/auth', true)
      })

      twitterConnectEnv?.addEventListener('click', async () => {
        twitterConnectEnv.setAttribute('disabled', 'disabled')
        notify('Connecting X from .env…', 'info', { title: 'X/Twitter' })
        try {
          const response = await fetch('/api/postline/twitter/connect', { method: 'POST' })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'X connect failed.')
          await refreshTwitter()
          notify('X connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          twitterConnectEnv.removeAttribute('disabled')
        }
      })

      const twitterCallback = consumeOAuthResult('twitter')
      if (twitterCallback?.value === 'connected')
        notify('X connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
      else if (twitterCallback?.value === 'error')
        notify(twitterCallback.message || 'X connection failed.', 'error', { title: 'X/Twitter' })

      const startTwitter = () => void refreshTwitter()
      onMount(startTwitter)

      // --- Instagram ---
      const instagramHandle = root.querySelector('[data-instagram-channel-handle]')
      const instagramDetail = root.querySelector('[data-instagram-channel-detail]')
      const instagramStatusPill = root.querySelector('[data-instagram-channel-status]')
      const instagramConnect = root.querySelector('[data-instagram-connect]')
      const instagramConnectEnv = root.querySelector('[data-instagram-connect-env]')

      const renderInstagram = (data) => {
        const connected = Boolean(data?.canPublish)
        const label = data?.handle ? `@${data.handle}` : 'Not connected'
        if (instagramHandle) {
          instagramHandle.textContent = connected ? label : (data?.handle ? `${label}, reconnect` : 'Not connected')
        }
        if (instagramDetail) {
          instagramDetail.textContent = connected
            ? 'Ready to crosspost. Remember Instagram posts need an image.'
            : data?.oauthConfigured
              ? 'Connect an Instagram Business account to crosspost. Posts require an image.'
              : data?.configuredFromEnv
                ? 'Token found in .env. Connect to start crossposting.'
                : 'Add Instagram Graph API keys to .env, then connect.'
        }
        if (instagramStatusPill) {
          instagramStatusPill.textContent = connected ? 'Connected' : (data?.handle ? 'Reconnect' : 'Setup')
          instagramStatusPill.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-[11px] font-bold ${
            connected
              ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
              : data?.handle
                ? 'border-amber-200 bg-amber-50 text-amber-800'
                : 'border-line text-muted'
          }`
        }
        if (instagramConnect) {
          instagramConnect.textContent = connected ? 'Reconnect Instagram' : 'Connect with Instagram'
          if (data && !data.oauthConfigured) instagramConnect.setAttribute('disabled', 'disabled')
          else instagramConnect.removeAttribute('disabled')
        }
        if (instagramConnectEnv) instagramConnectEnv.classList.toggle('hidden', !data?.configuredFromEnv)
      }

      const refreshInstagram = async () => {
        try {
          const data = await window.postlineInstagram?.fetchStatus()
          renderInstagram(data)
        }
        catch (error) {
          renderInstagram(null)
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Instagram' })
        }
      }

      instagramConnect?.addEventListener('click', () => {
        notify('Redirecting to Instagram…', 'info', { title: 'Instagram' })
        navigate('/api/postline/instagram/auth', true)
      })

      instagramConnectEnv?.addEventListener('click', async () => {
        instagramConnectEnv.setAttribute('disabled', 'disabled')
        notify('Connecting Instagram from .env…', 'info', { title: 'Instagram' })
        try {
          const response = await fetch('/api/postline/instagram/connect', { method: 'POST' })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Instagram connect failed.')
          await refreshInstagram()
          notify('Instagram connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          instagramConnectEnv.removeAttribute('disabled')
        }
      })

      const instagramCallback = consumeOAuthResult('instagram')
      if (instagramCallback?.value === 'connected')
        notify('Instagram connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
      else if (instagramCallback?.value === 'error')
        notify(instagramCallback.message || 'Instagram connection failed.', 'error', { title: 'Instagram' })

      const startInstagram = () => void refreshInstagram()
      onMount(startInstagram)

      // --- Threads ---
      const threadsHandle = root.querySelector('[data-threads-channel-handle]')
      const threadsDetail = root.querySelector('[data-threads-channel-detail]')
      const threadsStatusPill = root.querySelector('[data-threads-channel-status]')
      const threadsConnect = root.querySelector('[data-threads-connect]')
      const threadsConnectEnv = root.querySelector('[data-threads-connect-env]')

      const renderThreads = (data) => {
        const connected = Boolean(data?.canPublish)
        const label = data?.handle ? `@${data.handle}` : 'Not connected'
        if (threadsHandle) {
          threadsHandle.textContent = connected ? label : (data?.handle ? `${label}, reconnect` : 'Not connected')
        }
        if (threadsDetail) {
          threadsDetail.textContent = connected
            ? 'Ready to crosspost from Postline.'
            : data?.oauthConfigured
              ? 'Connect a Threads account to crosspost.'
              : data?.configuredFromEnv
                ? 'Token found in .env. Connect to start crossposting.'
                : 'Add Threads API keys to .env, then connect.'
        }
        if (threadsStatusPill) {
          threadsStatusPill.textContent = connected ? 'Connected' : (data?.handle ? 'Reconnect' : 'Setup')
          threadsStatusPill.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-[11px] font-bold ${
            connected
              ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
              : data?.handle
                ? 'border-amber-200 bg-amber-50 text-amber-800'
                : 'border-line text-muted'
          }`
        }
        if (threadsConnect) {
          threadsConnect.textContent = connected ? 'Reconnect Threads' : 'Connect with Threads'
          if (data && !data.oauthConfigured) threadsConnect.setAttribute('disabled', 'disabled')
          else threadsConnect.removeAttribute('disabled')
        }
        if (threadsConnectEnv) threadsConnectEnv.classList.toggle('hidden', !data?.configuredFromEnv)
      }

      const refreshThreads = async () => {
        try {
          const data = await window.postlineThreads?.fetchStatus()
          renderThreads(data)
        }
        catch (error) {
          renderThreads(null)
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Threads' })
        }
      }

      threadsConnect?.addEventListener('click', () => {
        notify('Redirecting to Threads…', 'info', { title: 'Threads' })
        navigate('/api/postline/threads/auth', true)
      })

      threadsConnectEnv?.addEventListener('click', async () => {
        threadsConnectEnv.setAttribute('disabled', 'disabled')
        notify('Connecting Threads from .env…', 'info', { title: 'Threads' })
        try {
          const response = await fetch('/api/postline/threads/connect', { method: 'POST' })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Threads connect failed.')
          await refreshThreads()
          notify('Threads connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          threadsConnectEnv.removeAttribute('disabled')
        }
      })

      const threadsCallback = consumeOAuthResult('threads')
      if (threadsCallback?.value === 'connected')
        notify('Threads connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
      else if (threadsCallback?.value === 'error')
        notify(threadsCallback.message || 'Threads connection failed.', 'error', { title: 'Threads' })

      const startThreads = () => void refreshThreads()
      onMount(startThreads)

      // --- Mastodon ---
      const mastodonForm = root.querySelector('[data-mastodon-connect-form]')
      const mastodonInstance = root.querySelector('[data-mastodon-instance]')
      const mastodonToken = root.querySelector('[data-mastodon-token]')
      const mastodonSubmit = root.querySelector('[data-mastodon-connect-submit]')
      const mastodonHandle = root.querySelector('[data-mastodon-channel-handle]')
      const mastodonDetail = root.querySelector('[data-mastodon-channel-detail]')
      const mastodonStatusPill = root.querySelector('[data-mastodon-channel-status]')

      const renderMastodon = (data) => {
        const connected = Boolean(data?.canPublish)
        if (mastodonHandle) mastodonHandle.textContent = connected ? data.handle : (data?.handle ? `${data.handle}, reconnect` : 'Not connected')
        if (mastodonInstance && data?.instance) mastodonInstance.value = data.instance
        if (mastodonDetail) {
          mastodonDetail.textContent = connected
            ? 'Ready to crosspost from Postline.'
            : data?.configuredFromEnv
              ? 'Token found in .env. Connect to start crossposting.'
              : 'Connect any Mastodon instance with an access token to crosspost.'
        }
        if (mastodonStatusPill) {
          mastodonStatusPill.textContent = connected ? 'Connected' : (data?.handle ? 'Reconnect' : 'Setup')
          mastodonStatusPill.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-[11px] font-bold ${
            connected
              ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
              : data?.handle
                ? 'border-amber-200 bg-amber-50 text-amber-800'
                : 'border-line text-muted'
          }`
        }
        if (mastodonSubmit) mastodonSubmit.textContent = connected ? 'Reconnect' : 'Connect'
      }

      const refreshMastodon = async () => {
        try {
          const response = await fetch('/api/postline/mastodon/status')
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Could not load Mastodon status.')
          renderMastodon(payload.data)
        }
        catch (error) {
          renderMastodon(null)
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Mastodon' })
        }
      }

      mastodonForm?.addEventListener('submit', async (event) => {
        event.preventDefault()
        mastodonSubmit?.setAttribute('disabled', 'disabled')
        notify('Connecting to Mastodon…', 'info', { title: 'Mastodon' })
        try {
          const response = await fetch('/api/postline/mastodon/connect', { method: 'POST', body: new FormData(mastodonForm) })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Mastodon connect failed.')
          if (mastodonToken) mastodonToken.value = ''
          await refreshMastodon()
          notify(`${payload.data.handle} is connected. You can crosspost from the composer.`, 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          mastodonSubmit?.removeAttribute('disabled')
        }
      })

      const startMastodon = () => void refreshMastodon()
      onMount(startMastodon)

      // --- Danger zone: bulk post deletion ---
      const purgeCard = root.querySelector('[data-purge-card]')
      const purgePreview = root.querySelector('[data-purge-preview]')
      const purgeRun = root.querySelector('[data-purge-run]')
      const purgeConfirmation = root.querySelector('[data-purge-confirmation]')
      const purgeSummary = root.querySelector('[data-purge-summary]')
      const purgeHint = root.querySelector('[data-purge-hint]')
      const PURGE_PHRASE = 'DELETE ALL POSTS'

      // A preview is only valid for the selection it ran against — changing
      // scope or accounts invalidates it and re-locks the delete button.
      let previewedSelection = null

      const purgeScope = () => root.querySelector('[data-purge-scope]:checked')?.value || 'tracked'
      const purgeProviders = () => Array.from(root.querySelectorAll('[data-purge-provider]:checked')).map(input => input.value)
      const purgeSelection = () => `${purgeScope()}:${purgeProviders().sort().join(',')}`

      const purgeResultRows = state([])

      /** One purge-result row flattened to exactly what the template renders. */
      const purgeRows = derived(() => purgeResultRows().map((row) => ({
        heading: row.handle ? `${row.provider} — ${row.handle}` : row.provider,
        // A skip reason always wins — it explains a zero that would otherwise
        // read as "nothing to delete" (e.g. LinkedIn refusing to list history).
        detail: row.skippedReason
          ? row.skippedReason
          : !row.supported || !row.connected
              ? 'Not available.'
              : `${row.matched} post${row.matched === 1 ? '' : 's'} would be deleted${row.truncated ? ' (capped at 2000 per run — run again for the rest)' : ''}.`,
      })))

      const renderPurgeResults = (data) => purgeResultRows.set(data?.providers || [])

      const syncPurgeButton = () => {
        const phraseOk = purgeConfirmation?.value === PURGE_PHRASE
        const previewOk = previewedSelection === purgeSelection()
        const enabled = Boolean(phraseOk && previewOk && purgeProviders().length)
        if (purgeRun) purgeRun.disabled = !enabled
        if (purgeHint) {
          purgeHint.textContent = !purgeProviders().length
            ? 'Pick at least one account.'
            : !previewOk
              ? 'Run a preview for this selection first.'
              : !phraseOk
                ? `Type ${PURGE_PHRASE} exactly to enable deletion.`
                : 'This permanently deletes the posts listed above.'
        }
      }

      purgeCard?.addEventListener('change', (event) => {
        // Any change to scope or accounts stales the preview.
        if (event.target?.matches('[data-purge-scope], [data-purge-provider]')) previewedSelection = null
        syncPurgeButton()
      })
      purgeConfirmation?.addEventListener('input', syncPurgeButton)

      purgePreview?.addEventListener('click', async () => {
        const providers = purgeProviders()
        if (!providers.length) {
          notify('Pick at least one account to preview.', 'error', { title: 'Danger zone' })
          return
        }

        purgePreview.setAttribute('disabled', 'disabled')
        if (purgeSummary) purgeSummary.textContent = 'Counting…'
        try {
          const query = new URLSearchParams({ scope: purgeScope(), providers: providers.join(',') })
          const response = await fetch(`/api/postline/purge/preview?${query.toString()}`)
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Preview failed.')

          renderPurgeResults(payload.data)
          previewedSelection = purgeSelection()
          if (purgeSummary) purgeSummary.textContent = `${payload.data.matched} post${payload.data.matched === 1 ? '' : 's'} matched.`
        }
        catch (error) {
          previewedSelection = null
          if (purgeSummary) purgeSummary.textContent = 'Preview failed.'
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Danger zone' })
        }
        finally {
          purgePreview.removeAttribute('disabled')
          syncPurgeButton()
        }
      })

      purgeRun?.addEventListener('click', async () => {
        const scope = purgeScope()
        const label = scope === 'all' ? 'every post on the selected accounts' : 'every post Postline published'
        // Last stop before an irreversible action.
        if (!window.confirm(`Permanently delete ${label}? This cannot be undone.`)) return

        purgeRun.disabled = true
        notify('Deleting posts…', 'info', { title: 'Danger zone' })
        try {
          const body = new FormData()
          body.set('scope', scope)
          body.set('providers', purgeProviders().join(','))
          body.set('confirmation', purgeConfirmation?.value || '')

          const response = await fetch('/api/postline/purge', { method: 'POST', body })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Deletion failed.')

          renderPurgeResults(payload.data)
          previewedSelection = null
          if (purgeConfirmation) purgeConfirmation.value = ''
          if (purgeSummary) purgeSummary.textContent = `${payload.data.deleted} deleted, ${payload.data.failed} failed.`
          notify(
            `Deleted ${payload.data.deleted} post${payload.data.deleted === 1 ? '' : 's'}.${payload.data.failed ? ` ${payload.data.failed} failed.` : ''}`,
            payload.data.failed ? 'error' : 'success',
            { title: 'Danger zone' },
          )
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Deletion failed' })
        }
        finally {
          syncPurgeButton()
        }
      })

      syncPurgeButton()

      // Gate the initial status fetch on DOMContentLoaded so the deferred
      // postline-bluesky module has loaded — otherwise a connected account
      // renders "Not connected" on a full page load. (Mirrors the other
      // providers.)
      const startBluesky = () => void refreshStatus()
      onMount(startBluesky)
    })()
  </script>
@endsection
