@extends('layouts/app')

<script server>
import { workspaceChannelsText, workspaceLocale } from '../../app/Support/Localization/workspace'
import { loadNetworkSetupGuides } from '../../app/Support/Social/network-setup-guides'

const networkSetupGuides = await loadNetworkSetupGuides(workspaceLocale)
export const channelsLocale = workspaceLocale
export const channelsText = workspaceChannelsText
export const channelsClient = { locale: workspaceLocale, messages: workspaceChannelsText }
</script>

@section('title'){{ channelsText.title }}@endsection

@section('content')
  @meta('description', channelsText.description)
  <section class="grid gap-4" data-postline-page="accounts" data-testid="accounts-page" lang="{{ channelsLocale }}">
    <WorkspacePageHeader titleKey="workspace.pages.accounts.title">
      <template #description><span class="block min-h-5" :text="channelSummary()"></span></template>
      <a class="inline-flex gap-2 items-center justify-center px-4 h-9 w-fit font-semibold text-ink text-sm bg-panel hover:bg-raised border border-line rounded-xl shadow-sm transition-colors" :href="returnToSetup() ? '/setup?step=channels' : '/composer'" data-stx-link>
        <span class="h-4 w-4 i-hugeicons-edit-02" aria-hidden="true"></span>
        <span :text="returnToSetup() ? copy.setup : copy.composer">{{ channelsText.composer }}</span>
      </a>
      <StxLink class="text-info text-ui underline" to="/listening">{{ channelsText.listen }}</StxLink>
    </WorkspacePageHeader>

    <nav class="flex gap-1 p-1 w-fit bg-panel-3 border border-line rounded-xl" aria-label="{{ channelsText.sections }}">
      <a class="inline-flex items-center justify-center px-3 h-8 font-semibold text-muted text-xs hover:text-ink rounded-lg transition-colors" href="/settings" data-stx-link data-no-router>{{ channelsText.general }}</a>
      <a class="inline-flex items-center justify-center px-3 h-8 font-semibold text-ink text-xs bg-panel border border-line rounded-lg shadow-sm" href="/accounts" data-stx-link aria-current="page">{{ channelsText.channels }}</a>
    </nav>

    <InstagramPagePicker />

    <section aria-labelledby="publishing-channels-title" :aria-busy="!channelsReady() && !bootstrap.error()">
      <Card padding="none" className="shadow-sm">
        <header class="flex gap-3 items-start justify-between px-4 py-3.5 border-b border-line">
          <div>
            <h2 class="m-0 font-semibold text-ink text-sm" id="publishing-channels-title">{{ channelsText.publishing }}</h2>
            <p class="m-0 mt-1 text-muted text-xs">{{ channelsText.credentialStorage }}</p>
          </div>
        </header>
        <p class="m-0 pt-3 px-4 text-sm" role="status" x-cloak x-show="oauthFeedback()" :class="oauthFailed() ? 'text-danger' : nativeConsentPending() ? 'text-muted' : 'text-success'" :text="oauthFeedback()"></p>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3 p-3" x-show="!channelsReady() && !bootstrap.error()" data-channels-loading>
          <span class="sr-only" role="status">{{ channelsText.loading }}</span>
          @for(i = 0; i < 3; i++)
            <div class="grid gap-4 p-4 min-h-52 border border-line rounded-2xl" aria-hidden="true">
              <Skeleton variant="avatar" className="bg-panel-2" />
              <Skeleton variant="text" className="w-3/4 bg-panel-2" />
              <Skeleton variant="text" className="w-1/2 bg-panel-2" />
            </div>
          @endfor
        </div>
        <ErrorState :show="bootstrap.error() && !channelsReady()" title="{{ channelsText.loadFailed }}" :message="bootstrap.error()" @retry="bootstrap.refresh()" testID="channels-error" />
        <EmptyState :show="channelsReady() && !channelProviders().length" variant="bare" title="{{ channelsText.empty }}" description="{{ channelsText.emptyDescription }}">
          <Button variant="secondary" size="xs" @click="bootstrap.refresh()">{{ channelsText.refresh }}</Button>
        </EmptyState>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3 p-3" x-cloak x-show="channelsReady()" data-publishing-channels>
          <div class="min-w-0" x-for="provider in channelProviders()" :key="provider">
            <NetworkChannelCard :provider="provider" :guide="guides[provider]" :authorizing="nativeConsentPending()" @authorize="startConsent(provider, false)" />
          </div>
        </div>
      </Card>
    </section>

    <XBrowserSession />

    {{--
      Bring your own keys: the X API, LinkedIn, Instagram and Threads sign in through a
      developer app the owner registers on each network. Its client id and
      secret are entered here (the secret is stored sealed), so no file has to
      be edited, which the Mac app cannot do at all.
    --}}
    <section aria-label="{{ channelsText.apps }}" x-cloak x-show="channelsReady()" data-network-apps>
      <Card padding="none" className="shadow-sm">
        <header class="px-4 py-3.5 border-b border-line">
          <h2 class="m-0 font-semibold text-ink text-sm">{{ channelsText.apps }}</h2>
          <p class="m-0 mt-1 text-muted text-xs">{{ channelsText.appsDescription }}</p>
        </header>
        <div class="divide-line divide-y">
          <details class="group" x-for="app in appRows()" :key="app.provider" :data-network-app="app.provider">
            <summary class="flex gap-3 items-center justify-between px-4 py-3 list-none hover:bg-panel-2 cursor-pointer">
              <span class="font-medium text-ink text-ui" :text="app.label"></span>
              <span class="flex gap-2 items-center">
                <Badge size="sm" :variant="app.configured ? 'success' : 'default'">{{ app.status }}</Badge>
                <span class="h-4 w-4 text-muted transition-transform group-open:rotate-180 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
              </span>
            </summary>
            <div class="grid gap-3 pb-4 px-4">
              <ol class="grid gap-1 m-0 pl-5 text-body text-xs" :lang="app.guideLanguage">
                <li x-for="step in app.steps" :text="step"></li>
              </ol>
              <a class="w-fit text-info text-xs underline" :href="app.guideUrl" :aria-label="words.t('networkGuide', { network: app.label })" target="_blank" rel="noopener noreferrer" x-show="app.guideUrl">{{ channelsText.fullGuide }}</a>
              <p class="m-0 text-body text-xs" x-show="app.readUsage" :text="app.readUsage" data-x-read-usage></p>
              <div class="grid gap-1">
                <span class="font-medium text-muted text-xs">{{ channelsText.redirectAddress }}</span>
                <div class="flex gap-2 items-center">
                  <code class="flex-1 px-2.5 py-1.5 min-w-0 text-ink text-xs truncate bg-panel-2 border border-line rounded-lg" :text="app.redirectUrl" :title="app.redirectUrl"></code>
                  <Button variant="secondary" size="xs" className="shrink-0" @click="copyRedirect(app.provider)">{{ channelsText.copy }}</Button>
                </div>
              </div>
              <form @submit.prevent="changeApp(app.provider, 'save')">
                <fieldset class="grid gap-2 sm:grid-cols-2 m-0 p-0 min-w-0 border-0" :disabled="Boolean(appBusy()[app.provider])">
                  <label class="grid gap-1 text-muted text-xs">
                    <span>{{ channelsText.clientId }}</span>
                    <input class="px-3 h-9 text-ink text-ui bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" type="text" autocomplete="off" spellcheck="false" :value="app.clientId" @input="setAppField(app.provider, 'clientId', $event)" data-app-client-id>
                  </label>
                  <label class="grid gap-1 text-muted text-xs" x-show="!app.publicClient">
                    <span>{{ channelsText.clientSecret }}</span>
                    <input class="px-3 h-9 text-ink text-ui bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" type="password" autocomplete="off" :disabled="app.publicClient" :placeholder="app.secretPlaceholder" :value="app.clientSecret" @input="setAppField(app.provider, 'clientSecret', $event)" data-app-client-secret>
                  </label>
                  <label class="gap-2 items-start sm:col-span-2 text-body text-xs" :class="app.allowsPublicClient ? 'flex' : 'hidden'">
                    <input class="mt-0.5" type="checkbox" :checked="app.publicClient" @change="setAppFlag(app.provider, 'publicClient', $event)" data-app-public-client>
                    <span :text="app.provider === 'linkedin' ? copy.publicLinkedInApp : copy.publicXApp"></span>
                  </label>
                  <p class="sm:col-span-2 m-0 text-muted text-xs" x-show="app.removesSecret">{{ channelsText.publicAppRemovesSecret }}</p>
                  {{-- LinkedIn company Pages (#130): opt-in, since the scopes need a product the app may not have. --}}
                  <label class="gap-2 items-start sm:col-span-2 text-body text-xs" :class="app.provider === 'linkedin' ? 'flex' : 'hidden'">
                    <input class="mt-0.5" type="checkbox" :checked="app.organizationPages" @change="setAppFlag(app.provider, 'organizationPages', $event)" data-app-organization-pages>
                    <span>{{ channelsText.companyPages }}</span>
                  </label>
                  <label class="flex gap-2 items-start sm:col-span-2 text-body text-xs">
                    <input class="mt-0.5" type="checkbox" :checked="app.engagementMetrics" @change="setAppFlag(app.provider, 'engagementMetrics', $event)">
                    <span :text="app.provider === 'twitter' ? copy.paidEngagement : copy.engagement"></span>
                  </label>
                  <label class="gap-2 items-start sm:col-span-2 text-body text-xs" :class="app.provider === 'twitter' ? 'flex' : 'hidden'">
                    <input class="mt-0.5" type="checkbox" :checked="app.directMessages" @change="setAppFlag(app.provider, 'directMessages', $event)" data-app-direct-messages>
                    <span>{{ channelsText.paidMessages }}</span>
                  </label>
                  <label class="gap-2 items-start sm:col-span-2 text-body text-xs" :class="app.provider === 'instagram' ? 'flex' : 'hidden'">
                    <input class="mt-0.5" type="checkbox" :checked="app.firstComments" @change="setAppFlag(app.provider, 'firstComments', $event)">
                    <span>{{ channelsText.firstComments }}</span>
                  </label>
                  <div class="flex flex-wrap gap-2 items-center sm:col-span-2">
                    <p class="m-0 mr-auto text-muted text-xs" :text="app.note"></p>
                    <Button variant="danger" size="xs" :show="app.removable" :disabled="Boolean(appBusy()[app.provider])" :loading="appBusy()[app.provider] === 'clear'" @click="changeApp(app.provider, 'clear')">{{ channelsText.remove }}</Button>
                    <Button variant="secondary" size="xs" :disabled="!app.testReady || Boolean(appBusy()[app.provider]) || nativeConsentPending()" @click="startConsent(app.provider, true)">{{ channelsText.testConnection }}</Button>
                    <Button size="xs" type="submit" :disabled="Boolean(appBusy()[app.provider])" :loading="appBusy()[app.provider] === 'save'" :label="appBusy()[app.provider] === 'save' ? copy.saving : copy.save">{{ channelsText.save }}</Button>
                  </div>
                </fieldset>
              </form>
            </div>
          </details>
        </div>
      </Card>
    </section>

    <WorkspaceCleanup :show="channelsReady() || bootstrap.error()" />
  </section>

  <script client>
    import { createI18n } from '@stacksjs/i18n/client'
    import { openNativeNetworkConsent } from '../functions/native-network-consent'
    import { showNotification } from '../functions/notification'

    const { locale: language, messages: copy } = {{ channelsClient }}
    const words = createI18n({ locale: language, messages: { [language]: copy } })
    const numbers = new Intl.NumberFormat(language)
    const plural = new Intl.PluralRules(language)
    const bootstrap = workspaceBootstrapQuery()
    const channelsReady = derived(() => Boolean(bootstrap.data()))
    const channelProviders = derived(() => bootstrap.data()?.providers.map(status => status.provider) ?? [])
    const channelSummary = derived(() => {
      if (!channelsReady()) return ''
      const count = channelProviders().length
      return words.t(plural.select(count) === 'one' ? 'channelCountOne' : 'channelCountMany', { count: numbers.format(count) })
    })
    const networkApps = derived(() => bootstrap.data()?.networkApps ?? [])
    const oauthFeedback = state('')
    const oauthFailed = state(false)
    const desktop = useNativeDesktop()
    const nativeConsentPending = state(false)
    let consent: AbortController | undefined

    onUnmounted(() => consent?.abort())

    async function startConsent(provider: string, test: boolean) {
      const host = desktop()
      if (!host) {
        navigate('/api/postline/' + provider + '/auth' + (test ? '?test=1' : ''), { reload: true })
        return
      }
      if (nativeConsentPending()) return
      consent = new AbortController()
      const { signal } = consent
      nativeConsentPending.set(true)
      oauthFailed.set(false)
      oauthFeedback.set('')
      try {
        const destination = await openNativeNetworkConsent(host, provider, test, signal, copy, () => oauthFeedback.set(copy.completeInBrowser))
        navigate(destination, { reload: true })
      }
      catch (error) {
        if (!signal.aborted) {
          oauthFailed.set(true)
          oauthFeedback.set(error instanceof Error ? error.message : copy.browserUnavailable)
        }
      }
      finally {
        if (consent?.signal === signal) {
          nativeConsentPending.set(false)
          consent = undefined
        }
      }
    }

    const setupInProgress = useSessionStorage('postline.setup.in-progress', false)
    const setupRequested = useRoute().query.setup === '1'
    const returnToSetup = derived(() => setupRequested || setupInProgress())

    onMount(() => void bootstrap.load())

    // Network app forms keep unsaved credentials in this view only.
    const appDrafts = state({})
    type AppAction = 'save' | 'clear'
    const appBusy = state<Partial<Record<string, AppAction>>>({})
    const guides = {{ networkSetupGuides }}
    const usd = new Intl.NumberFormat(language, { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 3 })
    const appRows = derived(() => networkApps().map((app) => {
      const guide = guides[app.provider]
      const draft = appDrafts()[app.provider] || {}
      const clientId = draft.clientId ?? app.clientId
      const clientSecret = draft.clientSecret ?? ''
      const publicClient = draft.publicClient ?? Boolean(app.publicClient)
      const organizationPages = draft.organizationPages ?? Boolean(app.organizationPages)
      const engagementMetrics = draft.engagementMetrics ?? Boolean(app.engagementMetrics)
      const directMessages = draft.directMessages ?? Boolean(app.directMessages)
      const firstComments = draft.firstComments ?? Boolean(app.firstComments)
      const hasChanges = clientId.trim() !== app.clientId || (!publicClient && Boolean(clientSecret.trim()))
        || publicClient !== Boolean(app.publicClient)
        || organizationPages !== Boolean(app.organizationPages) || engagementMetrics !== Boolean(app.engagementMetrics)
        || directMessages !== Boolean(app.directMessages)
        || firstComments !== Boolean(app.firstComments)
      return {
        provider: app.provider,
        label: guide?.label ?? app.provider,
        steps: guide?.steps ?? [],
        guideUrl: guide?.url ?? '',
        guideLanguage: guide?.language ?? language,
        configured: app.configured,
        readUsage: app.readUsage
          ? words.t('readUsage', { used: usd.format(app.readUsage.estimatedUsd), limit: usd.format(app.readUsage.limitUsd) })
          : '',
        status: app.configured ? (app.source === 'environment' ? copy.environment : copy.configured) : copy.unconfigured,
        redirectUrl: app.redirectUrl,
        clientId,
        clientSecret,
        allowsPublicClient: app.allowsPublicClient,
        publicClient,
        removesSecret: publicClient && app.source === 'settings' && app.hasSecret,
        organizationPages,
        engagementMetrics,
        directMessages,
        firstComments,
        secretPlaceholder: app.hasSecret ? copy.keepSecret : copy.pasteSecret,
        removable: app.source === 'settings',
        testReady: app.configured && !hasChanges,
        note: app.source === 'environment' ? copy.environmentNote : app.configured ? copy.configuredNote : '',
      }
    }))
    const setAppField = (provider, field, event) => {
      const drafts = { ...appDrafts() }
      drafts[provider] = { ...(drafts[provider] || {}), [field]: String(event?.target?.value || '') }
      appDrafts.set(drafts)
    }
    const setAppFlag = (provider, field, event) => {
      const drafts = { ...appDrafts() }
      drafts[provider] = { ...(drafts[provider] || {}), [field]: Boolean(event?.target?.checked) }
      appDrafts.set(drafts)
    }
    async function changeApp(provider: string, action: AppAction) {
      if (appBusy()[provider]) return
      const row = appRows().find(entry => entry.provider === provider)
      if (!row) return
      if (action === 'clear') {
        if (!row.removable || !await stxConfirm(words.t('removeWarning', { network: row.label }), { title: words.t('removeTitle', { network: row.label }), type: 'error', confirmText: copy.removeApp })) return
        if (appBusy()[provider]) return
      }
      appBusy.update(actions => ({ ...actions, [provider]: action }))
      try {
        const body = new FormData()
        body.set('provider', provider)
        if (action === 'save') {
          body.set('client_id', row.clientId || '')
          if (!row.publicClient) body.set('client_secret', row.clientSecret || '')
          if (provider === 'linkedin') body.set('organization_pages', row.organizationPages ? '1' : '0')
          body.set('engagement_metrics', row.engagementMetrics ? '1' : '0')
          if (row.allowsPublicClient) body.set('public_client', row.publicClient ? '1' : '0')
          if (provider === 'twitter') body.set('direct_messages', row.directMessages ? '1' : '0')
          if (provider === 'instagram') body.set('first_comments', row.firstComments ? '1' : '0')
          await requestJson('/api/postline/network-apps', { method: 'POST', body }, copy.saveFailed)
          const drafts = { ...appDrafts() }
          delete drafts[provider]
          appDrafts.set(drafts)
        }
        else {
          await requestJson('/api/postline/network-apps/clear', { method: 'POST', body }, copy.removeFailed)
        }
        await bootstrap.load()
        if (action === 'save') showNotification({ message: words.t('appSaved', { network: row.label }), tone: 'success', title: row.label })
      }
      catch (error) {
        showNotification({ message: error instanceof Error ? error.message : String(error), tone: 'error', title: row.label })
      }
      finally {
        const pending = { ...appBusy() }
        delete pending[provider]
        appBusy.set(pending)
      }
    }

    async function copyRedirect(provider: string) {
      const row = appRows().find(entry => entry.provider === provider)
      if (!row) return
      try {
        await navigator.clipboard.writeText(row.redirectUrl)
        showNotification({ message: copy.copied, tone: 'success', title: row.label })
      }
      catch {
        showNotification({ message: row.redirectUrl, tone: 'info', title: copy.copyManually })
      }
    }

    ;(() => {
      const route = useRoute()
      for (const provider of ['linkedin', 'twitter', 'instagram', 'threads']) {
        const result = route.query[provider]
        if (!['connected', 'tested', 'error'].includes(result)) continue
        const params = new URLSearchParams(route.fullPath.split('?')[1] || '')
        const message = params.get('message')
        params.delete(provider)
        params.delete('message')
        const query = params.toString()
        window.history.replaceState({}, '', `${route.path}${query ? `?${query}` : ''}`)
        oauthFailed.set(result === 'error')
        const name = providerLabel(provider)
        if (result === 'connected') oauthFeedback.set(words.t('connected', { network: name }))
        else if (result === 'tested') oauthFeedback.set(words.t('connectionPassed', { network: name }))
        else oauthFeedback.set(message || words.t('connectionFailed', { network: name }))
        if (result === 'connected') {
          // The redirected page reads the fresh account as it mounts.
          // Notify any existing workspace windows as well.
          onMount(() => announceWorkspaceChange())
        }
        break
      }
    })()
  </script>
@endsection
