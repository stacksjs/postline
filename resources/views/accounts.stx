@extends('layouts/app')

<script server>
import { workspaceChannelsText, workspaceLocale } from '../../app/Support/Localization/workspace'
import { loadNetworkSetupGuides } from '../../app/Support/Social/network-setup-guides'

const networkSetupGuides = await loadNetworkSetupGuides()
export const channelsLocale = workspaceLocale
export const channelsText = workspaceChannelsText
export const channelsClient = { locale: workspaceLocale, messages: workspaceChannelsText }
</script>

@section('title'){{ channelsText.title }}@endsection

@section('content')
  @meta('description', channelsText.description)
  <section class="grid gap-4" data-postline-page="accounts" data-testid="accounts-page" lang="{{ channelsLocale }}">
    <WorkspacePageHeader titleKey="workspace.pages.accounts.title">
      <template #description><span class="block min-h-5" :text="channelSummary()"></span></template>
      <a class="inline-flex gap-2 items-center justify-center px-4 h-9 w-fit font-semibold text-ink text-sm bg-panel hover:bg-raised border border-line rounded-xl shadow-sm transition-colors" :href="returnToSetup() ? '/setup?step=channels' : '/composer'" data-stx-link>
        <span class="h-4 w-4 i-hugeicons-edit-02" aria-hidden="true"></span>
        <span :text="returnToSetup() ? copy.setup : copy.composer">{{ channelsText.composer }}</span>
      </a>
      <StxLink class="text-info text-ui underline" to="/listening">{{ channelsText.listen }}</StxLink>
    </WorkspacePageHeader>

    <nav class="flex gap-1 p-1 w-fit bg-panel-3 border border-line rounded-xl" aria-label="{{ channelsText.sections }}">
      <a class="inline-flex items-center justify-center px-3 h-8 font-semibold text-muted text-xs hover:text-ink rounded-lg transition-colors" href="/settings" data-stx-link data-no-router>{{ channelsText.general }}</a>
      <a class="inline-flex items-center justify-center px-3 h-8 font-semibold text-ink text-xs bg-panel border border-line rounded-lg shadow-sm" href="/accounts" data-stx-link aria-current="page">{{ channelsText.channels }}</a>
    </nav>

    <InstagramPagePicker />

    <section aria-labelledby="publishing-channels-title" :aria-busy="!channelsReady() && !bootstrap.error()">
      <Card padding="none" className="shadow-sm">
        <header class="flex gap-3 items-start justify-between px-4 py-3.5 border-b border-line">
          <div>
            <h2 class="m-0 font-semibold text-ink text-sm" id="publishing-channels-title">{{ channelsText.publishing }}</h2>
            <p class="m-0 mt-1 text-muted text-xs">{{ channelsText.credentialStorage }}</p>
          </div>
        </header>
        <p class="m-0 pt-3 px-4 text-sm" role="status" x-cloak x-show="oauthFeedback()" :class="oauthFailed() ? 'text-danger' : 'text-success'" :text="oauthFeedback()"></p>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3 p-3" x-show="!channelsReady() && !bootstrap.error()" data-channels-loading>
          <span class="sr-only" role="status">{{ channelsText.loading }}</span>
          @for(i = 0; i < 3; i++)
            <div class="grid gap-4 p-4 min-h-52 border border-line rounded-2xl" aria-hidden="true">
              <Skeleton variant="avatar" className="bg-panel-2" />
              <Skeleton variant="text" className="w-3/4 bg-panel-2" />
              <Skeleton variant="text" className="w-1/2 bg-panel-2" />
            </div>
          @endfor
        </div>
        <ErrorState :show="bootstrap.error() && !channelsReady()" title="{{ channelsText.loadFailed }}" :message="bootstrap.error()" @retry="bootstrap.refresh()" testID="channels-error" />
        <EmptyState :show="channelsReady() && !channelProviders().length" variant="bare" title="{{ channelsText.empty }}" description="{{ channelsText.emptyDescription }}">
          <button class="text-info text-ui underline" type="button" @click="bootstrap.refresh()">{{ channelsText.refresh }}</button>
        </EmptyState>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3 p-3" x-cloak x-show="channelsReady()" data-publishing-channels>
          <div class="min-w-0" x-for="provider in channelProviders()" :key="provider">
            <NetworkChannelCard :provider="provider" :guide="guides[provider]" />
          </div>
        </div>
      </Card>
    </section>

    <XBrowserSession />

    {{--
      Bring your own keys: the X API, LinkedIn, Instagram and Threads sign in through a
      developer app the owner registers on each network. Its client id and
      secret are entered here (the secret is stored sealed), so no file has to
      be edited, which the Mac app cannot do at all.
    --}}
    <section aria-label="{{ channelsText.apps }}" x-cloak x-show="channelsReady()" data-network-apps>
      <Card padding="none" className="shadow-sm">
        <header class="px-4 py-3.5 border-b border-line">
          <h2 class="m-0 font-semibold text-ink text-sm">{{ channelsText.apps }}</h2>
          <p class="m-0 mt-1 text-muted text-xs">{{ channelsText.appsDescription }}</p>
        </header>
        <div class="divide-line divide-y">
          <details class="group" x-for="app in appRows()" :data-network-app="app.provider">
            <summary class="flex gap-3 items-center justify-between px-4 py-3 list-none hover:bg-panel-2 cursor-pointer">
              <span class="font-medium text-ink text-ui" :text="app.label"></span>
              <span class="flex gap-2 items-center">
                <Badge size="sm" :variant="app.configured ? 'success' : 'default'">{{ app.status }}</Badge>
                <span class="h-4 w-4 text-muted transition-transform group-open:rotate-180 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
              </span>
            </summary>
            <div class="grid gap-3 pb-4 px-4">
              <ol class="grid gap-1 m-0 pl-5 text-body text-xs" lang="en">
                <li x-for="step in app.steps" :text="step"></li>
              </ol>
              <a class="w-fit text-info text-xs underline" :href="app.guideUrl" :aria-label="words.t('networkGuide', { network: app.label })" target="_blank" rel="noopener noreferrer" x-show="app.guideUrl">{{ channelsText.fullGuide }}</a>
              <p class="m-0 text-body text-xs" x-show="app.readUsage" :text="app.readUsage" data-x-read-usage></p>
              <div class="grid gap-1">
                <span class="font-medium text-muted text-xs">{{ channelsText.redirectAddress }}</span>
                <div class="flex gap-2 items-center">
                  <code class="flex-1 px-2.5 py-1.5 min-w-0 text-ink text-xs truncate bg-panel-2 border border-line rounded-lg" :text="app.redirectUrl" :title="app.redirectUrl"></code>
                  <button class="shrink-0 px-2.5 h-8 font-medium text-ink text-xs bg-panel hover:bg-raised border border-line rounded-lg" type="button" @click="copyRedirect(app.provider)">{{ channelsText.copy }}</button>
                </div>
              </div>
              <form class="grid gap-2 sm:grid-cols-2" @submit.prevent="saveApp(app.provider)">
                <label class="grid gap-1 text-muted text-xs">
                  <span>{{ channelsText.clientId }}</span>
                  <input class="px-3 h-9 text-ink text-ui bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" type="text" autocomplete="off" spellcheck="false" :value="app.clientId" @input="setAppField(app.provider, 'clientId', $event)" data-app-client-id>
                </label>
                <label class="grid gap-1 text-muted text-xs">
                  <span>{{ channelsText.clientSecret }}</span>
                  <input class="px-3 h-9 text-ink text-ui bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" type="password" autocomplete="off" :placeholder="app.secretPlaceholder" :value="app.clientSecret" @input="setAppField(app.provider, 'clientSecret', $event)" data-app-client-secret>
                </label>
                {{-- LinkedIn company Pages (#130): opt-in, since the scopes need a product the app may not have. --}}
                <label class="gap-2 items-start sm:col-span-2 text-body text-xs" :class="app.provider === 'linkedin' ? 'flex' : 'hidden'">
                  <input class="mt-0.5" type="checkbox" :checked="app.organizationPages" @change="setAppFlag(app.provider, 'organizationPages', $event)" data-app-organization-pages>
                  <span>{{ channelsText.companyPages }}</span>
                </label>
                <label class="flex gap-2 items-start sm:col-span-2 text-body text-xs">
                  <input class="mt-0.5" type="checkbox" :checked="app.engagementMetrics" @change="setAppFlag(app.provider, 'engagementMetrics', $event)">
                  <span :text="app.provider === 'twitter' ? copy.paidEngagement : copy.engagement"></span>
                </label>
                <label class="gap-2 items-start sm:col-span-2 text-body text-xs" :class="app.provider === 'twitter' ? 'flex' : 'hidden'">
                  <input class="mt-0.5" type="checkbox" :checked="app.directMessages" @change="setAppFlag(app.provider, 'directMessages', $event)" data-app-direct-messages>
                  <span>{{ channelsText.paidMessages }}</span>
                </label>
                <label class="gap-2 items-start sm:col-span-2 text-body text-xs" :class="app.provider === 'instagram' ? 'flex' : 'hidden'">
                  <input class="mt-0.5" type="checkbox" :checked="app.firstComments" @change="setAppFlag(app.provider, 'firstComments', $event)">
                  <span>{{ channelsText.firstComments }}</span>
                </label>
                <div class="flex flex-wrap gap-2 items-center sm:col-span-2">
                  <p class="m-0 mr-auto text-muted text-xs" :text="app.note"></p>
                  <button class="px-3 h-8 font-medium text-danger text-xs bg-panel hover:bg-danger-soft border border-line rounded-lg disabled:opacity-50" type="button" x-show="app.removable" :disabled="appBusy() === app.provider" @click="clearApp(app.provider)">{{ channelsText.remove }}</button>
                  <Button variant="secondary" size="xs" :disabled="!app.testReady || appBusy() === app.provider" @click="navigate('/api/postline/' + app.provider + '/auth?test=1', { reload: true })">{{ channelsText.testConnection }}</Button>
                  <button class="px-3 h-8 font-semibold text-on-accent text-xs bg-accent hover:bg-accent-hover rounded-lg disabled:opacity-50" type="submit" :disabled="appBusy() === app.provider">{{ channelsText.save }}</button>
                </div>
              </form>
            </div>
          </details>
        </div>
      </Card>
    </section>

    <details class="overflow-hidden bg-panel border border-line rounded-2xl open:border-danger-line shadow-sm group" x-cloak x-show="channelsReady() || bootstrap.error()" data-purge-card>
      <summary class="flex gap-3 items-center justify-between p-4 list-none hover:bg-panel-2 transition-colors cursor-pointer">
        <div class="flex gap-3 items-center"><span class="grid place-items-center h-9 w-9 text-danger text-lg bg-danger-soft rounded-xl" aria-hidden="true"><span class="i-hugeicons-alert-02"></span></span><div>
          <strong class="text-ink text-ui">{{ channelsText.cleanup }}</strong>
          <p class="mb-0 mt-1 text-muted text-xs">{{ channelsText.cleanupDescription }}</p>
        </div></div>
        <span class="h-4 w-4 text-muted transition-transform group-open:rotate-180 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
      </summary>

      <div class="grid gap-4 p-4 border-danger-line border-t">
        <div class="flex gap-2 items-center p-3 text-danger text-xs bg-danger-soft border border-danger-line rounded-xl"><span class="shrink-0 h-4 w-4 i-hugeicons-alert-02" aria-hidden="true"></span><span>{{ channelsText.cleanupWarning }}</span></div>
        <fieldset class="grid gap-2 m-0 p-0 border-0">
          <legend class="mb-1 p-0 font-semibold text-muted text-xs">{{ channelsText.whatToDelete }}</legend>
          <label class="flex gap-2.5 items-start p-3 border border-line rounded-xl cursor-pointer">
            <input class="mt-0.5" type="radio" name="purge-scope" value="tracked" checked data-purge-scope>
            <span>
              <span class="block font-semibold text-ink text-ui">{{ channelsText.trackedPosts }}</span>
              <span class="block mt-0.5 text-muted text-xs">{{ channelsText.trackedDescription }}</span>
            </span>
          </label>
          <label class="flex gap-2.5 items-start p-3 border border-line rounded-xl cursor-pointer">
            <input class="mt-0.5" type="radio" name="purge-scope" value="all" data-purge-scope>
            <span>
              <span class="block font-semibold text-ink text-ui">{{ channelsText.allPosts }}</span>
              <span class="block mt-0.5 text-muted text-xs">{{ channelsText.allPostsDescription }}</span>
            </span>
          </label>
        </fieldset>

        <fieldset class="grid gap-2 m-0 p-0 border-0">
          <legend class="mb-1 p-0 font-semibold text-muted text-xs">{{ channelsText.accounts }}</legend>
          <div class="flex flex-wrap gap-3">
            <label class="inline-flex gap-2 items-center text-ui">
              <input type="checkbox" value="bluesky" checked data-purge-provider> Bluesky
            </label>
            <label class="inline-flex gap-2 items-center text-ui">
              <input type="checkbox" value="twitter" checked data-purge-provider> X
            </label>
            <label class="inline-flex gap-2 items-center text-ui">
              <input type="checkbox" value="mastodon" checked data-purge-provider> Mastodon
            </label>
            <label class="inline-flex gap-2 items-center text-ui">
              <input type="checkbox" value="linkedin" checked data-purge-provider> LinkedIn
            </label>
          </div>
          <p class="m-0 text-muted text-xs">{{ channelsText.deletionLimits }}</p>
        </fieldset>

        <div class="flex flex-wrap gap-3 items-center">
          <button class="inline-flex items-center justify-center px-4 h-10 font-semibold text-ink text-sm bg-panel hover:bg-panel-3 border border-line rounded-xl disabled:opacity-50 transition-colors" type="button" data-purge-preview>{{ channelsText.preview }}</button>
          <span class="text-muted text-xs" data-purge-summary>{{ channelsText.noPreview }}</span>
        </div>

        {{-- Rendered from the purgeRows() signal. Object-form :class, because
            the string form of :class merges with the static list and a static
            hidden class would never come back off. --}}
        <div class="grid hidden gap-2" :class="{ 'hidden': purgeRows().length === 0 }" data-purge-results>
          <div class="p-3 text-ui border border-line rounded-xl" x-for="row in purgeRows()">
            <strong :text="row.heading"></strong>
            <p class="my-1 text-muted" :text="row.detail"></p>
          </div>
        </div>

        <div class="grid gap-2 p-3 bg-danger-soft border border-danger-line rounded-xl">
          <label class="grid gap-1.5">
            <span class="font-semibold text-danger text-xs">{{ channelsText.type }} <code class="px-1 py-0.5 text-xs bg-panel rounded" data-purge-phrase>{{ channelsText.thePhrase }}</code> {{ channelsText.toConfirm }}</span>
            <input class="px-3 h-10 text-ink text-sm bg-panel border border-danger-line outline-none rounded-xl focus:border-danger-solid focus:ring-2 focus:ring-danger-soft" type="text" autocomplete="off" placeholder="{{ channelsText.previewFirst }}" aria-label="{{ channelsText.confirmationPhrase }}" data-purge-confirmation>
          </label>
          <button class="inline-flex items-center justify-center px-4 h-10 font-semibold text-on-solid text-sm bg-danger-solid hover:bg-danger-solid-hover rounded-xl disabled:opacity-50 transition-colors disabled:cursor-not-allowed" type="button" disabled data-purge-run>{{ channelsText.deletePermanently }}</button>
          <button class="hidden items-center justify-center px-4 h-10 font-semibold text-danger text-sm bg-panel hover:bg-hover border border-danger-line rounded-xl transition-colors" type="button" data-purge-cancel>{{ channelsText.stopDeleting }}</button>
          <p class="m-0 text-danger text-xs" data-purge-hint>{{ channelsText.previewHint }}</p>
        </div>
      </div>
    </details>
  </section>

  <script client>
    import { createI18n } from '@stacksjs/i18n/client'
    import { showNotification } from '../functions/notification'

    const { locale: language, messages: copy } = {{ channelsClient }}
    const words = createI18n({ locale: language, messages: { [language]: copy } })
    const numbers = new Intl.NumberFormat(language)
    const plural = new Intl.PluralRules(language)
    const bootstrap = workspaceBootstrapQuery()
    const channelsReady = derived(() => Boolean(bootstrap.data()))
    const channelProviders = derived(() => bootstrap.data()?.providers.map(status => status.provider) ?? [])
    const channelSummary = derived(() => {
      if (!channelsReady()) return ''
      const count = channelProviders().length
      return words.t(plural.select(count) === 'one' ? 'channelCountOne' : 'channelCountMany', { count: numbers.format(count) })
    })
    const networkApps = derived(() => bootstrap.data()?.networkApps ?? [])
    const oauthFeedback = state('')
    const oauthFailed = state(false)

    const setupInProgress = useSessionStorage('postline.setup.in-progress', false)
    const setupRequested = useRoute().query.setup === '1'
    const returnToSetup = derived(() => setupRequested || setupInProgress())

    onMount(() => void bootstrap.load())

    // Network app forms keep unsaved credentials in this view only.
    const appDrafts = state({})
    const appBusy = state('')
    const guides = {{ networkSetupGuides }}
    const usd = new Intl.NumberFormat(language, { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 3 })
    const appRows = derived(() => networkApps().map((app) => {
      const guide = guides[app.provider]
      const draft = appDrafts()[app.provider] || {}
      const clientId = draft.clientId ?? app.clientId
      const clientSecret = draft.clientSecret ?? ''
      const organizationPages = draft.organizationPages ?? Boolean(app.organizationPages)
      const engagementMetrics = draft.engagementMetrics ?? Boolean(app.engagementMetrics)
      const directMessages = draft.directMessages ?? Boolean(app.directMessages)
      const firstComments = draft.firstComments ?? Boolean(app.firstComments)
      const hasChanges = clientId.trim() !== app.clientId || Boolean(clientSecret.trim())
        || organizationPages !== Boolean(app.organizationPages) || engagementMetrics !== Boolean(app.engagementMetrics)
        || directMessages !== Boolean(app.directMessages)
        || firstComments !== Boolean(app.firstComments)
      return {
        provider: app.provider,
        label: guide?.label ?? app.provider,
        steps: guide?.steps ?? [],
        guideUrl: guide?.url ?? '',
        configured: app.configured,
        readUsage: app.readUsage
          ? words.t('readUsage', { used: usd.format(app.readUsage.estimatedUsd), limit: usd.format(app.readUsage.limitUsd) })
          : '',
        status: app.configured ? (app.source === 'environment' ? copy.environment : copy.configured) : copy.unconfigured,
        redirectUrl: app.redirectUrl,
        clientId,
        clientSecret,
        organizationPages,
        engagementMetrics,
        directMessages,
        firstComments,
        secretPlaceholder: app.hasSecret ? copy.keepSecret : copy.pasteSecret,
        removable: app.source === 'settings',
        testReady: app.configured && !hasChanges,
        note: app.source === 'environment' ? copy.environmentNote : app.configured ? copy.configuredNote : '',
      }
    }))
    const setAppField = (provider, field, event) => {
      const drafts = { ...appDrafts() }
      drafts[provider] = { ...(drafts[provider] || {}), [field]: String(event?.target?.value || '') }
      appDrafts.set(drafts)
    }
    const setAppFlag = (provider, field, event) => {
      const drafts = { ...appDrafts() }
      drafts[provider] = { ...(drafts[provider] || {}), [field]: Boolean(event?.target?.checked) }
      appDrafts.set(drafts)
    }
    const appHandlers = { save: null, clear: null, copy: null }
    const saveApp = provider => appHandlers.save?.(provider)
    const clearApp = provider => appHandlers.clear?.(provider)
    const copyRedirect = provider => appHandlers.copy?.(provider)

    const purgeResultRows = state([])

    /**
     * Why a run stops short. A network's daily cap (Threads: 100 a day) is
     * named with what is left, so a short run does not look like a bug.
     */
    const purgeCapNote = (row) => {
      if (row.dailyLimit && row.truncated)
        return words.t('dailyTruncated', { network: row.provider, limit: numbers.format(row.dailyLimit.limit), remaining: numbers.format(row.dailyLimit.remaining) })
      if (row.dailyLimit)
        return words.t('dailyLimit', { network: row.provider, limit: numbers.format(row.dailyLimit.limit), remaining: numbers.format(row.dailyLimit.remaining) })
      return row.truncated ? copy.capped : ''
    }

    /** One purge-result row flattened to exactly what the template renders. */
    const purgeRows = derived(() => purgeResultRows().map((row) => ({
      heading: row.handle ? `${row.provider} — ${row.handle}` : row.provider,
      // A skip reason always wins — it explains a zero that would otherwise
      // read as "nothing to delete" (e.g. LinkedIn refusing to list history).
      detail: row.skippedReason
        ? row.skippedReason
        : !row.supported || !row.connected
            ? copy.unavailable
            : words.t(plural.select(row.matched) === 'one' ? 'wouldDeleteOne' : 'wouldDeleteMany', { count: numbers.format(row.matched), limit: purgeCapNote(row) }),
    })))

    ;(() => {
      const root = document.querySelector('[data-testid="accounts-page"]')
      if (!root) return

      const notify = (message, tone = 'neutral', options = {}) => {
        showNotification({ message, tone: tone === 'success' ? 'success' : tone === 'error' ? 'error' : 'info', title: options.title })
      }

      const route = useRoute()
      for (const provider of ['linkedin', 'twitter', 'instagram', 'threads']) {
        const result = route.query[provider]
        if (!['connected', 'tested', 'error'].includes(result)) continue
        const params = new URLSearchParams(route.fullPath.split('?')[1] || '')
        const message = params.get('message')
        params.delete(provider)
        params.delete('message')
        const query = params.toString()
        window.history.replaceState({}, '', `${route.path}${query ? `?${query}` : ''}`)
        oauthFailed.set(result === 'error')
        const name = providerLabel(provider)
        if (result === 'connected') oauthFeedback.set(words.t('connected', { network: name }))
        else if (result === 'tested') oauthFeedback.set(words.t('connectionPassed', { network: name }))
        else oauthFeedback.set(message || words.t('connectionFailed', { network: name }))
        if (result === 'connected') {
          // The redirected page reads the fresh account as it mounts.
          // Notify any existing workspace windows as well.
          onMount(() => announceWorkspaceChange())
        }
        break
      }

      appHandlers.save = async (provider) => {
        const row = appRows().find(entry => entry.provider === provider)
        if (!row) return
        appBusy.set(provider)
        try {
          const body = new FormData()
          body.set('provider', provider)
          body.set('client_id', row.clientId || '')
          body.set('client_secret', row.clientSecret || '')
          if (provider === 'linkedin') body.set('organization_pages', row.organizationPages ? '1' : '0')
          body.set('engagement_metrics', row.engagementMetrics ? '1' : '0')
          if (provider === 'twitter') body.set('direct_messages', row.directMessages ? '1' : '0')
          if (provider === 'instagram') body.set('first_comments', row.firstComments ? '1' : '0')
          await requestJson('/api/postline/network-apps', { method: 'POST', body }, copy.saveFailed)
          const drafts = { ...appDrafts() }
          delete drafts[provider]
          appDrafts.set(drafts)
          await bootstrap.load()
          notify(words.t('appSaved', { network: row.label }), 'success', { title: row.label })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: row.label })
        }
        finally {
          appBusy.set('')
        }
      }
      appHandlers.clear = async (provider) => {
        const row = appRows().find(entry => entry.provider === provider)
        if (!row || !await stxConfirm(words.t('removeWarning', { network: row.label }), { title: words.t('removeTitle', { network: row.label }), type: 'error', confirmText: copy.removeApp })) return
        appBusy.set(provider)
        try {
          const body = new FormData()
          body.set('provider', provider)
          await requestJson('/api/postline/network-apps/clear', { method: 'POST', body }, copy.removeFailed)
          await bootstrap.load()
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: row.label })
        }
        finally {
          appBusy.set('')
        }
      }
      appHandlers.copy = async (provider) => {
        const row = appRows().find(entry => entry.provider === provider)
        if (!row) return
        try {
          await navigator.clipboard.writeText(row.redirectUrl)
          notify(copy.copied, 'success', { title: row.label })
        }
        catch {
          notify(row.redirectUrl, 'info', { title: copy.copyManually })
        }
      }

      // --- Danger zone: bulk post deletion ---
      const purgeCard = root.querySelector('[data-purge-card]')
      const purgePreview = root.querySelector('[data-purge-preview]')
      const purgeRun = root.querySelector('[data-purge-run]')
      const purgeConfirmation = root.querySelector('[data-purge-confirmation]')
      const purgeSummary = root.querySelector('[data-purge-summary]')
      const purgeHint = root.querySelector('[data-purge-hint]')
      const purgePhraseLabel = root.querySelector('[data-purge-phrase]')
      const purgeCancel = root.querySelector('[data-purge-cancel]')
      let purgeRunId = ''

      // A preview is only valid for the selection it ran against — changing
      // scope or accounts invalidates it and re-locks the delete button. The
      // phrase names the count it showed ("DELETE 42 POSTS"), and its token
      // goes back with the run, so nothing beyond what was shown is deleted.
      let previewedSelection = null
      let previewPhrase = ''
      let previewToken = ''
      const setPreview = (phrase, token) => {
        previewPhrase = phrase || ''
        previewToken = token || ''
        if (purgePhraseLabel) purgePhraseLabel.textContent = previewPhrase || copy.thePhrase
        if (purgeConfirmation) purgeConfirmation.placeholder = previewPhrase || copy.previewFirst
      }

      const purgeScope = () => root.querySelector('[data-purge-scope]:checked')?.value || 'tracked'
      const purgeProviders = () => Array.from(root.querySelectorAll('[data-purge-provider]:checked')).map(input => input.value)
      const purgeSelection = () => `${purgeScope()}:${purgeProviders().sort().join(',')}`

      const renderPurgeResults = (data) => purgeResultRows.set(data?.providers || [])

      const syncPurgeButton = () => {
        const phraseOk = Boolean(previewPhrase) && purgeConfirmation?.value === previewPhrase
        const previewOk = previewedSelection === purgeSelection()
        const nothingToDelete = previewOk && previewPhrase === 'DELETE 0 POSTS'
        const enabled = Boolean(phraseOk && previewOk && !nothingToDelete && purgeProviders().length)
        if (purgeRun) purgeRun.disabled = !enabled
        if (purgeHint) {
          purgeHint.textContent = !purgeProviders().length
            ? copy.selectAccount
            : !previewOk
              ? copy.previewSelection
              : nothingToDelete
                ? copy.noMatches
              : !phraseOk
                ? words.t('typeExact', { phrase: previewPhrase })
                : copy.deletePreviewed
        }
      }

      purgeCard?.addEventListener('change', (event) => {
        // Any change to scope or accounts stales the preview.
        if (event.target?.matches('[data-purge-scope], [data-purge-provider]')) {
          previewedSelection = null
          setPreview('', '')
        }
        syncPurgeButton()
      })
      purgeConfirmation?.addEventListener('input', syncPurgeButton)

      purgePreview?.addEventListener('click', async () => {
        const providers = purgeProviders()
        if (!providers.length) {
          notify(copy.selectToPreview, 'error', { title: copy.dangerZone })
          return
        }

        purgePreview.setAttribute('disabled', 'disabled')
        if (purgeSummary) purgeSummary.textContent = copy.counting
        try {
          const query = new URLSearchParams({ scope: purgeScope(), providers: providers.join(',') })
          const response = await fetch(`/api/postline/purge/preview?${query.toString()}`)
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || copy.previewFailed)

          renderPurgeResults(payload.data)
          previewedSelection = purgeSelection()
          setPreview(payload.data.confirmation, payload.data.previewToken)
          if (purgeSummary) purgeSummary.textContent = words.t(plural.select(payload.data.matched) === 'one' ? 'matchesOne' : 'matchesMany', { count: numbers.format(payload.data.matched) })
        }
        catch (error) {
          previewedSelection = null
          setPreview('', '')
          if (purgeSummary) purgeSummary.textContent = copy.previewFailed
          notify(error instanceof Error ? error.message : String(error), 'error', { title: copy.dangerZone })
        }
        finally {
          purgePreview.removeAttribute('disabled')
          syncPurgeButton()
        }
      })

      purgeRun?.addEventListener('click', async () => {
        const scope = purgeScope()
        // Last stop before an irreversible action, with the number it is about.
        const count = Number((previewPhrase.match(/\d+/) || ['0'])[0])
        const where = scope === 'all' ? copy.fromSelected : copy.fromPostline
        if (!await stxConfirm(words.t(plural.select(count) === 'one' ? 'confirmOne' : 'confirmMany', { count: numbers.format(count), where }), { title: copy.confirmTitle, type: 'error', confirmText: copy.deletePosts })) return

        purgeRun.disabled = true
        try {
          const body = new FormData()
          body.set('scope', scope)
          body.set('providers', purgeProviders().join(','))
          body.set('confirmation', purgeConfirmation?.value || '')
          body.set('preview_token', previewToken)

          const response = await fetch('/api/postline/purge', { method: 'POST', body })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || copy.deletionFailed)

          // The deleting carries on in the background; follow it here.
          purgeRunId = payload.data.runId
          previewedSelection = null
          setPreview('', '')
          if (purgeConfirmation) purgeConfirmation.value = ''
          showPurgeRunning(true)
          await followPurge(purgeRunId)
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: copy.deletionFailedTitle })
        }
        finally {
          showPurgeRunning(false)
          purgeRunId = ''
          syncPurgeButton()
        }
      })

      const showPurgeRunning = (running) => {
        purgeCancel?.classList.toggle('hidden', !running)
        purgeCancel?.classList.toggle('inline-flex', running)
        if (purgeCancel) purgeCancel.disabled = false
        if (running && purgeRun) purgeRun.disabled = true
      }

      /** Poll a background run until it finishes, showing how far it has got. */
      const followPurge = async (runId) => {
        for (;;) {
          const response = await fetch(`/api/postline/purge/status?run=${encodeURIComponent(runId)}`)
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || copy.lostRun)
          const run = payload.data
          if (purgeSummary) purgeSummary.textContent = `${words.t('deleteProgress', { deleted: numbers.format(run.deleted), limit: numbers.format(run.limit) })}${run.failed ? words.t('deleteProgressFailed', { failed: numbers.format(run.failed) }) : ''}${run.status === 'running' ? '…' : '.'}`
          if (run.status !== 'running') {
            if (run.result) renderPurgeResults(run.result)
            if (run.status === 'failed') throw new Error(run.error || copy.deletionFailed)
            const stopped = run.status === 'cancelled' ? copy.stopped : ''
            notify(
              words.t(plural.select(run.deleted) === 'one' ? 'deletedOne' : 'deletedMany', { count: numbers.format(run.deleted) })
                + (run.failed ? words.t('deletedFailed', { count: numbers.format(run.failed) }) : '') + stopped,
              run.failed ? 'error' : 'success',
              { title: copy.dangerZone },
            )
            return
          }
          await new Promise(resolve => setTimeout(resolve, 1000))
        }
      }

      purgeCancel?.addEventListener('click', async () => {
        if (!purgeRunId) return
        purgeCancel.disabled = true
        const body = new FormData()
        body.set('run', purgeRunId)
        try {
          await fetch('/api/postline/purge/cancel', { method: 'POST', body })
          if (purgeSummary) purgeSummary.textContent = copy.stopping
        }
        catch {
          purgeCancel.disabled = false
        }
      })

      syncPurgeButton()

    })()
  </script>
@endsection
