          <details class="group">
            <summary class="inline-flex items-center justify-center h-9 w-full font-semibold list-none text-ink text-xs bg-panel-2 hover:bg-raised border border-line rounded-xl transition-colors cursor-pointer">Manage Mastodon</summary>
            <form class="grid gap-2 pt-3" data-mastodon-connect-form>
              <input class="px-3 h-9 text-ink text-xs bg-raised border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" name="instance" placeholder="mastodon.social" autocomplete="url" aria-label="Mastodon instance" data-mastodon-instance required>
              <input class="px-3 h-9 text-ink text-xs bg-raised border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" name="access_token" type="password" placeholder="Access token" autocomplete="off" aria-label="Mastodon access token" data-mastodon-token required>
              <button class="inline-flex items-center justify-center px-3 h-9 w-full font-semibold text-on-accent text-xs bg-accent hover:bg-accent-hover rounded-xl disabled:opacity-50 transition-colors" type="submit" data-mastodon-connect-submit>Connect Mastodon</button>
              {{-- read:accounts is not optional: connecting verifies the token
                  against /api/v1/accounts/verify_credentials before it is saved,
                  so a write-only token fails at connect, not at publish. --}}
              <p class="m-0 text-muted text-xs">Create a token in your instance settings with the read:accounts, write:statuses and write:media scopes. A token for another account, on any instance, adds it alongside.</p>
            </form>
          </details>
        </article>
      </div>
    </section>

    {{--
      Bring your own keys: X, LinkedIn, Instagram and Threads sign in through a
      developer app the owner registers on each network. Its client id and
      secret are entered here (the secret is stored sealed), so no file has to
      be edited, which the Mac app cannot do at all.
    --}}
    <section class="overflow-hidden bg-panel border border-line rounded-2xl shadow-sm" aria-label="Your network apps" data-network-apps>
      <header class="px-4 py-3.5 border-b border-line">
        <h2 class="m-0 font-semibold text-ink text-sm">Your network apps</h2>
        <p class="m-0 mt-1 text-muted text-xs">X, LinkedIn, Instagram and Threads connect through an app you register on each network. Postline has no keys of its own: yours stay in this workspace.</p>
      </header>
      <div class="divide-line divide-y">
        <details class="group" x-for="app in appRows()" data-network-app>
          <summary class="flex gap-3 items-center justify-between px-4 py-3 list-none hover:bg-panel-2 cursor-pointer">
            <span class="font-medium text-ink text-ui" :text="app.label"></span>
            <span class="flex gap-2 items-center">
              <span class="px-2 py-0.5 font-semibold text-xs rounded-full" :class="app.configured ? 'text-success bg-success-soft' : 'text-muted bg-panel-2'" :text="app.status"></span>
              <span class="h-4 w-4 text-muted transition-transform group-open:rotate-180 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
            </span>
          </summary>
          <div class="grid gap-3 pb-4 px-4">
            <ol class="grid gap-1 m-0 pl-5 text-body text-xs">
              <li x-for="step in app.steps" :text="step"></li>
            </ol>
            <div class="grid gap-1">
              <span class="font-medium text-muted text-xs">Redirect address to give the network</span>
              <div class="flex gap-2 items-center">
                <code class="flex-1 px-2.5 py-1.5 min-w-0 text-ink text-xs truncate bg-panel-2 border border-line rounded-lg" :text="app.redirectUrl" :title="app.redirectUrl"></code>
                <button class="shrink-0 px-2.5 h-8 font-medium text-ink text-xs bg-panel hover:bg-raised border border-line rounded-lg" type="button" @click="copyRedirect(app.provider)">Copy</button>
              </div>
            </div>
            <form class="grid gap-2 sm:grid-cols-2" @submit.prevent="saveApp(app.provider)">
              <label class="grid gap-1 text-muted text-xs">
                <span>Client id</span>
                <input class="px-3 h-9 text-ink text-ui bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" type="text" autocomplete="off" spellcheck="false" :value="app.clientId" @input="setAppField(app.provider, 'clientId', $event)" data-app-client-id>
              </label>
              <label class="grid gap-1 text-muted text-xs">
                <span>Client secret</span>
                <input class="px-3 h-9 text-ink text-ui bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" type="password" autocomplete="off" :placeholder="app.secretPlaceholder" :value="app.clientSecret" @input="setAppField(app.provider, 'clientSecret', $event)" data-app-client-secret>
              </label>
              {{-- LinkedIn company Pages (#130): opt-in, since the scopes need a product the app may not have. --}}
              <label class="gap-2 items-start sm:col-span-2 text-body text-xs" :class="app.provider === 'linkedin' ? 'flex' : 'hidden'">
                <input class="mt-0.5" type="checkbox" :checked="app.organizationPages" @change="setAppPages(app.provider, $event)" data-app-organization-pages>
                <span>Also connect the company Pages I administer. Needs the Community Management API product on this app; without it LinkedIn refuses the sign-in.</span>
              </label>
              <div class="flex flex-wrap gap-2 items-center sm:col-span-2">
                <p class="m-0 mr-auto text-muted text-xs" :text="app.note"></p>
                <button class="px-3 h-8 font-medium text-danger text-xs bg-panel hover:bg-danger-soft border border-line rounded-lg disabled:opacity-50" type="button" x-show="app.removable" :disabled="appBusy() === app.provider" @click="clearApp(app.provider)">Remove</button>
                <button class="px-3 h-8 font-semibold text-on-accent text-xs bg-accent hover:bg-accent-hover rounded-lg disabled:opacity-50" type="submit" :disabled="appBusy() === app.provider">Save</button>
              </div>
            </form>
          </div>
        </details>
      </div>
    </section>

    <details class="overflow-hidden bg-panel border border-line rounded-2xl open:border-danger-line shadow-sm group" data-purge-card>
      <summary class="flex gap-3 items-center justify-between p-4 list-none hover:bg-panel-2 transition-colors cursor-pointer">
        <div class="flex gap-3 items-center"><span class="grid place-items-center h-9 w-9 text-danger text-lg bg-danger-soft rounded-xl" aria-hidden="true"><span class="i-hugeicons-alert-02"></span></span><div>
          <strong class="text-ink text-ui">Cleanup</strong>
          <p class="mb-0 mt-1 text-muted text-xs">Preview or permanently remove posts from connected accounts.</p>
        </div></div>
        <span class="h-4 w-4 text-muted transition-transform group-open:rotate-180 i-hugeicons-arrow-down-01" aria-hidden="true"></span>
      </summary>

      <div class="grid gap-4 p-4 border-danger-line border-t">
        <div class="flex gap-2 items-center p-3 text-danger text-xs bg-danger-soft border border-danger-line rounded-xl"><span class="shrink-0 h-4 w-4 i-hugeicons-alert-02" aria-hidden="true"></span><span>Deletion is permanent. Postline always shows a preview and requires an exact confirmation phrase first.</span></div>
        <fieldset class="grid gap-2 m-0 p-0 border-0">
          <legend class="mb-1 p-0 font-semibold text-muted text-xs">What to delete</legend>
          <label class="flex gap-2.5 items-start p-3 border border-line rounded-xl cursor-pointer">
            <input class="mt-0.5" type="radio" name="purge-scope" value="tracked" checked data-purge-scope>
            <span>
              <span class="block font-semibold text-ink text-ui">Posts Postline published</span>
              <span class="block mt-0.5 text-muted text-xs">Only posts sent from this workspace. Anything you posted elsewhere stays.</span>
            </span>
          </label>
          <label class="flex gap-2.5 items-start p-3 border border-line rounded-xl cursor-pointer">
            <input class="mt-0.5" type="radio" name="purge-scope" value="all" data-purge-scope>
            <span>
              <span class="block font-semibold text-ink text-ui">Everything on the account</span>
              <span class="block mt-0.5 text-muted text-xs">Every post the account ever made, including posts created outside Postline.</span>
            </span>
          </label>
        </fieldset>

        <fieldset class="grid gap-2 m-0 p-0 border-0">
          <legend class="mb-1 p-0 font-semibold text-muted text-xs">Accounts</legend>
          <div class="flex flex-wrap gap-3">
            <label class="inline-flex gap-2 items-center text-ui">
              <input type="checkbox" value="bluesky" checked data-purge-provider> Bluesky
            </label>
            <label class="inline-flex gap-2 items-center text-ui">
              <input type="checkbox" value="twitter" checked data-purge-provider> X
            </label>
            <label class="inline-flex gap-2 items-center text-ui">
              <input type="checkbox" value="mastodon" checked data-purge-provider> Mastodon
            </label>
            <label class="inline-flex gap-2 items-center text-ui">
              <input type="checkbox" value="linkedin" checked data-purge-provider> LinkedIn
            </label>
          </div>
          <p class="m-0 text-muted text-xs">LinkedIn can delete the posts Postline published; listing its full history needs a partner permission most apps don't hold. Instagram and Threads can't delete posts at all through their APIs — remove those in their own apps.</p>
        </fieldset>

        <div class="flex flex-wrap gap-3 items-center">
          <button class="inline-flex items-center justify-center px-4 h-10 font-semibold text-ink text-sm bg-panel hover:bg-panel-3 border border-line rounded-xl disabled:opacity-50 transition-colors" type="button" data-purge-preview>Preview what would be deleted</button>
          <span class="text-muted text-xs" data-purge-summary>No preview yet.</span>
        </div>

        {{-- Rendered from the purgeRows() signal. Object-form :class, because
            the string form of :class merges with the static list and a static
            hidden class would never come back off. --}}
        <div class="grid hidden gap-2" :class="{ 'hidden': purgeRows().length === 0 }" data-purge-results>
          <div class="p-3 text-ui border border-line rounded-xl" x-for="row in purgeRows()">
            <strong :text="row.heading"></strong>
            <p class="my-1 text-muted" :text="row.detail"></p>
          </div>
        </div>

        <div class="grid gap-2 p-3 bg-danger-soft border border-danger-line rounded-xl">
          <label class="grid gap-1.5">
            <span class="font-semibold text-danger text-xs">Type <code class="px-1 py-0.5 text-xs bg-panel rounded" data-purge-phrase>the phrase the preview shows</code> to confirm</span>
            <input class="px-3 h-10 text-ink text-sm bg-panel border border-danger-line outline-none rounded-xl focus:border-danger-solid focus:ring-2 focus:ring-danger-soft" type="text" autocomplete="off" placeholder="Run a preview first" aria-label="Deletion confirmation phrase" data-purge-confirmation>
          </label>
          <button class="inline-flex items-center justify-center px-4 h-10 font-semibold text-on-solid text-sm bg-danger-solid hover:bg-danger-solid-hover rounded-xl disabled:opacity-50 transition-colors disabled:cursor-not-allowed" type="button" disabled data-purge-run>Delete permanently</button>
          <button class="hidden items-center justify-center px-4 h-10 font-semibold text-danger text-sm bg-panel hover:bg-hover border border-danger-line rounded-xl transition-colors" type="button" data-purge-cancel>Stop deleting</button>
          <p class="m-0 text-danger text-xs" data-purge-hint>Run a preview first, then type the phrase it shows to enable deletion.</p>
        </div>
      </div>
    </details>
  </section>

  <script client>
    // Template-bound state lives at the top level of the script: stx binds
    // `:text`, `x-for` and `@click` expressions to top-level declarations, and
    // signals declared inside the IIFE below were invisible to the template,
    // so these lists never rendered.

    // --- Connected accounts (several per network) ---
    // Rendered declaratively from these signals into each card's list; the
    // per-network status renderers below still own the card header.
    const accountList = state([])

    // --- Your network apps (bring your own keys) ---
    const networkApps = state([])
    const appDrafts = state({})
    const appBusy = state('')
    const APP_GUIDES = {
      twitter: {
        label: 'X',
        steps: [
          'Open developer.x.com, sign in, and open your project\'s app (create one if you have none).',
          'Under User authentication settings, choose Set up: OAuth 2.0, app type Web App.',
          'Paste the redirect address below as the Callback URI, and your site as the Website URL.',
          'Under Keys and tokens, copy the OAuth 2.0 Client ID and Client Secret into the fields below.',
        ],
      },
      linkedin: {
        label: 'LinkedIn',
        steps: [
          'Open linkedin.com/developers/apps and create an app, linked to a LinkedIn Page you manage.',
          'Under Products, add "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".',
          'Under Auth, add the redirect address below as an Authorized redirect URL.',
          'Copy the Client ID and Primary Client Secret from the Auth tab into the fields below.',
          'To post as a company Page too, add the "Community Management API" product, then tick the box below.',
        ],
      },
      instagram: {
        label: 'Instagram',
        steps: [
          'Your Instagram account must be a Business or Creator account linked to a Facebook Page.',
          'Open developers.facebook.com/apps, create a Business app, and add Facebook Login for Business and the Instagram Graph API.',
          'Under Facebook Login settings, add the redirect address below as a Valid OAuth Redirect URI.',
          'Under App settings, Basic, copy the App ID and App Secret into the fields below.',
        ],
      },
      threads: {
        label: 'Threads',
        steps: [
          'Open developers.facebook.com/apps and create an app with the "Access the Threads API" use case.',
          'In the Threads API settings, add the redirect address below as a Redirect Callback URL.',
          'Add your Threads account as a Threads tester and accept the invite in the Threads app.',
          'Copy the Threads App ID and Threads App Secret into the fields below.',
        ],
      },
    }
    const appRows = derived(() => networkApps().map((app) => {
      const guide = APP_GUIDES[app.provider] || { label: app.provider, steps: [] }
      const draft = appDrafts()[app.provider] || {}
      return {
        provider: app.provider,
        label: guide.label,
        steps: guide.steps,
        configured: app.configured,
        status: app.configured ? (app.source === 'environment' ? 'Set in .env' : 'Set up') : 'Not set up',
        redirectUrl: app.redirectUrl,
        clientId: draft.clientId ?? app.clientId,
        clientSecret: draft.clientSecret ?? '',
        organizationPages: draft.organizationPages ?? Boolean(app.organizationPages),
        secretPlaceholder: app.hasSecret ? 'Stored. Leave blank to keep it.' : 'Paste the client secret',
        removable: app.source === 'settings',
        note: app.source === 'environment' ? 'Read from .env. Saving here takes over from it.' : app.configured ? 'Saved. Connect the account in its card above.' : '',
      }
    }))
    const setAppField = (provider, field, event) => {
      const drafts = { ...appDrafts() }
      drafts[provider] = { ...(drafts[provider] || {}), [field]: String(event?.target?.value || '') }
      appDrafts.set(drafts)
    }
    const setAppPages = (provider, event) => {
      const drafts = { ...appDrafts() }
      drafts[provider] = { ...(drafts[provider] || {}), organizationPages: Boolean(event?.target?.checked) }
      appDrafts.set(drafts)
    }
    const appHandlers = { load: null, save: null, clear: null, copy: null }
    const saveApp = provider => appHandlers.save?.(provider)
    const clearApp = provider => appHandlers.clear?.(provider)
    const copyRedirect = provider => appHandlers.copy?.(provider)
    const disconnectingId = state(0)

    const accountName = (account) => {
      const handle = String(account?.handle || '')
      if (account?.provider === 'linkedin' || handle.startsWith('@')) return handle
      return `@${handle}`
    }

    /** "Expires in 3 days", from an ISO time. */
    const expiryLabel = (expiresAt) => {
      const hours = Math.round((Date.parse(String(expiresAt)) - Date.now()) / 3_600_000)
      if (!Number.isFinite(hours)) return 'Expires soon'
      if (hours <= 0) return 'Expired'
      if (hours < 48) return `Expires in ${hours} hour${hours === 1 ? '' : 's'}`
      return `Expires in ${Math.round(hours / 24)} days`
    }

    /** One account row flattened to exactly what the template renders. */
    const accountRowsFor = (provider) => {
      const rows = accountList().filter(account => account.provider === provider)
      return rows.map((account) => {
        const name = accountName(account)
        return {
          id: account.id,
          label: name,
          title: account.displayName && account.displayName !== account.handle ? `${account.displayName} (${name})` : name,
          connected: Boolean(account.connected),
          // "Default" only means something once there is a choice: it is the
          // account a campaign or a plain network target publishes through.
          // A token nothing can renew, or one whose renewal keeps failing,
          // is said here a week ahead and not by a failed post.
          ok: Boolean(account.connected) && !account.expiresSoon,
          status: !account.connected ? 'Reconnect' : account.expiresSoon ? expiryLabel(account.expiresAt) : rows.length > 1 && account.isDefault ? 'Default' : 'Connected',
          statusTitle: account.connected && account.expiresSoon
            ? 'This sign-in is about to lapse. Connect the account again to keep publishing.'
            : '',
          busy: disconnectingId() === account.id,
          // Offered only where it changes something: a connected account that
          // is not already the default, on a network with more than one.
          canBeDefault: Boolean(account.connected) && !account.isDefault && rows.length > 1,
          defaultLabel: `Publish to ${name} by default`,
          disconnectLabel: `Disconnect ${name}`,
        }
      })
    }

    const blueskyAccounts = derived(() => accountRowsFor('bluesky'))
    const linkedinAccounts = derived(() => accountRowsFor('linkedin'))
    const instagramAccounts = derived(() => accountRowsFor('instagram'))
    const threadsAccounts = derived(() => accountRowsFor('threads'))
    const twitterAccounts = derived(() => accountRowsFor('twitter'))
    const mastodonAccounts = derived(() => accountRowsFor('mastodon'))

    // Filled in by the IIFE below, which owns the DOM and the status refreshers.
    const accountHandlers = { disconnect: null, makeDefault: null }
    const disconnectAccount = id => accountHandlers.disconnect?.(id)
    const makeDefaultAccount = id => accountHandlers.makeDefault?.(id)

    const purgeResultRows = state([])

    /**
     * Why a run stops short. A network's daily cap (Threads: 100 a day) is
     * named with what is left, so a short run does not look like a bug.
     */
    const purgeCapNote = (row) => {
      if (row.dailyLimit && row.truncated)
        return ` now; ${row.provider} allows ${row.dailyLimit.limit} deletions a day, ${row.dailyLimit.remaining} left today, so run again tomorrow for the rest`
      if (row.dailyLimit)
        return ` (${row.provider} allows ${row.dailyLimit.limit} deletions a day; ${row.dailyLimit.remaining} left today)`
      return row.truncated ? ' (capped at 2000 per run — run again for the rest)' : ''
    }

    /** One purge-result row flattened to exactly what the template renders. */
    const purgeRows = derived(() => purgeResultRows().map((row) => ({
      heading: row.handle ? `${row.provider} — ${row.handle}` : row.provider,
      // A skip reason always wins — it explains a zero that would otherwise
      // read as "nothing to delete" (e.g. LinkedIn refusing to list history).
      detail: row.skippedReason
        ? row.skippedReason
        : !row.supported || !row.connected
            ? 'Not available.'
            : `${row.matched} post${row.matched === 1 ? '' : 's'} would be deleted${purgeCapNote(row)}.`,
    })))

    ;(() => {
      const root = document.querySelector('[data-testid="accounts-page"]')
      if (!root) return

      const form = root.querySelector('[data-bluesky-connect-form]')
      const identifier = root.querySelector('[data-bluesky-identifier]')
      const password = root.querySelector('[data-bluesky-password]')
      const submit = root.querySelector('[data-bluesky-connect-submit]')
      const handle = root.querySelector('[data-bluesky-channel-handle]')
      const detail = root.querySelector('[data-bluesky-channel-detail]')
      const status = root.querySelector('[data-bluesky-channel-status]')
      const notify = (message, tone = 'neutral', options = {}) => {
        // Resolve the toast helper at call time — it's a deferred module that
        // loads after this inline script parses, so an eager capture is
        // undefined on a full page load (e.g. the OAuth redirect back here).
        const show = window.postlineToast?.show
        if (show) show({ message, tone: tone === 'success' ? 'success' : tone === 'error' ? 'error' : 'info', title: options.title })
        else console.log(message)
      }

      /**
       * The card's handle line. With one account it names it, as it always
       * has; with several, the list under it names each one and this counts.
       */
      const handleLine = (data, single) => {
        const total = (data?.accounts || []).length
        return total > 1 ? `${total} accounts connected` : single
      }

      const refreshAccounts = async () => {
        try {
          accountList.set(await fetchAccounts())
        }
        catch (error) {
          // Same as the status cards: degrade quietly on load.
          accountList.set([])
          console.warn('[postline] account list failed:', error)
        }
      }

      const renderStatus = (data) => {
        const connected = Boolean(data?.canPublish)
        const label = data?.handle ? `@${data.handle}` : 'Not connected'
        // The form adds accounts as well as reconnecting them, so it is no
        // longer prefilled with the connected handle.
        if (handle) handle.textContent = handleLine(data, label)
        if (detail) {
          detail.textContent = connected
            ? 'Ready to publish and sync timeline from Postline.'
            : data?.handle
              ? 'Saved handle found. Add a valid app password to publish.'
              : 'Add an app password to publish and sync your timeline.'
        }
        if (status) {
          status.textContent = connected ? 'Connected' : data?.handle ? 'Needs password' : 'Setup'
          status.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-semibold ${
            connected
              ? 'border-success-line bg-success-soft text-success'
              : data?.handle
                ? 'border-warning-line bg-warning-soft text-warning'
                : 'border-line text-muted'
          }`
        }
        if (submit) submit.textContent = connected ? 'Add or reconnect account' : 'Connect Bluesky'
      }

      const refreshStatus = async () => {
        try {
          const data = await window.postlineSocial?.fetchStatus('bluesky')
          renderStatus(data)
        }
        catch (error) {
          // Inline status ("Setup" / "Not connected") communicates the failure;
          // no toast on load so an expired session can't spam one each visit.
          renderStatus(null)
          console.warn('[postline] bluesky status failed:', error)
        }
      }

      form?.addEventListener('submit', async (event) => {
        event.preventDefault()
        submit?.setAttribute('disabled', 'disabled')
        notify('Connecting to Bluesky…', 'info', { title: 'Channels' })

        try {
          const payload = await requestJson('/api/postline/bluesky/connect', {
            method: 'POST',
            body: new FormData(form),
          }, 'Bluesky connect failed.')
          if (password) password.value = ''
          if (identifier) identifier.value = ''
          await Promise.all([refreshStatus(), refreshAccounts()])
          notify(`${payload.data.handle} is connected. You can publish from the composer.`, 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          submit?.removeAttribute('disabled')
        }
      })

      // --- LinkedIn ---
      const linkedinHandle = root.querySelector('[data-linkedin-channel-handle]')
      const linkedinDetail = root.querySelector('[data-linkedin-channel-detail]')
      const linkedinStatusPill = root.querySelector('[data-linkedin-channel-status]')
      const linkedinConnect = root.querySelector('[data-linkedin-connect]')
      const linkedinConnectEnv = root.querySelector('[data-linkedin-connect-env]')

      const renderLinkedIn = (data) => {
        const connected = Boolean(data?.canPublish)
        const label = data?.displayName || data?.handle || 'Not connected'
        if (linkedinHandle) {
          linkedinHandle.textContent = handleLine(data, connected ? label : (data?.handle ? `${label}, reconnect` : 'Not connected'))
        }
        if (linkedinDetail) {
          linkedinDetail.textContent = connected
            ? 'Ready to crosspost. To add another account, sign in to it on LinkedIn first.'
            : data?.oauthConfigured
              ? 'Connect with LinkedIn to crosspost member shares.'
              : data?.configuredFromEnv
                ? 'Token found in .env. Connect to start crossposting.'
                : 'Set up your LinkedIn app below, then connect.'
        }
        if (linkedinStatusPill) {
          linkedinStatusPill.textContent = connected ? 'Connected' : (data?.handle ? 'Reconnect' : 'Setup')
          linkedinStatusPill.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-semibold ${
            connected
              ? 'border-success-line bg-success-soft text-success'
              : data?.handle
                ? 'border-warning-line bg-warning-soft text-warning'
                : 'border-line text-muted'
          }`
        }
        if (linkedinConnect) {
          linkedinConnect.textContent = connected ? 'Connect another account' : data?.handle ? 'Reconnect LinkedIn' : 'Connect with LinkedIn'
          if (data && !data.oauthConfigured) linkedinConnect.setAttribute('disabled', 'disabled')
          else linkedinConnect.removeAttribute('disabled')
        }
        if (linkedinConnectEnv) linkedinConnectEnv.classList.toggle('hidden', !data?.configuredFromEnv)
      }

      const refreshLinkedIn = async () => {
        try {
          const data = await window.postlineSocial?.fetchStatus('linkedin')
          renderLinkedIn(data)
        }
        catch (error) {
          renderLinkedIn(null)
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'LinkedIn' })
        }
      }

      linkedinConnect?.addEventListener('click', () => {
        notify('Redirecting to LinkedIn…', 'info', { title: 'LinkedIn' })
        navigate('/api/postline/linkedin/auth', true)
      })

      linkedinConnectEnv?.addEventListener('click', async () => {
        linkedinConnectEnv.setAttribute('disabled', 'disabled')
        notify('Connecting LinkedIn from .env…', 'info', { title: 'LinkedIn' })
        try {
          await requestJson('/api/postline/linkedin/connect', { method: 'POST' }, 'LinkedIn connect failed.')
          await Promise.all([refreshLinkedIn(), refreshAccounts()])
          notify('LinkedIn connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          linkedinConnectEnv.removeAttribute('disabled')
        }
      })

      /**
       * Read a provider's OAuth callback result, then strip it from the URL.
       *
       * Reads the query FRESH on every call. The previous code built one
       * URLSearchParams for LinkedIn and mutated it with delete(); Instagram and
       * Threads then read from that already-mutated object, so a callback
       * carrying both a provider key and a message could lose the message.
       *
       * replaceState, not navigate(): navigate() pushes a history entry, so Back
       * would land on a URL still carrying the callback params and re-run this
       * handler. The runtime offers no replace-mode navigation, which is why
       * this one raw history call survives.
       */
      const consumeOAuthResult = (provider) => {
        const route = useRoute()
        const value = route.query[provider]
        if (!value) return null
        const params = new URLSearchParams(route.fullPath.split('?')[1] || '')
        const message = params.get('message')
        params.delete(provider)
        params.delete('message')
        const query = params.toString()
        window.history.replaceState({}, '', `${route.path}${query ? `?${query}` : ''}`)
        return { value, message }
      }

      const linkedinCallback = consumeOAuthResult('linkedin')
      if (linkedinCallback?.value === 'connected')
        notify('LinkedIn connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
      else if (linkedinCallback?.value === 'error')
        notify(linkedinCallback.message || 'LinkedIn connection failed.', 'error', { title: 'LinkedIn' })

      const startLinkedIn = () => void refreshLinkedIn()
      onMount(startLinkedIn)

      // --- X (Twitter) ---
      const twitterHandle = root.querySelector('[data-twitter-channel-handle]')
      const twitterDetail = root.querySelector('[data-twitter-channel-detail]')
      const twitterStatusPill = root.querySelector('[data-twitter-channel-status]')
      const twitterConnect = root.querySelector('[data-twitter-connect]')
      const twitterConnectEnv = root.querySelector('[data-twitter-connect-env]')

      const renderTwitter = (data) => {
        const connected = Boolean(data?.canPublish)
        const label = data?.handle ? `@${data.handle}` : 'Not connected'
        if (twitterHandle) {
          twitterHandle.textContent = handleLine(data, connected ? label : (data?.handle ? `${label}, reconnect` : 'Not connected'))
        }
        if (twitterDetail) {
          twitterDetail.textContent = connected
            ? 'Ready to crosspost. To add another account, switch to it on x.com first.'
            : data?.oauthConfigured
              ? 'Connect X to crosspost tweets. X bills per post, and a post with a link costs far more.'
              : data?.configuredFromEnv
                ? 'Token found in .env. Connect to start crossposting.'
                : 'Set up your X app below, then connect.'
        }
        if (twitterStatusPill) {
          twitterStatusPill.textContent = connected ? 'Connected' : (data?.handle ? 'Reconnect' : 'Setup')
          twitterStatusPill.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-semibold ${
            connected
              ? 'border-success-line bg-success-soft text-success'
              : data?.handle
                ? 'border-warning-line bg-warning-soft text-warning'
                : 'border-line text-muted'
          }`
        }
        if (twitterConnect) {
          twitterConnect.textContent = connected ? 'Connect another account' : data?.handle ? 'Reconnect X' : 'Connect with X'
          if (data && !data.oauthConfigured) twitterConnect.setAttribute('disabled', 'disabled')
          else twitterConnect.removeAttribute('disabled')
        }
        if (twitterConnectEnv) twitterConnectEnv.classList.toggle('hidden', !data?.configuredFromEnv)
      }

      const refreshTwitter = async () => {
        try {
          renderTwitter(await window.postlineSocial?.fetchStatus('twitter'))
        }
        catch (error) {
          renderTwitter(null)
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'X/Twitter' })
        }
      }

      twitterConnect?.addEventListener('click', () => {
        notify('Redirecting to X…', 'info', { title: 'X/Twitter' })
        navigate('/api/postline/twitter/auth', true)
      })

      twitterConnectEnv?.addEventListener('click', async () => {
        twitterConnectEnv.setAttribute('disabled', 'disabled')
        notify('Connecting X from .env…', 'info', { title: 'X/Twitter' })
        try {
          await requestJson('/api/postline/twitter/connect', { method: 'POST' }, 'X connect failed.')
          await Promise.all([refreshTwitter(), refreshAccounts()])
          notify('X connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          twitterConnectEnv.removeAttribute('disabled')
        }
      })

      const twitterCallback = consumeOAuthResult('twitter')
      if (twitterCallback?.value === 'connected')
        notify('X connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
      else if (twitterCallback?.value === 'error')
        notify(twitterCallback.message || 'X connection failed.', 'error', { title: 'X/Twitter' })

      const startTwitter = () => void refreshTwitter()
      onMount(startTwitter)

      // --- Instagram ---
      const instagramHandle = root.querySelector('[data-instagram-channel-handle]')
      const instagramDetail = root.querySelector('[data-instagram-channel-detail]')
      const instagramStatusPill = root.querySelector('[data-instagram-channel-status]')
      const instagramConnect = root.querySelector('[data-instagram-connect]')
      const instagramConnectEnv = root.querySelector('[data-instagram-connect-env]')

      const renderInstagram = (data) => {
        const connected = Boolean(data?.canPublish)
        const label = data?.handle ? `@${data.handle}` : 'Not connected'
        if (instagramHandle) {
          instagramHandle.textContent = handleLine(data, connected ? label : (data?.handle ? `${label}, reconnect` : 'Not connected'))
        }
        if (instagramDetail) {
          instagramDetail.textContent = connected
            ? 'Ready to crosspost. Remember Instagram posts need an image.'
            : data?.oauthConfigured
              ? 'Connect an Instagram Business account to crosspost. Posts require an image.'
              : data?.configuredFromEnv
                ? 'Token found in .env. Connect to start crossposting.'
                : 'Set up your Instagram app below, then connect.'
        }
        if (instagramStatusPill) {
          instagramStatusPill.textContent = connected ? 'Connected' : (data?.handle ? 'Reconnect' : 'Setup')
          instagramStatusPill.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-semibold ${
            connected
              ? 'border-success-line bg-success-soft text-success'
              : data?.handle
                ? 'border-warning-line bg-warning-soft text-warning'
                : 'border-line text-muted'
          }`
        }
        if (instagramConnect) {
          instagramConnect.textContent = connected ? 'Connect another account' : data?.handle ? 'Reconnect Instagram' : 'Connect with Instagram'
          if (data && !data.oauthConfigured) instagramConnect.setAttribute('disabled', 'disabled')
          else instagramConnect.removeAttribute('disabled')
        }
        if (instagramConnectEnv) instagramConnectEnv.classList.toggle('hidden', !data?.configuredFromEnv)
      }

      const refreshInstagram = async () => {
        try {
          const data = await window.postlineSocial?.fetchStatus('instagram')
          renderInstagram(data)
        }
        catch (error) {
          renderInstagram(null)
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Instagram' })
        }
      }

      instagramConnect?.addEventListener('click', () => {
        notify('Redirecting to Instagram…', 'info', { title: 'Instagram' })
        navigate('/api/postline/instagram/auth', true)
      })

      instagramConnectEnv?.addEventListener('click', async () => {
        instagramConnectEnv.setAttribute('disabled', 'disabled')
        notify('Connecting Instagram from .env…', 'info', { title: 'Instagram' })
        try {
          await requestJson('/api/postline/instagram/connect', { method: 'POST' }, 'Instagram connect failed.')
          await Promise.all([refreshInstagram(), refreshAccounts()])
          notify('Instagram connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          instagramConnectEnv.removeAttribute('disabled')
        }
      })

      const instagramCallback = consumeOAuthResult('instagram')
      if (instagramCallback?.value === 'connected')
        notify('Instagram connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
      else if (instagramCallback?.value === 'error')
        notify(instagramCallback.message || 'Instagram connection failed.', 'error', { title: 'Instagram' })

      const startInstagram = () => void refreshInstagram()
      onMount(startInstagram)

      // --- Threads ---
      const threadsHandle = root.querySelector('[data-threads-channel-handle]')
      const threadsDetail = root.querySelector('[data-threads-channel-detail]')
      const threadsStatusPill = root.querySelector('[data-threads-channel-status]')
      const threadsConnect = root.querySelector('[data-threads-connect]')
      const threadsConnectEnv = root.querySelector('[data-threads-connect-env]')

      const renderThreads = (data) => {
        const connected = Boolean(data?.canPublish)
        const label = data?.handle ? `@${data.handle}` : 'Not connected'
        if (threadsHandle) {
          threadsHandle.textContent = handleLine(data, connected ? label : (data?.handle ? `${label}, reconnect` : 'Not connected'))
        }
        if (threadsDetail) {
          threadsDetail.textContent = connected
            ? 'Ready to crosspost from Postline.'
            : data?.oauthConfigured
              ? 'Connect a Threads account to crosspost.'
              : data?.configuredFromEnv
                ? 'Token found in .env. Connect to start crossposting.'
                : 'Set up your Threads app below, then connect.'
        }
        if (threadsStatusPill) {
          threadsStatusPill.textContent = connected ? 'Connected' : (data?.handle ? 'Reconnect' : 'Setup')
          threadsStatusPill.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-semibold ${
            connected
              ? 'border-success-line bg-success-soft text-success'
              : data?.handle
                ? 'border-warning-line bg-warning-soft text-warning'
                : 'border-line text-muted'
          }`
        }
        if (threadsConnect) {
          threadsConnect.textContent = connected ? 'Connect another account' : data?.handle ? 'Reconnect Threads' : 'Connect with Threads'
          if (data && !data.oauthConfigured) threadsConnect.setAttribute('disabled', 'disabled')
          else threadsConnect.removeAttribute('disabled')
        }
        if (threadsConnectEnv) threadsConnectEnv.classList.toggle('hidden', !data?.configuredFromEnv)
      }

      const refreshThreads = async () => {
        try {
          const data = await window.postlineSocial?.fetchStatus('threads')
          renderThreads(data)
        }
        catch (error) {
          renderThreads(null)
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Threads' })
        }
      }

      threadsConnect?.addEventListener('click', () => {
        notify('Redirecting to Threads…', 'info', { title: 'Threads' })
        navigate('/api/postline/threads/auth', true)
      })

      threadsConnectEnv?.addEventListener('click', async () => {
        threadsConnectEnv.setAttribute('disabled', 'disabled')
        notify('Connecting Threads from .env…', 'info', { title: 'Threads' })
        try {
          await requestJson('/api/postline/threads/connect', { method: 'POST' }, 'Threads connect failed.')
          await Promise.all([refreshThreads(), refreshAccounts()])
          notify('Threads connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          threadsConnectEnv.removeAttribute('disabled')
        }
      })

      const threadsCallback = consumeOAuthResult('threads')
      if (threadsCallback?.value === 'connected')
        notify('Threads connected. You can crosspost from the composer.', 'success', { title: 'Connected' })
      else if (threadsCallback?.value === 'error')
        notify(threadsCallback.message || 'Threads connection failed.', 'error', { title: 'Threads' })

      const startThreads = () => void refreshThreads()
      onMount(startThreads)

      // --- Mastodon ---
      const mastodonForm = root.querySelector('[data-mastodon-connect-form]')
      const mastodonInstance = root.querySelector('[data-mastodon-instance]')
      const mastodonToken = root.querySelector('[data-mastodon-token]')
      const mastodonSubmit = root.querySelector('[data-mastodon-connect-submit]')
      const mastodonHandle = root.querySelector('[data-mastodon-channel-handle]')
      const mastodonDetail = root.querySelector('[data-mastodon-channel-detail]')
      const mastodonStatusPill = root.querySelector('[data-mastodon-channel-status]')

      const renderMastodon = (data) => {
        const connected = Boolean(data?.canPublish)
        if (mastodonHandle) mastodonHandle.textContent = handleLine(data, connected ? data.handle : (data?.handle ? `${data.handle}, reconnect` : 'Not connected'))
        if (mastodonInstance && data?.instance) mastodonInstance.value = data.instance
        if (mastodonDetail) {
          mastodonDetail.textContent = connected
            ? 'Ready to crosspost from Postline.'
            : data?.configuredFromEnv
              ? 'Token found in .env. Connect to start crossposting.'
              : 'Connect any Mastodon instance with an access token to crosspost.'
        }
        if (mastodonStatusPill) {
          mastodonStatusPill.textContent = connected ? 'Connected' : (data?.handle ? 'Reconnect' : 'Setup')
          mastodonStatusPill.className = `whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-semibold ${
            connected
              ? 'border-success-line bg-success-soft text-success'
              : data?.handle
                ? 'border-warning-line bg-warning-soft text-warning'
                : 'border-line text-muted'
          }`
        }
        if (mastodonSubmit) mastodonSubmit.textContent = connected ? 'Add or reconnect account' : 'Connect'
      }

      const refreshMastodon = async () => {
        try {
          renderMastodon(await window.postlineSocial?.fetchStatus('mastodon'))
        }
        catch (error) {
          renderMastodon(null)
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Mastodon' })
        }
      }

      mastodonForm?.addEventListener('submit', async (event) => {
        event.preventDefault()
        mastodonSubmit?.setAttribute('disabled', 'disabled')
        notify('Connecting to Mastodon…', 'info', { title: 'Mastodon' })
        try {
          const payload = await requestJson('/api/postline/mastodon/connect', { method: 'POST', body: new FormData(mastodonForm) }, 'Mastodon connect failed.')
          if (mastodonToken) mastodonToken.value = ''
          await Promise.all([refreshMastodon(), refreshAccounts()])
          notify(`${payload.data.handle} is connected. You can crosspost from the composer.`, 'success', { title: 'Connected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Connect failed' })
        }
        finally {
          mastodonSubmit?.removeAttribute('disabled')
        }
      })

      const startMastodon = () => void refreshMastodon()
      onMount(startMastodon)

      // Disconnect refreshes the account list and that network's card, since
      // the card's default account may be the one that just went away.
      const refreshNetwork = {
        bluesky: () => refreshStatus(),
        linkedin: () => refreshLinkedIn(),
        twitter: () => refreshTwitter(),
        instagram: () => refreshInstagram(),
        threads: () => refreshThreads(),
        mastodon: () => refreshMastodon(),
      }

      accountHandlers.disconnect = async (id) => {
        const account = accountList().find(entry => entry.id === id)
        if (!account || disconnectingId()) return
        const name = accountName(account)
        // Reversible (connect it again), but it stops scheduled posts that
        // target this account, so it still asks first.
        if (!window.confirm(`Disconnect ${name}? Scheduled posts for this account will fail until it is connected again. Its published posts are kept.`)) return

        disconnectingId.set(id)
        try {
          await disconnectSocialAccount(id)
          await Promise.all([refreshAccounts(), refreshNetwork[account.provider]?.()])
          notify(`${name} is disconnected.`, 'success', { title: 'Disconnected' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Disconnect failed' })
        }
        finally {
          disconnectingId.set(0)
        }
      }

      accountHandlers.makeDefault = async (id) => {
        const account = accountList().find(entry => entry.id === id)
        if (!account || disconnectingId()) return
        const name = accountName(account)

        disconnectingId.set(id)
        try {
          const body = new FormData()
          body.set('id', String(id))
          await requestJson('/api/postline/accounts/default', { method: 'POST', body }, 'Could not change the default account.')
          await Promise.all([refreshAccounts(), refreshNetwork[account.provider]?.()])
          notify(`Posts to this network now go to ${name} unless you pick another account.`, 'success', { title: 'Default changed' })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Could not change the default' })
        }
        finally {
          disconnectingId.set(0)
        }
      }

      const startAccounts = () => void refreshAccounts()
      onMount(startAccounts)

      appHandlers.load = async () => {
        try {
          const response = await fetch('/api/postline/network-apps')
          const payload = await response.json()
          if (response.ok && payload.ok) networkApps.set(payload.data.apps || [])
        }
        catch {}
      }
      appHandlers.save = async (provider) => {
        const row = appRows().find(entry => entry.provider === provider)
        if (!row) return
        appBusy.set(provider)
        try {
          const body = new FormData()
          body.set('provider', provider)
          body.set('client_id', row.clientId || '')
          body.set('client_secret', row.clientSecret || '')
          if (provider === 'linkedin') body.set('organization_pages', row.organizationPages ? '1' : '0')
          await requestJson('/api/postline/network-apps', { method: 'POST', body }, 'Could not save the app.')
          const drafts = { ...appDrafts() }
          delete drafts[provider]
          appDrafts.set(drafts)
          await appHandlers.load()
          await Promise.all([refreshNetwork[provider]?.()])
          notify(`${row.label} app saved. Connect the account in its card.`, 'success', { title: row.label })
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: row.label })
        }
        finally {
          appBusy.set('')
        }
      }
      appHandlers.clear = async (provider) => {
        const row = appRows().find(entry => entry.provider === provider)
        if (!row || !window.confirm(`Remove your ${row.label} app from Postline? Connected ${row.label} accounts stop renewing until an app is set up again.`)) return
        appBusy.set(provider)
        try {
          const body = new FormData()
          body.set('provider', provider)
          const payload = await requestJson('/api/postline/network-apps/clear', { method: 'POST', body }, 'Could not remove the app.')
          networkApps.set(payload.data.apps || [])
          await refreshNetwork[provider]?.()
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: row.label })
        }
        finally {
          appBusy.set('')
        }
      }
      appHandlers.copy = async (provider) => {
        const row = appRows().find(entry => entry.provider === provider)
        if (!row) return
        try {
          await navigator.clipboard.writeText(row.redirectUrl)
          notify('Redirect address copied.', 'success', { title: row.label })
        }
        catch {
          notify(row.redirectUrl, 'info', { title: 'Copy this address' })
        }
      }
      onMount(() => void appHandlers.load())

      // --- Danger zone: bulk post deletion ---
      const purgeCard = root.querySelector('[data-purge-card]')
      const purgePreview = root.querySelector('[data-purge-preview]')
      const purgeRun = root.querySelector('[data-purge-run]')
      const purgeConfirmation = root.querySelector('[data-purge-confirmation]')
      const purgeSummary = root.querySelector('[data-purge-summary]')
      const purgeHint = root.querySelector('[data-purge-hint]')
      const purgePhraseLabel = root.querySelector('[data-purge-phrase]')
      const purgeCancel = root.querySelector('[data-purge-cancel]')
      let purgeRunId = ''

      // A preview is only valid for the selection it ran against — changing
      // scope or accounts invalidates it and re-locks the delete button. The
      // phrase names the count it showed ("DELETE 42 POSTS"), and its token
      // goes back with the run, so nothing beyond what was shown is deleted.
      let previewedSelection = null
      let previewPhrase = ''
      let previewToken = ''
      const setPreview = (phrase, token) => {
        previewPhrase = phrase || ''
        previewToken = token || ''
        if (purgePhraseLabel) purgePhraseLabel.textContent = previewPhrase || 'the phrase the preview shows'
        if (purgeConfirmation) purgeConfirmation.placeholder = previewPhrase || 'Run a preview first'
      }

      const purgeScope = () => root.querySelector('[data-purge-scope]:checked')?.value || 'tracked'
      const purgeProviders = () => Array.from(root.querySelectorAll('[data-purge-provider]:checked')).map(input => input.value)
      const purgeSelection = () => `${purgeScope()}:${purgeProviders().sort().join(',')}`

      const renderPurgeResults = (data) => purgeResultRows.set(data?.providers || [])

      const syncPurgeButton = () => {
        const phraseOk = Boolean(previewPhrase) && purgeConfirmation?.value === previewPhrase
        const previewOk = previewedSelection === purgeSelection()
        const nothingToDelete = previewOk && previewPhrase === 'DELETE 0 POSTS'
        const enabled = Boolean(phraseOk && previewOk && !nothingToDelete && purgeProviders().length)
        if (purgeRun) purgeRun.disabled = !enabled
        if (purgeHint) {
          purgeHint.textContent = !purgeProviders().length
            ? 'Pick at least one account.'
            : !previewOk
              ? 'Run a preview for this selection first.'
              : nothingToDelete
                ? 'The preview matched no posts, so there is nothing to delete.'
              : !phraseOk
                ? `Type ${previewPhrase} exactly to enable deletion.`
                : 'This permanently deletes the posts listed above.'
        }
      }

      purgeCard?.addEventListener('change', (event) => {
        // Any change to scope or accounts stales the preview.
        if (event.target?.matches('[data-purge-scope], [data-purge-provider]')) {
          previewedSelection = null
          setPreview('', '')
        }
        syncPurgeButton()
      })
      purgeConfirmation?.addEventListener('input', syncPurgeButton)

      purgePreview?.addEventListener('click', async () => {
        const providers = purgeProviders()
        if (!providers.length) {
          notify('Pick at least one account to preview.', 'error', { title: 'Danger zone' })
          return
        }

        purgePreview.setAttribute('disabled', 'disabled')
        if (purgeSummary) purgeSummary.textContent = 'Counting…'
        try {
          const query = new URLSearchParams({ scope: purgeScope(), providers: providers.join(',') })
          const response = await fetch(`/api/postline/purge/preview?${query.toString()}`)
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Preview failed.')

          renderPurgeResults(payload.data)
          previewedSelection = purgeSelection()
          setPreview(payload.data.confirmation, payload.data.previewToken)
          if (purgeSummary) purgeSummary.textContent = `${payload.data.matched} post${payload.data.matched === 1 ? '' : 's'} matched.`
        }
        catch (error) {
          previewedSelection = null
          setPreview('', '')
          if (purgeSummary) purgeSummary.textContent = 'Preview failed.'
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Danger zone' })
        }
        finally {
          purgePreview.removeAttribute('disabled')
          syncPurgeButton()
        }
      })

      purgeRun?.addEventListener('click', async () => {
        const scope = purgeScope()
        // Last stop before an irreversible action, with the number it is about.
        const count = Number((previewPhrase.match(/\d+/) || ['0'])[0])
        const where = scope === 'all' ? 'from the selected accounts' : 'that Postline published'
        if (!window.confirm(`Permanently delete ${count} post${count === 1 ? '' : 's'} ${where}? This cannot be undone.`)) return

        purgeRun.disabled = true
        try {
          const body = new FormData()
          body.set('scope', scope)
          body.set('providers', purgeProviders().join(','))
          body.set('confirmation', purgeConfirmation?.value || '')
          body.set('preview_token', previewToken)

          const response = await fetch('/api/postline/purge', { method: 'POST', body })
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Deletion failed.')

          // The deleting carries on in the background; follow it here.
          purgeRunId = payload.data.runId
          previewedSelection = null
          setPreview('', '')
          if (purgeConfirmation) purgeConfirmation.value = ''
          showPurgeRunning(true)
          await followPurge(purgeRunId)
        }
        catch (error) {
          notify(error instanceof Error ? error.message : String(error), 'error', { title: 'Deletion failed' })
        }
        finally {
          showPurgeRunning(false)
          purgeRunId = ''
          syncPurgeButton()
        }
      })

      const showPurgeRunning = (running) => {
        purgeCancel?.classList.toggle('hidden', !running)
        purgeCancel?.classList.toggle('inline-flex', running)
        if (purgeCancel) purgeCancel.disabled = false
        if (running && purgeRun) purgeRun.disabled = true
      }

      /** Poll a background run until it finishes, showing how far it has got. */
      const followPurge = async (runId) => {
        for (;;) {
          const response = await fetch(`/api/postline/purge/status?run=${encodeURIComponent(runId)}`)
          const payload = await response.json()
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Lost track of the deletion run.')
          const run = payload.data
          if (purgeSummary) purgeSummary.textContent = `${run.deleted} of ${run.limit} deleted${run.failed ? `, ${run.failed} failed` : ''}${run.status === 'running' ? '…' : '.'}`
          if (run.status !== 'running') {
            if (run.result) renderPurgeResults(run.result)
            if (run.status === 'failed') throw new Error(run.error || 'Deletion failed.')
            const stopped = run.status === 'cancelled' ? ' Stopped before the end.' : ''
            notify(
              `Deleted ${run.deleted} post${run.deleted === 1 ? '' : 's'}.${run.failed ? ` ${run.failed} failed.` : ''}${stopped}`,
              run.failed ? 'error' : 'success',
              { title: 'Danger zone' },
            )
            return
          }
          await new Promise(resolve => setTimeout(resolve, 1000))
        }
      }

      purgeCancel?.addEventListener('click', async () => {
        if (!purgeRunId) return
        purgeCancel.disabled = true
        const body = new FormData()
        body.set('run', purgeRunId)
        try {
          await fetch('/api/postline/purge/cancel', { method: 'POST', body })
          if (purgeSummary) purgeSummary.textContent = 'Stopping after the post in hand…'
        }
        catch {
          purgeCancel.disabled = false
        }
      })

      syncPurgeButton()

      // Gate the initial status fetch on DOMContentLoaded so the deferred
      // postline-bluesky module has loaded — otherwise a connected account
      // renders "Not connected" on a full page load. (Mirrors the other
      // providers.)
      const startBluesky = () => void refreshStatus()
      onMount(startBluesky)
    })()
  </script>
@endsection
