@extends('layouts/app')

<script server cache>
import { workspaceLocale, workspaceTimelineText } from '../../app/Support/Localization/workspace'

export const timelineLocale = workspaceLocale
export const timelineText = workspaceTimelineText
export const timelineClient = { locale: workspaceLocale, messages: workspaceTimelineText }
</script>

@section('title')Postline - {{ timelineText.title }}@endsection

@section('content')
  @meta('description', 'Read your Bluesky home timeline in Postline.')
  <section class="grid gap-4" data-postline-page="timeline" data-testid="timeline-page" lang="{{ timelineLocale }}">
    <WorkspacePageHeader titleKey="workspace.pages.timeline.title" descriptionKey="workspace.pages.timeline.description">
      <div class="grid sm:flex gap-2 grid-cols-2 items-center">
        <a class="inline-flex items-center justify-center px-4 h-9 font-semibold text-ink text-sm bg-panel hover:bg-hover border border-line rounded-xl shadow-sm transition-colors" href="/composer" data-stx-link>{{ timelineText.compose }}</a>
        <Button size="sm" leftIcon="<span class='i-hugeicons-refresh' aria-hidden='true'></span>" data-timeline-refresh :loading="busy()" :label="refreshLabel()" @click="refreshManual">{{ timelineText.refresh }}</Button>
      </div>
    </WorkspacePageHeader>

    <section aria-label="{{ timelineText.region }}">
      <Card padding="none" className="shadow-sm">
        <div class="flex gap-3 items-center justify-between px-4 py-3.5 border-b border-line">
          <div>
            <strong class="font-semibold text-ink text-sm">{{ timelineText.following }}</strong>
            <p class="m-0 mt-0.5 text-muted text-xs" :text="metaText()">{{ timelineText.loadingFeed }}</p>
          </div>
          <span class="px-2.5 py-1 font-semibold text-info text-xs bg-info-soft border border-info-line rounded-full">Bluesky</span>
        </div>
        <div class="grid">
          <WorkspaceListSkeleton :show="busy()" label="{{ timelineText.loadingTimeline }}" />
          <ErrorState :show="feedError()" title="{{ timelineText.loadError }}" :message="feedError()" @retry="refresh()" />
          <EmptyState :show="showEmpty() && !busy()" variant="bare" title="{{ timelineText.emptyFeed }}" description="{{ timelineText.emptyDescription }}">
            <Button variant="secondary" size="sm" @click="refresh()">{{ timelineText.refresh }}</Button>
          </EmptyState>
          <EmptyState :show="notConnected() && !busy() && !feedError()" variant="bare" title="{{ timelineText.connectBluesky }}">
            <StxLink class="text-info text-ui underline" to="/accounts">{{ timelineText.openChannels }}</StxLink>
          </EmptyState>

          <article class="grid px-4 py-3.5 hover:bg-hover border-b border-line last:border-b-0 transition-colors" x-for="item in items()">
            <div class="grid gap-3 grid-cols-[2.75rem_minmax(0,1fr)] items-start">
              <a class="grid overflow-hidden place-items-center h-11 w-11 font-semibold text-info text-ui bg-info-soft border border-line rounded-full" :href="profileUrl(item.handle)" target="_blank" rel="noopener noreferrer" data-timeline-avatar :aria-label="item.name">
                <Avatar :src="item.avatar" :name="item.name" :handle="item.handle" />
              </a>
              <div class="grid gap-2 min-w-0">
                <div class="flex gap-2 items-start justify-between">
                  <div class="grid gap-0.5 min-w-0">
                    <div class="flex flex-wrap gap-x-1.5 gap-y-0.5 items-baseline min-w-0">
                      <a class="break-words font-semibold text-ink text-sm hover:underline" :href="profileUrl(item.handle)" target="_blank" rel="noopener noreferrer">{{ item.name }}</a>
                      <a class="break-all text-muted text-ui hover:underline" :href="profileUrl(item.handle)" target="_blank" rel="noopener noreferrer">@{{ item.handle }}</a>
                      <span class="text-muted text-ui">·</span>
                      <time class="text-muted text-ui" :datetime="item.postedAt">{{ item.relativeTime }}</time>
                    </div>
                    <span class="font-semibold text-info text-xs tracking-wider uppercase">Bluesky</span>
                  </div>
                  <a class="inline-flex items-center justify-center shrink-0 h-8 w-8 text-muted hover:text-ink hover:bg-panel-2 rounded-lg transition-colors" :href="item.url" target="_blank" rel="noopener noreferrer" aria-label="{{ timelineText.openPost }}" title="{{ timelineText.openOnBluesky }}">
                    <span class="h-4 w-4 i-hugeicons-square-arrow-up-right-02" aria-hidden="true"></span>
                  </a>
                </div>
                <p class="m-0 break-words text-base text-body whitespace-pre-wrap" data-timeline-copy><template x-for="part in item.body"><a class="break-all text-info underline-offset-2 hover:underline" x-if="part.href" :href="part.href" target="_blank" rel="noopener noreferrer" :text="part.text"></a><span x-else :text="part.text"></span></template></p>
                <div class="flex flex-wrap gap-x-4 gap-y-1 items-center">
                  <a class="inline-flex gap-1.5 items-center px-1.5 py-1 font-semibold text-muted text-xs hover:text-info hover:bg-info-soft rounded-lg transition-colors" :href="item.url" target="_blank" rel="noopener noreferrer">
                    <span class="h-4 w-4 i-hugeicons-comment-02" aria-hidden="true"></span><span>{{ item.replies }}</span><span class="sr-only"> {{ timelineText.replies }}</span>
                  </a>
                  <span class="inline-flex gap-1.5 items-center px-1.5 py-1 font-semibold text-muted text-xs rounded-lg">
                    <span class="h-4 w-4 i-hugeicons-repeat" aria-hidden="true"></span><span>{{ item.reposts }}</span><span class="sr-only"> {{ timelineText.reposts }}</span>
                  </span>
                  <span class="inline-flex gap-1.5 items-center px-1.5 py-1 font-semibold text-muted text-xs rounded-lg">
                    <span class="h-4 w-4 i-hugeicons-favourite" aria-hidden="true"></span><span>{{ item.likes }}</span><span class="sr-only"> {{ timelineText.likes }}</span>
                  </span>
                </div>
              </div>
            </div>
          </article>
        </div>
      </Card>
    </section>
  </section>

  <script client>
    import { createI18n } from '@stacksjs/i18n/client'
    import { showNotification } from '../functions/notification'
    /**
     * Wire shapes for `/api/postline/timeline`, declared where they are used.
     *
     * These describe what the BROWSER receives, which is a flattened projection
     * of `app/Support/Social/types.ts` — deliberately separate, because the wire
     * shape and the server shape are free to diverge. Local to this block on
     * purpose: nothing outside this view refers to them, and a shared ambient
     * `.d.ts` would be an unenforced second source of truth for one file's
     * internals.
     */
    interface TimelineApiItem {
      uri?: string | null
      postUrl?: string | null
      authorHandle?: string | null
      authorName?: string | null
      authorAvatar?: string | null
      postedAt?: string | null
      body?: string | null
      replyCount?: number | null
      repostCount?: number | null
      likeCount?: number | null
    }

    /** A timeline post flattened to exactly what one row renders. */
    interface TimelineRow {
      handle: string
      name: string
      url: string
      avatar: string
      postedAt: string
      relativeTime: string
      body: Array<{ text: string, href?: string }>
      replies: string
      reposts: string
      likes: string
    }

    const { locale: language, messages: copy } = {{ timelineClient }}
    const words = createI18n({ locale: language, messages: { [language]: copy } })
    const elapsed = language === 'en' ? undefined : new Intl.RelativeTimeFormat(language, { numeric: 'auto', style: 'short' })
    const compactCounts = language === 'en' ? undefined : new Intl.NumberFormat(language, { notation: 'compact', maximumFractionDigits: 1 })

    const items = state([])
    const metaText = state(copy.loadingFeed)
    const refreshLabel = state(copy.refresh)
    const busy = state(false)
    const feedError = state('')
    const loaded = state(false)

    /** No Bluesky account to read from: the page says how to connect one. */
    const notConnected = state(false)
    const showEmpty = derived(() => loaded() && !feedError() && !notConnected() && items().length === 0)

    const formatCount = (value: number | null | undefined): string => {
      const n = Number(value) || 0
      if (compactCounts) return compactCounts.format(n)
      if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`
      if (n >= 1000) return `${(n / 1000).toFixed(1).replace(/\.0$/, '')}K`
      return String(n)
    }

    const profileUrl = (handle: string): string => `https://bsky.app/profile/${encodeURIComponent(handle)}`

    const postUrl = (item: TimelineApiItem): string => {
      if (item.postUrl) return item.postUrl
      const id = String(item.uri || '').split('/').pop()
      return id
        ? `https://bsky.app/profile/${encodeURIComponent(item.authorHandle)}/post/${id}`
        : profileUrl(item.authorHandle)
    }

    const bodyParts = (text: string): TimelineRow['body'] => text.split(/(https?:\/\/[^\s<]+)/g)
      .flatMap((part, index) => part ? [{ text: part, ...(index % 2 ? { href: part } : {}) }] : [])

    /**
     * Flatten an API item into exactly what the template renders. Doing the
     * derivation once here keeps the markup free of expression logic and means
     * each row is plain data by the time x-for sees it.
     */
    const toRow = (item: TimelineApiItem): TimelineRow => {
      const handle = item.authorHandle || 'unknown.bsky.social'
      const name = item.authorName || handle
      return {
        handle,
        name,
        url: postUrl(item),
        avatar: item.authorAvatar || '',
        postedAt: item.postedAt || '',
        relativeTime: relativeTime(item.postedAt, { compact: true, formatter: elapsed }),
        body: bodyParts(item.body || ''),
        replies: formatCount(item.replyCount),
        reposts: formatCount(item.repostCount),
        likes: formatCount(item.likeCount),
      }
    }

    /**
     * `manual` = the user clicked Refresh, so toast feedback is wanted. The
     * initial auto-load stays silent and lets the inline feed state speak, so a
     * failing load never spams a toast or stacks one across pages.
     */
    const refresh = async ({ manual = false } = {}) => {
      busy.set(true)
      refreshLabel.set(copy.refreshing)
      feedError.set('')
      metaText.set(copy.syncing)

      try {
        const response = await fetch('/api/postline/bluesky/timeline?limit=30')
        const payload = await response.json()
        if (!response.ok || !payload.ok) throw new Error(payload.error || copy.syncError)

        notConnected.set(payload.data.connected === false)
        const rows = Array.isArray(payload.data.items) ? payload.data.items.map(toRow) : []
        items.set(rows)
        metaText.set(notConnected() ? copy.noAccount : words.t('postCount', { count: rows.length }))
        if (manual) {
          showNotification({
            title: copy.title,
            message: words.t('loadedPosts', { count: rows.length }),
            tone: 'success',
            durationMs: 3200,
          })
        }
      }
      catch (error) {
        const message = error instanceof Error ? error.message : String(error)
        items.set([])
        feedError.set(message)
        metaText.set(copy.loadFeedError)
        if (manual)
          showNotification({ title: copy.title, message, tone: 'error', id: 'timeline-load' })
      }
      finally {
        busy.set(false)
        loaded.set(true)
        refreshLabel.set(copy.refresh)
      }
    }

    const refreshManual = () => void refresh({ manual: true })

    onMount(() => {
      void refresh()
    })
  </script>
@endsection
