@extends('layouts/app')

<script server cache>
import { workspaceListeningText, workspaceLocale } from '../../app/Support/Localization/workspace'

export const listeningLocale = workspaceLocale
export const listeningText = workspaceListeningText
export const listeningClient = { locale: workspaceLocale, messages: workspaceListeningText }
</script>

@section('title')Postline - {{ listeningText.title }}@endsection

@section('content')
  @meta('description', listeningText.description)
  <section class="grid gap-4" data-postline-page="listening" data-testid="listening-page" lang="{{ listeningLocale }}">
    <WorkspacePageHeader titleKey="workspace.pages.listening.title">
      <template #description><span :show="!loading()" :text="watchOverview()"></span></template>
      <div class="flex flex-wrap gap-2 items-center">
        {{-- New matches raise an alert on the server (#112): a Mac notification
            from the app shell on any page, an email when mail is set up, and a
            line in Activity. This page asks the browser for nothing. --}}
        <a class="inline-flex gap-2 items-center justify-center px-3 h-9 font-semibold text-body text-xs bg-panel hover:bg-raised border border-line rounded-xl transition-colors" href="/activity" data-stx-link title="{{ listeningText.alertDetails }}">
          <span class="h-4 w-4 i-hugeicons-notification-01" aria-hidden="true"></span>
          {{ listeningText.alertLocation }}
        </a>
        <button class="inline-flex gap-2 items-center justify-center px-4 h-9 font-semibold text-on-accent text-sm bg-accent hover:bg-accent-hover rounded-xl disabled:opacity-50 transition-colors" type="button" :disabled="scanning() || !canScan()" @click="runScan">
          <span class="h-4 w-4 i-hugeicons-radar-02" :class="scanning() ? 'animate-spin' : ''" aria-hidden="true"></span>
          <span :text="scanning() ? copy.scanning : copy.scan">{{ listeningText.scan }}</span>
        </button>
      </div>
    </WorkspacePageHeader>

    <div class="grid gap-4 lg:grid-cols-[minmax(13rem,18rem)_minmax(0,1fr)] xl:grid-cols-[22rem_minmax(0,1fr)]">
      <aside class="grid content-start gap-4" aria-label="{{ listeningText.rules }}">
        <section class="p-4 bg-panel border border-line rounded-2xl shadow-sm">
          <header class="flex gap-3 items-start justify-between mb-4">
            <div><h2 class="m-0 font-semibold text-ink text-sm" :text="draftId() ? copy.editRule : copy.newRule">{{ listeningText.newRule }}</h2><p class="m-0 mt-1 text-muted text-xs">{{ listeningText.splitKeywords }}</p></div>
            <button class="grid place-items-center h-8 w-8 text-muted hover:text-ink hover:bg-panel-2 rounded-lg" type="button" aria-label="{{ listeningText.clearForm }}" x-show="draftId()" @click="resetForm"><span class="h-4 w-4 i-hugeicons-cancel-01" aria-hidden="true"></span></button>
          </header>
          <form class="grid gap-3" @submit="saveMonitor($event)">
            <label class="grid gap-1.5"><span class="font-semibold text-body text-xs">{{ listeningText.name }}</span><input class="px-3 h-9 text-ink text-sm bg-bg border border-field-line outline-none rounded-xl focus:ring-2 focus:ring-focus" required maxlength="120" placeholder="{{ listeningText.nameExample }}" x-model="draftName"></label>
            <label class="grid gap-1.5"><span class="font-semibold text-body text-xs">{{ listeningText.keywords }}</span><textarea class="px-3 py-2 min-h-24 text-ink text-sm bg-bg border border-field-line outline-none rounded-xl focus:ring-2 focus:ring-focus resize-y" required placeholder="{{ listeningText.keywordsExample }}" x-model="draftKeywords"></textarea><small class="text-muted text-xs">{{ listeningText.keywordLimit }}</small></label>
            <label class="grid gap-1.5"><span class="font-semibold text-body text-xs">{{ listeningText.triggerWhen }}</span><select class="px-3 h-9 text-ink text-sm bg-bg border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" x-model="draftMatchMode"><option value="any">{{ listeningText.anyKeyword }}</option><option value="all">{{ listeningText.allKeywords }}</option><option value="phrase">{{ listeningText.exactPhrase }}</option></select></label>
            <fieldset class="grid gap-2 m-0 p-0 border-0"><legend class="mb-1 font-semibold text-body text-xs">{{ listeningText.networks }}</legend><div class="grid gap-2 grid-cols-3"><button class="px-2 h-9 font-semibold text-xs border rounded-xl transition-colors" type="button" x-for="provider in providerOptions" :class="draftProviders().includes(provider) ? 'text-ink bg-panel-2 border-line-strong' : 'text-muted bg-bg border-line'" @click="toggleProvider(provider)" :aria-pressed="draftProviders().includes(provider)" :text="providerLabel(provider)"></button></div></fieldset>
            <label class="grid gap-1.5" :show="canReadXInBrowser() && draftProviders().includes('twitter')">
              <span class="font-semibold text-body text-xs">{{ listeningText.xSource }}</span>
              <select class="px-3 h-9 text-ink text-sm bg-bg border border-field-line outline-none rounded-xl focus:ring-2 focus:ring-focus" x-model="draftTwitterReadSource">
                <option value="api">X API</option>
                <option value="browser">{{ listeningText.browserSession }}</option>
              </select>
              <small class="text-muted text-xs" :show="draftTwitterReadSource() === 'browser'">
                {{ listeningText.importX }} <a href="/accounts" data-stx-link class="text-info underline">{{ listeningText.channels }}</a>.
              </small>
            </label>
            <label class="flex gap-3 items-center p-3 bg-panel-2 border border-line rounded-xl"><input type="checkbox" :checked="draftStatus() === 'active'" @change="draftStatus.set($event.target.checked ? 'active' : 'paused')"><span><strong class="block text-ink text-xs">{{ listeningText.watchActive }}</strong><small class="block mt-0.5 text-muted text-xs">{{ listeningText.schedulerChecks }}</small></span></label>
            <div class="flex gap-2 items-center pt-1">
              <button class="inline-flex flex-1 items-center justify-center h-9 font-semibold text-on-accent text-sm bg-accent hover:bg-accent-hover rounded-xl disabled:opacity-50" type="submit" :disabled="saving()"><span :text="saving() ? copy.saving : draftId() ? copy.updateRule : copy.createRule">{{ listeningText.createRule }}</span></button>
              <button class="inline-flex items-center justify-center px-3 h-9 font-semibold text-danger text-xs hover:bg-danger-soft border border-danger-line rounded-xl disabled:opacity-50" type="button" x-show="draftId()" :disabled="deleting()" @click="deleteMonitor"><span :text="deleting() ? copy.deleting : copy.delete">{{ listeningText.delete }}</span></button>
            </div>
          </form>
        </section>

        <section class="overflow-hidden bg-panel border border-line rounded-2xl shadow-sm" x-show="monitors().length">
          <header class="px-4 py-3 border-b border-line"><h2 class="m-0 font-semibold text-ink text-sm">{{ listeningText.savedWatches }}</h2></header>
          <div class="divide-line divide-y">
            <button class="grid gap-2 p-3 w-full text-left hover:bg-panel-2 transition-colors" type="button" x-for="monitor in monitors()" @click="selectMonitor(monitor)">
              <div class="flex gap-2 items-center justify-between"><strong class="text-ink text-ui" :text="monitor.name"></strong><span class="px-2 py-0.5 font-semibold text-xs rounded-full" :class="monitor.status === 'active' ? 'text-success bg-success-soft' : 'text-muted bg-panel-2'" :text="copy.statuses[monitor.status] || monitor.status"></span></div>
              <p class="m-0 line-clamp-2 text-muted text-xs" :text="monitor.keywords.join(', ')"></p>
              <div class="flex gap-2 items-center text-muted text-xs"><span :text="words.t('unreadCount', { count: monitor.unreadCount })"></span><span>·</span><span :text="monitor.providers.map(providerLabel).join(', ')"></span></div>
            </button>
          </div>
        </section>
      </aside>

      <section aria-label="{{ listeningText.mentions }}">
        <Card padding="none" className="min-h-[34rem] shadow-sm">
          <header class="flex flex-wrap gap-3 items-center justify-between px-4 py-3.5 border-b border-line">
            <div><h2 class="m-0 font-semibold text-ink text-sm">{{ listeningText.mentionInbox }}</h2><p class="m-0 mt-1 text-muted text-xs" :text="inboxSummary()">{{ listeningText.newMatches }}</p></div>
            <div class="flex gap-2 items-center">
              <select class="px-3 h-8 text-ink text-xs bg-panel-2 border border-field-line rounded-lg" aria-label="{{ listeningText.watch }}" @change="filterMonitorId.set(Number($event.target.value))"><option value="0">{{ listeningText.allWatches }}</option><option x-for="monitor in monitors()" :value="monitor.id" :text="monitor.name"></option></select>
              <button class="px-3 h-8 font-semibold text-ink text-xs bg-panel-2 hover:bg-raised border border-line rounded-lg disabled:opacity-50" type="button" :disabled="unreadCount() === 0" @click="markAllRead">{{ listeningText.markAllRead }}</button>
            </div>
          </header>

          <WorkspaceListSkeleton :show="loading()" label="{{ listeningText.loadingMentions }}" />
          <ErrorState :show="mentionLoadError() && !loading()" title="{{ listeningText.readMentionsFailed }}" :message="mentionLoadError()" @retry="loadData()" />
          <EmptyState :show="showEmpty()" variant="bare" :title="monitors().length ? copy.noMentions : copy.firstRule" :description="monitors().length ? copy.matchesWillAppear : copy.chooseTerms">
            <button class="text-info text-ui underline disabled:opacity-50" type="button" :show="activeCount()" :disabled="scanning()" @click="runScan">{{ listeningText.runScan }}</button>
          </EmptyState>

          <div class="divide-line divide-y" x-show="!loading() && filteredMentions().length">
            <article class="grid gap-3 p-4 hover:bg-panel-2/45 transition-colors" x-for="mention in filteredMentions()" :data-command-context="mention.authorName || mention.authorHandle" :class="mention.status === 'unread' ? 'bg-info-soft' : ''">
              <div class="flex gap-3 items-start">
                <NetworkChip :provider="mention.provider" />
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap gap-x-2 gap-y-1 items-center">
                    <strong class="text-ink text-ui" :text="mention.authorName || `@${mention.authorHandle}`"></strong>
                    <span class="text-muted text-xs" :text="`@${mention.authorHandle}`" x-show="mention.authorName"></span>
                    <span class="text-muted text-xs">·</span><time class="text-muted text-xs" :datetime="mention.postedAt" :text="relativeTime(mention.postedAt, { fallback: copy.notYet, formatter: elapsed })"></time>
                    <span class="h-2 w-2 bg-info-solid rounded-full" x-show="mention.status === 'unread'" aria-label="{{ listeningText.unread }}"></span>
                  </div>
                  <p class="m-0 mt-2 leading-5 text-body text-ui whitespace-pre-line" :text="mention.body"></p>
                  <div class="flex flex-wrap gap-1.5 mt-3"><span class="px-2 py-0.5 font-semibold text-note text-xs bg-note-soft border border-note-line rounded-full" x-for="keyword in mention.matchedKeywords" :text="keyword"></span></div>
                </div>
                <a class="grid place-items-center shrink-0 h-8 w-8 text-muted hover:text-ink hover:bg-raised border border-line rounded-lg" :href="mention.url" target="_blank" rel="noopener noreferrer" aria-label="{{ listeningText.openMention }}" @click="markRead(mention.id)"><span class="h-4 w-4 i-hugeicons-square-arrow-up-right-02" aria-hidden="true"></span></a>
              </div>
            </article>
            <button class="p-3 w-full text-center text-muted text-ui hover:text-ink hover:bg-panel-2 transition-colors" type="button" x-show="nextOffset() !== null" :disabled="loadingMore()" @click="loadMoreMentions" :text="loadingMore() ? copy.loading : copy.moreMentions">{{ listeningText.moreMentions }}</button>
          </div>
          <p class="m-0 px-4 py-3 text-danger text-sm bg-danger-soft border-danger-line border-t" x-show="errorMessage()" :text="errorMessage()"></p>
        </Card>
      </section>
    </div>
  </section>

  <script client>
    import { createI18n } from '@stacksjs/i18n/client'
    import { showNotification } from '../functions/notification'
    import { xBrowserWindow } from '../functions/x-browser-session'
    const { locale: language, messages: copy } = {{ listeningClient }}
    const words = createI18n({ locale: language, messages: { [language]: copy } })
    const elapsed = language === 'en' ? undefined : new Intl.RelativeTimeFormat(language, { numeric: 'auto' })

    interface ListeningMonitor {
      id: number
      name: string
      keywords: string[]
      providers: string[]
      matchMode: string
      twitterReadSource: 'api' | 'browser'
      status: string
      lastCheckedAt?: string | null
      lastError?: string | null
      unreadCount: number
      mentionCount: number
    }

    interface ListeningMention {
      id: number
      monitorId: number
      provider: string
      authorHandle: string
      authorName?: string | null
      body: string
      matchedKeywords: string[]
      status: string
      postedAt: string
      url: string
    }

    const providerOptions = ['bluesky', 'twitter', 'mastodon']
    const monitors = state([])
    const mentions = state([])
    const loading = state(true)
    const loaded = state(false)
    const saving = state(false)
    const deleting = state(false)
    const scanning = state(false)
    const errorMessage = state('')
    const mentionLoadError = state('')
    const filterMonitorId = state(0)
    // Mentions come a page at a time (#105).
    const nextOffset = state<number | null>(null)
    const loadingMore = state(false)
    const draftId = state(0)
    const draftName = state('')
    const draftKeywords = state('')
    const draftProviders = state(['bluesky'])
    const draftMatchMode = state('any')
    const draftTwitterReadSource = state<'api' | 'browser'>('api')
    const canReadXInBrowser = state(false)
    useNativeDesktop().onReady(host => canReadXInBrowser.set(Boolean(xBrowserWindow(host))))
    const draftStatus = state('active')
    let pollTimer = 0

    const filteredMentions = derived(() => filterMonitorId() ? mentions().filter(item => item.monitorId === filterMonitorId()) : mentions())
    const unreadCount = derived(() => mentions().filter(item => item.status === 'unread').length)
    const activeCount = derived(() => monitors().filter(item => item.status === 'active').length)
    const canScan = derived(() => monitors().some(monitor => monitor.status === 'active'
      && (!filterMonitorId() || monitor.id === filterMonitorId())
      && monitor.providers.some(provider => provider !== 'twitter' || monitor.twitterReadSource !== 'browser')))
    const showEmpty = derived(() => loaded() && !loading() && !mentionLoadError() && filteredMentions().length === 0)
    const inboxSummary = derived(() => {
      const rows = filteredMentions()
      return words.tc('mentionSummary', rows.length, { unread: rows.filter(item => item.status === 'unread').length })
    })
    const lastCheckedLabel = derived(() => {
      const values = monitors().map(item => item.lastCheckedAt).filter(Boolean).sort().reverse()
      return values.length ? relativeTime(values[0], { formatter: elapsed }) : ''
    })
    const watchOverview = derived(() => {
      const summary = words.tc('watchSummary', activeCount(), { unread: unreadCount() })
      const time = lastCheckedLabel()
      return time ? `${summary} · ${words.t('lastChecked', { time })}` : summary
    })

    const loadData = async ({ quiet = false } = {}) => {
      if (!quiet) loading.set(true)
      mentionLoadError.set('')
      try {
        const payload = await requestJson('/api/postline/listening', {}, copy.readMentionsFailed)
        const monitorRows = Array.isArray(payload.data?.monitors) ? payload.data.monitors : []
        const mentionRows = Array.isArray(payload.data?.mentions) ? payload.data.mentions : []
        monitors.set(monitorRows)
        // A quiet refresh updates the first page and keeps pages loaded below it.
        if (quiet && nextOffset() !== null && mentions().length > mentionRows.length) {
          const fresh = new Set(mentionRows.map(item => item.id))
          mentions.set([...mentionRows, ...mentions().filter(item => !fresh.has(item.id))])
        }
        else {
          mentions.set(mentionRows)
          nextOffset.set(payload.data?.nextOffset ?? null)
        }
      }
      catch (error) {
        mentionLoadError.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        loading.set(false)
        loaded.set(true)
      }
    }

    const loadMoreMentions = async () => {
      const offset = nextOffset()
      if (offset === null || loadingMore()) return
      loadingMore.set(true)
      try {
        const payload = await requestJson(`/api/postline/listening?offset=${offset}`, {}, copy.readMentionsFailed)
        const seen = new Set(mentions().map(item => item.id))
        mentions.set([...mentions(), ...(Array.isArray(payload.data?.mentions) ? payload.data.mentions : []).filter(item => !seen.has(item.id))])
        nextOffset.set(payload.data?.nextOffset ?? null)
      }
      catch (error) {
        errorMessage.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        loadingMore.set(false)
      }
    }

    const resetForm = () => {
      draftId.set(0)
      draftName.set('')
      draftKeywords.set('')
      draftProviders.set(['bluesky'])
      draftMatchMode.set('any')
      draftTwitterReadSource.set('api')
      draftStatus.set('active')
    }

    const selectMonitor = (monitor: ListeningMonitor) => {
      draftId.set(monitor.id)
      draftName.set(monitor.name)
      draftKeywords.set(monitor.keywords.join(', '))
      draftProviders.set([...monitor.providers])
      draftMatchMode.set(monitor.matchMode)
      draftTwitterReadSource.set(monitor.twitterReadSource === 'browser' ? 'browser' : 'api')
      draftStatus.set(monitor.status)
      filterMonitorId.set(monitor.id)
    }

    const toggleProvider = (provider: string) => {
      draftProviders.set(draftProviders().includes(provider) ? draftProviders().filter(item => item !== provider) : [...draftProviders(), provider])
    }

    const saveMonitor = async (event: SubmitEvent) => {
      event.preventDefault()
      saving.set(true)
      try {
        await requestJson('/api/postline/listening', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: draftId(), name: draftName(), keywords: draftKeywords().split(',').map(item => item.trim()).filter(Boolean), providers: draftProviders(), match_mode: draftMatchMode(), status: draftStatus(), twitter_read_source: canReadXInBrowser() ? draftTwitterReadSource() : undefined }),
        })
        showNotification({ title: copy.saved, message: copy.savedDescription, tone: 'success', id: 'listening-save' })
        resetForm()
        await loadData()
      }
      catch (error) {
        showNotification({ title: copy.saveFailed, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'listening-save' })
      }
      finally {
        saving.set(false)
      }
    }

    const deleteMonitor = async () => {
      const id = draftId()
      if (deleting() || !id) return
      if (!await stxConfirm(copy.deleteWarning, { title: copy.confirmDelete, type: 'error', confirmText: copy.deleteRule, cancelText: copy.cancel })) return
      deleting.set(true)
      try {
        await requestJson('/api/postline/listening/delete', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id }) })
        resetForm()
        filterMonitorId.set(0)
        await loadData()
        showNotification({ title: copy.deleted, message: copy.deletedDescription, tone: 'success', id: 'listening-delete' })
      }
      catch (error) {
        showNotification({ title: copy.deleteFailed, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'listening-delete' })
      }
      finally {
        deleting.set(false)
      }
    }

    const runScan = async () => {
      scanning.set(true)
      try {
        const payload = await requestJson('/api/postline/listening/scan', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ monitor_id: filterMonitorId() || 0 }) })
        await loadData({ quiet: true })
        const skipped = payload.data?.errors?.length || 0
        const message = words.tc('newMentions', payload.data?.created || 0)
        const attention = skipped ? words.tc('scanAttention', skipped) : ''
        showNotification({ title: copy.scanComplete, message: [message, attention].filter(Boolean).join(' '), tone: skipped ? 'neutral' : 'success', id: 'listening-scan' })
      }
      catch (error) {
        showNotification({ title: copy.scanFailed, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'listening-scan' })
      }
      finally {
        scanning.set(false)
      }
    }

    const markRead = async (id: number) => {
      mentions.set(mentions().map(item => item.id === id ? { ...item, status: 'read' } : item))
      try {
        await requestJson('/api/postline/listening/read', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id }) })
      }
      catch {
        await loadData({ quiet: true })
      }
    }

    const markAllRead = async () => {
      try {
        await requestJson('/api/postline/listening/read', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ monitor_id: filterMonitorId() || 0 }) })
        mentions.set(mentions().map(item => !filterMonitorId() || item.monitorId === filterMonitorId() ? { ...item, status: 'read' } : item))
      }
      catch (error) {
        showNotification({ title: copy.updateMentionsFailed, message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'listening-read' })
      }
    }

    // A hidden tab asks for nothing (#184); the next tick after it is shown
    // again catches up, and a quiet refresh merges by id rather than redrawing.
    const visibility = useDocumentVisibility()
    onMount(() => {
      void loadData()
      pollTimer = window.setInterval(() => {
        if (visibility.value === 'hidden') return
        void loadData({ quiet: true })
      }, 60_000)
    })
    onUnmounted(() => window.clearInterval(pollTimer))
  </script>
@endsection
