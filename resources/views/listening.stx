@extends('layouts/postline')

@section('title', 'Postline - Listening')
@section('description', 'Watch brand and product keywords across social networks and collect new mentions.')

@section('content')
  <section class="grid gap-4" data-postline-page="listening" data-testid="listening-page">
    <header class="flex flex-col gap-4 items-stretch justify-between md:flex-row md:items-center min-h-11">
      <div>
        <p class="mb-1.5 font-bold text-[11px] text-muted tracking-wider uppercase">Social Listening</p>
        <h1 class="m-0 font-bold text-[22px] text-ink tracking-normal">Know when people talk about you</h1>
        <p class="mb-0 mt-1.5 text-[13px] text-muted">Watch brand, product, and competitor keywords across Bluesky, X, and Mastodon.</p>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <button class="inline-flex gap-2 items-center justify-center px-3 h-9 font-bold text-ink text-xs bg-panel hover:bg-white border border-line rounded-xl transition-colors" type="button" @click="enableDesktopAlerts" :text="desktopAlertLabel()">Enable desktop alerts</button>
        <button class="inline-flex gap-2 items-center justify-center px-4 h-9 font-bold text-on-accent text-sm bg-accent hover:bg-neutral-800 rounded-xl disabled:opacity-50 transition-colors" type="button" :disabled="scanning() || activeCount() === 0" @click="runScan">
          <span class="h-4 w-4 i-hugeicons-radar-02" :class="scanning() ? 'animate-spin' : ''" aria-hidden="true"></span>
          <span :text="scanning() ? 'Scanning…' : 'Scan now'">Scan now</span>
        </button>
      </div>
    </header>

    <div class="grid gap-3 sm:grid-cols-3">
      <article class="flex gap-3 items-center p-4 bg-panel border border-line rounded-2xl shadow-sm">
        <span class="grid place-items-center shrink-0 h-10 w-10 text-lg text-violet-700 bg-violet-50 rounded-xl i-hugeicons-radar-02" aria-hidden="true"></span>
        <div><span class="block font-bold text-[10px] text-muted tracking-wider uppercase">Active watches</span><strong class="block mt-1 text-ink text-xl" :text="String(activeCount())">0</strong></div>
      </article>
      <article class="flex gap-3 items-center p-4 bg-panel border border-line rounded-2xl shadow-sm">
        <span class="grid place-items-center shrink-0 h-10 w-10 text-blue-700 text-lg bg-blue-50 rounded-xl i-hugeicons-notification-02" aria-hidden="true"></span>
        <div><span class="block font-bold text-[10px] text-muted tracking-wider uppercase">Unread mentions</span><strong class="block mt-1 text-ink text-xl" :text="String(unreadCount())">0</strong></div>
      </article>
      <article class="flex gap-3 items-center p-4 bg-panel border border-line rounded-2xl shadow-sm">
        <span class="grid place-items-center shrink-0 h-10 w-10 text-emerald-700 text-lg bg-emerald-50 rounded-xl i-hugeicons-clock-01" aria-hidden="true"></span>
        <div class="min-w-0"><span class="block font-bold text-[10px] text-muted tracking-wider uppercase">Last checked</span><strong class="block mt-1 text-ink text-sm truncate" :text="lastCheckedLabel()">Not yet</strong></div>
      </article>
    </div>

    <div class="grid gap-4 xl:grid-cols-[22rem_minmax(0,1fr)]">
      <aside class="grid content-start gap-4" aria-label="Listening rules">
        <section class="p-4 bg-panel border border-line rounded-2xl shadow-sm">
          <header class="flex gap-3 items-start justify-between mb-4">
            <div><h2 class="m-0 font-bold text-ink text-sm" :text="draftId() ? 'Edit listening rule' : 'New listening rule'">New listening rule</h2><p class="m-0 mt-1 text-muted text-xs">Use commas to watch several keywords.</p></div>
            <button class="grid place-items-center h-8 w-8 text-muted hover:text-ink hover:bg-panel-2 rounded-lg" type="button" aria-label="Clear form" x-show="draftId()" @click="resetForm"><span class="h-4 w-4 i-hugeicons-cancel-01" aria-hidden="true"></span></button>
          </header>
          <form class="grid gap-3" @submit="saveMonitor($event)">
            <label class="grid gap-1.5"><span class="font-bold text-body text-xs">Name</span><input class="px-3 h-9 text-ink text-sm bg-bg border border-line outline-none rounded-xl focus:ring-2 focus:ring-zinc-400/40" required maxlength="120" placeholder="Brand mentions" x-model="draftName"></label>
            <label class="grid gap-1.5"><span class="font-bold text-body text-xs">Keywords</span><textarea class="px-3 py-2 min-h-24 text-ink text-sm bg-bg border border-line outline-none rounded-xl focus:ring-2 focus:ring-zinc-400/40 resize-y" required placeholder="Postline, stacks.js, launch tool" x-model="draftKeywords"></textarea><small class="text-[11px] text-muted">Up to 20 keywords. Matching is case-insensitive.</small></label>
            <label class="grid gap-1.5"><span class="font-bold text-body text-xs">Trigger when</span><select class="px-3 h-9 text-ink text-sm bg-bg border border-line outline-none rounded-xl" x-model="draftMatchMode"><option value="any">Any keyword appears</option><option value="all">All keywords appear</option><option value="phrase">The exact phrase appears</option></select></label>
            <fieldset class="grid gap-2 m-0 p-0 border-0"><legend class="mb-1 font-bold text-body text-xs">Networks</legend><div class="grid gap-2 grid-cols-3"><button class="px-2 h-9 font-bold text-[11px] border rounded-xl transition-colors" type="button" x-for="provider in providerOptions" :class="draftProviders().includes(provider.id) ? 'text-ink bg-panel-2 border-zinc-400' : 'text-muted bg-bg border-line'" @click="toggleProvider(provider.id)" :text="provider.label"></button></div></fieldset>
            <label class="flex gap-3 items-center p-3 bg-panel-2 border border-line rounded-xl"><input type="checkbox" :checked="draftStatus() === 'active'" @change="draftStatus.set($event.target.checked ? 'active' : 'paused')"><span><strong class="block text-ink text-xs">Watch automatically</strong><small class="block mt-0.5 text-[11px] text-muted">The scheduler checks active rules every five minutes.</small></span></label>
            <div class="flex gap-2 items-center pt-1">
              <button class="inline-flex flex-1 items-center justify-center h-9 font-bold text-on-accent text-sm bg-accent hover:bg-neutral-800 rounded-xl disabled:opacity-50" type="submit" :disabled="saving()"><span :text="saving() ? 'Saving…' : draftId() ? 'Update rule' : 'Create rule'">Create rule</span></button>
              <button class="inline-flex items-center justify-center px-3 h-9 font-bold text-red-700 text-xs hover:bg-red-50 border border-red-200 rounded-xl" type="button" x-show="draftId()" @click="deleteMonitor">Delete</button>
            </div>
          </form>
        </section>

        <section class="overflow-hidden bg-panel border border-line rounded-2xl shadow-sm" x-show="monitors().length">
          <header class="px-4 py-3 border-b border-line"><h2 class="m-0 font-bold text-ink text-sm">Saved watches</h2></header>
          <div class="divide-line divide-y">
            <button class="grid gap-2 p-3 w-full text-left hover:bg-panel-2 transition-colors" type="button" x-for="monitor in monitors()" @click="selectMonitor(monitor)">
              <div class="flex gap-2 items-center justify-between"><strong class="text-[13px] text-ink" :text="monitor.name"></strong><span class="px-2 py-0.5 font-bold text-[10px] rounded-full" :class="monitor.status === 'active' ? 'text-emerald-700 bg-emerald-50' : 'text-muted bg-panel-2'" :text="monitor.status"></span></div>
              <p class="m-0 line-clamp-2 text-muted text-xs" :text="monitor.keywords.join(', ')"></p>
              <div class="flex gap-2 items-center text-[10px] text-muted"><span :text="`${monitor.unreadCount} unread`"></span><span>·</span><span :text="monitor.providers.map(providerLabel).join(', ')"></span></div>
            </button>
          </div>
        </section>
      </aside>

      <section class="overflow-hidden min-h-[34rem] bg-panel border border-line rounded-2xl shadow-sm" aria-label="Keyword mentions">
        <header class="flex flex-wrap gap-3 items-center justify-between px-4 py-3.5 border-b border-line">
          <div><h2 class="m-0 font-bold text-ink text-sm">Mention inbox</h2><p class="m-0 mt-1 text-muted text-xs" :text="inboxSummary()">New matching posts appear here.</p></div>
          <div class="flex gap-2 items-center">
            <select class="px-3 h-8 text-ink text-xs bg-panel-2 border border-line rounded-lg" @change="filterMonitorId.set(Number($event.target.value))"><option value="0">All watches</option><option x-for="monitor in monitors()" :value="monitor.id" :text="monitor.name"></option></select>
            <button class="px-3 h-8 font-bold text-ink text-xs bg-panel-2 hover:bg-white border border-line rounded-lg disabled:opacity-50" type="button" :disabled="unreadCount() === 0" @click="markAllRead">Mark all read</button>
          </div>
        </header>

        <div class="grid gap-3 place-items-center px-6 py-20 text-center" x-show="loading()">
          <span class="h-7 w-7 text-muted animate-spin i-hugeicons-loading-03" aria-hidden="true"></span><p class="m-0 text-muted text-sm">Loading listening rules…</p>
        </div>
        <div class="grid gap-3 place-items-center px-6 py-20 text-center" x-show="showEmpty()">
          <span class="grid place-items-center h-14 w-14 text-2xl text-violet-700 bg-violet-50 rounded-2xl i-hugeicons-radar-02" aria-hidden="true"></span>
          <div><h2 class="m-0 font-bold text-base text-ink" :text="monitors().length ? 'No mentions found yet' : 'Create your first listening rule'">Create your first listening rule</h2><p class="m-0 mt-1 max-w-md text-muted text-sm" :text="monitors().length ? 'Run a scan now. New matching posts will be saved here and highlighted as unread.' : 'Choose the terms and networks you care about. Postline will keep checking them for you.'"></p></div>
        </div>

        <div class="divide-line divide-y" x-show="!loading() && filteredMentions().length">
          <article class="grid gap-3 p-4 hover:bg-panel-2/45 transition-colors" x-for="mention in filteredMentions()" :class="mention.status === 'unread' ? 'bg-blue-50/30' : ''">
            <div class="flex gap-3 items-start">
              <span class="grid place-items-center shrink-0 h-9 w-9 font-bold text-white text-xs rounded-xl" :class="providerColor(mention.provider)" :text="providerInitial(mention.provider)"></span>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap gap-x-2 gap-y-1 items-center">
                  <strong class="text-[13px] text-ink" :text="mention.authorName || `@${mention.authorHandle}`"></strong>
                  <span class="text-muted text-xs" :text="`@${mention.authorHandle}`" x-show="mention.authorName"></span>
                  <span class="text-muted text-xs">·</span><time class="text-muted text-xs" :datetime="mention.postedAt" :text="relativeTime(mention.postedAt)"></time>
                  <span class="h-2 w-2 bg-blue-500 rounded-full" x-show="mention.status === 'unread'" aria-label="Unread"></span>
                </div>
                <p class="m-0 mt-2 leading-5 text-[13px] text-body whitespace-pre-line" :text="mention.body"></p>
                <div class="flex flex-wrap gap-1.5 mt-3"><span class="px-2 py-0.5 font-bold text-[10px] text-violet-700 bg-violet-50 border border-violet-100 rounded-full" x-for="keyword in mention.matchedKeywords" :text="keyword"></span></div>
              </div>
              <a class="grid place-items-center shrink-0 h-8 w-8 text-muted hover:text-ink hover:bg-white border border-line rounded-lg" :href="mention.url" target="_blank" rel="noopener noreferrer" aria-label="Open mention" @click="markRead(mention.id)"><span class="h-4 w-4 i-hugeicons-square-arrow-up-right-02" aria-hidden="true"></span></a>
            </div>
          </article>
        </div>
        <p class="m-0 px-4 py-3 text-red-700 text-sm bg-red-50 border-red-100 border-t" x-show="errorMessage()" :text="errorMessage()"></p>
      </section>
    </div>
  </section>

  <script client>
    interface ListeningMonitor {
      id: number
      name: string
      keywords: string[]
      providers: string[]
      matchMode: string
      status: string
      lastCheckedAt?: string | null
      lastError?: string | null
      unreadCount: number
      mentionCount: number
    }

    interface ListeningMention {
      id: number
      monitorId: number
      provider: string
      authorHandle: string
      authorName?: string | null
      body: string
      matchedKeywords: string[]
      status: string
      postedAt: string
      url: string
    }

    const providerOptions = [{ id: 'bluesky', label: 'Bluesky' }, { id: 'twitter', label: 'X' }, { id: 'mastodon', label: 'Mastodon' }]
    const monitors = state([])
    const mentions = state([])
    const loading = state(true)
    const loaded = state(false)
    const saving = state(false)
    const scanning = state(false)
    const errorMessage = state('')
    const filterMonitorId = state(0)
    const draftId = state(0)
    const draftName = state('')
    const draftKeywords = state('')
    const draftProviders = state(['bluesky'])
    const draftMatchMode = state('any')
    const draftStatus = state('active')
    const notificationPermission = state(typeof Notification === 'undefined' ? 'unsupported' : Notification.permission)
    let pollTimer = 0

    const filteredMentions = derived(() => filterMonitorId() ? mentions().filter(item => item.monitorId === filterMonitorId()) : mentions())
    const unreadCount = derived(() => mentions().filter(item => item.status === 'unread').length)
    const activeCount = derived(() => monitors().filter(item => item.status === 'active').length)
    const showEmpty = derived(() => loaded() && !loading() && !errorMessage() && filteredMentions().length === 0)
    const inboxSummary = derived(() => `${filteredMentions().length} mention${filteredMentions().length === 1 ? '' : 's'}, ${filteredMentions().filter(item => item.status === 'unread').length} unread`)
    const lastCheckedLabel = derived(() => {
      const values = monitors().map(item => item.lastCheckedAt).filter(Boolean).sort().reverse()
      return values.length ? relativeTime(values[0]) : 'Not yet'
    })
    const desktopAlertLabel = derived(() => notificationPermission() === 'granted' ? 'Desktop alerts on' : notificationPermission() === 'denied' ? 'Alerts blocked' : notificationPermission() === 'unsupported' ? 'Alerts unavailable' : 'Enable desktop alerts')

    const providerLabel = (provider: string): string => providerOptions.find(item => item.id === provider)?.label || provider
    const providerInitial = (provider: string): string => provider === 'twitter' ? 'X' : provider.slice(0, 1).toUpperCase()
    const providerColor = (provider: string): string => provider === 'twitter' ? 'bg-zinc-900' : provider === 'mastodon' ? 'bg-indigo-600' : 'bg-blue-600'
    const relativeTime = (value: string | null | undefined): string => {
      const date = new Date(String(value || '').replace(' ', 'T') + (String(value || '').includes('Z') ? '' : 'Z'))
      if (Number.isNaN(date.getTime())) return 'Not yet'
      const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000))
      if (seconds < 60) return 'just now'
      if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`
      if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`
      if (seconds < 604800) return `${Math.floor(seconds / 86400)}d ago`
      return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })
    }

    const requestJson = async (url: string, options: RequestInit = {}) => {
      const response = await fetch(url, options)
      const payload = await response.json()
      if (!response.ok || !payload.ok) throw new Error(payload.error || 'Listening request failed.')
      return payload
    }

    const notifyNewMentions = (previousIds: Set<number>, rows: ListeningMention[]) => {
      if (notificationPermission() !== 'granted') return
      const fresh = rows.filter(item => item.status === 'unread' && !previousIds.has(item.id))
      if (!fresh.length) return
      const first = fresh[0]
      new Notification(fresh.length === 1 ? `New ${providerLabel(first.provider)} mention` : `${fresh.length} new social mentions`, {
        body: fresh.length === 1 ? first.body.slice(0, 180) : 'Open Postline Listening to review the new matches.',
      })
    }

    const loadData = async ({ quiet = false } = {}) => {
      if (!quiet) loading.set(true)
      errorMessage.set('')
      const previousIds = new Set(mentions().map(item => item.id))
      try {
        const payload = await requestJson('/api/postline/listening')
        const monitorRows = Array.isArray(payload.data?.monitors) ? payload.data.monitors : []
        const mentionRows = Array.isArray(payload.data?.mentions) ? payload.data.mentions : []
        monitors.set(monitorRows)
        mentions.set(mentionRows)
        if (quiet) notifyNewMentions(previousIds, mentionRows)
      }
      catch (error) {
        errorMessage.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        loading.set(false)
        loaded.set(true)
      }
    }

    const resetForm = () => {
      draftId.set(0)
      draftName.set('')
      draftKeywords.set('')
      draftProviders.set(['bluesky'])
      draftMatchMode.set('any')
      draftStatus.set('active')
    }

    const selectMonitor = (monitor: ListeningMonitor) => {
      draftId.set(monitor.id)
      draftName.set(monitor.name)
      draftKeywords.set(monitor.keywords.join(', '))
      draftProviders.set([...monitor.providers])
      draftMatchMode.set(monitor.matchMode)
      draftStatus.set(monitor.status)
      filterMonitorId.set(monitor.id)
    }

    const toggleProvider = (provider: string) => {
      draftProviders.set(draftProviders().includes(provider) ? draftProviders().filter(item => item !== provider) : [...draftProviders(), provider])
    }

    const saveMonitor = async (event: SubmitEvent) => {
      event.preventDefault()
      saving.set(true)
      try {
        await requestJson('/api/postline/listening', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: draftId(), name: draftName(), keywords: draftKeywords().split(',').map(item => item.trim()).filter(Boolean), providers: draftProviders(), match_mode: draftMatchMode(), status: draftStatus() }),
        })
        postlineToast?.show?.({ title: 'Listening rule saved', message: 'Postline will watch these keywords automatically.', tone: 'success', id: 'listening-save' })
        resetForm()
        await loadData()
      }
      catch (error) {
        postlineToast?.show?.({ title: 'Could not save rule', message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'listening-save' })
      }
      finally {
        saving.set(false)
      }
    }

    const deleteMonitor = async () => {
      if (!draftId() || !window.confirm('Delete this listening rule and its saved mentions?')) return
      try {
        await requestJson('/api/postline/listening/delete', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: draftId() }) })
        resetForm()
        filterMonitorId.set(0)
        await loadData()
        postlineToast?.show?.({ title: 'Listening rule deleted', message: 'The watch and its saved mentions were removed.', tone: 'success', id: 'listening-delete' })
      }
      catch (error) {
        postlineToast?.show?.({ title: 'Could not delete rule', message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'listening-delete' })
      }
    }

    const runScan = async () => {
      scanning.set(true)
      try {
        const payload = await requestJson('/api/postline/listening/scan', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ monitor_id: filterMonitorId() || 0 }) })
        await loadData({ quiet: true })
        const skipped = payload.data?.errors?.length || 0
        const suffix = skipped ? ` ${skipped} network${skipped === 1 ? '' : 's'} need attention.` : ''
        postlineToast?.show?.({ title: 'Listening scan complete', message: `${payload.data?.created || 0} new mention${payload.data?.created === 1 ? '' : 's'} saved.${suffix}`, tone: skipped ? 'neutral' : 'success', id: 'listening-scan' })
      }
      catch (error) {
        postlineToast?.show?.({ title: 'Listening scan failed', message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'listening-scan' })
      }
      finally {
        scanning.set(false)
      }
    }

    const markRead = async (id: number) => {
      mentions.set(mentions().map(item => item.id === id ? { ...item, status: 'read' } : item))
      try {
        await requestJson('/api/postline/listening/read', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id }) })
      }
      catch {
        await loadData({ quiet: true })
      }
    }

    const markAllRead = async () => {
      try {
        await requestJson('/api/postline/listening/read', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ monitor_id: filterMonitorId() || 0 }) })
        mentions.set(mentions().map(item => !filterMonitorId() || item.monitorId === filterMonitorId() ? { ...item, status: 'read' } : item))
      }
      catch (error) {
        postlineToast?.show?.({ title: 'Could not update mentions', message: error instanceof Error ? error.message : String(error), tone: 'error', id: 'listening-read' })
      }
    }

    const enableDesktopAlerts = async () => {
      if (typeof Notification === 'undefined' || Notification.permission === 'denied') return
      notificationPermission.set(await Notification.requestPermission())
      if (notificationPermission() === 'granted')
        postlineToast?.show?.({ title: 'Desktop alerts enabled', message: 'Postline can alert you when a polling refresh finds new mentions.', tone: 'success', id: 'listening-notifications' })
    }

    onMount(() => {
      void loadData()
      pollTimer = window.setInterval(() => void loadData({ quiet: true }), 60_000)
    })
    onUnmounted(() => window.clearInterval(pollTimer))
  </script>
@endsection
