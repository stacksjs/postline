@extends('layouts/marketing')

@section('title', 'Postline — write once, publish everywhere')
@section('description', 'Postline publishes one draft to Bluesky, X, LinkedIn, Instagram, Threads and Mastodon. Queue, campaigns, inbox and analytics in one open-source app that runs with your keys.')

<script server>
import { FEATURES, USE_CASES } from '../../app/Support/Marketing/catalog'
import { marketingHead } from '../../app/Support/Marketing/head'
import { urlTo } from '../../config/domains'

const features = FEATURES
const useCases = USE_CASES

const networks = [
  { name: 'Bluesky', icon: 'bluesky' },
  { name: 'X', icon: 'x' },
  { name: 'LinkedIn', icon: 'linkedin' },
  { name: 'Instagram', icon: 'instagram' },
  { name: 'Threads', icon: 'threads' },
  { name: 'Mastodon', icon: 'mastodon' },
]

const steps = [
  { n: 1, title: 'Connect your accounts', body: 'Bluesky and Mastodon connect in a minute. X, LinkedIn, Instagram and Threads first need a developer app of your own, which Channels walks you through. Connect several accounts per network when you post as yourself and as a company.' },
  { n: 2, title: 'Write it once', body: 'One draft, counted against every network you picked. Give a network its own wording when it needs different words.' },
  { n: 3, title: 'Publish, or queue it', body: 'Send it now, schedule it in your own timezone, or lay out a whole launch on a campaign calendar.' },
]

const faqs = [
  { q: 'Is Postline free?', a: 'Yes. Postline is MIT licensed and free to run yourself, with no limit on accounts or posts. A hosted plan is in development. Leave your address below to hear when it opens.' },
  { q: 'Which networks does it publish to?', a: 'Bluesky, X, LinkedIn, Instagram, Threads and Mastodon, plus long-form posts to a blog on your own site. You can connect several accounts on the same network.' },
  { q: 'Where are my access tokens kept?', a: 'In your own database, encrypted with a key your instance generates. Postline has no service in the middle, so there is nobody else who could hold a copy.' },
  { q: 'Do I need a server?', a: 'You can run the desktop app on an Apple silicon Mac with macOS 13 or later. For overnight publishing or access from another device, self-host Postline on an always-on server and use it in your browser. On a Mac, you can switch on temporary image links in Settings so Instagram and Threads can fetch your images.' },
  { q: 'What do the networks charge?', a: 'Most of them nothing. X bills API access per use, and that cost is between you and X: Postline adds nothing on top and tells you which network a failed post was rejected by.' },
]

// Structured data for the application and the FAQ visible on this page.
const structuredData = [
  {
    '@type': 'SoftwareApplication',
    'name': 'Postline',
    'applicationCategory': 'BusinessApplication',
    'operatingSystem': 'macOS 13 or later',
    'processorRequirements': 'Apple silicon (ARM64)',
    'description': 'Write a post once and publish it to Bluesky, X, LinkedIn, Instagram, Threads and Mastodon. Open source, and it runs with your own keys.',
    'url': urlTo('/'),
    'license': 'https://opensource.org/licenses/MIT',
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
  },
  {
    '@type': 'FAQPage',
    'mainEntity': faqs.map(faq => ({ '@type': 'Question', 'name': faq.q, 'acceptedAnswer': { '@type': 'Answer', 'text': faq.a } })),
  },
]
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': structuredData }).replaceAll('<', '\\u003c')
useHead({
  ...marketingHead('/', '/images/og/home.png'),
  script: [{ type: 'application/ld+json', content: jsonLd }],
})
</script>

@section('content')
