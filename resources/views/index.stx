  {{-- Networks --}}
  <section class="relative py-8 border-line border-y marquee" aria-label="Supported networks">
    {{-- Moving content needs a way to stop it (WCAG 2.2.2). A checkbox and
        :has() in config/css.ts pause the track with no script; hovering or
        focusing the row pauses it too, and reduced motion never starts it. --}}
    <label class="flex absolute right-3 top-1/2 z-10 items-center justify-center h-8 w-8 text-muted hover:text-ink bg-panel border border-line rounded-full cursor-pointer -translate-y-1/2 marquee-toggle">
      <input class="sr-only" type="checkbox">
      {{-- The swap is on plain wrappers: an icon class sets its own display,
          which would win over a layered rule. --}}
      <span class="marquee-when-playing" aria-hidden="true"><span class="block h-4 w-4 i-hugeicons-pause"></span></span>
      <span class="marquee-when-paused" aria-hidden="true"><span class="block h-4 w-4 i-hugeicons-play"></span></span>
      <span class="sr-only">Pause the list of networks</span>
    </label>
    <div class="overflow-hidden marquee-mask">
      <ul class="flex gap-14 items-center m-0 p-0 w-max list-none marquee-track">
        {{-- Two identical halves, so the track loops without a seam. The
            second is hidden from assistive technology: it is the same list. --}}
        @foreach (networks as network)
          <li class="flex gap-2.5 items-center text-body"><span class="h-5 w-5 i-simple-icons-{{ network.icon }}" aria-hidden="true"></span><span class="font-medium text-[15px]">{{ network.name }}</span></li>
