@extends('layouts/app')

<script server cache>
import { workspaceLocale, workspaceWritingText } from '../../app/Support/Localization/workspace'

export const writingLocale = workspaceLocale
export const writingText = workspaceWritingText
export const writingClient = { locale: workspaceLocale, messages: workspaceWritingText }
</script>

@section('title')Postline - {{ writingText.blog }}@endsection

@section('content')
  @meta('description', 'Manage long-form posts published through Postline.')
  <section class="grid gap-4" data-postline-page="blog" data-testid="blog-page" lang="{{ writingLocale }}">
    <WorkspacePageHeader titleKey="workspace.pages.writing.title">
      <template #description><span :text="summaryText()"></span> · <a class="underline hover:text-ink" href="/blog" target="_blank" rel="noopener">{{ writingText.viewPublished }}</a></template>
      <a class="inline-flex gap-2 items-center justify-center px-4 h-9 font-semibold text-on-accent text-sm bg-accent hover:bg-accent-hover rounded-xl transition-colors" href="/composer" data-stx-link data-craft-no-drag x-show="!loaded() || items().length > 0">
        <span class="h-4 w-4 i-hugeicons-edit-02" aria-hidden="true"></span>
        {{ writingText.writePost }}
      </a>
    </WorkspacePageHeader>

    <section aria-label="{{ writingText.publishedPosts }}">
      <Card padding="none" className="shadow-sm">
        <header class="flex gap-3 items-center justify-between px-4 py-3.5 border-b border-line">
          <div>
            <h2 class="m-0 font-semibold text-ink text-sm">{{ writingText.posts }}</h2>
          </div>
          <button class="inline-flex gap-2 items-center justify-center px-3 h-8 font-semibold text-ink text-xs bg-panel-2 hover:bg-raised border border-line rounded-lg disabled:opacity-50 transition-colors" type="button" :disabled="loading()" @click="loadPosts">
            <span class="h-3.5 w-3.5 i-hugeicons-refresh" aria-hidden="true"></span>
            {{ writingText.refresh }}
          </button>
        </header>

        <WorkspaceListSkeleton :show="loading()" label="{{ writingText.loading }}" />
        <ErrorState :show="errorMessage() && !loading()" title="{{ writingText.loadFailure }}" :message="errorMessage()" @retry="loadPosts()" />
        <EmptyState :show="showEmpty()" variant="bare" title="{{ writingText.empty }}" description="{{ writingText.emptyDescription }}">
          <StxLink class="text-info text-ui underline" to="/composer">{{ writingText.openComposer }}</StxLink>
        </EmptyState>

        <div class="divide-line divide-y" x-show="!loading() && items().length">
          <article class="grid gap-3 p-4" x-for="item in rows()" data-blog-row>
            <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center" x-show="!item.editing">
              <div class="min-w-0">
                <div class="flex gap-2 items-center mb-1.5">
                  <span class="px-2 py-0.5 font-semibold text-xs border rounded-full" :class="item.published ? 'text-success bg-success-soft border-success-line' : 'text-muted bg-panel-2 border-line'" :text="item.published ? copy.published : copy.takenDown"></span>
                  <time class="text-muted text-xs" :datetime="item.publishedAt" :text="item.date"></time>
                </div>
                <h3 class="m-0 font-semibold text-ink text-sm" :text="item.title"></h3>
                <p class="m-0 mt-1 line-clamp-2 text-muted text-ui" :text="item.excerpt"></p>
              </div>
              <div class="flex flex-wrap gap-1.5 items-center justify-end">
                <a class="inline-flex gap-1.5 items-center justify-center px-3 h-8 font-medium text-ink text-xs bg-panel hover:bg-raised border border-line rounded-lg" x-show="item.published" :href="item.url" target="_blank" rel="noopener noreferrer">
                  {{ writingText.viewLive }}
                  <span class="h-3.5 w-3.5 i-hugeicons-square-arrow-up-right-02" aria-hidden="true"></span>
                </a>
                <button class="inline-flex items-center justify-center px-3 h-8 font-medium text-ink text-xs bg-panel hover:bg-raised border border-line rounded-lg disabled:opacity-50" type="button" :disabled="busyId() === item.id" @click="startEdit(item.id)">{{ writingText.edit }}</button>
                <button class="inline-flex items-center justify-center px-3 h-8 font-medium text-ink text-xs bg-panel hover:bg-raised border border-line rounded-lg disabled:opacity-50" type="button" :disabled="busyId() === item.id" @click="toggleLive(item.id)" :text="item.published ? copy.takeDown : copy.putBack"></button>
                <button class="inline-flex items-center justify-center px-3 h-8 font-medium text-danger text-xs bg-panel hover:bg-danger-soft border border-line rounded-lg disabled:opacity-50" type="button" :disabled="busyId() === item.id" @click="removePost(item.id)">{{ writingText.deleteAction }}</button>
              </div>
            </div>
            <form class="grid gap-2" x-show="item.editing" @submit.prevent="saveEdit(item.id)">
              <input class="px-3 h-9 text-ink text-sm bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft" type="text" maxlength="200" aria-label="{{ writingText.title }}" :value="item.draftTitle" @input="setDraft(item.id, 'title', $event)" data-blog-edit-title>
              <textarea class="px-3 py-2 min-h-40 text-ink text-ui bg-panel border border-field-line outline-none rounded-xl focus:border-info-solid focus:ring-2 focus:ring-info-soft resize-y" aria-label="{{ writingText.text }}" :value="item.draftBody" @input="setDraft(item.id, 'body', $event)" data-blog-edit-body></textarea>
              <div class="flex gap-2 justify-end">
                <button class="inline-flex items-center justify-center px-3 h-8 font-medium text-ink text-xs bg-panel hover:bg-raised border border-line rounded-lg" type="button" @click="cancelEdit()">{{ writingText.cancel }}</button>
                <button class="inline-flex items-center justify-center px-3 h-8 font-semibold text-on-accent text-xs bg-accent hover:bg-accent-hover rounded-lg disabled:opacity-50" type="submit" :disabled="busyId() === item.id">{{ writingText.save }}</button>
              </div>
            </form>
          </article>
        </div>

      </Card>
    </section>

    {{--
      Bring posts over from another platform (#117): a CSV export or a JSON
      array of { title, body, slug, publishedAt }. A preview runs first and
      says exactly what an import would create, update and skip.
    --}}
    <section class="grid gap-3 p-4 bg-panel border border-line rounded-2xl shadow-sm" aria-labelledby="import-heading">
      <div>
        <h2 id="import-heading" class="m-0 font-semibold text-ink text-sm">{{ writingText.importPosts }}</h2>
        <p class="m-0 mt-1 text-muted text-xs">{{ writingText.importDescription }}</p>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <label class="inline-flex gap-2 items-center px-3 h-8 font-semibold text-ink text-xs bg-panel-2 hover:bg-raised border border-line rounded-lg cursor-pointer">
          <span class="h-3.5 w-3.5 i-hugeicons-file-import" aria-hidden="true"></span>
          <span :text="importName() || copy.chooseFile">{{ writingText.chooseFile }}</span>
          <input class="sr-only" type="file" accept=".csv,.json,text/csv,application/json" :disabled="importing()" @change="chooseImport($event)">
        </label>
        <Button size="sm" :show="importResult()?.report.dryRun" :loading="importing()" :label="importing() ? copy.importing : copy.importAction" @click="runImport">{{ writingText.importAction }}</Button>
      </div>
      <p class="m-0 text-xs" x-show="importMessage()" :class="importTone() === 'error' ? 'text-danger' : 'text-body'" :text="importMessage()" role="status" aria-live="polite"></p>
      <ul class="grid gap-1 m-0 pl-5 list-disc text-muted text-xs" x-show="importSkipped().length">
        <li x-for="item in importSkipped()" :text="words.t('skippedRow', { row: item.row, reason: item.reason })"></li>
      </ul>
    </section>
  </section>

  <script client>
    import type { ImportReport } from '../../app/Services/ImportService'
    import { createI18n } from '@stacksjs/i18n/client'
    import { showNotification } from '../functions/notification'

    const { locale: language, messages: copy } = {{ writingClient }}
    const words = createI18n({ locale: language, messages: { [language]: copy } })
    const dateLocale = language === 'en' ? undefined : language

    const items = state([])
    const loading = state(true)
    const loaded = state(false)
    const errorMessage = state('')

    const busyId = state(0)
    const editingId = state(0)
    const drafts = state({ title: '', body: '' })

    const publishedCount = derived(() => items().filter(item => item.status === 'published').length)
    const showEmpty = derived(() => loaded() && !loading() && !errorMessage() && items().length === 0)
    const summaryText = derived(() => {
      if (errorMessage()) return copy.unavailable
      const published = publishedCount()
      const takenDown = items().length - published
      return takenDown ? words.t('bothCounts', { published, takenDown }) : words.t('publishedCount', { count: published })
    })

    const dateLabel = (value: string | null | undefined): string => {
      const date = new Date(value)
      return Number.isNaN(date.getTime())
        ? copy.published
        : date.toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', year: 'numeric' })
    }

    interface ImportFile {
      name: string
      text: string
    }

    const importName = state('')
    const importResult = state<{ file: ImportFile, report: ImportReport } | null>(null)
    const importing = state(false)
    const importMessage = state('')
    const importTone = state('neutral')
    let importSelection = 0
    // At most 20 skipped rows on screen; the count above covers the rest.
    const importSkipped = derived(() => importResult()?.report.skippedRows.slice(0, 20) ?? [])

    const sendImport = async ({ name, text }: ImportFile, dryRun: boolean): Promise<ImportReport> => {
      const body = new FormData()
      if (name.toLowerCase().endsWith('.json') || text.trim().startsWith('['))
        body.set('posts', text)
      else
        body.set('csv', text)
      if (dryRun) body.set('dry_run', '1')
      const response = await fetch('/api/postline/import/posts', { method: 'POST', body })
      const payload = await response.json()
      if (!response.ok || !payload.ok) throw new Error(payload.error || copy.fileFailure)
      return payload.data.report
    }

    const chooseImport = async (event: Event) => {
      const input = event.target as HTMLInputElement | null
      const file = input?.files?.[0]
      if (!file || importing()) return
      const selection = ++importSelection
      importName.set(file.name)
      importResult.set(null)
      importMessage.set(copy.readingFile)
      importTone.set('neutral')
      try {
        const source = { name: file.name, text: await file.text() }
        if (selection !== importSelection) return
        const report = await sendImport(source, true)
        if (selection !== importSelection) return
        importResult.set({ file: source, report })
        importMessage.set(words.t('previewReport', report))
      }
      catch (error) {
        if (selection !== importSelection) return
        importMessage.set(error instanceof Error ? error.message : String(error))
        importTone.set('error')
      }
    }

    const runImport = async () => {
      const preview = importResult()
      if (!preview?.report.dryRun || importing()) return
      importing.set(true)
      importMessage.set(copy.importing)
      importTone.set('neutral')
      try {
        const report = await sendImport(preview.file, false)
        importResult.set({ file: preview.file, report })
        importMessage.set(words.t('importReport', report))
        await loadPosts()
      }
      catch (error) {
        importMessage.set(error instanceof Error ? error.message : String(error))
        importTone.set('error')
      }
      finally {
        importing.set(false)
      }
    }

    const loadPosts = async () => {
      loading.set(true)
      errorMessage.set('')
      try {
        const response = await fetch('/api/postline/blog')
        const payload = await response.json()
        if (!response.ok || !payload.ok) throw new Error(payload.error || copy.loadFailure)
        items.set(Array.isArray(payload.data?.items) ? payload.data.items : [])
      }
      catch (error) {
        items.set([])
        errorMessage.set(error instanceof Error ? error.message : String(error))
      }
      finally {
        loading.set(false)
        loaded.set(true)
      }
    }

    const rows = derived(() => items().map(item => ({
      ...item,
      published: item.status === 'published',
      excerpt: item.excerpt || item.body,
      date: dateLabel(item.publishedAt),
      editing: editingId() === item.id,
      draftTitle: editingId() === item.id ? drafts().title : item.title,
      draftBody: editingId() === item.id ? drafts().body : item.body,
    })))

    const toast = (message: string, tone: 'success' | 'error' = 'success'): void => {
      showNotification({ message, tone, title: tone === 'error' ? copy.blog : copy.completed })
    }

    const send = async (path: string, fields: Record<string, string>) => {
      const body = new FormData()
      for (const [key, value] of Object.entries(fields)) body.set(key, value)
      const response = await fetch(`/api/postline/blog/${path}`, { method: 'POST', body })
      const payload = await response.json()
      if (!response.ok || !payload.ok) throw new Error(payload.error || copy.requestFailure)
      return payload.data
    }

    const startEdit = (id: number) => {
      const item = items().find(entry => entry.id === id)
      if (!item) return
      drafts.set({ title: item.title, body: item.body })
      editingId.set(id)
    }
    const cancelEdit = () => editingId.set(0)
    const setDraft = (id: number, field: 'title' | 'body', event: Event) => {
      if (editingId() !== id) return
      drafts.set({ ...drafts(), [field]: String((event.target as HTMLInputElement | null)?.value || '') })
    }

    const saveEdit = async (id: number) => {
      busyId.set(id)
      try {
        await send('update', { id: String(id), title: drafts().title, body: drafts().body })
        editingId.set(0)
        await loadPosts()
        toast(copy.saved)
      }
      catch (error) {
        toast(error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        busyId.set(0)
      }
    }

    const toggleLive = async (id: number) => {
      const item = items().find(entry => entry.id === id)
      if (!item) return
      busyId.set(id)
      try {
        await send(item.status === 'published' ? 'unpublish' : 'republish', { id: String(id) })
        await loadPosts()
        toast(item.status === 'published' ? copy.removedFromSite : copy.backOnSite)
      }
      catch (error) {
        toast(error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        busyId.set(0)
      }
    }

    const removePost = async (id: number) => {
      const item = items().find(entry => entry.id === id)
      if (!item || !await stxConfirm(words.t('confirmMessage', { title: item.title }), { title: copy.confirmTitle, type: 'error', confirmText: copy.confirmAction, cancelText: copy.cancel })) return
      busyId.set(id)
      try {
        await send('delete', { id: String(id) })
        await loadPosts()
        toast(copy.deleted)
      }
      catch (error) {
        toast(error instanceof Error ? error.message : String(error), 'error')
      }
      finally {
        busyId.set(0)
      }
    }

    onMount(() => void loadPosts())
  </script>
@endsection
