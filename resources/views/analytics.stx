@extends('layouts/app')

@section('title', 'Postline - Analytics')

@section('content')
  @meta('description', 'Review lightweight publishing analytics in Postline.')
  <section class="grid gap-5" data-postline-page="analytics" data-testid="analytics-page">
    <WorkspacePageHeader title="Publishing insights">
      <label class="grid gap-1 text-muted text-xs">
        <span>Date range</span>
        <select class="px-2.5 h-9 text-ink text-ui bg-panel border border-field-line rounded-xl" @change="changeRange(Number($event.target.value))">
          <option value="7" :selected="days() === 7">Last 7 days</option>
          <option value="30" selected :selected="days() === 30">Last 30 days</option>
          <option value="90" :selected="days() === 90">Last 90 days</option>
        </select>
      </label>
    </WorkspacePageHeader>

    <WorkspaceListSkeleton :show="loading()" label="Loading analytics" />
    <ErrorState :show="!loading() && error()" title="Could not load analytics" :message="error()" @retry="loadAnalytics(page())" />
    <EmptyState :show="!loading() && !error() && total() === 0" :title="'No publishing activity in the last ' + days() + ' days'" description="Publish a post to start seeing activity here.">
      <StxLink class="text-info text-ui underline" to="/composer">Write a post</StxLink>
    </EmptyState>

    <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4" x-cloak :show="showResults()">
      <Card padding="sm" className="shadow-sm">
        <div class="grid gap-2">
          <span class="text-muted text-xs">Posts published</span>
          <strong class="text-2xl" :text="total()" data-analytics-total></strong>
        </div>
      </Card>
      <Card padding="sm" className="shadow-sm">
        <div class="grid gap-2">
          <span class="text-muted text-xs">Engagement</span>
          <strong class="text-2xl" :text="interactions() ?? 'Not available'" data-analytics-engagement></strong>
          <span class="text-muted text-xs" :text="engagementDescription()" data-analytics-engagement-trend></span>
        </div>
      </Card>
      <Card padding="sm" className="shadow-sm">
        <div class="grid gap-2">
          <span class="text-muted text-xs">Best network</span>
          <strong class="text-2xl" :text="bestNetwork()?.label ?? 'No recommendation'"></strong>
          <span class="text-muted text-xs" :text="bestNetwork()?.sample ?? 'Needs a clear leader and ' + data()?.stats.minSample + ' measured posts on each of two channels'"></span>
        </div>
      </Card>
      <Card padding="sm" className="shadow-sm">
        <div class="grid gap-2">
          <span class="text-muted text-xs">Best window</span>
          <strong class="text-2xl" :text="bestWindow()?.label ?? 'No recommendation'"></strong>
          <span class="text-muted text-xs" :text="bestWindow()?.sample ?? 'Needs a clear leader and ' + data()?.stats.minSample + ' measured posts in each of two hours'"></span>
        </div>
      </Card>
    </div>

    <div class="grid gap-3.5 lg:grid-cols-[minmax(0,1fr)_320px]" x-cloak :show="showResults()">
      <section class="min-w-0" aria-labelledby="analytics-chart-title">
        <Card padding="none" className="shadow-sm">
          <header class="flex gap-3 items-center justify-between p-3.5 border-b border-line">
            <h2 class="m-0 font-semibold text-ui" id="analytics-chart-title">Publishing activity</h2>
            <span class="text-muted text-xs">Dates in UTC</span>
          </header>
          <p class="m-0 p-3.5 text-muted text-ui" :show="!enoughDays()">Publish on at least two days to see a trend.</p>
          <div class="relative mx-3.5 my-3.5 h-56 sm:h-64" :show="enoughDays()">
            <canvas class="block h-full w-full" ref="chartCanvas" data-analytics-chart role="img" aria-label="Posts published each day. A data table follows."></canvas>
          </div>
          <details class="p-3.5 text-ui border-line border-t">
            <summary class="font-medium text-info cursor-pointer">Daily publishing totals</summary>
            <table class="mt-2 w-full text-left">
              <thead><tr><th scope="col">Date (UTC)</th><th scope="col">Posts published</th></tr></thead>
              <tbody><tr x-for="day in series()" :key="day.label"><td :text="day.label"></td><td :text="day.value"></td></tr></tbody>
            </table>
          </details>
        </Card>
      </section>

      <aside class="grid content-start gap-3.5">
        <section aria-labelledby="network-engagement-title">
          <Card padding="none" className="shadow-sm">
            <header class="p-3.5 border-b border-line">
              <h2 class="m-0 font-semibold text-ui" id="network-engagement-title">Engagement by network</h2>
            </header>
            <ul class="grid gap-2 m-0 p-3.5 list-none text-muted text-xs" data-analytics-network-engagement>
              <li x-for="network in networks()" :key="network.provider">
                <strong class="block text-ink" :text="network.label"></strong>
                <span :text="network.description"></span>
              </li>
            </ul>
          </Card>
        </section>
        <section aria-labelledby="channel-mix-title">
          <Card padding="none" className="shadow-sm">
            <header class="p-3.5 border-b border-line">
              <h2 class="m-0 font-semibold text-ui" id="channel-mix-title">Publishing by network</h2>
            </header>
            <div class="grid gap-2 p-3.5">
              <div class="flex gap-2 justify-between text-ui" x-for="network in networks()" :key="network.provider">
                <span :text="network.label"></span>
                <span class="text-muted" :text="network.published + ' · ' + network.share + '%'"></span>
              </div>
            </div>
          </Card>
        </section>
        <section aria-labelledby="publishing-windows-title">
          <Card padding="none" className="shadow-sm">
            <header class="p-3.5 border-b border-line">
              <h2 class="m-0 font-semibold text-ui" id="publishing-windows-title">Most-used posting windows</h2>
            </header>
            <ul class="grid gap-2 m-0 p-3.5 text-muted text-ui">
              <li x-for="period in windows()" :key="period.hour" :text="formatWindow(period.hour) + ' · ' + period.count + (period.count === 1 ? ' post' : ' posts')"></li>
            </ul>
          </Card>
        </section>
      </aside>
    </div>

    <section class="min-w-0" aria-labelledby="published-posts-title" x-cloak x-show="showResults() && posts().length">
      <Card padding="none" className="shadow-sm">
        <header class="p-3.5 border-b border-line">
          <h2 class="m-0 font-semibold text-ui" id="published-posts-title" tabindex="-1" ref="postsHeading">Published posts</h2>
        </header>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-ui">
            <thead class="text-muted bg-panel-2">
              <tr><th class="p-3" scope="col">Post</th><th class="p-3" scope="col">Published (UTC)</th><th class="p-3" scope="col">Reported metrics</th></tr>
            </thead>
            <tbody class="divide-line divide-y">
              <tr x-for="post in posts()" :key="post.id">
                <th class="p-3 font-medium wrap-anywhere" scope="row" :text="post.title"></th>
                <td class="p-3 text-muted whitespace-nowrap" :text="formatPostDate(post.publishedAt)"></td>
                <td class="p-3">
                  <ul class="grid gap-1 m-0 p-0 list-none">
                    <li x-for="target in post.targets" :key="target.id"><strong :text="providerLabel(target.provider) + (target.handle ? ' · ' + target.handle : '')"></strong> <span class="text-muted" :text="metricsText(target)"></span></li>
                  </ul>
                  <span class="text-muted" :show="!post.targets.length">No reported metrics</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <nav class="flex gap-3 items-center justify-between px-3 py-2.5 border-line border-t" aria-label="Published posts pages" :show="pageCount() > 1">
          <button class="px-2.5 h-9 text-ui bg-panel-2 border border-line rounded-lg disabled:opacity-50" type="button" :disabled="page() <= 1" @click="loadAnalytics(page() - 1, true)">Previous</button>
          <span class="text-muted text-xs" :text="'Page ' + page() + ' of ' + pageCount()"></span>
          <button class="px-2.5 h-9 text-ui bg-panel-2 border border-line rounded-lg disabled:opacity-50" type="button" :disabled="page() >= pageCount()" @click="loadAnalytics(page() + 1, true)">Next</button>
        </nav>
      </Card>
    </section>
  </section>

  <script client>
    import type { AnalyticsPayload } from '../assets/scripts/lib/analytics'
    import { drawPublishingChart, engagementLabels, formatPostDate, formatSample, formatWindow } from '../assets/scripts/lib/analytics'
    import { providerLabel } from '../functions/networks'
    import { requestJson } from '../functions/postline-client'

    const chartCanvas = useRef('chartCanvas')
    const postsHeading = useRef('postsHeading')
    const data = state<AnalyticsPayload | null>(null)
    const days = state(30)
    const page = state(1)
    const loading = state(true)
    const error = state('')
    let request: AbortController | undefined
    let chart: ReturnType<typeof drawPublishingChart> | undefined

    const total = derived(() => data()?.totalPosts ?? 0)
    const series = derived(() => data()?.series ?? [])
    const enoughDays = derived(() => series().filter(point => point.value > 0).length >= 2)
    const showResults = derived(() => !loading() && !error() && total() > 0)
    const posts = derived(() => data()?.posts ?? [])
    const windows = derived(() => data()?.windows ?? [])
    const pageCount = derived(() => data()?.pageCount ?? 0)
    const bestNetwork = derived(() => {
      const best = data()?.stats.bestChannel
      return best ? { label: providerLabel(best.provider), sample: formatSample(best) } : null
    })
    const bestWindow = derived(() => {
      const best = data()?.stats.bestHour
      return best ? { label: formatWindow(best.hour), sample: formatSample(best) } : null
    })
    const reported = derived(() => data()?.stats.engagement?.countsByProvider ?? [])
    const totals = derived(() => {
      const engagement = data()?.stats.engagement
      return {
        likes: reported().some(counts => counts.likes !== undefined) ? engagement?.likes : undefined,
        reposts: reported().some(counts => counts.reposts !== undefined) ? engagement?.reposts : undefined,
        replies: reported().some(counts => counts.replies !== undefined) ? engagement?.replies : undefined,
      }
    })
    const interactions = derived(() => Object.values(totals()).some(value => value !== undefined)
      ? Object.values(totals()).reduce<number>((sum, value) => sum + (value ?? 0), 0).toLocaleString()
      : null)
    const engagementDescription = derived(() => engagementLabels(totals(), 'like or reaction', 'likes and reactions')
      || 'Waiting for a supported network to report likes, reposts or replies')

    function metricsText(target: { provider: string, counts?: Parameters<typeof engagementLabels>[0] }) {
      return engagementLabels(target.counts ?? {}, target.provider === 'linkedin' ? 'reaction' : 'like') || 'No reported metrics'
    }

    const networks = derived(() => (data()?.channelMix ?? []).map(network => ({
      ...network,
      label: providerLabel(network.provider),
      description: metricsText({ provider: network.provider, counts: reported().find(item => item.provider === network.provider) }),
    })))

    function changeRange(range: number) {
      days.set(range)
      void loadAnalytics(1)
    }

    async function loadAnalytics(nextPage: number, focusPosts = false) {
      request?.abort()
      const controller = new AbortController()
      request = controller
      chart?.destroy()
      chart = undefined
      page.set(nextPage)
      loading.set(true)
      error.set('')
      try {
        const payload = await requestJson(`/api/postline/analytics?days=${days()}&page=${nextPage}`, { signal: controller.signal, cache: 'no-store' }, 'Could not load analytics.')
        if (!payload.data?.stats || !Array.isArray(payload.data.series) || !Array.isArray(payload.data.posts))
          throw new Error('Analytics data was incomplete.')
        if (controller.signal.aborted) return
        data.set(payload.data)
        page.set(payload.data.page)
        loading.set(false)
        await nextTick()
        if (controller.signal.aborted) return
        if (enoughDays() && chartCanvas.current)
          chart = drawPublishingChart(chartCanvas.current, series())
        if (focusPosts) postsHeading.current?.focus()
      }
      catch (problem) {
        if (controller.signal.aborted) return
        error.set(problem instanceof Error ? problem.message : 'Could not load analytics.')
        loading.set(false)
      }
    }

    onMount(() => { void loadAnalytics(1) })
    onUnmounted(() => {
      request?.abort()
      chart?.destroy()
    })
  </script>
@endsection
