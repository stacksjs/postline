@extends('layouts/app')

@section('title', 'Postline - Analytics')

@section('content')
  @meta('description', 'Review lightweight publishing analytics in Postline.')
  <section class="grid gap-5" data-postline-page="analytics" data-testid="analytics-page" ref="analyticsPage" @postline-analytics-state="showAnalyticsState($event)">
    <header class="flex gap-4 items-center justify-between min-h-11">
      <div>
        <p class="mb-1.5 font-semibold text-muted text-xs tracking-wider uppercase">Analytics</p>
        <h1 class="m-0 font-semibold text-2xl text-ink tracking-normal">Publishing insights</h1>
        <p class="mb-0 mt-1.5 text-muted text-ui">How your posting has performed over the last 30 days.</p>
      </div>
    </header>

    <WorkspaceListSkeleton :show="analyticsState() === 'loading'" label="Loading analytics" />
    <ErrorState :show="analyticsState() === 'error'" title="Could not load analytics" :message="analyticsError()" @retry="retryAnalytics()" />
    <EmptyState :show="analyticsState() === 'empty'" title="No publishing activity in the last 30 days" description="Publish a post to start seeing activity here.">
      <StxLink class="text-info text-ui underline" to="/composer">Write a post</StxLink>
    </EmptyState>

    <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4" x-cloak :show="analyticsState() === 'ready'">
      <article class="grid gap-2 p-3.5 bg-panel border border-line rounded-2xl shadow-sm">
        <span class="text-muted text-xs">Posts this week</span>
        <strong class="text-2xl" data-analytics-posts-week>0</strong>
        <span class="text-muted text-xs" data-analytics-posts-trend>Loading…</span>
      </article>
      <article class="grid gap-2 p-3.5 bg-panel border border-line rounded-2xl shadow-sm">
        <span class="text-muted text-xs">Engagement · Last 30 days</span>
        <strong class="text-2xl" data-analytics-engagement>Not available</strong>
        <span class="text-muted text-xs" data-analytics-engagement-trend>Loading…</span>
      </article>
      <article class="grid gap-2 p-3.5 bg-panel border border-line rounded-2xl shadow-sm">
        <span class="text-muted text-xs">Best network</span>
        <strong class="text-2xl" data-analytics-best-channel>Not available</strong>
        <span class="text-muted text-xs" data-analytics-best-channel-trend>Loading…</span>
      </article>
      <article class="grid gap-2 p-3.5 bg-panel border border-line rounded-2xl shadow-sm">
        <span class="text-muted text-xs">Best window</span>
        <strong class="text-2xl" data-analytics-best-window>Not available</strong>
        <span class="text-muted text-xs" data-analytics-best-window-trend>Loading…</span>
      </article>
    </div>

    <div class="grid gap-3.5 lg:grid-cols-[minmax(0,1fr)_320px]" x-cloak :show="analyticsState() === 'ready'">
      <section class="bg-panel border border-line rounded-2xl shadow-sm">
        <header class="flex gap-3 items-center justify-between p-3.5 border-b border-line">
          <strong class="text-ui">Publishing activity</strong>
          <span class="text-muted text-xs">Last 30 days</span>
        </header>
        <div class="p-3.5">
          <svg class="block h-auto w-full" viewBox="0 0 640 280" role="img" aria-label="Posts published over the last 30 days" data-analytics-chart>
            <desc>Posts published over the last 30 days with dates on the x axis and post counts on the y axis.</desc>
            <rect data-chart-background x="0" y="0" width="640" height="280" rx="16" fill="#fafafa"></rect>
            <g data-chart-legend></g>
            <g data-chart-grid></g>
            <g data-chart-y-axis></g>
            <g data-chart-x-axis></g>
            <g data-chart-labels></g>
            <path data-chart-area fill="rgba(37, 99, 235, 0.10)"></path>
            <path data-chart-line fill="none" stroke="#2563eb" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
            <g data-chart-points></g>
            <g data-chart-hover aria-hidden="true"></g>
            <rect data-chart-hit-area x="0" y="0" width="640" height="280" fill="transparent" tabindex="0" role="application" aria-label="Hover or focus the publishing activity chart for point details."></rect>
          </svg>
        </div>
      </section>

      <aside class="grid content-start gap-3.5">
        <section class="bg-panel border border-line rounded-2xl shadow-sm" aria-labelledby="network-engagement-title">
          <header class="p-3.5 border-b border-line">
            <h2 class="m-0 font-semibold text-ui" id="network-engagement-title">Engagement by network</h2>
          </header>
          <ul class="grid gap-2 m-0 p-3.5 list-none text-muted text-xs" data-analytics-network-engagement>
            <li>Waiting for reported engagement.</li>
          </ul>
        </section>
        <section class="bg-panel border border-line rounded-2xl shadow-sm">
          <header class="p-3.5 border-b border-line">
            <strong class="text-ui">Publishing by network</strong>
          </header>
          <div class="grid gap-3 p-3.5" data-analytics-channel-mix>
            <p class="m-0 text-muted text-xs">Loading…</p>
          </div>
        </section>

        <section class="bg-panel border border-line rounded-2xl shadow-sm">
          <header class="p-3.5 border-b border-line">
            <strong class="text-ui">Most-used posting windows</strong>
          </header>
          <div class="grid gap-2 p-3 text-muted text-xs" data-analytics-windows>
            <p class="m-0 text-xs">Loading…</p>
          </div>
        </section>
      </aside>
    </div>
  </section>

  <script client>
    type AnalyticsState = 'loading' | 'error' | 'empty' | 'ready'
    const analyticsPage = useRef('analyticsPage')
    const analyticsState = state<AnalyticsState>('loading')
    const analyticsError = state('')

    function showAnalyticsState(event: CustomEvent<{ state: AnalyticsState, message?: string }>) {
      analyticsState.set(event.detail.state)
      analyticsError.set(event.detail.message ?? '')
    }

    function retryAnalytics() {
      analyticsPage.current?.dispatchEvent(new Event('postline-analytics-retry'))
    }
  </script>
@endsection
